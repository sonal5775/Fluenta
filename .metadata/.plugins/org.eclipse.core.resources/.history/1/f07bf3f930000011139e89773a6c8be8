	public void saveOtherTestResult(String specimanId, List<OtherTestResultLabTestingDto> othrTestResult) {
		logger.info("Entering saveOtherTestResult with specimenId: {}, otherTestResult: {}", specimanId,
				othrTestResult);

		dbSessionService.setSessionInfo(this.getClass().getName());
		for (OtherTestResultLabTestingDto item : othrTestResult) {
			OtherTestResultQualityTransactionEntity othrTstRsltEntity = new OtherTestResultQualityTransactionEntity();
			Optional<OtherTestResultQualityTransactionEntity> optional = otherTestResultQualityTransactionRepository
					.findById(specimanId);
			if (optional.isPresent()) {
				othrTstRsltEntity = optional.get();
			} else {
				othrTstRsltEntity.setSpecimanId(specimanId);
				othrTstRsltEntity.setCreatedDate(new Date());
				othrTstRsltEntity.setCreatedBy(ClientIpUtils.getClient());
				othrTstRsltEntity.setIsActive(BigDecimal.ONE);
				othrTstRsltEntity.setCreatedMacAddress(ClientIpUtils.getClientIpAddress());
			}
			othrTstRsltEntity.setTestRemarks(item.getTestRemarks());
			othrTstRsltEntity.setModifiedBy(ClientIpUtils.getClient());
			othrTstRsltEntity.setModifiedDate(new Date());
			othrTstRsltEntity.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());
			otherTestResultQualityTransactionRepository.save(othrTstRsltEntity);
			updateSpecimanForOtherTest(specimanId, item);
		}
	}

	private void updateSpecimanForOtherTest(String specimanId, OtherTestResultLabTestingDto item) {
		SpecimenQualityTransactionEntity specimnQltyTrsnEntity = new SpecimenQualityTransactionEntity();
		Optional<SpecimenQualityTransactionEntity> isCheckSpecimanId = specimenQualityTransactionRepository
				.findById(specimanId);
		if (isCheckSpecimanId.isPresent()) {
			specimnQltyTrsnEntity = isCheckSpecimanId.get();
			specimnQltyTrsnEntity.setSpecimenStatus(item.getSpecimenStatus());
		} else {
			specimnQltyTrsnEntity.setSpecimenId(specimanId);
		}
		specimnQltyTrsnEntity.setFinalResult(item.getFinalResult());
		if (item.getManualDecision() != null && QualityConstants.PASS.equals(item.getManualDecision())) {
			specimnQltyTrsnEntity.setReleaseRemark(item.getReleaseRemark());
		} else {
			specimnQltyTrsnEntity.setHoldRemark(item.getReleaseRemark());
		}
		specimnQltyTrsnEntity.setManualDecision(item.getManualDecision());
		specimenQualityTransactionRepository.save(specimnQltyTrsnEntity);
	}

	@Transactional
	@Override
	public FluentaApiResponse<Void> retest(String sampleId, String specimanId, String baseSpecimenId) {
		logger.info("Entering retest with sampleId: {}, specimenId: {}", sampleId, specimanId);

		dbSessionService.setSessionInfo(this.getClass().getName());
		FluentaApiResponse<Void> response = new FluentaApiResponse<>();
		SpecimenQualityTransactionEntity specimnQltyTrsnEntity;
		Optional<SpecimenQualityTransactionEntity> isCheckSpecimanId = specimenQualityTransactionRepository
				.findById(specimanId);

		if (isCheckSpecimanId.isPresent()) {

			specimnQltyTrsnEntity = isCheckSpecimanId.get();
			specimnQltyTrsnEntity.setSpecimenStatus(QualityConstants.REJECTED);
			specimenQualityTransactionRepository.save(specimnQltyTrsnEntity);
			response.addMessage(MessageType.SUCCESS, "Resample Successfully Completed");

		} else {
			response.addMessage(MessageType.ERROR, "No valid testOrderId records found to update.");

		}
		List<SpecimenQualityTransactionEntity> findChildSpecimanId = specimenQualityTransactionRepository
				.findChildBySpecimanId(baseSpecimenId);

		if (!findChildSpecimanId.isEmpty()) {

			for (SpecimenQualityTransactionEntity sqt : findChildSpecimanId) {
				sqt.setSpecimenStatus(QualityConstants.REJECTED);
				specimenQualityTransactionRepository.save(sqt);
			}
			response.addMessage(MessageType.SUCCESS, "Resample Successfully Completed");

		} else {
			response.addMessage(MessageType.ERROR, "No valid testOrderId records found to update.");

		}

		saveSpecimenGeneration(sampleId, specimanId, findChildSpecimanId);
		return response;
	}

