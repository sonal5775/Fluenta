	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public ResponseEntity<FluentaApiResponse<List<SampleDetailsDto>>> updateManualDecision(
	        List<SampleDetailsDto> request) {

	    long methodStart = System.currentTimeMillis();

	    dbSessionService.setSessionInfo(this.getClass().getName());

	    final String modifiedBy = ClientIpUtils.getClient();
	    final String modifiedIp = ClientIpUtils.getClientIpAddress();
	    final Date now = new Date();

	    List<PostProdTaskMtEntity> tasksToSave = new ArrayList<>();
	    List<PpspecimanmapQtEntity> specimenMapsToSave = new ArrayList<>();
	    List<TestOrderLineQualityListEntity> testOrdersToSave = new ArrayList<>();

	    List<HsmQualityChemicalDto> chemPayload = new ArrayList<>();
	    List<HsmQualityMechanicalDto> mechPayload = new ArrayList<>();

	    for (SampleDetailsDto dto : request) {

	        long loopStart = System.currentTimeMillis();

	        // ---------------- Fetch Task ----------------
	        PostProdTaskMtEntity task = postProdTaskMtEntityJpaRepository
	                .getTasksByPpidAndPrid(dto.getPpId(), dto.getTpiRequired(), QualityConstants.INSP_FLAG_YES)
	                .orElseThrow(() -> new ResourceNotFoundException(
	                        "PostProdTaskMtEntity", dto.getPpId(), null));

	        task.setFinalResult(dto.getFinalResult());
	        task.setManualDecision(dto.getManualDecision());
	        task.setTaskStatus(QualityConstants.STATUS_COMPLETE);
	        task.setModifiedBy(modifiedBy);
	        task.setModifiedDate(now);
	        task.setModifiedMacAddress(modifiedIp);
	        task.setReleaseRemark(dto.getReleaseRemark());

	        tasksToSave.add(task);

	        // ---------------- Mapped Coils ----------------
	        List<PostProdTaskMtEntity> mappedCoils =
	                postProdTaskMtEntityJpaRepository.getTasksByMappedSampleId(
	                        task.getId().getPpId(), task.getMapSampleId());

	        for (PostProdTaskMtEntity coilTask : mappedCoils) {
	            coilTask.setFinalResult(dto.getFinalResult());
	            coilTask.setManualDecision(dto.getManualDecision());

	            if (QualityConstants.PASS.equals(dto.getManualDecision())) {
	                coilTask.setTaskStatus(QualityConstants.STATUS_COMPLETED);
	            }

	            coilTask.setModifiedBy(modifiedBy);
	            coilTask.setModifiedDate(now);
	            coilTask.setModifiedMacAddress(modifiedIp);
	            coilTask.setReleaseRemark(dto.getReleaseRemark());
	        }

	        tasksToSave.addAll(mappedCoils);

	        // ---------------- Sample Status ----------------
	        sampleQtMasterRepository.findById(dto.getSampleId().trim())
	                .ifPresent(sample ->
	                        sample.setSampleStatus(QualityConstants.STATUS_COMPLETED));

	        // ---------------- Specimen Maps ----------------
	        List<String> specimenList = specimenQualityTransactionRepository
	                .findSpecimenBySampleId(dto.getSampleId(), QualityConstants.STATUS_COMPLETE);

	        for (String specimenId : specimenList) {

	            PpspecimanmapQtPKEntity pk = new PpspecimanmapQtPKEntity();
	            pk.setppId(dto.getPpId());
	            pk.setspecimanId(specimenId);
	            pk.setppCounter(dto.getPpCtr());

	            PpspecimanmapQtEntity entity =
	                    ppspecimanMapQtRepository.findById(pk)
	                            .orElse(new PpspecimanmapQtEntity());

	            entity.setId(pk);
	            entity.setPpMapStatus(QualityConstants.STATUS_MAPPED);
	            entity.setTaskStepId(dto.getTaskstepId());

	            specimenMapsToSave.add(entity);
	        }

	        // ---------------- FAIL Logic ----------------
	        if (QualityConstants.FAIL.equals(dto.getManualDecision())) {

	            List<TestOrderLineQualityListEntity> orders =
	                    testordlQtRepository.findTestOrdByPpId(dto.getPpId());

	            if (!orders.isEmpty()) {
	                TestOrderLineQualityListEntity order = orders.get(0);
	                order.setTestppSts(QualityConstants.REJECTED);
	                testOrdersToSave.add(order);

	                List<TestOrderLineQualityListEntity> otherOrders =
	                        testordlQtRepository.findTestOrderByIdAndStatus(
	                                order.getId().gettestOrderId(),
	                                QualityConstants.MAPPED);

	                for (TestOrderLineQualityListEntity other : otherOrders) {

	                    other.setTestppSts(QualityConstants.PENDING);

	                    postProdTaskMtEntityJpaRepository
	                            .getTasksByPpidAndPrid(
	                                    other.getPpId(),
	                                    dto.getTpiRequired(),
	                                    QualityConstants.INSP_FLAG_YES)
	                            .ifPresent(t -> t.setMapSampleId(null));

	                    testOrdersToSave.add(other);
	                }
	            }
	        }

	        // ---------------- SAP Data Prep ----------------
	        mechPayload.add(
	                sapInterface.buildHsmQualityMechanicalDto(
	                        new HsmQualityMechanicalDto(),
	                        dto.getPpId(),
	                        dto.getHeatId(),
	                        dto.getSampleId()));

	        chemPayload.add(
	                sapInterface.buildHsmQualityChemicalDto(
	                        new HsmQualityChemicalDto(),
	                        dto.getPpId(),
	                        dto.getSlabid(),
	                        dto.getHeatId(),
	                        dto.getSampleId()));

	        logger.info("Processed PPID {} in {} ms----------------------",
	                dto.getPpId(),
	                System.currentTimeMillis() - loopStart);
	    }

	    // ---------------- Batch Save ----------------
	    long dbStart = System.currentTimeMillis();

	    postProdTaskMtEntityJpaRepository.saveAll(tasksToSave);
	    ppspecimanMapQtRepository.saveAll(specimenMapsToSave);
	    testordlQtRepository.saveAll(testOrdersToSave);

	    long dbEnd = System.currentTimeMillis();
	    logger.info("DB batch save time = {} ms--------------------", (dbEnd - dbStart));

	    // ---------------- SAP Calls ----------------
	    long sapStart = System.currentTimeMillis();

	    try {
	        sapServiceClient.sendHsmMechTestData(
	                JsonUtil.convertObjectToJson(
	                        new JsonFormatMechSapDto(mechPayload)));

	        sapServiceClient.sendHsmChemTestData(
	                JsonUtil.convertObjectToJson(
	                        new JsonFormatSapDto(chemPayload)));

	    } catch (Exception ex) {
	        logger.info("Error while sending SAP Mech/Chem Test Data", ex);
	    }

	    long sapEnd = System.currentTimeMillis();
	    logger.info("SAP call time = {} ms----------------", (sapEnd - sapStart));

	    long methodEnd = System.currentTimeMillis();
	    logger.info("updateManualDecision TOTAL time = {} ms for {} records--------------------",
	            (methodEnd - methodStart), request.size());

	    return ResponseUtil.createResponse(request, "Update", false);
	}


    @Override
    public ResponseEntity<FluentaApiResponse<List<ChemicalTestingDto>>> fetchChemical(String internalGrd, String extGrd,
                                                                                      String ppId, String slabId, String sampleId) {

        List<MechanicalTestDto> testBySampleIdAndName = custRepository.getTestBySampleIdAndName(sampleId,
                QualityConstants.SPECTRO_TEST);

        List<ChemicalTestingDto> list = custRepository.fetchChemical(internalGrd, extGrd, ppId, slabId,
                testBySampleIdAndName);

        if (testBySampleIdAndName != null && !testBySampleIdAndName.isEmpty()) {
            MechanicalTestDto mechanicalTestDto = testBySampleIdAndName.get(0);
            list.forEach(dto -> dto.setSpecimanId(mechanicalTestDto.getSpecimenId()));
        }
        return ResponseUtil.createResponse(list, "Fetching Mapped Coils", true);

    }

	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public void saveChemTesting(List<ChemicalTestingDto> dto) {
		dbSessionService.setSessionInfo(this.getClass().getName());

		if (dto != null && !dto.isEmpty()) {
			for (ChemicalTestingDto chemicalTestingDto : dto) {
				if (chemicalTestingDto.getElement() != null) {
					ChemResultQtEntity existingEntity = chemResultQtRepository
							.findBySpecAndEle(chemicalTestingDto.getElement(), chemicalTestingDto.getSpecimanId());
					ChemResultQtPkEntity pk = new ChemResultQtPkEntity();
					pk.setElement(chemicalTestingDto.getElement());
					pk.setspecimanId(chemicalTestingDto.getSpecimanId());

					if (existingEntity != null) {
						existingEntity.setElementValue(chemicalTestingDto.getTpaRecValue());
						chemResultQtRepository.save(existingEntity);
					} else {
						ChemResultQtEntity newEntity = new ChemResultQtEntity();
						newEntity.setId(pk);
						newEntity.setElementValue(chemicalTestingDto.getTpaRecValue());
						chemResultQtRepository.save(newEntity);
					}
				}

			}
		}
	}

