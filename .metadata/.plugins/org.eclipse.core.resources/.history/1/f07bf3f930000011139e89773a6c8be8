	@Override
	public MechanicalTestResultDto getMechanicalTestResult(String sampleId, BigDecimal coilThk) {
		logger.info("Fetching mechanical test result for sampleId: {}", sampleId);

		List<MechanicalTestDto> mechanicalTestList = custRepository.getMechanicalTestList(sampleId);
		logger.info("Mechanical test list: {}", mechanicalTestList);

		MechanicalTestResultDto response = new MechanicalTestResultDto();

		for (MechanicalTestDto dto : mechanicalTestList) {
			logger.info("Processing testType: {}", dto.getTestType());

			switch (dto.getTestType()) {
			case OfsConstants.TENSILE:
				List<TensileLabTestingDto> tensileResult = custRepository.getTensileResult(dto.getSpecimenId());
				List<TensileLabTestingDto> validTensile = tensileResult.stream().filter(e -> dto.getTestSource() == null
						|| isThicknessInRange(e.getThkaim(),e.getDimtolpve(),e.getDimtolnve(),e.getThkmin(), e.getMinopr(), e.getThkmax(), e.getMaxopr()))
						.toList();
				response.getTensileResult().addAll(validTensile);
				break;
			case OfsConstants.BEND:
				List<BendResultLabTestingDto> bendtResult = custRepository.getBendtResult(dto.getSpecimenId());
				List<BendResultLabTestingDto> validBend = bendtResult.stream().filter(e -> dto.getTestSource() == null
						|| isThicknessInRange(e.getThkaim(),e.getDimtolpve(),e.getDimtolnve(), e.getThkmin(), e.getMinopr(), e.getThkmax(), e.getMaxopr()))
						.toList();
				response.getBendResult().addAll(validBend);
				break;
			case OfsConstants.IMPACT_CVN:
				List<ImpactResultDto> cvn = custRepository.getImpactResult(dto.getSpecimenId(), "CVN");
				logger.info("IMPACT_CVN data  testType:--------------- {}", cvn);
				List<ImpactResultDto> validCvn = cvn.stream().filter(e -> dto.getTestSource() == null
						|| isThicknessInRange(e.getThkaim(),e.getDimtolpve(),e.getDimtolnve(), e.getThkmin(), e.getMinopr(), e.getThkmax(), e.getMaxopr()))
						.toList();
				response.getImpactResultCvn().addAll(validCvn);
				break;
			case OfsConstants.IMPACT_CUN:
				List<ImpactResultDto> cun = custRepository.getImpactResult(dto.getSpecimenId(), "CUN");
				logger.info("IMPACT_CUN data  testType:--------------- {}", cun);
				List<ImpactResultDto> validCun = cun.stream().filter(e -> dto.getTestSource() == null
						|| isThicknessInRange(e.getThkaim(),e.getDimtolpve(),e.getDimtolnve(), e.getThkmin(), e.getMinopr(), e.getThkmax(), e.getMaxopr()))
						.toList();
				response.getImpactResultCun().addAll(validCun);
				break;
			case OfsConstants.HARDNESS:
				List<HardnessLabTestingDto> hardnessResult = custRepository.getHardnessResult(dto.getSpecimenId());
				logger.info("HARDNESS data  testType:----------- {}", hardnessResult);
				List<HardnessLabTestingDto> validHardness = hardnessResult.stream()
						.filter(e -> dto.getTestSource() == null || isThicknessInRange(e.getThkaim(),e.getDimtolpve(),e.getDimtolnve(), e.getThkmin(),
								">=", e.getThkmax(), "<="))
						.toList();
				response.getHardnessResult().addAll(validHardness);
				break;
			case OfsConstants.HTTT:
				List<HighTempTensileTestResultLabTestingDto> highTempTesnsileTestResult = custRepository
						.getHighTempTesnsileTestResult(dto.getSpecimenId());
				List<HighTempTensileTestResultLabTestingDto> validHttt = highTempTesnsileTestResult.stream()
						.filter(e -> dto.getTestSource() == null || isThicknessInRange(e.getThkaim(),e.getDimtolpve(),e.getDimtolnve(), e.getThkmin(),
								e.getMinopr(), e.getThkmax(), e.getMaxopr()))
						.toList();
				response.getHighTempTensileTestResult().addAll(validHttt);
				break;
			case OfsConstants.DWTT:
				List<DWTTResultLabTestingDto> dwttResult = custRepository.getDWTTResult(dto.getSpecimenId());
				logger.info("DWTT data  testType:--------------- {}", dwttResult);
				List<DWTTResultLabTestingDto> validDwtt = dwttResult.stream().filter(e -> dto.getTestSource() == null
						|| isThicknessInRange(e.getThkaim(),e.getDimtolpve(),e.getDimtolnve(), e.getThkmin(), e.getMinopr(), e.getThkmax(), e.getMaxopr()))
						.toList();
				response.getDwttResult().addAll(validDwtt);
				break;
			case OfsConstants.INCLUSION_RATING:
				response.getInclusionRatingResult()
						.addAll(custRepository.getInclusionRatingResult(dto.getSpecimenId()));
				break;
			case OfsConstants.Z_TEST:
				List<ZTestResultLabTestingDto> zTestResult = custRepository.getZTestResult(dto.getSpecimenId());
				logger.info("Z_TEST data  testType:--------------- {}", zTestResult);
				List<ZTestResultLabTestingDto> validZtest = zTestResult.stream().filter(e -> dto.getTestSource() == null
						|| isThicknessInRange(e.getThkaim(),e.getDimtolpve(),e.getDimtolnve(), e.getThkmin(), e.getMinopr(), e.getThkmax(), e.getMaxopr()))
						.toList();
				response.getZtestResult().addAll(validZtest);
				break;
			default:
				logger.warn("Unhandled testType: {}", dto.getTestType());
				break;
			}
		}
		logger.info("Constructed MechanicalTestResultDto: {}", response);
		return response;
	}

	private boolean isThicknessInRange(BigDecimal thickness, BigDecimal dimtolpve,BigDecimal dimtolnve,BigDecimal thkmin, String minopr, BigDecimal thkmax,
			String maxopr) {
		if (thkmax != null && dimtolpve != null) {
		    thkmax = thkmax.add(dimtolpve);
		}

		if (thkmin != null && dimtolnve != null) {
		    thkmin = thkmin.subtract(dimtolnve);
		}
		// Case 1: All null → Always true
		if (thkmin == null && minopr == null && thkmax == null && maxopr == null) {
			return true;
		}

		// Case 2: thkmin with ">" operator, others null
		if (thkmin != null && ">".equals(minopr) && thkmax == null && maxopr == null) {
			return thickness.compareTo(thkmin) > 0;
		}

		// Case 3: thkmin with ">=" operator, others null
		if (thkmin != null && ">=".equals(minopr) && thkmax == null && maxopr == null) {
			return thickness.compareTo(thkmin) >= 0;
		}

		// Case 4: thkmin with "=" operator, others null
		if (thkmin != null && "=".equals(minopr) && thkmax == null && maxopr == null) {
			return thickness.compareTo(thkmin) == 0;
		}

		// Case 5: thkmax with "<" operator, thkmin and minopr null
		if (thkmin == null && minopr == null && thkmax != null && maxopr != null && "<".equals(maxopr)) {
			return thickness.compareTo(thkmax) < 0;
		}

		// Case 6: thkmax with "<=" operator, thkmin and minopr null
		if (thkmin == null && minopr == null && thkmax != null && maxopr != null && "<=".equals(maxopr)) {
			return thickness.compareTo(thkmax) <= 0;
		}

		// Case 7: thkmax with "=" operator, others null
		if (thkmin == null && minopr == null && thkmax != null && maxopr != null && "=".equals(maxopr)) {
			return thickness.compareTo(thkmax) == 0;
		}

		// Case 8: Both thkmin and thkmax with valid operators
		if (thkmin != null && minopr != null && thkmax != null && maxopr != null) {
			boolean minCond = evaluateOperator(thickness, thkmin, minopr);
			boolean maxCond = evaluateOperator(thickness, thkmax, maxopr);
			return minCond && maxCond;
		}

		// Default fallback → If nothing matches, return false
		return false;
	}

	private boolean evaluateOperator(BigDecimal thickness, BigDecimal limit, String operator) {
		if (limit == null || operator == null) {
			return true;
		}

		return switch (operator.trim()) {
		case ">" -> thickness.compareTo(limit) > 0;
		case ">=" -> thickness.compareTo(limit) >= 0;
		case "<" -> thickness.compareTo(limit) < 0;
		case "<=" -> thickness.compareTo(limit) <= 0;
		case "=" -> thickness.compareTo(limit) == 0;
		default -> false;
		};
	}

