    public Page<CoilModificationDetailsDto> getCoilDetails(CoilModificationRequestDto request, Integer page,
                                                           Integer size, String query, String countQueryParm, Integer skip) {
        int effectiveOffset = page * size;
        int effectivePageSize = size;
        if (skip != null && skip > 0) {
            if (skip >= size) {
                effectiveOffset += skip;
                skip = 0;
            } else {
                effectiveOffset += skip;
                effectivePageSize -= skip;
            }
        }

        TypedQuery<CoilModificationDetailsDto> queryCount = entityManager.createQuery(query, CoilModificationDetailsDto.class);

        queryCount.setParameter(QualityConstants.TPI_REQUIRED, QualityConstants.HSM_QC);
        queryCount.setParameter(QualityConstants.TASK_STATUS, QualityConstants.PENDING);
        queryCount.setParameter(OfsConstants.COIL_ID_FROM, request.getFromCoilid());
        queryCount.setParameter(OfsConstants.COIL_ID_TO, request.getToCoilid());
        queryCount.setParameter(QualityConstants.HSM_INSP, QualityConstants.HSM_INSP);
        queryCount.setParameter(QualityConstants.REWORK, QualityConstants.REWORK);
        queryCount.setParameter(QualityConstants.SHRCOIL, QualityConstants.PROD_CODE_HRCOIL);
        queryCount.setParameter(QualityConstants.S_CODE_F, QualityConstants.CODE_F);

        queryCount.setFirstResult(effectiveOffset);
        queryCount.setMaxResults(effectivePageSize);
        List<CoilModificationDetailsDto> resultList = queryCount.getResultList();
        Query countQuery = entityManager.createQuery(countQueryParm);

        countQuery.setParameter(QualityConstants.TPI_REQUIRED, QualityConstants.HSM_QC);
        countQuery.setParameter(QualityConstants.TASK_STATUS, QualityConstants.PENDING);
        countQuery.setParameter(OfsConstants.COIL_ID_FROM, request.getFromCoilid());
        countQuery.setParameter(OfsConstants.COIL_ID_TO, request.getToCoilid());
        countQuery.setParameter(QualityConstants.HSM_INSP, QualityConstants.HSM_INSP);
        countQuery.setParameter(QualityConstants.REWORK, QualityConstants.REWORK);
        countQuery.setParameter(QualityConstants.SHRCOIL, QualityConstants.PROD_CODE_HRCOIL);
        countQuery.setParameter(QualityConstants.S_CODE_F, QualityConstants.CODE_F);
        Long totalRows = (Long) countQuery.getSingleResult();
        Pageable pageable = PageRequest.of(page, size);
        return new PageImpl<>(resultList, pageable, totalRows);

    }

