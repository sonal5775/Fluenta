    public List<String> searchMatchingCoils(String query) {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT DISTINCT TRIM(qsl.ppId) ")
          .append("FROM QualityScheduleListEntity qsl ")
          .append("WHERE LOWER(TRIM(qsl.ppId)) LIKE LOWER(:query)");  // FIXED
         // .append("ORDER BY TO_NUMBER(TRIM(qsl.ppId)) DESC");        // optional sorting

        TypedQuery<String> q = entityManager.createQuery(sb.toString(), String.class);
        q.setMaxResults(10);
        q.setParameter("query", "%" + query.trim().toLowerCase() + "%");

        return q.getResultList();
    }

