    public List<ScrapDetailsDto> getScrapDetails(CoilModificationDetailsDto dto) {
        StringBuilder queryBuilder = new StringBuilder();
        queryBuilder.append("SELECT DISTINCT new com.hindindustec.fluenta.hsm.quality.dto.ScrapDetailsDto(")
                .append("mass.id.prdctr, ")
                .append("mass.scrapdesc, ")
                .append("'', ")
                .append("mass.samplen, ")
                .append("mass.ppwgt, ")
                .append("mass.sampwdt, ")
                .append("mass.samprem,")
                .append("mass.prdid")
                .append(") ")
                .append("FROM PpqcmassbalQt mass ")
                .append("WHERE TRIM(mass.id.ppid) = :ppId ")
                .append("AND mass.id.ppctr = :ppctr ")
                .append("AND mass.id.taskstepid = :taskstepid ");

        TypedQuery<ScrapDetailsDto> q = entityManager.createQuery(queryBuilder.toString(), ScrapDetailsDto.class);

        q.setParameter(QualityConstants.PP_ID, dto.getCoilid());
        q.setParameter(QualityConstants.PPCTR, dto.getPpCtr());
        q.setParameter(QualityConstants.TASK_STEP_ID, dto.getTaskStepId());

        return q.getResultList();
    }

