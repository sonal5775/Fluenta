package in.net.usit.yip.core.auditing;

import java.net.InetAddress;
import java.net.NetworkInterface;
import java.net.SocketException;
import java.net.UnknownHostException;
import java.util.Enumeration;

import lombok.extern.slf4j.Slf4j;

/**
 * NetWork Utils for MAC address, IP address
 * 
 * @author: Dhammpal Kamble(DK)
 */
@Slf4j
public class NetworkUtils {

    private static final String DEFAULT_MAC_ADDRESS = "00-00-00-00-00-00";

	 private NetworkUtils() {
	        throw new UnsupportedOperationException("This is a utility class and cannot be instantiated");
	    }

	    /**
	     * Gets the MAC address of the primary network interface
	     * @return MAC address in format XX-XX-XX-XX-XX-XX or 00-00-00-00-00-00 if not found
	     */
	    public static String getCurrentMacAddress() {
	        try {
	        	/**
	        	 * First try getting MAC via localhost (My(DK) approach)
	        	 */
	            String localhostMac = getMacByInetAddress(InetAddress.getLocalHost());
	            if (!DEFAULT_MAC_ADDRESS.equals(localhostMac)) {
	                return localhostMac;
	            }

	            Enumeration<NetworkInterface> networkInterfaces = NetworkInterface.getNetworkInterfaces();
	            while (networkInterfaces.hasMoreElements()) {
	                NetworkInterface network = networkInterfaces.nextElement();
	                if (isPhysicalInterface(network)) {
	                    String mac = formatMacAddress(network.getHardwareAddress());
	                    if (!DEFAULT_MAC_ADDRESS.equals(mac)) {
	                        return mac;
	                    }
	                }
	            }
	        } catch (UnknownHostException | SocketException e) {
	            log.error("Failed to get MAC address", e);
	        }
	        
	        return DEFAULT_MAC_ADDRESS;
	    }

	    /**
	     * Gets MAC address for a specific network interface by name
	     */
	    public static String getMacByInterface(String interfaceName) {
	        try {
	            NetworkInterface network = NetworkInterface.getByName(interfaceName);
	            if (network != null && isPhysicalInterface(network)) {
	                return formatMacAddress(network.getHardwareAddress());
	            }
	        } catch (SocketException e) {
	            log.error("Failed to get MAC for interface {}", interfaceName, e);
	        }
	        return DEFAULT_MAC_ADDRESS;
	    }

	    /**
	     * My(Dhammpal) approach - get MAC by InetAddress
	     */
	    private static String getMacByInetAddress(InetAddress ip) {
	        try {
	            NetworkInterface network = NetworkInterface.getByInetAddress(ip);
	            if (network != null && isPhysicalInterface(network)) {
	                return formatMacAddress(network.getHardwareAddress());
	            }
	        } catch (SocketException e) {
	            log.debug("Failed to get MAC for IP {}", ip, e);
	        }
	        return DEFAULT_MAC_ADDRESS;
	    }

	    /**
	     * Formats raw MAC bytes to XX-XX-XX-XX-XX-XX
	     */
	    private static String formatMacAddress(byte[] mac) {
	        if (mac == null || mac.length == 0) {
	            return DEFAULT_MAC_ADDRESS;
	        }

	        String[] hexadecimal = new String[mac.length];
	        for (int i = 0; i < mac.length; i++) {
	            hexadecimal[i] = String.format("%02X", mac[i]);
	        }
	        return String.join("-", hexadecimal);
	    }

	    /**
	     * Checks if this is a physical network interface
	     */
	    private static boolean isPhysicalInterface(NetworkInterface network) throws SocketException {
	        return network.getHardwareAddress() != null && 
	               !network.isLoopback() && 
	               network.isUp() &&
	               !network.getDisplayName().toLowerCase().contains("virtual") &&
	               !network.getName().startsWith("docker") &&
	               !network.getName().startsWith("veth");
	    }
	
}
