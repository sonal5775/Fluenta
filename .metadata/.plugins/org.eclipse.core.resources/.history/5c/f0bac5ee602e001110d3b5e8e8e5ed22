    @Override
    @Transactional(rollbackFor = TransactionException.class)
    public String releasedCoilRecords(CoilClearanceRequestDto request) {
        dbSessionService.setSessionInfo(this.getClass().getName());

        for (CoilClearanceListDto record : request.getTData()) {
            Optional<Inventory> pphmtOpt = pphMtRepository.findByPpId(record.getPpid().trim());
            PostProdTaskMtEntity ppPostProdTasksEntity = masterRepo.getTasksByPpidAndPrid(record.getPpid(), HSMQC,QualityConstants.INSP_FLAG_YES)
                    .orElseThrow(() -> new CustomException(QualityConstants.NORECORDFOUNDFORCOILID + record.getPpid()));

			// Fetch sample and salvage tasks
			PostProdTaskMtEntity salvageTask = masterRepo.findActiveByCoilIdAndPrid(record.getPpid(),
					QualityConstants.REWORK, QualityConstants.PENDING, QualityConstants.CUT_TYPE_SALVAGE);
			PostProdTaskMtEntity sampleTask = masterRepo.findActiveByCoilIdAndPrid(record.getPpid(),
					QualityConstants.HSM_INSP, QualityConstants.PENDING, QualityConstants.CUT_TYPE_SAMPLE);
			Optional<TdcJmEntity> tdcOptional = tdcJmRepository.findByTdcIdAndSourceType(record.getTdcId());
			// Check if sample or salvage records exist
			boolean sampleExists = sampleTask != null;
			boolean salvageExists = salvageTask != null;
 
			if ((sampleExists && tdcOptional.isPresent()) || salvageExists) {
				StringBuilder message = new StringBuilder("failed,Mass balancing is pending for ");
				if (sampleExists  && tdcOptional.isPresent()) {
					message.append("sample");
				}
				if ((sampleExists  && tdcOptional.isPresent()) && salvageExists) {
					message.append(" and ");
				}
				if (salvageExists) {
					message.append("salvage");
				}
				message.append(".");
				return message.toString();
			}

            if (pphmtOpt.isPresent()) {
                Inventory pphmtRecord = pphmtOpt.get();
                String productionCodeId = pphmtRecord.getProductionCodeId();
                String coilDecision = (record.getManualDecision() != null && !record.getManualDecision().isEmpty())
                        ? record.getManualDecision().trim()
                        : request.getUserDefinedStatus().trim();
                if (coilDecision != null) {
					coilDecision = coilDecision.split("-")[0].trim();
				}
				logger.info("coilDecision release coil Data: {}", coilDecision);
                switch (coilDecision) {
                    case "FGP1", "HCRM", "HCTL", "HRSP", "HSLT" -> {
                        pphmtRecord.setModifiedDate(new Date());
                        pphmtRecord.setModifiedBy(record.getDecisionBy());
                        pphmtRecord.setUserDefinedStatus(coilDecision);
                        pphmtRecord.setProductionPlanStatus(QualityConstants.COIL_CLEARANCE_READY_TO_DISPATCH);
                        ppPostProdTasksEntity.setTaskStatus(QualityConstants.RELEASED);
                    }

                    case "FGP2", "FGP3", "AUS1","AUS1 - Auction" -> {
                        pphmtRecord.setModifiedDate(new Date());
                        pphmtRecord.setPurchaseOrderId(BigDecimal.valueOf(100));
                        pphmtRecord.setPopReactor(BigDecimal.valueOf(10));
                        pphmtRecord.setModifiedBy(record.getDecisionBy());
                        pphmtRecord.setUserDefinedStatus(coilDecision);
                        pphmtRecord.setProductionPlanStatus(QualityConstants.COIL_CLEARANCE_FREE_STOCK);
                        ppPostProdTasksEntity.setTaskStatus(QualityConstants.RELEASED);
                    }

                    /* below case handle in front-end(record will not relased with below case)
*                    case "HCSL", "TPIP" -> {
*                        pphmtRecord.setModifiedDate(new Date());
*                        pphmtRecord.setModifiedBy(record.getDecisionBy());
*                        pphmtRecord.setUserDefinedStatus(coilDecision);
*                        pphmtRecord.setProductionPlanStatus(QualityConstants.COIL_CLEARANCE_HOLD);
*                        ppPostProdTasksEntity.setTaskStatus(QualityConstants.RELEASED);
                   }

 */                  default -> throw new CustomException(QualityConstants.UNSUPPORTEDCOILDECISION + coilDecision);
                }
                logger.info("pphmtRecord: {}", pphmtRecord);
               pphMtRepository.save(pphmtRecord);
                
                /*
                 * SAP CODE FOR UDDECISION DATA
                 */
                List<HsmQualityUDDecisionDto> payload = new ArrayList<>();
                HsmQualityUDDecisionDto dtoUDDataSAP = new HsmQualityUDDecisionDto();
                HsmQualityUDDecisionDto dtoUDData = sapInterface.buildHsmQualityUDDto(dtoUDDataSAP, record, coilDecision,
                        request, ppPostProdTasksEntity.getDecisionDate(), productionCodeId);
                logger.info(
                        "Sending UD Decision dtoUDData data to SAP--------------------------------------- | dtoUDData={} | productionCodeId={}",
                        dtoUDData,productionCodeId
                );
                payload.add(dtoUDData);
                try {
                    JsonFormatUDSapDto jsonFormatUDSapDto = new JsonFormatUDSapDto();
                    jsonFormatUDSapDto.setUdDto(payload);
                    String convertObjectToJson = JsonUtil.convertObjectToJson(jsonFormatUDSapDto);
                
                    logger.info(
                            "Sending UD Decision data to SAP--------------------------------------- | CoilNo={} | Payload={}",
                            coilDecision,
                            convertObjectToJson
                    );

                    sapServiceClient.sendHsmCoilClearanceUdDesicionData(convertObjectToJson);

                    logger.info(
                            "UD Decision data sent successfully------------------------ | CoilNo={}",
                            coilDecision
                    );
                
                    

                } catch (Exception e) {
                	 logger.error(
                	            "Error while sending UD Decision data to SAP -----------------------| CoilNo={}",
                	            coilDecision,
                	            e
                	    );

                }
            }
        }
        return "success,Records released successfully.";
    }

