    @Override
    public FluentaPaginatedResponse<CoilClearanceListDto> getCoilClearanceDetails(CoilClearanceRequestDto request,
                                                                                  int page, int size, String filterPathString, String sort) {
        List<String> filterList = DevExtGridFilterUtils.extractElements(filterPathString);
        List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);
        logger.info("Request Data: {}", request);
        if (!filterList.isEmpty()) {
            boolean isNumber = DevExtGridFilterUtils.isNumberOrStringCheck(filterList.get(2));

            if (filterList.contains("or") && !isNumber) {
                filterList = DevExtGridFilterUtils.removeNumberFieldsFromString(filterList, CoilClearanceListDto.class);
            }

        }

        String query = custRepo.getAllPaginatedHSMCoilClearanceInString();
        String countQuery = custRepo.getAllPaginatedHSMCoilClearanceInStringForCount();
        logger.info("FilterList: {}", filterList);
        if (!filterList.isEmpty()) {

            String valueForSearch = null;
            boolean isSalesOrderNo = false;
            for (String s : filterList) {
                if (s.equals("soItemNo")) {
                    int indexOfField = filterList.indexOf("soItemNo");
                    valueForSearch = filterList.get(indexOfField + 2);
                    String tempStringValue = null;
                    if (valueForSearch.contains("-")) {
                        String[] arr = valueForSearch.split("-");
                        tempStringValue = arr[0];
                    } else {
                        tempStringValue = valueForSearch;
                    }

                    filterList.set(indexOfField, "soId");
                    filterList.set(indexOfField + 2, tempStringValue);
                    isSalesOrderNo = true;
                }
            }

            if (isSalesOrderNo) {
                String tempStringValue = null;
                if (valueForSearch.contains("-")) {
                    String[] arr = valueForSearch.split("-");
                    tempStringValue = arr[1];
                } else {
                    tempStringValue = valueForSearch;
                }
                filterList.add(" or ");
                filterList.add(QualityConstants.SOLID);
                filterList.add("=");
                if (isNumber(tempStringValue)) {
                    filterList.add(tempStringValue);
                } else {
                    filterList.add("0");
                }

            }

            query = filterQueryUsingFilterList(filterList, query);
            countQuery = filterQueryUsingFilterList(filterList, countQuery);

        }

        Map<String, String> columnAlise = checkClassAleasWithNoStop();

        if (!sortList.isEmpty()) {
            if (sortList.get(3).equals("true")) {
                query = query + ORDER_BY + columnAlise.get(sortList.get(1)) + QualityConstants.DESC;
            } else {
                query = query + ORDER_BY + columnAlise.get(sortList.get(1));
            }
        }

        Page<CoilClearanceListDto> response = custRepo.getCoilClearanceDetails(request, page, size, query, countQuery);
        logger.info("response: {}", response);
        FluentaPaginatedResponse<CoilClearanceListDto> paginatedResponse = new FluentaPaginatedResponse<CoilClearanceListDto>(
                response.getContent(), response.getTotalElements(), response.getTotalPages());
        return paginatedResponse;
    }

    /**
