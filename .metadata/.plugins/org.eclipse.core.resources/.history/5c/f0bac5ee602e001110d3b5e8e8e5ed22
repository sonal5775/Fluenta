    private <T> T handleFilterOrSort(CoilClearanceRequestDto request, List<String> filterList, List<String> sortList,
                                     Integer page, Integer size, Integer skip, boolean requireTotalCount, String status, Integer pageStore,
                                     Integer latestGroupCount) {
        if (!requireTotalCount) {
            size = page + size;
            page = 0;
        }

        String query = custRepo.getAllPaginatedHSMCoilClearanceInString();
        String countQuery = getMainCoilClearanceQueryCount(status);
        if (!filterList.isEmpty()) {
            query = filterQueryUsingFilterList(filterList, query);
            countQuery = filterQueryUsingFilterList(filterList, countQuery);
        }

        query = applySorting(sortList, query);
        Page<CoilClearanceListDto> coilClearance = custRepo.getCoilClearance(request, status, page, size, query,
                countQuery, skip);
        return (T) new FluentaPaginatedResponse<>(coilClearance.getContent(), coilClearance.getTotalElements());
    }

    private String applySorting(List<String> sortList, String query) {
        if (!sortList.isEmpty()) {
            Map<String, String> columnAlias = checkClassAleasWithNoStop();
            if (sortList.get(3).equals("true")) {
                query += QualityConstants.ORDER_BY + columnAlias.get(sortList.get(1)) + QualityConstants.DESC;
            } else {
                query += QualityConstants.ORDER_BY + columnAlias.get(sortList.get(1));
            }
        } else {
            query += OfsConstants.COIL_CLEARANCE_ORDER_BY;
        }
        return query;
    }

