     */
    @Override
    @Transactional(rollbackFor = TransactionException.class)
    public void updateCoilRecords(CoilClearanceRequestDto request) throws CustomException {
        logger.info("request data: {}", request);
        dbSessionService.setSessionInfo(this.getClass().getName());

        for (CoilClearanceListDto record : request.getTData()) {
            Optional<Inventory> pphmtOpt = pphMtRepository.findByPpId(record.getPpid().trim());
            if (pphmtOpt.isPresent()) {
                Inventory pphmtRecord = pphmtOpt.get();

                String coilDecision = (record.getManualDecision() != null && !record.getManualDecision().isEmpty())
                        ? record.getManualDecision().trim()
                        : request.getUserDefinedStatus().trim();
                if (coilDecision != null) {
					coilDecision = coilDecision.split("-")[0].trim();
				}
				logger.info("coilDecision update coil Data: {}", coilDecision);
                switch (coilDecision) {
                    case "FGP1", "HCRM", "HCTL", "HRSP", "HSLT" -> {
                        pphmtRecord.setModifiedDate(new Date());
                        pphmtRecord.setModifiedBy(record.getDecisionBy());
                        pphmtRecord.setUserDefinedStatus(coilDecision);
                        pphmtRecord.setProductionPlanStatus(QualityConstants.COIL_CLEARANCE_READY_TO_DISPATCH);
                    }

                    case "FGP2", "FGP3", "AUS1" -> {
                        pphmtRecord.setModifiedDate(new Date());
                        pphmtRecord.setPurchaseOrderId(BigDecimal.valueOf(100));
                        pphmtRecord.setPopReactor(BigDecimal.valueOf(10));
                        pphmtRecord.setModifiedBy(record.getDecisionBy());
                        pphmtRecord.setUserDefinedStatus(coilDecision);
                        pphmtRecord.setProductionPlanStatus(QualityConstants.COIL_CLEARANCE_FREE_STOCK);
                    }

                    case "HCSL", "HLD", "TPIP" -> {
                        pphmtRecord.setModifiedDate(new Date());
                        pphmtRecord.setModifiedBy(record.getDecisionBy());
                        pphmtRecord.setUserDefinedStatus(coilDecision);
                        pphmtRecord.setProductionPlanStatus(QualityConstants.COIL_CLEARANCE_HOLD);
                    }

                    default -> throw new CustomException(QualityConstants.UNSUPPORTEDCOILDECISION + coilDecision);
                }
                logger.info("pphmtRecord: {}", pphmtRecord);
                pphMtRepository.save(pphmtRecord);
                processPostProduction(record, coilDecision, request);
            }
        }
    }

    private void processPostProduction(CoilClearanceListDto record, String coilDecision,
                                       CoilClearanceRequestDto request) throws CustomException {
        PostProdTaskMtEntity ppPostProdTasksEntity = masterRepo.getTasksByPpidAndPrid(record.getPpid(), HSMQC,QualityConstants.INSP_FLAG_YES)
                .orElseThrow(() -> new CustomException(QualityConstants.NORECORDFOUNDFORCOILID + record.getPpid()));

        logger.info("record: {}", record);
        switch (coilDecision) {
            case "FGP1", "FGP3", "HCRM", "HCTL", "HRSP", "HSLT", "AUS1" -> {
                ppPostProdTasksEntity.setTaskStatus(QualityConstants.STATUS_COMPLETE);
                ppPostProdTasksEntity.setDecisionDate(new Date());
                ppPostProdTasksEntity.setDecisionBy(record.getDecisionBy());
                ppPostProdTasksEntity.setReleaseRemark(record.getQaRemark());
                ppPostProdTasksEntity.setDivertReason(record.getSelectedReason());
                ppPostProdTasksEntity.setManualDecision(coilDecision);
            }

            case "FGP2", "TPIP" -> {
                ppPostProdTasksEntity.setDecisionDate(new Date());
                ppPostProdTasksEntity.setDecisionBy(record.getDecisionBy());
                ppPostProdTasksEntity.setReleaseRemark(record.getQaRemark());
                ppPostProdTasksEntity.setManualDecision(coilDecision);
                ppPostProdTasksEntity.setDivertReason(record.getSelectedReason());
            }
            case "HCSL" -> {
                ppPostProdTasksEntity.setDecisionDate(new Date());
                ppPostProdTasksEntity.setDecisionBy(record.getDecisionBy());
                ppPostProdTasksEntity.setReleaseRemark(record.getQaRemark());
                ppPostProdTasksEntity.setManualDecision(coilDecision);
                Optional<PostProdTaskMtEntity> taskOptional = masterRepo.getTasksByPpidAndPrid(record.getPpid(),
                        QualityConstants.HSM_INSP,QualityConstants.INSP_FLAG_YES);
                if (taskOptional.isPresent()) {
                    PostProdTaskMtEntity tasksEntity = taskOptional.get();
                    tasksEntity.setTaskStatus(QualityConstants.PENDING);
                    tasksEntity.setCutType(QualityConstants.CUT_TYPE_SALVAGE);
                    tasksEntity.setCutFlag(QualityConstants.INSP_FLAG_YES);
                    masterRepo.save(tasksEntity);
                }
                Optional<PostProdTaskMtEntity> newTaskOptional = masterRepo.getTasksByPpidAndPrid(record.getPpid(),
                        QualityConstants.REWORK,QualityConstants.INSP_FLAG_YES);
                if (newTaskOptional.isEmpty()) {
                    PostProdTaskMtEntity tasksEntity = new PostProdTaskMtEntity();
                    PostProdTaskMtPKEntity taskMtPKEntity = new PostProdTaskMtPKEntity();
                    Long latestTaskStepIdByCoilId = masterRepo.findHighestTaskStepIdByCoilId(record.getPpid());
                    latestTaskStepIdByCoilId = latestTaskStepIdByCoilId + 10;
                    taskMtPKEntity.setTaskstepId(latestTaskStepIdByCoilId);
                    taskMtPKEntity.setPpId(record.getPpid());
                    taskMtPKEntity.setPpCtr(0);
                    tasksEntity.setId(taskMtPKEntity);
                    tasksEntity.setTpiRequired(QualityConstants.REWORK);
                    tasksEntity.setTaskSource(QualityConstants.TASK_SOURCE_QUALITY);
                    tasksEntity.setIsActive(BigDecimal.ONE);
                    tasksEntity.setCreatedBy(ClientIpUtils.getClient());
                    tasksEntity.setCreatedDate(new Date());
                    tasksEntity.setCreatedMacAddress(ClientIpUtils.getClientIpAddress());
                    tasksEntity.setTaskStatus(QualityConstants.STATUS_PENDING);
                    tasksEntity.setLatestFlag(QualityConstants.INSP_FLAG_YES);
                    masterRepo.save(tasksEntity);
                } else {
                    PostProdTaskMtEntity postProdTaskMtEntity = newTaskOptional.get();
                    postProdTaskMtEntity.setLatestFlag(QualityConstants.INSP_FLAG_NO);
                    masterRepo.save(postProdTaskMtEntity);
                    PostProdTaskMtEntity tasksEntity = new PostProdTaskMtEntity();
                    PostProdTaskMtPKEntity taskMtPKEntity = new PostProdTaskMtPKEntity();
                    Long latestTaskStepIdByCoilId = masterRepo.findHighestTaskStepIdByCoilId(record.getPpid());
                    latestTaskStepIdByCoilId = latestTaskStepIdByCoilId + 10;
                    taskMtPKEntity.setTaskstepId(latestTaskStepIdByCoilId);
                    taskMtPKEntity.setPpId(record.getPpid());
                    taskMtPKEntity.setPpCtr(0);
                    tasksEntity.setId(taskMtPKEntity);
                    tasksEntity.setTpiRequired(QualityConstants.REWORK);
                    tasksEntity.setTaskSource(QualityConstants.TASK_SOURCE_QUALITY);
                    tasksEntity.setIsActive(BigDecimal.ONE);
                    tasksEntity.setCreatedBy(ClientIpUtils.getClient());
                    tasksEntity.setCreatedDate(new Date());
                    tasksEntity.setCreatedMacAddress(ClientIpUtils.getClientIpAddress());
                    tasksEntity.setTaskStatus(QualityConstants.STATUS_PENDING);
                    tasksEntity.setLatestFlag(QualityConstants.INSP_FLAG_YES);
                    masterRepo.save(tasksEntity);
                }
            }

            case "HLD" -> {
                Optional<PostProdTaskMtEntity> taskOptional = masterRepo.getTasksByPpidAndPrid(record.getPpid(),
                        QualityConstants.HSM_INSP,QualityConstants.INSP_FLAG_YES);
                if (taskOptional.isPresent()) {
                    PostProdTaskMtEntity tasksEntity = taskOptional.get();
                    tasksEntity.setTaskStatus(QualityConstants.PENDING);
                    masterRepo.save(tasksEntity);
                }

                ppPostProdTasksEntity.setDecisionDate(new Date());
                ppPostProdTasksEntity.setDecisionBy(record.getDecisionBy());
                ppPostProdTasksEntity.setManualDecision(coilDecision);
                ppPostProdTasksEntity.setHoldRemark(record.getQaRemark());
                ppPostProdTasksEntity.setHoldReason(record.getSelectedReason());
            }

            default -> throw new CustomException(QualityConstants.UNSUPPORTEDCOILDECISION + coilDecision);
        }

        masterRepo.save(ppPostProdTasksEntity);
 
    }

    private void updatePpInspChars(String ppid, Long latestTaskStepId) {
        PostProdTaskMtEntity activeByCoilIdAndPrid = masterRepo.findActiveByCoilIdAndPrid(ppid, "REWORK", "PENDING", QualityConstants.CUT_TYPE_SALVAGE);
        if (activeByCoilIdAndPrid == null) return;
        Long previousTaskStepId = masterRepo.findPreviousTaskStepId(ppid, "REWORK", "COMPLETE", activeByCoilIdAndPrid.getId().getTaskstepId());
        if (previousTaskStepId == null) return;
        List<PpInspCharEntity> byPpId = ppInspCharRepository.findByPpId(ppid, previousTaskStepId);
        List<PpInspCharEntity> records = byPpId.stream().map(orig -> {
            PpInspCharEntity newEntity = new PpInspCharEntity();

            // create a new record with the new taskStepId.
            PpInspCharEntityPK newId = new PpInspCharEntityPK();
            newId.setPpid(ppid);
            newId.setTaskstepid(latestTaskStepId);
            newId.setPpctr(orig.getId().getPpctr());
            newId.setAtrid(orig.getId().getAtrid());
            newEntity.setId(newId);

            // set other fields
            newEntity.setCrBy(ClientIpUtils.getClient());
            newEntity.setCrDt(new Date());
            newEntity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
            newEntity.setIsactv(BigDecimal.ONE);
            newEntity.setNumval(orig.getNumval());
            newEntity.setStrval(orig.getStrval());
            newEntity.setInsprslt(orig.getInsprslt());
            return newEntity;
        }).collect(Collectors.toList());
        ppInspCharRepository.saveAll(records);
    }

    public String filterQueryUsingFilterList(List<String> filterList, String query) {
        query = query + " AND (";

        List<String> columnNames = DevExtGridFilterUtils.getAllFields(CoilClearanceListDto.class);

        Map<String, String> columnDataTypesKeyValuePair = DevExtGridFilterUtils
                .getAllFieldsWithTypes(CoilClearanceListDto.class);
        Map<String, String> columnAlise = checkClassAleas();
        boolean isClobObject = false;
        boolean isStringObject = false;
        boolean isDateObject = false;
        boolean isContains = false;
        boolean isNotContains = false;
        boolean isStartWith = false;
        boolean isEndWith = false;
        for (int i = 0; i < filterList.size(); i++) {
            String item = filterList.get(i);
            if (columnNames.contains(item)) {
                if (columnDataTypesKeyValuePair.get(item).equals("CLOB")) {
                    query = query + "DBMS_LOB.INSTR(" + columnAlise.get(item) + ",";
                    isClobObject = true;
                } else if (columnDataTypesKeyValuePair.get(item).equals("DATE")) {
                    query = query + " TO_CHAR(" + columnAlise.get(item) + ", 'YYYY-MM-DD')";
                    isDateObject = true;
                } else if (columnDataTypesKeyValuePair.get(item).equals("VARCHAR2")) {
                    if (item.equals("concatSoItem")) {
                        query = query + " (CONCAT(qcschdl.soId, '-', qcschdl.solId) ";
                    } else {
                        query = query + "(UPPER(TRIM(" + columnAlise.get(item) + "" + "))";
                    }
                    isStringObject = true;
                } else {

                    query = query + columnAlise.get(item);

                }
            } else if (item.equals(CONTAINS) || item.equals(NOTCONTAINS) || item.equals(STARTSWITH)
                    || item.equals(ENDSWITH)) {
                if (isClobObject) {

                } else if (isDateObject) {

                    query = query + LIKE;

                } else {
                    if (item.equals(CONTAINS)) {
                        query = query + LIKE;
                        isContains = true;
                    } else if (item.equals(NOTCONTAINS)) {
                        query = query + NOT_LIKE;
                        isNotContains = true;

                    } else if (item.equals(STARTSWITH)) {
                        query = query + LIKE;
                        isStartWith = true;
                    } else if (item.equals(ENDSWITH)) {
                        query = query + LIKE;
                        isEndWith = true;
                    } else {
                        query = query + " = ";
                    }

                }

            } else if (item.equals("or") || item.equals("and")) {
                query = query + " " + item + " ";
            } else if (item.equals("=")) {
                query = query + " " + item;

            } else if (item.equals("<>")) {
                query = query + " " + item;
            } else if (item.equals(">=")) {
                query = query + " " + item;
            } else if (item.equals("<")) {
                query = query + " " + item;
            } else if (item.equals(">")) {
                query = query + " " + item;
            } else {
                if (isClobObject) {
                    query = query + "'" + item + "') > 0";
                    isClobObject = false;
                } else if (isStringObject) {
                    if (isContains) {
                        query = query + QualityConstants.UPPERTRIM + item + "%'" + ")))";
                        isContains = false;
                    } else if (isNotContains) {
                        query = query + QualityConstants.UPPERTRIM + item + "%')))";
                        isNotContains = false;

                    } else if (isStartWith) {
                        query = query + " UPPER(TRIM('" + item + "%')))";
                        isStartWith = false;
                    } else if (isEndWith) {
                        query = query + QualityConstants.UPPERTRIM + item + "')))";
                        isEndWith = false;
                    } else {
                        query = query + " UPPER(TRIM('" + item + "')))";
                    }
                    isStringObject = false;
                } else if (isDateObject) {
                    DateTimeFormatter formatter = DateTimeFormatter.ISO_OFFSET_DATE_TIME;
                    OffsetDateTime dateTime = OffsetDateTime.parse(item, formatter);
                    String dateOnly = dateTime.toLocalDate().toString();
                    query = query + " '" + dateOnly + "'";
                    isDateObject = false;
                } else {
                    query = query + " " + item + "";
                }

            }
        }
        query = query + ")";

        return query;
    }

