				coilDecision = coilDecision.split("-")[0].trim();
			}
			logger.info("coilDecision save coil Data: {}", coilDecision);
            switch (coilDecision) {
                case "FGP1", "FGP3", "HCRM", "HCTL", "HRSP", "HSLT", "AUS1", "FGP2", "TPIP" -> {
                    ppPostProdTasksEntity.setDecisionDate(new Date());
