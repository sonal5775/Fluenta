            page = 0;
        }

        String queryForGrouping = getCoilClearanceQueryForGroupingAndFiltering(groupList, filterList, status);
        String queryForGroupingAndFilteringCount = getCoilClearanceQueryForGroupingAndFilteringCount(groupList,
                filterList, sortList, status);
        String mainCountQuery = getMainCoilClearanceQueryCount(status);
        Long mainQueryCount = custRepo.getMainCoilClearanceQueryCount(request, mainCountQuery, status);
        Page<Object[]> groupingListData = custRepo.getGroupingListData(queryForGrouping,
                queryForGroupingAndFilteringCount, page, size, skip, request, status);
        Long totalDistCount = custRepo.groupCountQuery(queryForGroupingAndFilteringCount, request, status);
        return buildGroupedDataResponse(groupingListData, mainQueryCount,
                (totalDistCount != null && totalDistCount != 0) ? totalDistCount : latestGroupCounts);

