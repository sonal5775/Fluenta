        dbSessionService.setSessionInfo(this.getClass().getName());

        for (CoilClearanceListDto record : request.getTData()) {
            PostProdTaskMtEntity ppPostProdTasksEntity = masterRepo.getTasksByPpidAndPrid(record.getPpid(), HSMQC,QualityConstants.INSP_FLAG_YES)
