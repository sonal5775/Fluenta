    private <T> T buildGroupedDataResponse(Page<Object[]> groupingListData, Long mainQueryCount, Long totalDistCount) {
        GroupedDataResponse<CoilClearanceRequestDto> result = new GroupedDataResponse<>(null, 0L, 0L);
        List<Group<CoilClearanceRequestDto>> list = new ArrayList<>();

        for (Object[] row : groupingListData) {
            String groupKey = row[0] instanceof BigDecimal ? ((BigDecimal) row[0]).toPlainString()
                    : String.valueOf(row[0]);
            Long count = row[1] instanceof BigDecimal ? ((BigDecimal) row[1]).longValue() : (Long) row[1];
            list.add(new Group<>(groupKey, null, count));
        }

        result.setData(list);
        result.setTotalCount(mainQueryCount);
        result.setGroupCount(totalDistCount);
        return (T) result;
    }

  
