	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public OfsCommonResponse saveSlabStockLocation(SlabStockDto slabStockDto) {
		OfsCommonResponse response = new OfsCommonResponse(1);
		dbSessionService.setSessionInfo(this.getClass().getName());

		PphMtPK entityPk = new PphMtPK();
		entityPk.setPpid(slabStockDto.getPpid());
		entityPk.setPpctr(slabStockDto.getPpctr());

		PphMt entity = pphMtRepository.findById(entityPk)
				.orElseThrow(() -> new CustomException("Entity not found with ppid: " + slabStockDto.getPpid()));

		List<PphMt> duplicateEntry = new ArrayList<>();
		if (slabStockDto.getPpsts() !=null && OfsStatusConstants.HOLD.equals(slabStockDto.getPpsts())
				|| OfsStatusConstants.AVAILABLE.equals(slabStockDto.getPpsts())
				|| OfsStatusConstants.FREE_STOCK.equals(slabStockDto.getPpsts())) {

			duplicateEntry = slabStockCustRepository.findRecordUsingLocationAndSequenceTyped(slabStockDto.getSlocid(),
					slabStockDto.getSlocseq());
		}

		if (duplicateEntry.isEmpty()) {
			entity.setSlocid(slabStockDto.getSlocid());
			entity.setPrevslocid(slabStockDto.getPrevslocid());
			entity.setSlocseq(slabStockDto.getSlocseq());
			entity.setPrevslocseq(slabStockDto.getPrevslocseq());
			entity.setRhfrmks(slabStockDto.getRhfrmks());

			pphMtRepository.save(entity);
			response.addInfoMsg("Success");
		} else {
			PphMt firstDuplicate = duplicateEntry.get(0);
			PphMtPK pphMtPK = firstDuplicate.getId();
			response.addErrorMsg("Already bay row and sequence is allotted to SLABID: " + pphMtPK.getPpid());
		}

		return response;
	}

