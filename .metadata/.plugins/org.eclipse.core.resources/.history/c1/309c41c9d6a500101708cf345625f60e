	    for (Object[] row : groupingListData) {
	        String groupKey = row[0] instanceof BigDecimal
	                ? ((BigDecimal) row[0]).toPlainString()
	                : String.valueOf(row[0]);
	        Long count = row[1] instanceof BigDecimal
	                ? ((BigDecimal) row[1]).longValue()
	                : (Long) row[1];
	        list.add(new Group<>(groupKey, null, count));
	    }

	    result.setData(list);
	    result.setTotalCount(mainQueryCount);
	    result.setGroupCount(totalDistCount);
	    return (T) result;
	}
	
	public int findIndexOfKey(List<String> list, String key, int targetIndex) {
        int count = 0;
        for (int i = 0; i < list.size(); i++) {
            if (list.get(i).equals(key)) {
                if (count == targetIndex) {
                    return i; // Return the index of the nth occurrence of the key
                }
                count++;
            }
        }
        return targetIndex; // If the targetIndex doesn't match an occurrence, return targetIndex itself
    }
