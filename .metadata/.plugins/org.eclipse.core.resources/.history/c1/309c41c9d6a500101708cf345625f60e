	public String filterQueryUsingFilterList(List<String> filterList, String query) {

		StringBuilder queryBuilder = new StringBuilder(query);
		queryBuilder.append(" AND (");

		List<String> columnNames = DevExtGridFilterUtils.getAllFields(SlabStockDto.class);
		

		Map<String, String> columnDataTypesKeyValuePair = DevExtGridFilterUtils
				.getAllFieldsWithTypes(SlabStockDto.class);
		Map<String, String> columnAlise = checkClassAleas();
		boolean isClobObject = false;
		boolean isStringObject = false;
		boolean isDateObject = false;
		boolean isContains = false;
		boolean isNotContains = false;
		boolean isStartWith = false;
		boolean isEndWith = false;
		boolean isNullCheck = false;
		boolean isDateString = false;

		for (int i = 0; i < filterList.size(); i++) {
			String item = filterList.get(i);
			if (columnNames.contains(item)) {
				if (columnDataTypesKeyValuePair.get(item).equals("CLOB")) {
					queryBuilder.append("DBMS_LOB.INSTR(").append(columnAlise.get(item)).append(",");
					isClobObject = true;
				} else if (columnDataTypesKeyValuePair.get(item).equals("DATE")) {
					queryBuilder.append(" TO_CHAR(").append(columnAlise.get(item))
							.append(", 'YYYY-MM-DD')");
					isDateObject = true;
					
				} else if (item.equals("dischargingDate")) {
					System.out.println("dataaaaa--------111-----------------"+item);
				    queryBuilder.append(" TO_DATE(SUBSTR(")
				                .append(columnAlise.get(item))
				                .append(",1,8), 'YYYYMMDD') ");
				    isDateString = true;

				} else if (columnDataTypesKeyValuePair.get(item).equals("VARCHAR2")) {
					queryBuilder.append(columnAlise.get(item)).append(item);
					int columnIndex = findIndexOfKey(filterList,item,i);
					
					if("null".equals(filterList.get(columnIndex+2))) {
						
						isNullCheck = true;
					}
					isStringObject = true;
				} else {
					queryBuilder.append(columnAlise.get(item)).append(item);

				}

			}else if(isNullCheck) {
				queryBuilder.append(" IS NULL ");
				i = i+1;
				isNullCheck = false;
				isStringObject = false;
			
				
			} else if (isDateString) {
				
			    if (item.matches("\\d{4}/\\d{2}/\\d{2}.*")) {
			    	DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm:ss");
			        LocalDateTime dateTime = LocalDateTime.parse(item, formatter);
System.out.println("dataaaaa-------------------------"+item);
			        String dateOnly = dateTime.toLocalDate().toString().replace("-", "");
			        queryBuilder.append(" TO_DATE('").append(dateOnly).append("','YYYYMMDD')");
			        isDateString = false;
			    } else {
			        queryBuilder.append(" ").append(item).append(" ");
			    }		


			} else if (item.equals(OfsConstants.CONTAINS) || item.equals(OfsConstants.NOTCONTAINS) || item.equals(OfsConstants.STARTSWITH)
					|| item.equals(OfsConstants.ENDSWITH)) {
				if (isClobObject) {
				} else if (isDateObject) {
					queryBuilder.append(OfsConstants.LIKE);
				} else {
					if (item.equals(OfsConstants.CONTAINS)) {
						queryBuilder.append(OfsConstants.LIKE);
						isContains = true;
					} else if (item.equals(OfsConstants.NOTCONTAINS)) {
						queryBuilder.append(OfsConstants.NOT_LIKE);
						isNotContains = true;
					} else if (item.equals(OfsConstants.STARTSWITH)) {
						queryBuilder.append(OfsConstants.LIKE);
						isStartWith = true;
					} else if (item.equals(OfsConstants.ENDSWITH)) {
						queryBuilder.append(OfsConstants.LIKE);
						isEndWith = true;
					} else {
						queryBuilder.append(" = ");
					}
				}
			} else if (item.equals("or") || item.equals("and")) {
				queryBuilder.append(" ").append(item).append(" ");
			} else if (item.equals("=") || item.equals("<>") || item.equals(">=") || item.equals("<")
					|| item.equals(">")) {
				queryBuilder.append(" ").append(item);
			} else {
				if (isClobObject) {
					queryBuilder.append("'").append(item).append("') > 0");
					isClobObject = false;
				} else if (isStringObject) {
					if (isContains) {
						queryBuilder.append(" '%").append(item.trim().toUpperCase()).append("%'");
						isContains = false;
					} else if (isNotContains) {
						queryBuilder.append(" '%").append(item.trim().toUpperCase()).append("%'");
						isNotContains = false;
					} else if (isStartWith) {
						queryBuilder.append(" '").append(item.trim().toUpperCase()).append("%'");
						isStartWith = false;
					} else if (isEndWith) {
						queryBuilder.append(" '%").append(item.trim().toUpperCase()).append("'");
						isEndWith = false;
					} else {
						queryBuilder.append(" '").append(item.trim().toUpperCase()).append("'");
					}
					isStringObject = false;
				} else if (isDateObject) {
					System.out.println("dataaaaa--------222-----------------"+item);
				    LocalDate localDate = null;

				    if (item.matches("\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2}")) {
				        LocalDateTime ldt = LocalDateTime.parse(item, DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm:ss"));
				        localDate = ldt.toLocalDate();

				    } else if (item.matches("\\d{4}/\\d{2}/\\d{2}\\+\\d{2}:\\d{2}:\\d{2}")) {
				        String fixedItem = item.replace("+", " ");
				        LocalDateTime ldt = LocalDateTime.parse(fixedItem, DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm:ss"));
				        localDate = ldt.toLocalDate();

				    } else if (item.matches("\\d{4}/\\d{2}/\\d{2}")) {
				        localDate = LocalDate.parse(item, DateTimeFormatter.ofPattern("yyyy/MM/dd"));

				    } else {
				        String fixedItem = item.replace(" ", "+");
				        OffsetDateTime odt = OffsetDateTime.parse(fixedItem);
				        localDate = odt.toLocalDate();
				    }

				    queryBuilder.append(" '").append(localDate.toString()).append("'");
				    isDateObject = false;

				} else {
				    queryBuilder.append(" ").append(item);
				}

			}
		}
		queryBuilder.append(" )");
		
		return queryBuilder.toString();
	}

