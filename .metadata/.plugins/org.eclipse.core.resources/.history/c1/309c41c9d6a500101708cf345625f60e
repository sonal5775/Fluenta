	public String processSqlQuery(String sql) {
		if (sql.trim().endsWith("or")) {
			sql = sql.substring(0, sql.length() - 2);
			sql = sql.trim().substring(0, sql.length() - 2).trim();
		} else if (sql.trim().endsWith(" or")) {
			sql = sql.substring(0, sql.length() - 2);
			sql = sql.trim().substring(0, sql.length() - 3).trim();
		}

		sql = sql.replaceAll("h\\.isactv\\s*=\\s*'Active'", "h.isactv = 1");

		sql = sql.replaceAll("h\\.isactv\\s*=\\s*'Inactive'", "h.isactv = 0");

		return sql;
	}

