    public List<String> filterListData(List<String> filterList) {
        List<String> result = new ArrayList<>();
        
        for (int i = 0; i < filterList.size(); i++) {
            String currentItem = filterList.get(i);

            // Check if the current item is "or" and the next items are in the form of <field> = null
            if (currentItem.equals("or") 
                && i + 3 < filterList.size() 
                && filterList.get(i + 1) != null 
                && filterList.get(i + 2).equals("=") 
                && filterList.get(i + 3).equals("null")) {
                // Skip the "or", <field>, "=", and "null" (i.e., the next 4 items)
                i += 3;  // Skip over this "or", "<field> =", "null"
            } else {
                // Add the current item to the result
                result.add(currentItem);
            }
        }

        return result;
    }

	
	
