	@Transactional(rollbackFor = TransactionException.class)
	public OfsCommonResponse cleanSlabCurrentLocations(SlabStockRequest request) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		OfsCommonResponse response = new OfsCommonResponse();
		List<SlabStockDto> slabLocationList = slabStockCustRepository.getSlabLocationUpdateDetails(request);
		
		if(slabLocationList!=null) {
			for(SlabStockDto slab : slabLocationList) {
			PphMt pphmt = new PphMt();
			PphMtPK pk = new PphMtPK();
			
			pk.setPpid(slab.getPpid());
			pk.setPpctr(slab.getPpctr());
			
			pphmt.setId(pk);
			Optional<PphMt> optional = pphMtRepository.findById(pk);
			
				if(optional.isPresent()) {
					PphMt newPphMt = optional.get();
					newPphMt.setPrevslocid(newPphMt.getSlocid());
					newPphMt.setPrevslocseq(newPphMt.getSlocseq());
					newPphMt.setSlocid(" ");
					newPphMt.setSlocseq(null);
					pphMtRepository.save(newPphMt);
				}	
			}
		}
		response.addInfoMsg("updated successfully");
		return response;
	}
	
