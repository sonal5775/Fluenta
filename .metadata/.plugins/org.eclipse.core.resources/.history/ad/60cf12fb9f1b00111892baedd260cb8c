	@Override
	public HsmQualityUDDecisionDto buildHsmQualityUDDto(HsmQualityUDDecisionDto dtoUDDataSAP,
			CoilClearanceListDto record, String coilDecision, CoilClearanceRequestDto request, Date shiftDate) {

		long maxRecordNo = sapdataO2eEiRepository.getMaxRecordNo(QualityConstants.OFS_SAP_INT_OBJ_TYPE_UD_COILQC);
		logger.info(QualityConstants.FETCHEDMAXRECORDNO, maxRecordNo);
		dtoUDDataSAP.setRecordNo(String.valueOf(maxRecordNo + 1));
		dtoUDDataSAP.setCharg(record.getPpid());
		dtoUDDataSAP.setSoNumber(record.getSoId());
		dtoUDDataSAP.setSLineItem(record.getSolId());
		dtoUDDataSAP.setPasThk40(record.getThickness());
		dtoUDDataSAP.setPasWid40(record.getWidth());
		dtoUDDataSAP.setPasLen40(null);
		dtoUDDataSAP.setUdDate(new Date());
		dtoUDDataSAP.setBudat(new Date());
		dtoUDDataSAP.setUdCode(coilDecision);
		switch (coilDecision) {
		  case "FGP1" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_UD_PRIME);
		    case "FGP2" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_NCO);
		    case "FGP3" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_NON_PRIME);
		    case "HCSL" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_UD_SALVAGE);
		    case "HLD"  -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_HOLD);
		    case "HCRM" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_ANGUL_CRM);
		    case "TPIP" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_THIRD_PARTY);
		    case "HCTL" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_CUT_TO_LENGTH);
		    case "HRSP" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_SKIN_PASS);
		    case "AUS1" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_AUCTION);
		    case "HSLT" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_SLITTER);
		    case "HRCA" -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_NEW_DEV);
		    default     -> dtoUDDataSAP.setUdDesc(QualityConstants.RESULT_UNKNOWN);
	}
		dtoUDDataSAP.setCheFin40(coilDecision);
		dtoUDDataSAP.setInspNam40(record.getDecisionBy());
		dtoUDDataSAP.setErdat(record.getDecisionDate());
		dtoUDDataSAP.setErzet(record.getDecisionDate());
		if (shiftDate != null) {
			LocalDateTime dateTime = shiftDate.toInstant().atZone(ZoneId.systemDefault()).toLocalDateTime();
			int hour = dateTime.getHour();
			String shift;

			if (hour >= 6 && hour < 14) {
				shift = "A";
			} else if (hour >= 14 && hour < 22) {
				shift = "B";
			} else {
				shift = "C";
			}

			dtoUDDataSAP.setInSft40(shift);
		} else {
			dtoUDDataSAP.setInSft40(null);
		}
		BigDecimal soqty = solStRepository.findSoqtyBySoidAndSolid(record.getSoId(), record.getSolId());
		dtoUDDataSAP.setMenge(soqty);
		dtoUDDataSAP.setMeins("TO");
		dtoUDDataSAP.setWerks("9082");
		dtoUDDataSAP.setMenge(record.getWeight());
		return dtoUDDataSAP;
	}

	@Override
	public HsmQualityMechanicalDto buildHsmQualityMechanicalDto(HsmQualityMechanicalDto dtoMechDataSAP, String coilid,
			String heatId, String sampleId, long recordNo) {
		
		long maxRecordNo = sapdataO2eEiRepository.getMaxRecordNo(QualityConstants.OFS_SAP_INT_OBJ_TYPE_MECH_COILQC);
		logger.info(QualityConstants.FETCHEDMAXRECORDNO, maxRecordNo);
		dtoMechDataSAP.setRecordNo(String.valueOf(maxRecordNo + 1));
		dtoMechDataSAP.setResultId(20);
		dtoMechDataSAP.setCharg(coilid);
		dtoMechDataSAP.setMatnr(" ");
		dtoMechDataSAP.setOperations(heatId);
		dtoMechDataSAP.setBudat(new Date());
		dtoMechDataSAP.setWerks("9082");
		dtoMechDataSAP.setZdate(new Date());
		dtoMechDataSAP.setZtime(new Time(System.currentTimeMillis()));
		dtoMechDataSAP.setSampleId(sampleId);
		if (sampleId != null) {

			List<MechanicalTestDto> mechanicalTestList = custRepository.getMechanicalTestList(sampleId);
			logger.debug("Mechanical test list: {}", mechanicalTestList);
			for (MechanicalTestDto dtomech : mechanicalTestList) {
				logger.debug("Processing testType: {}", dtomech.getTestType());

				switch (dtomech.getTestType()) {
				case OfsConstants.TENSILE:
					List<TensileLabTestingDto> tensileResults = custRepository
							.getTensileResult(dtomech.getSpecimenId());
					extractedTensile(dtoMechDataSAP, tensileResults);
					break;
				case OfsConstants.BEND:
					List<BendResultLabTestingDto> bendResults = custRepository.getBendtResult(dtomech.getSpecimenId());

					extractedBend(dtoMechDataSAP, bendResults);
					break;
				case OfsConstants.HARDNESS:
					List<HardnessLabTestingDto> hardnessResults = custRepository
							.getHardnessResult(dtomech.getSpecimenId());
					extractedHardness(dtoMechDataSAP, hardnessResults);
					break;

				case OfsConstants.IMPACT_CVN:
					List<ImpactResultDto> impactResultCvn = custRepository.getImpactResult(dtomech.getSpecimenId(),
							"CVN");
					extractedImpact(dtoMechDataSAP, impactResultCvn);
					break;
				case OfsConstants.IMPACT_CUN:
					List<ImpactResultDto> impactResultCun = custRepository.getImpactResult(dtomech.getSpecimenId(),
							"CUN");
					extractedImpact(dtoMechDataSAP, impactResultCun);
					break;

				case OfsConstants.HTTT:
					List<HighTempTensileTestResultLabTestingDto> highTempTensileTestResult = custRepository
							.getHighTempTesnsileTestResult(dtomech.getSpecimenId());
					extractedHttt(highTempTensileTestResult);
					break;
				case OfsConstants.DWTT:
					List<DWTTResultLabTestingDto> dwttResult = custRepository.getDWTTResult(dtomech.getSpecimenId());
					extractedDwtt(dtoMechDataSAP, dwttResult);
					break;
				case OfsConstants.INCLUSION_RATING:
					List<InclusionRatingLabTestingDto> getInclusionRatingResult = custRepository
							.getInclusionRatingResult(dtomech.getSpecimenId());
					extractedInclusionTest(dtoMechDataSAP, getInclusionRatingResult);
					break;
				case OfsConstants.Z_TEST:
					List<ZTestResultLabTestingDto> getZtestResult = custRepository
							.getZTestResult(dtomech.getSpecimenId());
					extractedZtest(dtoMechDataSAP, getZtestResult);
					break;
				default:
					logger.warn("Unhandled testType: {}", dtomech.getTestType());
					break;
				}

				extractedGrainSize(dtoMechDataSAP, dtomech);

				extractedMicrostructure(dtoMechDataSAP, dtomech);
			}

		}

		return dtoMechDataSAP;
	}

	private void extractedTensile(HsmQualityMechanicalDto dtoMechDataSAP, List<TensileLabTestingDto> tensileResults) {
		if (!tensileResults.isEmpty()) {
			TensileLabTestingDto tensile = tensileResults.get(0);
			dtoMechDataSAP.setYs20(tensile.getYs());
			dtoMechDataSAP.setUts20(tensile.getUts());
			dtoMechDataSAP.setYsuts20(tensile.getYsuts());
			dtoMechDataSAP.setEl20(tensile.getElongationGL200());
			dtoMechDataSAP.setGl20(new BigDecimal("20"));
			dtoMechDataSAP.setRa20("");
		}
	}

	private void extractedBend(HsmQualityMechanicalDto dtoMechDataSAP, List<BendResultLabTestingDto> bendResults) {
		if (!bendResults.isEmpty()) {
			BendResultLabTestingDto bend = bendResults.get(0);
			dtoMechDataSAP.setBend20(bend.getBendval());
			dtoMechDataSAP.setBendAngl20(bend.getDegrees());
		}
	}

	private void extractedHardness(HsmQualityMechanicalDto dtoMechDataSAP,
			List<HardnessLabTestingDto> hardnessResults) {
		if (!hardnessResults.isEmpty()) {
			HardnessLabTestingDto hard = hardnessResults.get(0);
			dtoMechDataSAP.setHard20(hard.getHardness());
			dtoMechDataSAP.setHardUnt20("");
		}
	}

	private void extractedImpact(HsmQualityMechanicalDto dtoMechDataSAP, List<ImpactResultDto> impactResultCun) {
		if (!impactResultCun.isEmpty()) {
			ImpactResultDto impactcun = impactResultCun.get(0);
			dtoMechDataSAP.setImp120(impactcun.getEnergyIndex());
			dtoMechDataSAP.setImp220(impactcun.getSaIndex());
			dtoMechDataSAP.setImp320(impactcun.getEnergyIndex());
			dtoMechDataSAP.setImpAvg20(impactcun.getEnergyAverage());
			dtoMechDataSAP.setImpTemp20(impactcun.getTemperature());
			dtoMechDataSAP.setImpSize20(impactcun.getEnergyIndex());
			dtoMechDataSAP.setImpShr120(impactcun.getEnergyIndex());
			dtoMechDataSAP.setImpShr220(impactcun.getEnergyIndex());
			dtoMechDataSAP.setImpShr320(impactcun.getEnergyIndex());
			dtoMechDataSAP.setImpShr20(impactcun.getEnergyIndex());
		}
	}

	private void extractedHttt(List<HighTempTensileTestResultLabTestingDto> highTempTensileTestResult) {
		if (!highTempTensileTestResult.isEmpty()) {
