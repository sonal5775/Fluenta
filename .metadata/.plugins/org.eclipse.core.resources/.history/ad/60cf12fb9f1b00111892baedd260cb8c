	@Override
	public OfsToSapIntResponse sendCasterSlabData(Inventory pphMt) {
		CasterSlabDataDto dto = new CasterSlabDataDto();
		logger.info("SENDING SLAB ID {}", pphMt.getId().getPpid());

		dto.setRecordNo(pphMt.getId().getPpctr());
		dto.setMatnr(pphMt.getProductionCodeId());
		dto.setCharg(pphMt.getId().getPpid());
		dto.setSaleOrdNo(null);
		dto.setSaleOrdItem(null);
		dto.setSpecStock("E");
		dto.setChargMs("");
		dto.setMenge(pphMt.getWeight());
		dto.setMeins("TO");
		dto.setBudat(new SimpleDateFormat(QualityConstants.YYYYMMDD).format(pphMt.getProductionDate()));
		dto.setWerks("9083");
		dto.setLgort("SRLA");
		dto.setBwart("101");
		dto.setVExtGrade(pphMt.getGradeId());
		dto.setVHeatno(pphMt.getHeatId());
		dto.setVProduct("SL");
		dto.setVExtGrade(pphMt.getExternalGrade());
		logger.info("PPHMT THK :{}", pphMt.getThickness());
		if (pphMt.getThickness() != null && pphMt.getThickness().intValue() >= 215
				&& pphMt.getThickness().intValue() <= 225) {
			logger.info("THK IN RAGNGE >= 215 && <=225 :{}", pphMt.getThickness());
			dto.setVThickness(new BigDecimal("220"));
		} else {
			logger.info("THK NOT IN RAGNGE >= 215 && <=225 :{}", pphMt.getThickness());
			dto.setVThickness(pphMt.getThickness());
		}
		logger.info("SENDING THK :{}", dto.getVThickness());
		dto.setVWidth(pphMt.getWidth());
		dto.setSLength(pphMt.getLength());
		dto.setVPieces(pphMt.getPieces());
		dto.setVTpp(pphMt.getWeight());
		dto.setVProcessRoute("NORM");
		dto.setVInspectionBy(pphMt.getInspectedBy());
		dto.setVTdcNo(pphMt.getToolDesignationCodeId());
		dto.setVQuality("");
		dto.setVQualityremark("");
		dto.setSODefect("");
		dto.setSMDefect("");
		dto.setSECondition("");
		dto.setVPweight(pphMt.getTheoreticalWeight());
		dto.setVColourCode("");
		dto.setVTnp(null);
		dto.setVSectionalWt2(dto.getVThickness().multiply(pphMt.getWidth()).multiply(BigDecimal.valueOf(7.85))
				.divide(BigDecimal.valueOf(Math.pow(10, 6))));
		dto.setVSectionalWt3(null);
		dto.setVHsqn("");
		dto.setXTranSlab("");
		dto.setVHeatnoT("");

		CasterSlabDataSapOfsPayload payload = new CasterSlabDataSapOfsPayload();
		payload.setSms2PrdDtl(dto);
		return sapServiceClient.saveSlabData(payload);
	}

