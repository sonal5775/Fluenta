			if(chemData.isPresent()) {
				SpecimenQualityTransactionEntity chemSpecimen = chemData.get();
				List<ChemResultQtEntity> chemistry = chemResultQtRepository
						.findBySpecimenId(chemSpecimen.getSpecimenId());

				for (ChemResultQtEntity chem : chemistry) {
					setElements(dtoData,chem,null);
				}
			}else {
				List<PpChemEntity> ladleChemistry = ppChemRepository.findAllByPpid(slabId);
				for (PpChemEntity chem : ladleChemistry) {
					setElements(dtoData,null,chem);
				}
			}
		}
		return dtoData;

	}

