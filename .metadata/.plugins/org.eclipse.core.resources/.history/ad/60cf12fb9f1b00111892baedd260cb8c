			dtoMechDataSAP.setBThin30(dwwt.getTybthin());
			dtoMechDataSAP.setBThick30(dwwt.getTybthick());
			dtoMechDataSAP.setCThin30(dwwt.getTycthin());
			dtoMechDataSAP.setCThick30(dwwt.getTycthick());
			dtoMechDataSAP.setDThin30(dwwt.getTydthin());
			dtoMechDataSAP.setDThick30(dwwt.getTydthick());
		}
	}

	private void extractedZtest(HsmQualityMechanicalDto dtoMechDataSAP, List<ZTestResultLabTestingDto> getZtestResult) {
		if (!getZtestResult.isEmpty()) {
			ZTestResultLabTestingDto ztest = getZtestResult.get(0);
			dtoMechDataSAP.setZRa120(ztest.getRaind());
