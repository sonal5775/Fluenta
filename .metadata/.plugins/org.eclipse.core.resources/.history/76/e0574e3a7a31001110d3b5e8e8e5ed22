	@Override
	@Transactional
	public boolean validateExternalGrade(ExternalGradeRequest request) {
		logger.info("validating external grade for request:{}", request);
		dbSessionService.setSessionInfo(this.getClass().getName());
		if (request.getExtGrdName() != null) {
			boolean validateChemistry = isValidateChemistry(request.getExtGradeList().get(0).getExtgrdnm());
			boolean validateMechanical = isValidateMechanical(request.getExtGradeList().get(0).getExtgrdnm());
			boolean validateCatalog = isValidateCatalog(request.getExtGrdName());
			if (validateChemistry && validateMechanical && validateCatalog) {
				if (request.getExtGradeList() != null) {
					for (ExtgrdJmDTO item : request.getExtGradeList()) {
						if (!Objects.equals(item.getExtgrdsts(), OfsStatusConstants.TDC_STATUS_RELEASED)
								&& !Objects.equals(item.getExtgrdsts(), OfsStatusConstants.TDC_WF_STATUS_PENDING)) {
							Optional<ExtGrdJmEntity> optional = extGrdRepository.findById(request.getExtGradeList().get(0).getExtgrdnm());
							if(optional.isPresent()) {
								ExtGrdJmEntity extGrdJmEntity = optional.get();
								extGrdJmEntity.setExtgrdsts(OfsStatusConstants.TDC_WF_STATUS_PENDING);
							}
						}
						
					}
				}
				return true;
			}
		}
		return false;
	}

	public boolean isValidateChemistry(String extgrdnm) {
		String normId = null;
		if(extgrdnm!=null) {
			Optional<ExtGrdJmEntity> extgrd =  extGrdRepository.findByExtGrdNm(extgrdnm);
			if(extgrd.isPresent()) {
				normId = extgrd.get().getNormid();
			}
		}
		if (normId != null) {
			long chemistry = elementMastrepository.findCountById(normId);
			if (chemistry > 0) {
				return true;
			}
		}
		return false;
	}

	public boolean isValidateMechanical(String extgrdnm) {
		String normId = null;
		if(extgrdnm!=null) {
			Optional<ExtGrdJmEntity> extgrd =  extGrdRepository.findByExtGrdNm(extgrdnm);
			if(extgrd.isPresent()) {
				normId = extgrd.get().getNormid();
			}
		}
		if (normId != null) {
			long tensileCount = tensileRepository.findCountById(normId);
			long bendCount = bendRepository.findCountById(normId);
			long dwttCount = dwttRepository.findCountById(normId);
			long hardnessCount = hardnessRepository.findCountById(normId);
			long htttCount = htttRepository.findCountById(normId);
			long impactCount = impactRepository.findCountById(normId);
			long inclusionCount = inclusionRepository.findCountById(normId);
			long shtCount = shtRepository.findCountById(normId);
			long zTestCount = ztestRepository.findCountById(normId);
			long grainSizeCount = othrtestRepository.findCountById(normId, OfsConstants.GRAIN_SIZE);
			long microStructureCount = othrtestRepository.findCountById(normId, OfsConstants.MICROSTRUCTURE);
			long naceSccCount = othrtestRepository.findCountById(normId, OfsConstants.NACE_SCC);
			long naceHicCount = othrtestRepository.findCountById(normId, OfsConstants.NACE_HIC);
			long wbbtCount = othrtestRepository.findCountById(normId, OfsConstants.WBBT);
			long strainAgingCount = othrtestRepository.findCountById(normId, OfsConstants.STRAIN_AGING);
			long ballisticCount = othrtestRepository.findCountById(normId, OfsConstants.BALLISTIC_TEST);
			long weldabilityCount = othrtestRepository.findCountById(normId, OfsConstants.WELDABILITY_TEST);

			if (tensileCount > 0 || bendCount > 0 || dwttCount > 0 || hardnessCount > 0 || htttCount > 0
					|| impactCount > 0 || inclusionCount > 0 || shtCount > 0 || zTestCount > 0 || grainSizeCount > 0
					|| microStructureCount > 0 || naceSccCount > 0 || naceHicCount > 0 || wbbtCount > 0
					|| strainAgingCount > 0 || ballisticCount > 0 || weldabilityCount > 0) {
				return true;
			}
		}
		return false;

	}

	public boolean isValidateCatalog(String extgrd) {
		if (extgrd != null) {
			long prodCatalog = prodCatalogJmRepository.findCountById(extgrd);
			if (prodCatalog > 0) {
				return true;
			}
		}
		return false;
	}

	@Override
	@Transactional
	public boolean modifyStatusToInProgress(ExternalGradeRequest request) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		boolean validateChemistry = isValidateChemistry(request.getExtGradeList().get(0).getExtgrdnm());
		boolean validateMechanical = isValidateMechanical(request.getExtGradeList().get(0).getExtgrdnm());
		boolean validateCatalog = isValidateCatalog(request.getExtGrdName());
		if (request.getExtGradeList() != null && validateChemistry || validateMechanical || validateCatalog) {
			for (ExtgrdJmDTO item : request.getExtGradeList()) {
				if ((!Objects.equals(item.getExtgrdsts(), OfsStatusConstants.TDC_STATUS_RELEASED)
						&& !Objects.equals(item.getExtgrdsts(), OfsStatusConstants.IN_PROGRESS)
						&& !Objects.equals(item.getExtgrdsts(), OfsStatusConstants.TDC_WF_STATUS_PENDING)) || item.getExtgrdsts()==null) {
					Optional<ExtGrdJmEntity> optional = extGrdRepository.findById(request.getExtGradeList().get(0).getExtgrdnm());
					if(optional.isPresent()) {
						ExtGrdJmEntity extGrdJmEntity = optional.get();
						extGrdJmEntity.setExtgrdsts(OfsStatusConstants.IN_PROGRESS);
					}
				}
			}
			return true;
		}
		return false;
	}

