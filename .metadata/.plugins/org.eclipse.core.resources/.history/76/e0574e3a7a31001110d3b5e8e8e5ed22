	@Override
	@Transactional(rollbackFor = Exception.class)
	public String saveExternalGrades(@Valid ExternalGradeRequest request) {
		logger.info("Saving external grades");
		dbSessionService.setSessionInfo(this.getClass().getName());

		if (request.getExtGradeList() != null && !request.getExtGradeList().isEmpty()) {
			for (ExtgrdJmDTO item : request.getExtGradeList()) {
				Optional<ExtGrdJmEntity> existingRecord;
				if(item.getPrevExtGrdNm()!=null && !item.getPrevExtGrdNm().equals(item.getExtgrdnm())
						&& request.getExtMultiStdGradeList() != null && request.getExtMultiStdGradeList().isEmpty()) {
					extGrdRepository.updatePrimaryKey(item.getExtgrdnm(), item.getPrevExtGrdNm(),ClientIpUtils.getClient(),ClientIpUtils.getClientIpAddress(),new Date(),item.getSpec(),item.getSubqlty(),item.getGrd(),item.getIsmultistd());
					return "Success";
				}
				existingRecord = extGrdRepository.findByExtGrdNm(item.getPrevExtGrdNm()!=null?item.getPrevExtGrdNm():" ");
				extractedIfExtGrdNmPresent(item, existingRecord);
			}
		}

		if (request.getExtMultiStdGradeList() != null && !request.getExtMultiStdGradeList().isEmpty()) {
			for (EgmultigrdlistJmDTO dto : request.getExtMultiStdGradeList()) {
				long ctr = 0;
				EgmultigrdlistJmEntity entity;
				EgmultigrdlistJmEntityPK pk = new EgmultigrdlistJmEntityPK();
				pk.setExtgrdnm(dto.getExtgrdnm());
				pk.setEgctr(dto.getEgctr());
				Optional<EgmultigrdlistJmEntity> existingRecord = egMultiStdRepository.findById(pk);
				if (existingRecord.isPresent()) {
					entity = existingRecord.get();
				} else {
					entity = new EgmultigrdlistJmEntity();
					ctr = egMultiStdRepository.getMaxEgCtr(dto.getExtgrdnm());
					pk.setEgctr(++ctr);
					entity.setId(pk);
				}
				entity.setMapextgrdnm(dto.getMapextgrdnm().trim());
				entity.setIsprimarygrd(dto.getIsprimarygrd().trim());
				egMultiStdRepository.save(entity);
			}
		}

		return "Success";
	}

	private void extractedIfExtGrdNmPresent(ExtgrdJmDTO item, Optional<ExtGrdJmEntity> existingRecord) {
		ExtGrdJmEntity entity;
		BigDecimal maxEgId;
		if (existingRecord.isEmpty()) {
			maxEgId = extGrdRepository.countTotalRecords();
			entity = new ExtGrdJmEntity();
			entity.setCrBy(ClientIpUtils.getClient());
			entity.setCrDt(new Date());
			entity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
			entity.setExtgrdnm(item.getExtgrdnm().trim());
			entity.setEgid(String.valueOf(maxEgId.intValue() + 1));	
			NormmastJmEntity normmastJmEntity = null;
				Optional<NormmastJmEntity> optional = normMastRepository.findById(item.getNormid()!=null?item.getNormid():" ");
				if (optional.isPresent()) {
					normmastJmEntity = optional.get();
					normmastJmEntity.setMoBy(ClientIpUtils.getClient());
					normmastJmEntity.setMoDt(new Date());
					normmastJmEntity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				} else {
				normmastJmEntity = new NormmastJmEntity();
				String maxCount = normMastRepository.generateNormId();
				long newId = Long.parseLong(maxCount) + 1;
				normmastJmEntity.setNormid(Long.toString(newId));
				normmastJmEntity.setNormty("EG");
				normmastJmEntity = normMastRepository.save(normmastJmEntity);
				entityManager.flush();
				}
			entity.setNormid(normmastJmEntity.getNormid());
			entity.setIsmultistd(item.getIsmultistd());
			entity.setSpec((item.getSpec() != null ? item.getSpec() : "").trim());
			entity.setGrd((item.getGrd() != null ? item.getGrd() : "").trim());
			entity.setSubqlty((item.getSubqlty() != null ? item.getSubqlty() : "").trim());
			extGrdRepository.save(entity);
		}
	}

@Override
	@Transactional(rollbackFor = Exception.class)
	public String saveReleaseExternalGrades(@Valid ExternalGradeRequest request) {
		logger.info("Release external grades");
		dbSessionService.setSessionInfo(this.getClass().getName());
	
		if (request.getExtGradeList() != null && !request.getExtGradeList().isEmpty()) {
			for (ExtgrdJmDTO item : request.getExtGradeList()) {			
				Optional<ExtGrdJmEntity> existingRecord = extGrdRepository.findByExtGrdNm(
				    item.getExtgrdnm() != null ? item.getExtgrdnm() : " "
				);
				if (existingRecord.isPresent()) {
					 ExtGrdJmEntity entity = existingRecord.get();
				    entity.setMoBy(ClientIpUtils.getClient());
				    entity.setMoDt(new Date());
				    entity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				 entity.setExtgrdsts(item.getExtgrdsts().trim());
				extGrdRepository.save(entity);
				}
			}
		}
		
 
		return "Success";
	}
 

