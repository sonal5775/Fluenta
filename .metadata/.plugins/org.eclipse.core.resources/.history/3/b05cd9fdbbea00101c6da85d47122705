	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public ResponseEntity<FluentaApiResponse<CheckListPostDto>> saveInspectionCheckList(CheckListPostDto request) {
		logger.info("{}", request);
		dbSessionService.setSessionInfo(this.getClass().getName());
		ResponseEntity<FluentaApiResponse<CheckListPostDto>> response = null;
		List<PhysicalInspCheckListDto> checkList = request.getCheckList();
		HsmOnlineInspCoilDto coilDto = request.getCoilDto();
		PostProdTaskMtEntity task = null;
		Optional<PostProdTaskMtEntity> taskOptional = postProdTaskMtRepository.getTasksByPpidAndPrid(
				coilDto.getPpId().trim(), QualityConstants.ONLINE_INSP, QualityConstants.INSP_FLAG_YES);
		if (taskOptional.isPresent()) {
			task = taskOptional.get();
			for (PhysicalInspCheckListDto dto : checkList) {
				InspChecklistMasterEntity checklistMasterEntity = new InspChecklistMasterEntity();
				InspChecklistMasterEntityPK checklistMasterEntityPK = new InspChecklistMasterEntityPK();
				PpInspChecklistEntity checklistEntity = new PpInspChecklistEntity();
				PpInspChecklistEntityPK checklistEntityPK = new PpInspChecklistEntityPK();
				logger.info("{}", dto);
				checklistMasterEntityPK.setPrid(QualityConstants.ONLINE_INSP);
				checklistMasterEntityPK.setAtrid(dto.getAttribute());
				Optional<InspChecklistMasterEntity> masterOptional = inspChecklistMasterRepository
						.findById(checklistMasterEntityPK);
				if (masterOptional.isPresent()) {
					checklistMasterEntity = masterOptional.get();
					checklistMasterEntity.setMoBy(ClientIpUtils.getClient());
					checklistMasterEntity.setMoDt(new Date());
					checklistMasterEntity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				} else {
					checklistMasterEntity.setId(checklistMasterEntityPK);
					checklistMasterEntity.setIsactv(BigDecimal.ONE);
					checklistMasterEntity.setCrBy(ClientIpUtils.getClient());
					checklistMasterEntity.setCrDt(new Date());
					checklistMasterEntity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
				}
				logger.info("{}", "saving master");
				inspChecklistMasterRepository.save(checklistMasterEntity);
				logger.info("{}", "saved master");
				checklistEntityPK.setPpid(coilDto.getPpId());
				checklistEntityPK.setPpctr(0);
				checklistEntityPK.setTaskstepid(task.getId().getTaskstepId());
				checklistEntityPK.setAtrid(dto.getAttribute());
				Optional<PpInspChecklistEntity> optional = ppInspChecklistRepository.findById(checklistEntityPK);
				if (optional.isPresent()) {
					checklistEntity = optional.get();
					checklistEntity.setMoBy(ClientIpUtils.getClient());
					checklistEntity.setMoDt(new Date());
					checklistEntity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				} else {
					checklistEntity.setId(checklistEntityPK);
					checklistEntity.setCrBy(ClientIpUtils.getClient());
					checklistEntity.setCrDt(new Date());
					checklistEntity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
					checklistEntity.setIsactv(BigDecimal.ONE);
					checklistEntity.setPrid(QualityConstants.ONLINE_INSP);
				}
				if (dto.isInspectionFlag()) {
					checklistEntity.setInspflg(QualityConstants.INSP_FLAG_YES);
				} else {
					checklistEntity.setInspflg(QualityConstants.INSP_FLAG_NO);
				}
				checklistEntity.setInsprem(dto.getRemarks());
				checklistEntity.setInsprslt(dto.getInspResult());
				logger.info("{}", checklistEntity);
				PpInspChecklistEntity save = ppInspChecklistRepository.save(checklistEntity);
				logger.info("{}", save);
				response = ResponseUtil.createResponse(request, "Save/Update Successful  ", false);
			}
		} else {
			response = ResponseUtil.createResponse(request, "Task Id Not Found  ", false);
		}
		return response;

	}

	@Override
	@SuppressWarnings("all")
	@Transactional(rollbackFor = TransactionException.class)
	public ResponseEntity<FluentaApiResponse<CheckListImagesPostdto>> saveInspectionCheckListImages(
			CheckListImagesPostdto request) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		ResponseEntity<FluentaApiResponse<CheckListImagesPostdto>> response = null;
		HsmOnlineInspCoilDto coilDto = request.getCoilDto();
		PhysicalInspCheckListDto checkListDto = request.getCheckListDto();
		List<PhysicalInspChkListImageDto> imageList = request.getImageList();
		CheckListPostDto checkListPostDto = new CheckListPostDto();
		checkListPostDto.setCoilDto(coilDto);
		ArrayList<PhysicalInspCheckListDto> checkList = new ArrayList<>();
		checkList.add(checkListDto);
		checkListPostDto.setCheckList(checkList);
		saveInspectionCheckList(checkListPostDto);
		PostProdTaskMtEntity task = null;
		Optional<PostProdTaskMtEntity> taskOptional = postProdTaskMtRepository.getTasksByPpidAndPrid(
				coilDto.getPpId().trim(), QualityConstants.ONLINE_INSP, QualityConstants.INSP_FLAG_YES);
		if (taskOptional.isPresent()) {
			task = taskOptional.get();
		}
		for (PhysicalInspChkListImageDto dto : imageList) {
			byte[] bytesFromBase64Url = FileConversionUtil.getBytesFromBase64Url(dto.getCapturedImage());
			dto.setImgfile(bytesFromBase64Url);
			PpInspImagesEntityPK pk = new PpInspImagesEntityPK();
			PpInspImagesEntity entity = new PpInspImagesEntity();
			pk.setAtrid(checkListDto.getAttribute());
			pk.setPpid(coilDto.getPpId());
			pk.setPpctr(0);
			pk.setTaskstepid(task.getId().getTaskstepId());
			pk.setImgcnt(dto.getImageCount());
			Optional<PpInspImagesEntity> optional = ppInspImagesRepository.findById(pk);
			if (optional.isPresent()) {
				entity = optional.get();
				entity.setMoBy(ClientIpUtils.getClient());
				entity.setMoDt(new Date());
				entity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
			} else {
				long maxDefectCtr = ppInspImagesRepository.getMaxImgCount(coilDto.getPpId(),
						checkListDto.getAttribute());
				pk.setImgcnt(maxDefectCtr + 1);
				entity.setId(pk);
				entity.setCrBy(ClientIpUtils.getClient());
				entity.setCrDt(new Date());
				entity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
				entity.setIsactv(BigDecimal.ONE);
			}
			entity.setImgdesc(dto.getImageDesc());
			entity.setImgfile(dto.getImgfile());
			entity.setImgnm(dto.getImageName());
			entity.setImgpos(dto.getImgposition());
			ppInspImagesRepository.save(entity);
			response = ResponseUtil.createResponse(request, "Save/Update Successful", false);
		}
		return response;
	}

