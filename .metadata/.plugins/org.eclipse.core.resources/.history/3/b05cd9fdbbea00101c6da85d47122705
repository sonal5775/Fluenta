				.append(" OR (:coilIdFrom IS NOT NULL AND :coilIdTo IS NOT NULL AND TO_NUMBER(TRIM(z.ppId)) BETWEEN TO_NUMBER(:coilIdFrom) AND TO_NUMBER(:coilIdTo)) ) ");
		String finalQuery = query.toString();

		if (!filterList.isEmpty()) {
