	public String filterQueryUsingFilterList(List<String> filterList, String query) {

	    StringBuilder queryBuilder = new StringBuilder(query).append(" AND (");

	    List<String> columnNames =
	            DevExtGridFilterUtils.getAllFields(HsmOnlineInspCoilDto.class);

	    Map<String, String> columnDataTypesKeyValuePair =
	            DevExtGridFilterUtils.getAllFieldsWithTypes(HsmOnlineInspCoilDto.class);

	    Map<String, String> columnAlise = checkClassAleas();

	    boolean isClobObject = false;
	    boolean isStringObject = false;
	    boolean isDateObject = false;
	    boolean isContains = false;
	    boolean isNotContains = false;
	    boolean isStartWith = false;
	    boolean isEndWith = false;
	    boolean isNullCheck = false;
	    boolean isDateString = false;

	    for (int i = 0; i < filterList.size(); i++) {

	        String item = filterList.get(i);

	        /* ================= COLUMN NAME ================= */
	        if (columnNames.contains(item)) {

	            String dataType = columnDataTypesKeyValuePair.get(item);

	            if ("CLOB".equals(dataType)) {

	                queryBuilder.append(" DBMS_LOB.INSTR(")
	                            .append(columnAlise.get(item))
	                            .append(",");
	                isClobObject = true;

	            } else if ("DATE".equals(dataType)) {

	                queryBuilder.append(" TO_CHAR(")
	                            .append(columnAlise.get(item))
	                            .append(", 'YYYY-MM-DD') ");
	                isDateObject = true;

	            } else if ("dischargingDate".equals(item)) {

	                queryBuilder.append(" TO_DATE(SUBSTR(")
	                            .append(columnAlise.get(item))
	                            .append(",1,8),'YYYYMMDD') ");
	                isDateString = true;

	            } else if ("VARCHAR2".equals(dataType)) {

	                // 🔥 CASE-INSENSITIVE FIX
	                queryBuilder.append(" UPPER(")
	                            .append(columnAlise.get(item))
	                            .append(") ");

	                int columnIndex = findIndexOfKey(filterList, item, i);
	                if ("null".equals(filterList.get(columnIndex + 2))) {
	                    isNullCheck = true;
	                }

	                isStringObject = true;

	            } else {
	                queryBuilder.append(columnAlise.get(item));
	            }

	        }

	        /* ================= NULL CHECK ================= */
	        else if (isNullCheck) {
	            queryBuilder.append(" IS NULL ");
	            isNullCheck = false;
	            isStringObject = false;
	            i++;
	        }

	        /* ================= DATE STRING ================= */
	        else if (isDateString) {

	            if (item.matches("\\d{4}-\\d{2}-\\d{2}T.*Z")) {
	                try {
	                    Instant instant = Instant.parse(item);
	                    LocalDate localDate =
	                            instant.atZone(ZoneId.systemDefault()).toLocalDate();
	                    String dateOnly =
	                            localDate.format(DateTimeFormatter.BASIC_ISO_DATE);

	                    queryBuilder.append(" TO_DATE('")
	                                .append(dateOnly)
	                                .append("','YYYYMMDD') ");
	                } catch (Exception e) {
	                    queryBuilder.append(" '").append(item).append("' ");
	                }
	                isDateString = false;
	                continue;
	            }

	            queryBuilder.append(" ").append(item).append(" ");
	        }

	        /* ================= OPERATORS ================= */
	        else if (item.equals(CONTAINS) || item.equals(NOTCONTAINS)
	                || item.equals(STARTSWITH) || item.equals(ENDSWITH)) {

	            if (isDateObject) {
	                queryBuilder.append(" LIKE ");
	            } else if (!isClobObject) {

	                if (item.equals(CONTAINS)) {
	                    queryBuilder.append(" LIKE ");
	                    isContains = true;
	                } else if (item.equals(NOTCONTAINS)) {
	                    queryBuilder.append(" NOT LIKE ");
	                    isNotContains = true;
	                } else if (item.equals(STARTSWITH)) {
	                    queryBuilder.append(" LIKE ");
	                    isStartWith = true;
	                } else if (item.equals(ENDSWITH)) {
	                    queryBuilder.append(" LIKE ");
	                    isEndWith = true;
	                }
	            }
	        }

	        /* ================= LOGICAL OPS ================= */
	        else if ("and".equals(item) || "or".equals(item)) {
	            if ("and".equals(item)) {
	                queryBuilder.append(" ) AND ( ");
	            } else {
	                queryBuilder.append(" OR ");
	            }
	        }

	        /* ================= COMPARISON OPS ================= */
	        else if (item.matches("=|<>|>=|<=|<|>")) {
	            queryBuilder.append(" ").append(item).append(" ");
	        }

	        /* ================= VALUES ================= */
	        else {

	            if (isClobObject) {
	                queryBuilder.append("'")
	                            .append(item)
	                            .append("') > 0 ");
	                isClobObject = false;
	            }

	            else if (isStringObject) {

	                String value = item.trim().toUpperCase(); // 🔥 FIX

	                if (isContains) {
	                    queryBuilder.append(" '%").append(value).append("%' ");
	                    isContains = false;
	                } else if (isNotContains) {
	                    queryBuilder.append(" '%").append(value).append("%' ");
	                    isNotContains = false;
	                } else if (isStartWith) {
	                    queryBuilder.append(" '").append(value).append("%' ");
	                    isStartWith = false;
	                } else if (isEndWith) {
	                    queryBuilder.append(" '%").append(value).append("' ");
	                    isEndWith = false;
	                } else {
	                    queryBuilder.append(" '").append(value).append("' ");
	                }

	                isStringObject = false;
	            }

	            else if (isDateObject) {

	                LocalDate localDate;

	                if (item.matches("\\d{4}/\\d{2}/\\d{2}")) {
	                    localDate =
	                            LocalDate.parse(item,
	                                    DateTimeFormatter.ofPattern("yyyy/MM/dd"));
	                } else {
	                    OffsetDateTime odt =
	                            OffsetDateTime.parse(item.replace(" ", "+"));
	                    localDate = odt.toLocalDate();
	                }

	                queryBuilder.append(" '").append(localDate).append("' ");
	                isDateObject = false;
	            }

	            else {
	                queryBuilder.append(" ").append(item).append(" ");
	            }
	        }
	    }

	    queryBuilder.append(" )");

	    return queryBuilder.toString();
	}

	public int findIndexOfKey(List<String> list, String key, int targetIndex) {
		int count = 0;
		for (int i = 0; i < list.size(); i++) {
			if (list.get(i).equals(key)) {
				if (count == targetIndex) {
					return i;
				}
				count++;
			}
		}
		return targetIndex;
	}

