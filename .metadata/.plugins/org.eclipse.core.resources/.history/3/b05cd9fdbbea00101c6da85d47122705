	private <T> T handleFilterOrSort(HsmOnlineInspectionRequestDto request, List<String> filterList,
			List<String> sortList, Integer page, Integer size, Integer skip, boolean requireTotalCount, String status,
			Integer pageStore, Integer latestGroupCount) {

		if (!requireTotalCount) {
			size = page + size;
			page = 0;
		}
	
		String query = hsmOnlineInspectionRepository.getAllPaginatedOnlCoilInString();
		String countQuery = getMainOnlineInspQueryCount(status);
		if (!filterList.isEmpty()) {
			query = filterQueryUsingFilterList(filterList, query);
			countQuery = filterQueryUsingFilterList(filterList, countQuery);
		}

		query = applySorting(sortList, query);
		Page<HsmOnlineInspCoilDto> processInsp = hsmOnlineInspectionRepository.getOnlineInsp(request, status, page,
				size, query, countQuery, skip);

		processInsp.getContent().parallelStream().forEach(onlineInspectionCoilDto -> {
			boolean isSeqValid = DownCoilerValidationUtil.checkNumber(onlineInspectionCoilDto.getSchdSeqId());
			onlineInspectionCoilDto.setInspFlag(isSeqValid ? "YES" : "");
		});

		return (T) new FluentaPaginatedResponse<>(processInsp.getContent(), processInsp.getTotalElements());
	}

	private String applySorting(List<String> sortList, String query) {
		if (!sortList.isEmpty()) {
			Map<String, String> columnAlias = checkClassAleasWithNoStop();
			if (sortList.get(3).equals("true")) {
				query += QualityConstants.ORDER_BY + columnAlias.get(sortList.get(1)) + QualityConstants.DESC;
			} else {
				query += QualityConstants.ORDER_BY + columnAlias.get(sortList.get(1));
			}
		}

		return query;
	}

