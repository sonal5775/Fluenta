			response = ResponseUtil.createResponse(dtoList, "Update Successful", false);
		}

		return response;
	}

	private List<PhysicalInspCheckListDto> buildCheckListDto(HsmOnlineInspCoilDto dto) {
		List<PhysicalInspCheckListDto> resultList = new ArrayList<>();

		List<String> attributes = List.of("Waviness", "Burs", "Circum Straps", "Stickers", "Telescopicity",
				"Eye Straps", "Surface", "Manual Marking");
		for (String atr : attributes) {
			PhysicalInspCheckListDto checkListDto = new PhysicalInspCheckListDto();
			checkListDto.setPpid(dto.getPpId());
			checkListDto.setPpctr(0);
			checkListDto.setAttribute(atr);
			PhysicalInspCheckListDto buildCheckListObject = buildCheckListObject(dto, checkListDto);
			resultList.add(buildCheckListObject);
		}
		return resultList;
	}

	private PhysicalInspCheckListDto buildCheckListObject(HsmOnlineInspCoilDto dto,
			PhysicalInspCheckListDto checkListDto) {
		switch (checkListDto.getAttribute()) {
		case "Waviness": {
			checkListDto.setInspResult(dto.getWavinessFlag());
			break;
		}
		case "Burs": {
			checkListDto.setInspResult(dto.getBursFlag());
			break;
		}
		case "Circum Straps": {
			checkListDto.setInspResult(dto.getCircumstFlag());
			break;
		}
		case "Stickers": {
			checkListDto.setInspResult(dto.getStickersFlag());
			break;
		}
		case "Telescopicity": {
			checkListDto.setInspResult(dto.getTelescopicityFlag());
			break;
		}
		case "Eye Straps": {
			checkListDto.setInspResult(dto.getEyestrapsFlag());
			break;
		}
		case "Surface": {
			checkListDto.setInspResult(dto.getSurfaceFlag());
			break;
		}
		case "Manual Marking": {
			checkListDto.setInspResult(dto.getManualmarkingFlag());
			break;
		}
		default:
		}
		return checkListDto;
	}

	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public ResponseEntity<FluentaApiResponse<OnlineDefectPostDto>> saveInspectionDefects(OnlineDefectPostDto request) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		ResponseEntity<FluentaApiResponse<OnlineDefectPostDto>> response = null;
		HsmOnlineInspCoilDto coilDto = request.getCoilDto();
		List<OnlineInspDefectDto> defectList = request.getDefectList();
		PostProdTaskMtEntity task = null;
		Optional<PostProdTaskMtEntity> taskOptional = postProdTaskMtRepository.getTasksByPpidAndPrid(
				coilDto.getPpId().trim(), QualityConstants.ONLINE_INSP, QualityConstants.INSP_FLAG_YES);
		if (taskOptional.isPresent()) {
			task = taskOptional.get();
			for (OnlineInspDefectDto dto : defectList) {
				DefectHeaderEntity headerEntity = new DefectHeaderEntity();
				DefectHeaderEntityPK headerPk = new DefectHeaderEntityPK();
				headerPk.setPrid(QualityConstants.ONLINE_INSP);
				headerPk.setDefectid(dto.getDefectid());

				Optional<DefectHeaderEntity> headerOptional = defectHeaderRepository.findById(headerPk);
				if (headerOptional.isPresent()) {
					headerEntity = headerOptional.get();
					headerEntity.setMoBy(ClientIpUtils.getClient());
					headerEntity.setMoDt(new Date());
					headerEntity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
					headerEntity.setDefectdesc(dto.getDefectdesc());
				} else {
					headerEntity.setId(headerPk);
					headerEntity.setDefectdesc(dto.getDefectdesc());
					headerEntity.setCrBy(ClientIpUtils.getClient());
					headerEntity.setCrDt(new Date());
					headerEntity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
				}
				defectHeaderRepository.save(headerEntity);

				PpInspDefectEntity inspDefectEntity = new PpInspDefectEntity();
				PpInspDefectEntityPK inspDefectEntityPK = new PpInspDefectEntityPK();
				inspDefectEntityPK.setPpid(coilDto.getPpId());
				inspDefectEntityPK.setPpctr(0);
				inspDefectEntityPK.setTaskstepid(task.getId().getTaskstepId());
				inspDefectEntityPK.setDefectctr(dto.getDefectctr());
				Optional<PpInspDefectEntity> optional = ppInspDefectRepository.findById(inspDefectEntityPK);
				if (optional.isPresent()) {
					inspDefectEntity = optional.get();
					inspDefectEntity.setMoBy(ClientIpUtils.getClient());
					inspDefectEntity.setMoDt(new Date());
					inspDefectEntity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				} else {
					long maxDefectCtr = ppInspDefectRepository.getMaxDefectCtr(coilDto.getPpId());
					inspDefectEntityPK.setDefectctr(maxDefectCtr + 1);
					inspDefectEntity.setId(inspDefectEntityPK);
					inspDefectEntity.setCrBy(ClientIpUtils.getClient());
					inspDefectEntity.setCrDt(new Date());
					inspDefectEntity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
					inspDefectEntity.setPrid(QualityConstants.ONLINE_INSP);
					inspDefectEntity.setDefectid(dto.getDefectid());

				}
				inspDefectEntity.setDefectside(dto.getDefectside());
				inspDefectEntity.setDefectpos(dto.getDefectpos());
				inspDefectEntity.setStartlen(dto.getStartlen());
				inspDefectEntity.setEndlen(dto.getEndlen());
				ppInspDefectRepository.save(inspDefectEntity);
				response = ResponseUtil.createResponse(request, "Save/Update Successful ", false);
			}
		} else {
			response = ResponseUtil.createResponse(request, "Save/Update UnSuccessful Due To Task Unavailability ",
					false);
		}

		return response;
	}

	@Override
	public <T> T getOnlineInspDetails(HsmOnlineInspectionRequestDto request, String status, int pageNumber,
			int pageSize, String filter, String sort, String group, int skip, boolean requireTotalCount,
			boolean requireGroupCount, String searchValue, Integer pageStore, Integer latestGroupCount) {

		List<String> filterList = DevExtGridFilterUtils.extractElements(filter);

		// new
		int[] pageSizeArr = processPageAndSize(pageNumber, pageSize, pageStore);
		pageNumber = pageSizeArr[0];
		pageSize = pageSizeArr[1];

		List<String> groupList = DevExtGridFilterUtils.getSortListFromString(group);

		List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);

		if (DevExtGridFilterUtils.isGroupWithoutFilterOrSort(group, filter, sort)) {
			return handleGroupOnly(request, groupList, pageNumber, pageSize, skip, status, pageStore, latestGroupCount);
		}

		if (DevExtGridFilterUtils.isGroupWithFilterOrSort(group, filter, sort)) {
			return handleGroupWithFilterOrSort(request, groupList, filterList, sortList, pageNumber, pageSize, skip,
					requireTotalCount, status, pageStore, latestGroupCount);
		}

		if (DevExtGridFilterUtils.isFilterOrSortOnly(group, filter, sort)) {
			return handleFilterOrSort(request, filterList, sortList, pageNumber, pageSize, skip, requireTotalCount,
					status, pageStore, latestGroupCount);
		}
		return null;
	}

	private int[] processPageAndSize(Integer pageNumber, Integer pageSize, Integer pageStore) {
		if (pageNumber == null) {
			pageNumber = 0;
		}
		if (pageSize == null) {
			pageSize = pageStore;
		}
		return new int[] { pageNumber, pageSize };
	}

