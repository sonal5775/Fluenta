				status);
		Page<Object[]> groupingListData = hsmOnlineInspectionRepository.getGroupingListData(queryForGrouping,
				queryForGroupingAndFilteringCount, page, size, skip, request, status);
		Long totalDistCount = hsmOnlineInspectionRepository.groupCountQuery(queryForGroupingAndFilteringCount, request,
				status);
		groupingListData.getContent().parallelStream().forEach(row -> {
			Object schdSeqObj = row[1]; // assuming schdSeqId is at index 0
			long schdSeqId = schdSeqObj != null ? (long) schdSeqObj : null;

			HsmOnlineInspCoilDto dto = new HsmOnlineInspCoilDto();
