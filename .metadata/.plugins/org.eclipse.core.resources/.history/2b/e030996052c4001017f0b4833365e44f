	private <T> T handleGroupOnly(CoilDetailsFilterRequestDto request, List<String> groupList, int pageNumber,
			int pageSize, int skip, String status, Integer pageStore, Integer latestGroupCount) {
		LOGGER.info("status : {} ", status);
		LOGGER.info("pageStore : {} ", pageStore);
		LOGGER.info("latestGroupCount : {} ", latestGroupCount);

		pageSize = pageNumber + pageSize;
		pageNumber = 0;
		String groupQuery = getQueryForGrouping(groupList);
		String groupCountQuery = getQueryForGroupingCount(groupList);
		String mainCountQuery = getMainCoildetailsQueryCount();
		Long mainQueryCount = coilDetailsCustRepository.getMainCoildetailsQueryCount(request, mainCountQuery);

		Page<Object[]> groupingListData = coilDetailsCustRepository.getGroupingListData(groupQuery, groupCountQuery,
				pageNumber, pageSize, skip, request);
		Long totalDistCount = coilDetailsCustRepository.groupCountQuery(groupCountQuery, request);

		return buildGroupedDataResponse(groupingListData, mainQueryCount, totalDistCount);
	}

	private String getQueryForGroupingCount(List<String> groupList) {
		String groupColumn = groupList.get(1); // Assuming the second element is the group column
		StringBuilder query = new StringBuilder();
		query.append(OfsConstants.SELECT + "  ").append("COUNT( DISTINCT ").append(checkClassAleas().get(groupColumn))
				.append(")").append(CoilDetailsCustRepository.COIL_DETAILS_GENERATE_REPORT_QUERY_CONDITION)
				.append(CoilDetailsCustRepository.COIL_DETAILS_GENERATE_REPORT_QUERY_WHERE_CONDITION);
		return query.toString();
	}

	private String getQueryForGrouping(List<String> groupList) {
		if (groupList == null || groupList.isEmpty()) {
			throw new IllegalArgumentException("groupList cannot be null or empty");
		}

		String desc = groupList.get(3);
		String groupColumn = groupList.get(1);
		StringBuilder query = new StringBuilder();
		query.append(OfsConstants.SELECT + " ").append(checkClassAleas().get(groupColumn)).append(" ,COUNT(*")
				.append(")").append(CoilDetailsCustRepository.COIL_DETAILS_GENERATE_REPORT_QUERY_CONDITION)
				.append(CoilDetailsCustRepository.COIL_DETAILS_GENERATE_REPORT_QUERY_WHERE_CONDITION);
		query.append(" " + OfsConstants.GROUP_BY + " " + checkClassAleas().get(groupColumn));

		if ("true".equals(desc)) {
			query.append(" " + OfsConstants.ORDER_BY + " ").append(checkClassAleas().get(groupColumn))
					.append(" " + OfsConstants.DESC + " ");
		} else {
			query.append(" " + OfsConstants.ORDER_BY + " ").append(checkClassAleas().get(groupColumn));
		}
		return query.toString();
	}

	@SuppressWarnings("unchecked")
	private <T> T buildGroupedDataResponse(Page<Object[]> groupingListData, Long mainQueryCount, Long totalDistCount) {
		GroupedDataResponse<CoilDetailsDto> result = new GroupedDataResponse<>(null, 0L, 0L);
		List<Group<CoilDetailsDto>> list = new ArrayList<>();

		for (Object[] row : groupingListData) {
			String groupKey = row[0] instanceof BigDecimal ? ((BigDecimal) row[0]).toPlainString()
					: String.valueOf(row[0]);
			Long count = row[1] instanceof BigDecimal ? ((BigDecimal) row[1]).longValue() : (Long) row[1];
			list.add(new Group<>(groupKey, null, count));
		}

		result.setData(list);
		result.setTotalCount(mainQueryCount);
		result.setGroupCount(totalDistCount);
		return (T) result;
	}

	private <T> T handleGroupWithFilterOrSort(CoilDetailsFilterRequestDto request, List<String> groupList,
			List<String> filterList, List<String> sortList, Integer page, Integer size, Integer skip,
			boolean requireTotalCount, Integer pageStore, Integer latestGroupCounts) {
		if (requireTotalCount && size == null) {
			size = pageStore;
		} else {
			size = page + size;
			page = 0;
		}

		String queryForGrouping = getCoilDetailsQueryForGroupingAndFiltering(groupList, filterList);
		String queryForGroupingAndFilteringCount = getCoilDetailsQueryForGroupingAndFilteringCount(groupList,
				filterList, sortList);
		String mainCountQuery = getMainCoildetailsQueryCount();
		Long mainQueryCount = coilDetailsCustRepository.getMainCoildetailsQueryCount(request, mainCountQuery);
		Page<Object[]> groupingListData = coilDetailsCustRepository.getGroupingListData(queryForGrouping,
				queryForGroupingAndFilteringCount, page, size, skip, request);
		Long totalDistCount = coilDetailsCustRepository.groupCountQuery(queryForGroupingAndFilteringCount, request);
		return buildGroupedDataResponse(groupingListData, mainQueryCount,
				(totalDistCount != null && totalDistCount != 0) ? totalDistCount : latestGroupCounts);
	}

