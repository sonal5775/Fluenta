	@Override
	public List<Object> getCoilDetailsByAllDatafields(ReportRequestDto request) {
		List<GroupedColumnDto> groupedDtoList = request.getGroupedDto();
		List<FeatureDto> featuredDtoList = request.getFeaturedDto();

		StringBuilder queryBuilder = new StringBuilder(OfsConstants.SELECT + " ");

		groupedDtoList.forEach(groupedDto -> {
			String dataField = getRealName(groupedDto.getDatafield());
			queryBuilder.append(dataField).append(", ");
		});
		for (FeatureDto featureDto : featuredDtoList) {
			String dataField = getRealName(featureDto.getDatafield());

			if (OfsConstants.AVERAGE.equalsIgnoreCase(featureDto.getFeature())) {
				queryBuilder.append("AVG").append("(").append(dataField).append(")");
			} else {
				queryBuilder.append(featureDto.getFeature().toUpperCase()).append("(").append(dataField).append(")");
			}
			if (!featuredDtoList.get(featuredDtoList.size() - 1).getDatafield()
					.equalsIgnoreCase(featureDto.getDatafield())) {
				queryBuilder.append(",");
			}

		}

		queryBuilder.append(OfsConstants.COIL_DETAILS_GENERATE_REPORT_DYNAMIC_QUERY_FROM_CLAUSE);
		if (!groupedDtoList.isEmpty()) {
			queryBuilder.append(" " + OfsConstants.GROUP_BY + " ");
			groupedDtoList.forEach(groupedDto -> {
				String dataField = getRealName(groupedDto.getDatafield());
				queryBuilder.append(dataField);
				if (!groupedDtoList.get(groupedDtoList.size() - 1).getDatafield()
						.equalsIgnoreCase(groupedDto.getDatafield())) {
					queryBuilder.append(", ");
				}

			});

		}

		// Add ORDER BY clause here
		queryBuilder.append(" ORDER BY ");
		if (!groupedDtoList.isEmpty()) {
			String orderByField = getRealName(groupedDtoList.get(0).getDatafield());
			queryBuilder.append(orderByField).append(" DESC");
		}

		String sqlQuery1 = queryBuilder.toString();
		return coilDetailsCustRepository.getCoilDetailsByAllDatafields(sqlQuery1);
	}

	public String getRealName(String alias) {
		Map<String, String> fieldTypes = checkClassAleas();
		return fieldTypes.getOrDefault(alias.trim(), "Alias not found");
	}

	public boolean isNumber(String str) {
		return str.matches("^[+-]?\\d*(\\.\\d+)?([eE][+-]?\\d+)?$");
	}

