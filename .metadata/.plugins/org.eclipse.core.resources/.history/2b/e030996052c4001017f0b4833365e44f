	@Override
	public <T> T getCoilDetails(CoilDetailsFilterRequestDto request, String status, int pageNumber, int pageSize,
			String filter, String sort, String group, int skip, boolean requireTotalCount, boolean requireGroupCount,
			String searchValue, Integer pageStore, Integer latestGroupCount) {
		LOGGER.info("Inside CoilDetailsServiceImp :: getCoilDetails: {}", request);

		List<String> filterList = DevExtGridFilterUtils.extractElements(filter);
		for (String string : filterList) {
			if (string.equalsIgnoreCase(OfsConstants.SHIFT_ID)) { // Case insensitive comparison
				int index = filterList.indexOf(string);
				String shiftValue = filterList.get(index + 2).toUpperCase(); // Normalize to uppercase
				switch (shiftValue) {
				case OfsConstants.A: // Matches uppercase "A"
					filterList.set(index + 2, OfsConstants.M);
					break;
				case OfsConstants.B: // Matches uppercase "B"
					filterList.set(index + 2, OfsConstants.A);
					break;
				case OfsConstants.C: // Matches uppercase "C"
					filterList.set(index + 2, OfsConstants.N);
					break;
				}
			}
		}
		int[] pageSizeArr = processPageAndSize(pageNumber, pageSize, pageStore);
		pageNumber = pageSizeArr[0];
		pageSize = pageSizeArr[1];

		List<String> groupList = DevExtGridFilterUtils.getSortListFromString(group);

		List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);

		if (DevExtGridFilterUtils.isGroupWithoutFilterOrSort(group, filter, sort)) {
			LOGGER.info("isGroupWithoutFilterOrSort---- : {} ", request);
			return handleGroupOnly(request, groupList, pageNumber, pageSize, skip, status, pageStore, latestGroupCount);
		}

		if (DevExtGridFilterUtils.isGroupWithFilterOrSort(group, filter, sort)) {
			LOGGER.info("isGroupWithFilterOrSort---- : {} ", request);
			return handleGroupWithFilterOrSort(request, groupList, filterList, sortList, pageNumber, pageSize, skip,
					requireTotalCount, pageStore, latestGroupCount);
		}

		if (DevExtGridFilterUtils.isFilterOrSortOnly(group, filter, sort)) {
			LOGGER.info("isFilterOrSortOnly -----: {} ", request);
			return handleFilterOrSort(request, filterList, sortList, pageNumber, pageSize, skip, requireTotalCount,
					pageStore, latestGroupCount);
		}

		return null;
	}

	@SuppressWarnings("unchecked")
	private <T> T handleFilterOrSort(CoilDetailsFilterRequestDto request, List<String> filterList,
			List<String> sortList, Integer page, Integer size, Integer skip, boolean requireTotalCount,
			Integer pageStore, Integer latestGroupCount) {

		if (!requireTotalCount) {
			size = page + size;
			page = 0;
		}

		String query = getMainCoilDetailsQuery();
		String countQuery = getMainCoildetailsQueryCount();
		LOGGER.info("query  handleFilterOrSort : ---------{} ", query);
		LOGGER.info("countQuery  handleFilterOrSort: -----{} ", countQuery);
		if (!filterList.isEmpty()) {
			query = filterQueryUsingFilterList(filterList, query);
			countQuery = filterQueryUsingFilterList(filterList, countQuery);
		}

		query = applySorting(sortList, query);
		LOGGER.info("query  handleFilterOrSort111 : ---------{} ", query);
		
		Page<CoilDetailsDto> paginatedResult = coilDetailsCustRepository.getCoilDetails(request, page, size, query,
				countQuery, skip);
		LOGGER.info(" handleFilterOrSort paginatedResult : ---------{} ", paginatedResult);
	
		List<CoilDetailsDto> processedContent = paginatedResult.getContent().stream().peek(dto -> {
			coilDetailsChemcialElements(dto);
		}).collect(Collectors.toList());
		return (T) new FluentaPaginatedResponse<>(processedContent, paginatedResult.getTotalElements());
	}

	private String applySorting(List<String> sortList, String query) {
		if (!sortList.isEmpty()) {
			Map<String, String> columnAlias = checkClassAleasWithNoStop();
			if (sortList.get(3).equals("true")) {
				query += OfsConstants.ORDER_BY + columnAlias.get(sortList.get(1)) + " " + OfsConstants.DESC + " ";
			} else {
				query += OfsConstants.ORDER_BY + columnAlias.get(sortList.get(1));
			}
		} else {
			query += " " + OfsConstants.ORDER_BY + " ph.prodDt " + OfsConstants.DESC + " ";
		}
		return query;
	}

