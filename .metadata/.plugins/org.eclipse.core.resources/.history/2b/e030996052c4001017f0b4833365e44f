	private void coilDetailsChemcialElements(CoilDetailsDto dto) {
		LOGGER.info(" handleFilterOrSort paginatedResult coilDetailsChemcialElements : ---------{} ", dto);
		if (dto.getSampleId() != null) {
			Optional<SpecimenQualityTransactionEntity> chemData = specimenQualityTransactionRepository
					.getDetailsBySampleIdAndTestMethod(dto.getSampleId().trim(), OfsConstants.SPECTRO_TEST);
			if (chemData.isPresent()) {
				SpecimenQualityTransactionEntity chemSpecimen = chemData.get();
				LOGGER.info(" handleFilterOrSort chemData specimen : ---------{} ", chemSpecimen);
				List<ChemrsltQt> chemistry = chemrsltRepository.findBySpecimenId(chemSpecimen.getSpecimenId());
				LOGGER.info(" handleFilterOrSort paginatedResult chemistry : ---------{} ", chemistry);
				for (ChemrsltQt chem : chemistry) {
					setElements(dto, chem, null);
				}
			} else {
				LOGGER.info(" handleFilterOrSort ladleChemistry else coilid   : --------- ",dto.getSlabid());
				List<PpChemEntity> ladleChemistry = ppChemRepository.findAllByPpid(dto.getSlabid());
				LOGGER.info(" handleFilterOrSort ladleChemistry else  dto : ---------{} ", ladleChemistry);
				for (PpChemEntity chem : ladleChemistry) {
					setElements(dto, null, chem);
				}
			}
		}
	}

	public String filterQueryUsingFilterList(List<String> filterList, String query) {
		StringBuilder queryBuilder = new StringBuilder(query);
		queryBuilder.append(" AND (");

		List<String> columnNames = DevExtGridFilterUtils.getAllFields(CoilDetailsDto.class);
		IntStream.range(0, filterList.size()).filter(i -> OfsConstants.SHIFT_ID.equals(filterList.get(i)))
				.forEach(i -> {
					int findIndex = i + 2; // Locate the index for the replacement
					if (findIndex < filterList.size()) { // Ensure index is within bounds
						String forSearch = filterList.get(findIndex);
						String updatedValue = switch (forSearch) {
						case OfsConstants.A -> OfsConstants.M;
						case OfsConstants.B -> OfsConstants.A;
						case OfsConstants.C -> OfsConstants.N;
						default -> forSearch; // No change for other values
						};
						filterList.set(findIndex, updatedValue);
					}
				});

		Map<String, String> columnDataTypesKeyValuePair = DevExtGridFilterUtils
				.getAllFieldsWithTypes(CoilDetailsDto.class);
		Map<String, String> columnAlise = checkClassAleas();
		boolean isClobObject = false;
		boolean isStringObject = false;
		boolean isDateObject = false;
		boolean isContains = false;
		boolean isNotContains = false;
		boolean isStartWith = false;
		boolean isEndWith = false;

		for (int i = 0; i < filterList.size(); i++) {
			String item = filterList.get(i);
			if (columnNames.contains(item)) {
				if ("CLOB".equals(columnDataTypesKeyValuePair.get(item))) {
					queryBuilder.append("DBMS_LOB.INSTR(").append(columnAlise.get(item)).append(",");
					isClobObject = true;
				} else if ("DATE".equals(columnDataTypesKeyValuePair.get(item))) {
					queryBuilder.append(" TO_CHAR(").append(columnAlise.get(item)).append(", 'YYYY-MM-DD')");
					isDateObject = true;
				} else if ("VARCHAR2".equals(columnDataTypesKeyValuePair.get(item))) {
					queryBuilder.append(columnAlise.get(item));
					isStringObject = true;
				} else {
					queryBuilder.append(columnAlise.get(item));
				}
			} else if (DevExtremePaginationConstant.CONTAINS.equals(item)
					|| DevExtremePaginationConstant.NOTCONTAINS.equals(item)
					|| DevExtremePaginationConstant.STARTSWITH.equals(item)
					|| DevExtremePaginationConstant.ENDSWITH.equals(item)) {
				if (isClobObject) {
					// Logic for CLOB objects (if any)
				} else if (isDateObject) {
					queryBuilder.append(DevExtremePaginationConstant.LIKE);
				} else {
					if (DevExtremePaginationConstant.CONTAINS.equals(item)) {
						queryBuilder.append(DevExtremePaginationConstant.LIKE);
						isContains = true;
					} else if (DevExtremePaginationConstant.NOTCONTAINS.equals(item)) {
						queryBuilder.append(DevExtremePaginationConstant.NOT_LIKE);
						isNotContains = true;
					} else if (DevExtremePaginationConstant.STARTSWITH.equals(item)) {
						queryBuilder.append(DevExtremePaginationConstant.LIKE);
						isStartWith = true;
					} else if (DevExtremePaginationConstant.ENDSWITH.equals(item)) {
						queryBuilder.append(DevExtremePaginationConstant.LIKE);
						isEndWith = true;
					} else {
						queryBuilder.append(" = ");
					}
				}
			} else if ("or".equals(item) || "and".equals(item)) {
				queryBuilder.append(" ").append(item).append(" ");
			} else if ("=".equals(item) || "<>".equals(item) || ">=".equals(item) || "<".equals(item)
					|| ">".equals(item)) {
				queryBuilder.append(" ").append(item);
			} else {
				if (isClobObject) {
					queryBuilder.append("'").append(item).append("') > 0");
					isClobObject = false;
				} else if (isStringObject) {
					if (isContains) {
						queryBuilder.append(" '%").append(item).append("%'");
						isContains = false;
					} else if (isNotContains) {
						queryBuilder.append(" '%").append(item).append("%'");
						isNotContains = false;
					} else if (isStartWith) {
						queryBuilder.append(" '").append(item).append("%'");
						isStartWith = false;
					} else if (isEndWith) {
						queryBuilder.append(" '%").append(item).append("'");
						isEndWith = false;
					} else {
						queryBuilder.append(" '").append(item).append("'");
					}
					isStringObject = false;
				} else if (isDateObject) {
					DateTimeFormatter formatter = DateTimeFormatter.ISO_OFFSET_DATE_TIME;
					OffsetDateTime dateTime = OffsetDateTime.parse(item, formatter);
					String dateOnly = dateTime.toLocalDate().toString();
					queryBuilder.append(" '").append(dateOnly).append("'");
					isDateObject = false;
				} else {
					queryBuilder.append(" ").append(item);
				}
			}
		}

		queryBuilder.append(")");

		return queryBuilder.toString();
	}

	public String processSqlQuery(String sql) {
		if (sql.trim().endsWith("or")) {
			sql = sql.substring(0, sql.length() - 2);
			sql = sql.trim().substring(0, sql.length() - 2).trim();
		} else if (sql.trim().endsWith(" or")) {
			sql = sql.substring(0, sql.length() - 2);
			sql = sql.trim().substring(0, sql.length() - 3).trim();
		}

		sql = sql.replaceAll("h\\.isactv\\s*=\\s*'Active'", "h.isactv = 1");

		sql = sql.replaceAll("h\\.isactv\\s*=\\s*'Inactive'", "h.isactv = 0");

		return sql;
	}

