	@SuppressWarnings("unchecked")
	@Override
	public Page<CoilDetailsDto> getCoilDetails(CoilDetailsFilterRequestDto request, int page, int size, String filter,
			String sort) {

		List<String> filterList = DevExtGridFilterUtils.extractElements(filter);
		List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);
		filterlistCoilDetailsData(filterList);
		String q = coilDetailsCustRepository.getAllPaginatedCoilDetailsReportInString();
		String countQuery = coilDetailsCustRepository.getAllPaginatedCoilDetailsReportInStringForCount();

		if (!filterList.isEmpty()) {
			q = filterQueryUsingFilterList(filterList, q);
			countQuery = filterQueryUsingFilterList(filterList, countQuery);

			q = processSqlQuery(q);
			countQuery = processSqlQuery(countQuery);
		}

		Map<String, String> columnAlise = checkClassAleasWithNoStop();
		if (!sortList.isEmpty()) {
			if (sortList.get(3).equals("true")) {
				q = q + DevExtremePaginationConstant.ORDER_BY + columnAlise.get(sortList.get(1)) + " "
						+ OfsConstants.DESC + " ";
			} else {
				q = q + DevExtremePaginationConstant.ORDER_BY + columnAlise.get(sortList.get(1));
			}
		}

		Page<CoilDetailsDto> paginatedResult = coilDetailsCustRepository.getCoilDetails(request, page, size, q,
				countQuery);

		List<CoilDetailsDto> processedContent = paginatedResult.getContent().stream().peek(dto -> {
			coilDetailsChemcialElements(dto);
		}).collect(Collectors.toList());

		return new PageImpl<>(processedContent, paginatedResult.getPageable(), paginatedResult.getTotalElements());
	}

	private void filterlistCoilDetailsData(List<String> filterList) {
		if (!filterList.isEmpty()) {

			String conditionForFiled = null;
			String valueForSearch = null;
			boolean isSalesOrderNo = false;
			for (String s : filterList) {
				if (s.equals(OfsConstants.SOID)) {
					int indexOfField = filterList.indexOf(OfsConstants.SOID);
					conditionForFiled = filterList.get(indexOfField + 1);
					valueForSearch = filterList.get(indexOfField + 2);
					String tempStringValue = null;
					if (valueForSearch.contains("-")) {
						String[] arr = valueForSearch.split("-");
						tempStringValue = arr[0];
					} else {
						tempStringValue = valueForSearch;
					}

					filterList.set(indexOfField, OfsConstants.ORDERITEML_ID);
					filterList.set(indexOfField + 2, tempStringValue);
					isSalesOrderNo = true;
				}
			}

			salesOrderData(filterList, valueForSearch, isSalesOrderNo);
		}
	}

	private void salesOrderData(List<String> filterList, String valueForSearch, boolean isSalesOrderNo) {
		if (isSalesOrderNo) {
			String tempStringValue = null;
			if (valueForSearch.contains("-")) {
				String[] arr = valueForSearch.split("-");
				tempStringValue = arr[1];
			} else {
				tempStringValue = valueForSearch;
			}
			filterList.add(" or ");
			filterList.add(OfsConstants.ORDERITEMLIST_ID);
			filterList.add("=");
			if (isNumber(tempStringValue)) {
				filterList.add(tempStringValue);
			} else {
				filterList.add("0");
			}
		}
	}

