	private <T> T handleGroupOnly(MaterialReInspectionRequest request, List<String> groupList, int pageNumber,
			int pageSize, int skip) {
		pageSize = pageNumber + pageSize;
		pageNumber = 0;
		
		String groupQuery = getQueryForGrouping(groupList);
	    String groupCountQuery = getQueryForGroupingCount(groupList);
		String mainCountQuery = getMainSlabeStockQueryCount();
		Long mainQueryCount = repository.getMainQueryCount(request,mainCountQuery);
	    Page<Object[]> groupingListData = repository.getGroupingListData(groupQuery, groupCountQuery,pageNumber,pageSize, skip,request);
		Long totalDistCount = repository.groupCountQuery(groupCountQuery,request);
		
		return buildGroupedDataResponse(groupingListData, mainQueryCount, totalDistCount);
	}

	private String getQueryForGrouping(List<String> groupList) {
		if (groupList == null || groupList.isEmpty()) {
	        throw new IllegalArgumentException("groupList cannot be null or empty");
	    }
		
		String desc = groupList.get(3);
	    String groupColumn = groupList.get(1); 
	    
	     StringBuilder query = new StringBuilder();

	     query.append("SELECT ")
	    .append(checkClassAleas().get(groupColumn))
		.append(groupColumn)	
		.append(" ,COUNT(*")
		.append(")")
		.append(OfsStatusConstants.WHERECONDITION);
	    
	    query.append(" GROUP BY "+checkClassAleas().get(groupColumn)+""+groupColumn+" ");
	    
	    if ("true".equals(desc)) {
	    	query.append(" ORDER BY ").append(checkClassAleas().get(groupColumn)).append(groupColumn).append(" DESC");
		} else {
			query.append(" ORDER BY ").append(checkClassAleas().get(groupColumn)).append(groupColumn);
		}
		return query.toString();
	}

	private String getQueryForGroupingCount(List<String> groupList) {
		String groupColumn = groupList.get(1);
		StringBuilder query = new StringBuilder();
		
		 query.append("SELECT ")
		    .append("COUNT( DISTINCT ")
			.append(checkClassAleas().get(groupColumn))
			.append(groupColumn)
			.append(")")
			.append(OfsStatusConstants.WHERECONDITION);
		return query.toString();
	}
	
	private String getMainSlabeStockQueryCount() {
		   StringBuilder query = new StringBuilder();

		     query.append("SELECT COUNT(distinct pp.id.ppid)")
		          .append(OfsStatusConstants.WHERECONDITION);
		return query.toString();
	}
	
	@SuppressWarnings("unchecked")
	private <T> T buildGroupedDataResponse(Page<Object[]> groupingListData, Long mainQueryCount, Long totalDistCount) {
	    GroupedDataResponse<MaterialReInspectionDto> result = new GroupedDataResponse<>(null, 0L, 0L);
	    List<Group<MaterialReInspectionDto>> list = new ArrayList<>();

	    for (Object[] row : groupingListData) {
	        String groupKey = row[0] instanceof BigDecimal
	                ? ((BigDecimal) row[0]).toPlainString()
	                : String.valueOf(row[0]);
	        Long count = row[1] instanceof BigDecimal
	                ? ((BigDecimal) row[1]).longValue()
	                : (Long) row[1];
	        list.add(new Group<>(groupKey, null, count));
	    }

	    result.setData(list);
	    result.setTotalCount(mainQueryCount);
	    result.setGroupCount(totalDistCount);
	    return (T) result;
	}
	
	private <T> T handleGroupWithFilterOrSort(MaterialReInspectionRequest request, List<String> groupList,
			List<String> filterList, List<String> sortList, Integer page, Integer size, Integer skip,
			boolean requireTotalCount,String status,Integer pageStore, Integer latestGroupCounts) {
		if (requireTotalCount && size == null) {
			size = pageStore;
		} else {
			size = page + size;
			page = 0;
		}

		String queryForGrouping = getSlabeStockQueryForGroupingAndFiltering(groupList, filterList,status);
		String queryForGroupingAndFilteringCount = getSlabeStockQueryForGroupingAndFilteringCount(groupList, filterList,sortList,status);
		String mainCountQuery = repository.countMainQuery;
		Long mainQueryCount = repository.getMainSlabeStockQueryCount(request,mainCountQuery,status);
		Page<Object[]> groupingListData = repository.getGroupingListData(queryForGrouping,queryForGroupingAndFilteringCount, page, size, skip,request,status);
		Long totalDistCount = repository.groupCountQuery(queryForGroupingAndFilteringCount,request,status);
		
	
		return buildGroupedDataResponse(groupingListData, mainQueryCount, (totalDistCount != null && totalDistCount != 0) ? totalDistCount : latestGroupCounts);
	}
	
