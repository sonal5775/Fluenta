	private int[] processPageAndSize(Integer pageNumber, Integer pageSize, Integer pageStore) {
		if (pageNumber == null) {
			pageNumber = 0;
		}
		if (pageSize == null) {
			pageSize = pageStore;
		}
		return new int[] { pageNumber, pageSize };
	}
	
	
	@SuppressWarnings("unchecked")
	private <T> T handleFilterOrSort(MaterialReInspectionRequest request, List<String> filterList, List<String> sortList,
			Integer page, Integer size, Integer skip, boolean requireTotalCount, String status, Integer pageStore,
			Integer latestGroupCount) {
		if (!requireTotalCount) {
			size = page + size;
			page = 0;
		}

		String query = repository.mainQuery ;
		String countQuery = repository.countMainQuery;
		

		if (!filterList.isEmpty()) {
			query = filterQueryUsingFilterList(filterList, query);
			countQuery = filterQueryUsingFilterList(filterList, countQuery);
		}

		query = applySorting(sortList, query);
		if (!filterList.isEmpty()) {
	        countQuery = (filterQueryUsingFilterList(filterList, countQuery.toString()));
	        countQuery = (processSqlQuery(countQuery.toString()));
	    }
		Page<MaterialReInspectionDto> slabeStock = repository.getSlabStocks(request, status, page, size,
				query, countQuery, skip);
		for(MaterialReInspectionDto dto: slabeStock) {
	        dto.setExtGrade(getExternalGrade(dto.getEqSpec(), dto.getEqSpecGroup(), dto.getEqSpecSubGroup()));
        }
		
		return (T) new FluentaPaginatedResponse<>(slabeStock.getContent(), slabeStock.getTotalElements());
	}
	
	

	public String filterQueryUsingFilterList(List<String> filterList, String query) {
		StringBuilder queryBuilder = new StringBuilder(query);
		queryBuilder.append(" AND (");

		List<String> columnNames = DevExtGridFilterUtils.getAllFields(MaterialReInspectionDto.class);

		Map<String, String> columnDataTypesKeyValuePair = DevExtGridFilterUtils
				.getAllFieldsWithTypes(MaterialReInspectionDto.class);
		Map<String, String> columnAlise = checkClassAleas();
		boolean isClobObject = false;
		boolean isStringObject = false;
		boolean isDateObject = false;
		boolean isContains = false;
		boolean isNotContains = false;
		boolean isStartWith = false;
		boolean isEndWith = false;
		boolean isNullCheck = false;

		for (int i = 0; i < filterList.size(); i++) {
			String item = filterList.get(i);
			if (columnNames.contains(item)) {
				if (columnDataTypesKeyValuePair.get(item).equals("CLOB")) {
					queryBuilder.append("DBMS_LOB.INSTR(").append(columnAlise.get(item)).append(item).append(",");
					isClobObject = true;
				} else if (columnDataTypesKeyValuePair.get(item).equals("DATE")) {
					queryBuilder.append(" TO_CHAR(").append(columnAlise.get(item)).append(item)
							.append(", 'YYYY-MM-DD')");
					isDateObject = true;
				} else if (columnDataTypesKeyValuePair.get(item).equals("VARCHAR2")) {

					queryBuilder.append(columnAlise.get(item)).append(item);
					int columnIndex = findIndexOfKey(filterList, item, i);

					if ("null".equals(filterList.get(columnIndex + 2))) {

						isNullCheck = true;
					}
					isStringObject = true;
				} else {
				 if(item.equals("reInspCtr")) {
						int ind = filterList.indexOf(item);
						queryBuilder.append(" ( (SELECT COUNT(*) FROM PostProdTaskMtEntity pppost WHERE pppost.id.ppId = pp.id.ppid AND pppost.id.ppCtr = pp.id.ppctr AND pppost.taskSource = 'REINSPECTION') = ").append(filterList.get(ind+2)).append(" ) ");
						i+=2;
					}
				
					else
					queryBuilder.append(columnAlise.get(item)).append(item);

				}

			} else if (isNullCheck) {
				queryBuilder.append(" IS NULL ");
				i = i + 1;
				isNullCheck = false;
				isStringObject = false;

			} else if (item.equals(OfsConstants.CONTAINS) || item.equals(OfsConstants.NOTCONTAINS)
					|| item.equals(OfsConstants.STARTSWITH) || item.equals(OfsConstants.ENDSWITH)) {
				if (isClobObject) {
				} else if (isDateObject) {
					queryBuilder.append(OfsConstants.LIKE);
				} else {
					if (item.equals(OfsConstants.CONTAINS)) {
						queryBuilder.append(OfsConstants.LIKE);
						isContains = true;
					} else if (item.equals(OfsConstants.NOTCONTAINS)) {
						queryBuilder.append(OfsConstants.NOT_LIKE);
						isNotContains = true;
					} else if (item.equals(OfsConstants.STARTSWITH)) {
						queryBuilder.append(OfsConstants.LIKE);
						isStartWith = true;
					} else if (item.equals(OfsConstants.ENDSWITH)) {
						queryBuilder.append(OfsConstants.LIKE);
						isEndWith = true;
					} else {
						queryBuilder.append(" = ");
					}
				}
			} else if (item.equals("or") || item.equals("and")) {
				queryBuilder.append(" ").append(item).append(" ");
			} else if (item.equals("=") || item.equals("<>") || item.equals(">=") || item.equals("<")
					|| item.equals(">")) {
				queryBuilder.append(" ").append(item);
			} else {
				if (isClobObject) {
					queryBuilder.append("'").append(item).append("') > 0");
					isClobObject = false;
				} else if (isStringObject) {
					if (isContains) {
						queryBuilder.append(" '%").append(item.trim().toUpperCase()).append("%'");
						isContains = false;
					} else if (isNotContains) {
						queryBuilder.append(" '%").append(item.trim().toUpperCase()).append("%'");
						isNotContains = false;
					} else if (isStartWith) {
						queryBuilder.append(" '").append(item.trim().toUpperCase()).append("%'");
						isStartWith = false;
					} else if (isEndWith) {
						queryBuilder.append(" '%").append(item.trim().toUpperCase()).append("'");
						isEndWith = false;
					} else {
						queryBuilder.append(" '").append(item.trim().toUpperCase()).append("'");
					}
					isStringObject = false;
				} else if (isDateObject) {
					DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy/MM/dd HH:mm:ss");
					LocalDateTime dateTime = LocalDateTime.parse(item, formatter);
					String dateOnly = dateTime.toLocalDate().toString();
					queryBuilder.append(" '").append(dateOnly).append("'");
					isDateObject = false;
				} else {
					queryBuilder.append(" ").append(item);
				}
			}
		}
		queryBuilder.append(" )");

		return queryBuilder.toString();
	}
	
	
	private String applySorting(List<String> sortList, String query) {
		if (!sortList.isEmpty()) {
			Map<String, String> columnAlias = checkClassAleasWithNoStop();
			if (sortList.get(3).equals("true")) {
				query += OfsConstants.ORDER_BY + columnAlias.get(sortList.get(1))+ sortList.get(1)+ " DESC";
			} else {
				query += OfsConstants.ORDER_BY + columnAlias.get(sortList.get(1))+sortList.get(1);
			}
		} else {
			query += " ORDER BY pp.prodDt DESC  ";
		}
		return query;
	}
	
	
	public int findIndexOfKey(List<String> list, String key, int targetIndex) {
		int count = 0;
		for (int i = 0; i < list.size(); i++) {
			if (list.get(i).equals(key)) {
				if (count == targetIndex) {
					return i; // Return the index of the nth occurrence of the key
				}
				count++;
			}
		}
		return targetIndex; // If the targetIndex doesn't match an occurrence, return targetIndex itself
	}
	
