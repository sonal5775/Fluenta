		materialReInspectionStatusDto.setCount(count != null ? count : 0);
		materialReInspectionStatusDto.setColor("");
		materialReInspectionStatusDto.setWgt(wgt);
		resultList.add(materialReInspectionStatusDto);
	}
	@Override
	@Transactional
	public FluentaApiResponse<String> saveReInspectionData(List<MaterialReInspectionDto> list) {
		FluentaApiResponse<String> response = new FluentaApiResponse<>();

		try {
			dbSessionService.setSessionInfo(this.getClass().getName());

			for (MaterialReInspectionDto item : list) {
				PphMt pphMt = new PphMt();
				PphMtPK id = new PphMtPK();
				id.setPpid(item.getPpid());
				id.setPpctr(item.getPpctr());
				pphMt.setId(id);

				Optional<PphMt> obj = pphMtRepository.findById(id);
				if (obj.isPresent()) {
					PphMt existingObj = obj.get();
					existingObj.setPpsts(OfsConstants.HOLD);
					pphMtRepository.save(existingObj);
					if (UtilityConstants.HRCOIL.equals(existingObj.getPrdid())) {
						repository.createPostProdTaskForReInspectionForHrCoil(existingObj);//TO DO AFTER QUALITY COMPLETION
					} else if (UtilityConstants.SLAB.equals(existingObj.getPrdid())) {
						repository.createPostProdTaskForReInspectionForSlab(existingObj);
					}

				}
			}

			response.setStatus(FluentaApiResponse.Status.SUCCESS);
			response.addMessage(MessageType.INFO, OfsConstants.RE_INSPECTION_SUCCESSFULLY);

		} catch (Exception e) {
			response.setStatus(FluentaApiResponse.Status.FAILURE);
			response.addMessage(MessageType.ERROR, OfsConstants.RE_INSPECTION_FAILD + ": " + e.getMessage());
			LOGGER.error(OfsConstants.RE_INSPECTION_FAILD, e);
		}

		return response;
	}
	

