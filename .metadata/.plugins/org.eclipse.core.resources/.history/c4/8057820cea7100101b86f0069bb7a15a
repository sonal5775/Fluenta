	@Override
	public <T> T getSlabStocks(MaterialReInspectionRequest slabStockRequest, String status, int pageNumber, int pageSize,
			String filter, String sort, String group, int skip, boolean requireTotalCount, boolean requireGroupCount,
			String searchValue, Integer pageStore, Integer latestGroupCount) {
		

		
		List<String> filterList = DevExtGridFilterUtils.extractElements(filter);

