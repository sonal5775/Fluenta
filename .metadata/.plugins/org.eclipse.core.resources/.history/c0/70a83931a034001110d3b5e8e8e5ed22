	/**
	 * This method updates sales enquiry status data
	 * 
	 * @author Pinaki Samal
	 * @param request - sales enquiry data
	 */
	@Override
	@Transactional(rollbackFor = Exception.class)
	public SalesEnquiryDto updateSalesEnquiryStatus(SalesEnquiryDto dto) {
		LOGGER.info("Inside SalesEnquiryServiceImpl:: updateSalesEnquiryStatus ");

		 dbSessionService.setSessionInfo(this.getClass().getName());
		if (dto.getSeid() != null && !dto.getSeid().trim().isEmpty()) {
			Optional<SehStEntity> sehStRepo = sehStJpaRepository.findById(dto.getSeid().trim());
			SehStEntity entity = null;

			if (sehStRepo.isPresent()) {
				entity = sehStRepo.get();
				entity.setMoDt(new Date());
				entity.setMoBy(ClientIpUtils.getClient());
				entity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				entity.setSests(dto.getSests());
				if(OfsStatusConstants.REQUESTED.equals(dto.getSests())) {
					entity.setTdcreqdt(new Date());
				}
				sehStJpaRepository.save(entity);
				registerSeHistory(dto);
				
			}
			
			
			
			
			
		}

		return dto;

	}

