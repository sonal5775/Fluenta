	/**
	 * This method returns in progress status data
	 * 
	 * @author Pinaki Samal
	 * @param request - header data
	 */
	@Override
	public List<StatusDto> getStatus(HeaderDateRequestDto request) {
		LOGGER.info("Inside SalesEnquiryServiceImpl:: getStatus ");

		ArrayList<StatusDto> list = new ArrayList<>();
		InProgressStatusDto inProgressDto = new InProgressStatusDto(OfsStatusConstants.IN_PROGRESS, 0);
		AttachedStatusDto attachedDto = new AttachedStatusDto(OfsStatusConstants.ATTACHED, 0);
		RequestedStatusDto requestedDto = new RequestedStatusDto(OfsStatusConstants.REQUESTED, 0);
		ConfirmedStatusDto confirmedDto = new ConfirmedStatusDto(OfsStatusConstants.CONFIRMED, 0);
		if (!salesEnquiryRepository.getInProgressStatus().isEmpty()) {
			inProgressDto = salesEnquiryRepository.getInProgressStatus().get(0);
		}
		if (!salesEnquiryRepository.getAttachedStatus().isEmpty()) {
			attachedDto = salesEnquiryRepository.getAttachedStatus().get(0);
		}
		if (!salesEnquiryRepository.getRequestedStatus().isEmpty()) {
			requestedDto = salesEnquiryRepository.getRequestedStatus().get(0);
		}
		if (!salesEnquiryRepository.getConfirmedStatus().isEmpty()) {
			confirmedDto = salesEnquiryRepository.getConfirmedStatus().get(0);
		}
		list.add(addStatus(inProgressDto));
		list.add(addStatus(requestedDto));
		list.add(addStatus(attachedDto));
		list.add(addStatus(confirmedDto));
		if (request.getFromDate() != null && request.getToDate() != null) {
			Long createdStatusCount = salesEnquiryRepository.getCreatedStatus(request);
			CreatedStatusDto createdDto = new CreatedStatusDto();
			createdDto.setStatus(OfsStatusConstants.CREATED);
			createdDto.setCount(createdStatusCount);
			Long rejectedStatusCount = salesEnquiryRepository.getRejectedStatus(request);
			RejectedStatusDto rejectedDto = new RejectedStatusDto();
			rejectedDto.setStatus(OfsStatusConstants.REJECTED);
			rejectedDto.setCount(rejectedStatusCount);
			list.add(addStatus(createdDto));
			list.add(addStatus(rejectedDto));
		}
		return list;
	}

