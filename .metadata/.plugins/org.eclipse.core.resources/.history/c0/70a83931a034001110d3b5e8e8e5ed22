	public String filterQueryUsingFilterList(List<String> filterList,String query) {
		query = query+" AND (";

		List<String> columnNames = DevExtGridFilterUtils.getAllFields(SalesEnquiryDto.class);

		Map<String, String> columnDataTypesKeyValuePair = DevExtGridFilterUtils.getAllFieldsWithTypes(SalesEnquiryDto.class);
		Map<String, String> columnAlise = checkClassAleas();
		boolean isClobObject = false;
		boolean isStringObject = false;
		boolean isDateObject = false;
		boolean isContains = false;
		boolean isNotContains = false;
		boolean isStartWith = false;
		boolean isEndWith = false;
		for(int i=0;i<filterList.size();i++) {
			String item = filterList.get(i);
			if(columnNames.contains(item)) {
				if(columnDataTypesKeyValuePair.get(item).equals("CLOB")) {
					query = query+"DBMS_LOB.INSTR("+columnAlise.get(item)+item+",";
					isClobObject = true;
				}else if(columnDataTypesKeyValuePair.get(item).equals("DATE")) {
					query = query+" TO_CHAR("+columnAlise.get(item)+item+", 'YYYY-MM-DD')";
					isDateObject = true;
				}else if(columnDataTypesKeyValuePair.get(item).equals("VARCHAR2")) {
					
						query = query+"(UPPER(TRIM("+columnAlise.get(item)+""+item+"))";
						isStringObject = true;
					
					
				}
				else {
					if("quantity".equals(item)) {
						int index = filterList.indexOf("quantity");
						query = query+ "(SELECT SUM(selSt.seqty) FROM SelStEntity selSt WHERE sehSt.seid = selSt.id.seid AND selSt.isactv = 1) "+filterList.get(index+1)+" "+filterList.get(index+2)+"";
						i +=2;
					}else {
					query = query+columnAlise.get(item)+item;
					}
					
				}
			}else if(item.equals(CONTAINS) || item.equals(NOTCONTAINS) || item.equals(STARTSWITH) || item.equals(ENDSWITH)){
				if(isClobObject) {

				}else if(isDateObject) {

					query = query+LIKE;

				}
				else {
					if(item.equals(CONTAINS)) {
						query = query+LIKE;
						isContains = true;
					}else if(item.equals(NOTCONTAINS)) {
						query = query+NOT_LIKE;
						isNotContains = true;

					}else if(item.equals(STARTSWITH)) {
						query = query+LIKE;
						isStartWith = true;
					}else if(item.equals(ENDSWITH)) {
						query = query+LIKE;
						isEndWith = true;
					}else {
						query = query+" = ";
					}

				}

			}
			else if(item.equals("or") || item.equals("and")) {
				query = query+" "+item+" ";
			}else if(item.equals("=")) {
				query = query+" "+item;

			}else if(item.equals("<>")) {
				query = query+" "+item;
			}else if(item.equals(">=")) {
				query = query+" "+item;
			}else if(item.equals("<")) {
				query = query+" "+item;
			}else if(item.equals(">")) {
				query = query+" "+item;
			}
			else {
				if(isClobObject) {
					query = query+"'"+item+"') > 0";
					isClobObject = false;
				}else if(isStringObject) {
					if(isContains) {
                        query = query+" UPPER(TRIM('%"+item+"%'"+")))";
                        isContains = false;
                    }else if(isNotContains) {
                        query = query+" UPPER(TRIM('%"+item+"%')))";
                        isNotContains = false;

                    }else if(isStartWith) {
                        query = query+" UPPER(TRIM('"+item+"%')))";
                        isStartWith = false;
                    }else if(isEndWith) {
                        query = query+" UPPER(TRIM('%"+item+"')))";
                        isEndWith = false;
                    }else {
                        query = query+" UPPER(TRIM('"+item+"')))";
                    }

					isStringObject = false;
				}else if(isDateObject ) {
					LocalDateTime dateTime = LocalDate.parse(item, DateTimeFormatter.ISO_LOCAL_DATE).atStartOfDay();
					String dateString = dateTime.toLocalDate().toString();
					query = query+" '"+dateString+"'";
					isDateObject = false;
				}
				else {
					query = query+" "+item+"";
				}

			}
		}
		query = query+")";

		return query;
	}
	
