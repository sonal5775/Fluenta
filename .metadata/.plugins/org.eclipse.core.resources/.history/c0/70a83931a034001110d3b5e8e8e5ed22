	@Override
	public FluentaPaginatedResponse<SalesEnquiryDto> getAllPaginatedSalesEnquiryDetails(
			StatusRequest request,Integer page, Integer size, String filterPathString,
			String sort) {
		List<String> filterList = DevExtGridFilterUtils.extractElements(filterPathString);
		List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);
		if(!filterList.isEmpty()) {
			boolean isNumber = DevExtGridFilterUtils.isNumberOrStringCheck(filterList.get(2));

			if(filterList.contains("or") && !isNumber) {
				filterList = DevExtGridFilterUtils.removeNumberFieldsFromString(filterList,SalesEnquiryDto.class);
			}
		}
		
		String query = getAllPaginatedSalesEnquiryDetailsInString(request);
		String countQuery = getAllPaginatedSalesEnquiryDetailsInStringForCount(request);
		
		if(!filterList.isEmpty()) {
			query = filterQueryUsingFilterList(filterList,query);
			countQuery = filterQueryUsingFilterList(filterList,countQuery);

		}
		Map<String, String> columnAlise = checkClassAleasWithNoStop();
		if(!sortList.isEmpty()){
			if(sortList.get(3).equals("true")) {
				query = query+ORDER_BY+columnAlise.get(sortList.get(1))+" DESC";
			}else {
				query = query+ORDER_BY+columnAlise.get(sortList.get(1));
			}
		}
		else {
			query = query + "ORDER BY sehSt.seDt DESC";
		}
		
		Page<SalesEnquiryDto> salesEnquiry = salesEnquiryRepository.getAllPaginatedSalesEnquiryDetails(request,page,size,query,countQuery);

	
		return new FluentaPaginatedResponse<SalesEnquiryDto>(
			    salesEnquiry.getContent(), 
			    salesEnquiry.getTotalElements(),
			    salesEnquiry.getTotalPages()
			);
		
	}
	
