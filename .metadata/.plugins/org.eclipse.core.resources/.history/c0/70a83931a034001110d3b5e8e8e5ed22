	/**
	 * Retrieves sales enquiry item details with support for filtering, sorting, grouping, and pagination. 
	 * Determines the appropriate data retrieval approach based on the provided parameters.
	 * @author -Sonal patil
	 **/
	@Override
	public <T> T getAllSalesEnquiryItemsDetails(StatusRequest request, String status, int pageNumber, int pageSize,
			String filter, String sort, String group, int skip, boolean requireTotalCount, boolean requireGroupCount,
			String searchValue, Integer pageStore, Integer latestGroupCount) {
		List<String> filterList = DevExtGridFilterUtils.extractElements(filter);
		 int[] pageSizeArr = processPageAndSize(pageNumber, pageSize,pageStore);
		 pageNumber = pageSizeArr[0];
		 pageSize = pageSizeArr[1];	 
		 List<String> groupList = DevExtGridFilterUtils.getSortListFromString(group);	
		 List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);		 
		 if (DevExtGridFilterUtils.isGroupWithoutFilterOrSort(group, filter, sort)) {
		     return handleGroupOnlySalesEnquiryDetails(request, groupList, pageNumber, pageSize, skip,status,pageStore,latestGroupCount);
		 }	 
		 if (DevExtGridFilterUtils.isGroupWithFilterOrSort(group, filter, sort)) {
		     return handleGroupWithFilterOrSortSalesEnquiryDetails(request, groupList, filterList, sortList, pageNumber, pageSize, skip,requireTotalCount,status,pageStore,latestGroupCount);
		 }
		 if (DevExtGridFilterUtils.isFilterOrSortOnly(group, filter, sort)) {
		     return handleFilterOrSortSalesEnquiryDetails(request, filterList, sortList,pageNumber, pageSize, skip, requireTotalCount,status,pageStore,latestGroupCount);
	     }
		  return null;
	}
	private int[] processPageAndSize(Integer pageNumber, Integer pageSize,Integer pageStore) {
	    if (pageNumber == null) {
	    	pageNumber = 0;
	    }
	    if (pageSize == null) {
	    	pageSize = pageStore;
	    }
	    return new int[]{pageNumber, pageSize};
	}
	private <T> T handleGroupOnlySalesEnquiryDetails(StatusRequest request, List<String> groupList, int pageNumber,
			int pageSize, int skip, String status,Integer pageStore, Integer latestGroupCount) {
		pageSize = pageNumber + pageSize;
		pageNumber = 0;	
		String groupQuery = getQueryForGroupingSalesEnquiryDetails(groupList);
	    String groupCountQuery = getQueryForGroupingCountSalesEnquiryDetails(groupList);
		String mainCountQuery = getMainSalesEnquiryDetailsQueryCount();
		Long mainQueryCount = salesEnquiryRepository.getSalesEnquiryDetailsQueryCount(request,mainCountQuery);
	    Page<Object[]> groupingListData = salesEnquiryRepository.getGroupingListDataSalesEnquiryDetails(groupQuery, groupCountQuery,pageNumber,pageSize, skip,request);
	    Long totalDistCount = salesEnquiryRepository.groupCountQuerySalesEnquiryDetails(groupCountQuery,request);
	    return buildGroupedDataResponse(groupingListData, mainQueryCount, totalDistCount);
	}
	private String getQueryForGroupingSalesEnquiryDetails(List<String> groupList) {
		if (groupList == null || groupList.isEmpty()) {
	        throw new IllegalArgumentException("groupList cannot be null or empty");
	    }	
		String desc = groupList.get(3);
	    String groupColumn = groupList.get(1); 
	    StringBuilder query = new StringBuilder();
		query.append(" "+OfsConstants.SELECT+" ")
		.append(checkClassAleas().get(groupColumn))
		.append(groupColumn)	
		.append(" ,COUNT(*")
		.append(")")
		.append(SalesEnquiryRepository.SALES_ENQUIRY_CONDITION) 
		.append(SalesEnquiryRepository.SALES_ENQUIRY_WHERE_CONDITION) ;
		query.append(" GROUP BY "+checkClassAleas().get(groupColumn)+""+groupColumn+" ");		
		if ("true".equals(desc)) {
		    query.append("  "+OfsConstants.ORDER_BY+" ").append(checkClassAleas().get(groupColumn)).append(groupColumn).append(" "+OfsConstants.DESC);
		} else {
		    query.append("  "+OfsConstants.ORDER_BY+" ").append(checkClassAleas().get(groupColumn)).append(groupColumn);
		}
		return query.toString();
	}
	private String getQueryForGroupingCountSalesEnquiryDetails(List<String> groupList) {
		String groupColumn = groupList.get(1); // Assuming the second element is the group column
		StringBuilder query = new StringBuilder();
		query.append(" "+OfsConstants.SELECT+" ")
		.append(OfsConstants.COUNT_DISTINCT)
		.append(checkClassAleas().get(groupColumn))
		.append(groupColumn)
		.append(")")
		.append(SalesEnquiryRepository.SALES_ENQUIRY_CONDITION) 
		.append(SalesEnquiryRepository.SALES_ENQUIRY_WHERE_CONDITION) ;
		return query.toString();
	}

	public String getMainSalesEnquiryDetailsQueryCount() {
	    StringBuilder query = new StringBuilder();
	    query.append(" SELECT COUNT(*")
		.append(") ")
	    .append(SalesEnquiryRepository.SALES_ENQUIRY_CONDITION) 
		.append(SalesEnquiryRepository.SALES_ENQUIRY_WHERE_CONDITION) ;
	    return query.toString();
	}

	@SuppressWarnings("unchecked")
	private <T> T buildGroupedDataResponse(Page<Object[]> groupingListData, Long mainQueryCount, Long totalDistCount) {
	    GroupedDataResponse<SalesEnquiryDto> result = new GroupedDataResponse<>(null, 0L, 0L);
	    List<Group<SalesEnquiryDto>> list = new ArrayList<>();
	    for (Object[] row : groupingListData) {
	        String groupKey;
	        if (row[0] instanceof BigDecimal bigDecimal) {
	            groupKey = bigDecimal.toPlainString();
	        } else {
	            groupKey = String.valueOf(row[0]);
	        }

	        Long count;
	        if (row[1] instanceof BigDecimal bigDecimal) {
	            count = bigDecimal.longValue();
	        } else {
	            count = (Long) row[1];
	        }

	        list.add(new Group<>(groupKey, null, count));
	    }
	    result.setData(list);
	    result.setTotalCount(mainQueryCount);
	    result.setGroupCount(totalDistCount);
	    return (T) result;
	}

	@SuppressWarnings("unchecked")
	private <T> T handleFilterOrSortSalesEnquiryDetails(StatusRequest request, List<String> filterList,List<String> sortList, Integer page, Integer size, Integer skip, boolean requireTotalCount,String status,Integer pageStore, Integer latestGroupCount) {
		if (!requireTotalCount) {
	        size = page + size;
	        page = 0;
	    }
		  String query = getSalesEnquiryDetailsQuery();
		    String countQuery = getMainSalesEnquiryDetailsQueryCount(); 
		    if (!filterList.isEmpty()) {
		        query = filterQueryUsingFilterList(filterList, query);
		       countQuery = filterQueryUsingFilterList(filterList, countQuery);
		     }
	    query = applySorting(sortList, query);
		 Page<SalesEnquiryDto> salesenquiryresult = salesEnquiryRepository.getSalesEnquiryDetails(request, page, size, query, countQuery, skip);
		 return (T) new FluentaPaginatedResponse<>(salesenquiryresult.getContent(), salesenquiryresult.getTotalElements());
	}
	private String applySorting(List<String> sortList, String query) {

		return  query + " ORDER BY sehSt.seDt DESC";  
	   
	}

	public String getSalesEnquiryDetailsQuery() {
		return 
				SalesEnquiryRepository.SALES_ENQUIRY_QUERY+
				SalesEnquiryRepository.SALES_ENQUIRY_CONDITION+
				SalesEnquiryRepository.SALES_ENQUIRY_WHERE_CONDITION;

	}
	private <T> T handleGroupWithFilterOrSortSalesEnquiryDetails(StatusRequest request, List<String> groupList,
			List<String> filterList, List<String> sortList, Integer page, Integer size, Integer skip,
			boolean requireTotalCount,String status,Integer pageStore, Integer latestGroupCounts) {
		if (requireTotalCount && size == null) {
			size = pageStore;
		} else {
			size = page + size;
			page = 0;
		}
		String queryForGrouping = getSalesEnquiryDetailsAndFiltering(groupList, filterList);
		String queryForGroupingAndFilteringCount = getSalesEnquiryDetailsAndFilteringCount(groupList, filterList,sortList,status);
		String mainCountQuery = getMainSalesEnquiryDetailsQueryCount();
		Long mainQueryCount = salesEnquiryRepository.getSalesEnquiryDetailsQueryCount(request,mainCountQuery);
		Page<Object[]> groupingListData = salesEnquiryRepository.getGroupingListDataSalesEnquiryDetails(queryForGrouping,queryForGroupingAndFilteringCount, page, size, skip,request);
		Long totalDistCount = salesEnquiryRepository.groupCountQuerySalesEnquiryDetails(queryForGroupingAndFilteringCount,request);	
		return buildGroupedDataResponse(groupingListData, mainQueryCount, (totalDistCount != null && totalDistCount != 0) ? totalDistCount : latestGroupCounts);
	}
	
	public String getSalesEnquiryDetailsAndFiltering(List<String> groupList,List<String> filterList) {
		String groupColumn = groupList.get(1);
		String desc = groupList.get(3);
		StringBuilder query = new StringBuilder();
		query.append(" "+OfsConstants.SELECT+" ")
		.append(checkClassAleas().get(groupColumn))
		.append(groupColumn)
		.append(" ,COUNT(*")
		.append(")")
		.append(SalesEnquiryRepository.SALES_ENQUIRY_CONDITION) 
		.append(SalesEnquiryRepository.SALES_ENQUIRY_WHERE_CONDITION) ;
		String filterQueryUsingFilterList = query.toString();		
		 if(!filterList.isEmpty()) {
			 filterQueryUsingFilterList = filterQueryUsingFilterList(filterList,query.toString());
		 }
		 filterQueryUsingFilterList = filterQueryUsingFilterList+" "+"GROUP BY "+checkClassAleas().get(groupColumn)+""+ groupColumn + " "+"ORDER BY "+checkClassAleas().get(groupColumn)+""+ groupColumn;
		 if("true".equals(desc)) {
			 filterQueryUsingFilterList = filterQueryUsingFilterList+" DESC";
		 }	 		
		return filterQueryUsingFilterList;
		
	}
