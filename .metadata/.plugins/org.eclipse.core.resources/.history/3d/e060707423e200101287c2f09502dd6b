    public Page<CoilClearanceListDto> getCoilClearanceDetails(CoilClearanceRequestDto request,
                                                              Integer page, Integer size, String query, String countQuery) {
        logger.info("Request Data: {}", request);

        Query queryCount = entityManager.createQuery(countQuery);
        queryCount.setParameter(OfsConstants.HEAT_ID, request.getHeatId());
        queryCount.setParameter(OfsConstants.COIL_ID_FROM, request.getPpidFrom());
        queryCount.setParameter(OfsConstants.COIL_ID_TO, request.getPpidTo());

        Number resultNumber = (Number) queryCount.getSingleResult();
        int totalRows = resultNumber.intValue();
        Pageable pageable = PageRequest.of(page, size);

        TypedQuery<CoilClearanceListDto> q = entityManager.createQuery(
                query,
                CoilClearanceListDto.class);
        q.setFirstResult(pageable.getPageNumber() * pageable.getPageSize());
        q.setMaxResults(pageable.getPageSize());

        q.setParameter(OfsConstants.HEAT_ID, request.getHeatId());
        q.setParameter(OfsConstants.COIL_ID_FROM, request.getPpidFrom());
        q.setParameter(OfsConstants.COIL_ID_TO, request.getPpidTo());

        logger.info("Fetching HSM Coil Clearance {}", q.getResultList());

        List<CoilClearanceListDto> resultList = q.getResultList();

        return new PageImpl<>(resultList, pageable, totalRows);
    }

