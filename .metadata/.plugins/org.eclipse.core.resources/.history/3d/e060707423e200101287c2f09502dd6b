    public Page<CoilClearanceListDto> getCoilClearance(CoilClearanceRequestDto request, String status, int page, int size, String query, String countQueryParm, Integer skip) {
        // Step 1: Calculate effective OFFSET and PAGE SIZE
        int effectiveOffset = page * size;
        int effectivePageSize = size;

        if (skip != null && skip > 0) {
            if (skip >= size) {
                effectiveOffset += skip; // Adjust the offset by skipping additional rows
                skip = 0; // Reset skip as it's already accounted for
            } else {
                effectiveOffset += skip;
                effectivePageSize -= skip; // Adjust the size to exclude skipped rows
            }
        }

        // Step 2: Query for Results
        TypedQuery<CoilClearanceListDto> q = entityManager.createQuery(query, CoilClearanceListDto.class);

        // Set parameters directly in this method
        q.setParameter(OfsConstants.HEAT_ID, request.getHeatId());
        q.setParameter(OfsConstants.COIL_ID_FROM, request.getPpidFrom());
        q.setParameter(OfsConstants.COIL_ID_TO, request.getPpidTo());

        q.setFirstResult(effectiveOffset);
        q.setMaxResults(effectivePageSize);

        List<CoilClearanceListDto> resultList = q.getResultList();

        // Step 3: Query for Count
        Query countQuery = entityManager.createQuery(countQueryParm);

        countQuery.setParameter(OfsConstants.HEAT_ID, request.getHeatId());
        countQuery.setParameter(OfsConstants.COIL_ID_FROM, request.getPpidFrom());
        countQuery.setParameter(OfsConstants.COIL_ID_TO, request.getPpidTo());


        Long totalRows = (Long) countQuery.getSingleResult();

        // Step 4: Pageable and PageImpl
        Pageable pageable = PageRequest.of(page, size);
        return new PageImpl<>(resultList, pageable, totalRows);

    }

