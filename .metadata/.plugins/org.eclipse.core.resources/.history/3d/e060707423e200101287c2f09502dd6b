        queryBuilder.append("SELECT DISTINCT(TRIM(h.heatId)) ")
                .append("FROM QualityScheduleLinesEntity h ")
                .append("ORDER BY TRIM(h.heatId) DESC");

        TypedQuery<String> q = entityManager.createQuery(queryBuilder.toString(), String.class);
        q.setMaxResults(10);
        return q.getResultList();
    }

