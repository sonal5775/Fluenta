    public Page<Object[]> getCoilDetailsGroupingListData(String queryForGrouping, String queryForGroupingAndFilteringCount,
                                                         Integer page, Integer size, Integer skip, CoilModificationRequestDto request) {

        // Step 1: Count Query
        Query queryCount = entityManager.createQuery(queryForGroupingAndFilteringCount);
        queryCount.setParameter(QualityConstants.TPI_REQUIRED, QualityConstants.HSM_QC);
        queryCount.setParameter(QualityConstants.TASK_STATUS, QualityConstants.PENDING);
        queryCount.setParameter(OfsConstants.COIL_ID_FROM, request.getFromCoilid());
        queryCount.setParameter(OfsConstants.COIL_ID_TO, request.getToCoilid());
        queryCount.setParameter(QualityConstants.HSM_INSP, QualityConstants.HSM_INSP);
        queryCount.setParameter(QualityConstants.REWORK, QualityConstants.REWORK);
        queryCount.setParameter(QualityConstants.SHRCOIL, QualityConstants.PROD_CODE_HRCOIL);
        queryCount.setParameter(QualityConstants.S_CODE_F, QualityConstants.CODE_F);

        Number resultNumber = (Number) queryCount.getSingleResult();
        int totalRows = resultNumber.intValue();

        // Step 2: Adjust effective offset considering SKIP and PAGE SIZE
        int effectiveOffset = page * size;
        int effectivePageSize = size;

        if (skip != null && skip > 0) {
            if (skip >= size) {
                effectiveOffset += skip; // Move to the next offset if skip exceeds size

            } else {
                effectiveOffset += skip;
                effectivePageSize -= skip; // Adjust the size to consider the skip
            }
        }

        // Step 3: Pageable object for response
        Pageable pageable = PageRequest.of(page, size);

        // Step 4: Data Query
        TypedQuery<Object[]> query = entityManager.createQuery(queryForGrouping, Object[].class);
        query.setParameter(QualityConstants.TPI_REQUIRED, QualityConstants.HSM_QC);
        query.setParameter(QualityConstants.TASK_STATUS, QualityConstants.PENDING);
        query.setParameter(OfsConstants.COIL_ID_FROM, request.getFromCoilid());
        query.setParameter(OfsConstants.COIL_ID_TO, request.getToCoilid());
        query.setParameter(QualityConstants.HSM_INSP, QualityConstants.HSM_INSP);
        query.setParameter(QualityConstants.REWORK, QualityConstants.REWORK);
        query.setParameter(QualityConstants.SHRCOIL, QualityConstants.PROD_CODE_HRCOIL);
        query.setParameter(QualityConstants.S_CODE_F, QualityConstants.CODE_F);

        query.setFirstResult(effectiveOffset); // Correct OFFSET
        query.setMaxResults(effectivePageSize); // Adjusted PAGE SIZE

        // Step 5: Fetch results
        List<Object[]> resultList = query.getResultList();

        // Step 6: Return paginated results
        return new PageImpl<>(resultList, pageable, totalRows);
    }

    public Page<CoilModificationDetailsDto> getCoilDetails(CoilModificationRequestDto request, int page, int size,
                                                           String query, String countQueryParm, Integer skip) {

        // Step 1: Calculate effective OFFSET and PAGE SIZE
        int effectiveOffset = page * size;
        int effectivePageSize = size;

        if (skip != null && skip > 0) {
            if (skip >= size) {
                effectiveOffset += skip; // Adjust the offset by skipping additional rows

            } else {
                effectiveOffset += skip;
                effectivePageSize -= skip; // Adjust the size to exclude skipped rows
            }
        }

        Query queryCount = entityManager.createQuery(countQueryParm);
        queryCount.setParameter(QualityConstants.TPI_REQUIRED, QualityConstants.HSM_QC);
        queryCount.setParameter(QualityConstants.TASK_STATUS, QualityConstants.PENDING);
        queryCount.setParameter(OfsConstants.COIL_ID_FROM, request.getFromCoilid());
        queryCount.setParameter(OfsConstants.COIL_ID_TO, request.getToCoilid());
        queryCount.setParameter(QualityConstants.HSM_INSP, QualityConstants.HSM_INSP);
        queryCount.setParameter(QualityConstants.REWORK, QualityConstants.REWORK);
        queryCount.setParameter(QualityConstants.SHRCOIL, QualityConstants.PROD_CODE_HRCOIL);
        queryCount.setParameter(QualityConstants.S_CODE_F, QualityConstants.CODE_F);

        TypedQuery<CoilModificationDetailsDto> q = entityManager.createQuery(query, CoilModificationDetailsDto.class);

        q.setParameter(QualityConstants.TPI_REQUIRED, QualityConstants.HSM_QC);
        q.setParameter(QualityConstants.TASK_STATUS, QualityConstants.PENDING);
        q.setParameter(OfsConstants.COIL_ID_FROM, request.getFromCoilid());
        q.setParameter(OfsConstants.COIL_ID_TO, request.getToCoilid());
        q.setParameter(QualityConstants.HSM_INSP, QualityConstants.HSM_INSP);
        q.setParameter(QualityConstants.REWORK, QualityConstants.REWORK);
        q.setParameter(QualityConstants.SHRCOIL, QualityConstants.PROD_CODE_HRCOIL);
        q.setParameter(QualityConstants.S_CODE_F, QualityConstants.CODE_F);

        q.setFirstResult(effectiveOffset);
        q.setMaxResults(effectivePageSize);

        List<CoilModificationDetailsDto> resultList = q.getResultList();

        Long totalRows = (Long) queryCount.getSingleResult();
        Pageable pageable = PageRequest.of(page, size);
        return new PageImpl<>(resultList, pageable, totalRows);
    }

