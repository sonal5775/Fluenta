    public String getCoilDetailsQuery() {
        StringBuilder queryBuilder = new StringBuilder();
        queryBuilder.append("SELECT DISTINCT new com.hindindustec.fluenta.hsm.quality.dto.CoilModificationDetailsDto (")
                .append("TRIM(pdo.id.coilid), ")
                .append("TRIM(pdo.id.slabid), ")
                .append("TRIM(pdo.schdid), ")
                .append("TRIM(pdo.heatid), ")
                .append("TRIM(pdo.grade), ")
                .append("TRIM(qcsch.extGrdNm), ")
                .append("COALESCE((SELECT ppinsp.strval FROM PpInspCharEntity ppinsp ")
                .append(WHERE_CONDITION).append(QualityConstants.ACHIEVE_GRADE).append("'), TRIM(pdo.grade)), ")
                .append("CONCAT(qcsch.soId, '-', qcsch.solId), ")
                .append("qcsch.tdcId, ")
                .append("pdo.avgCoilThk, ")
                .append("COALESCE((SELECT ppinsp.numval FROM PpInspCharEntity ppinsp ")
                .append(WHERE_CONDITION).append(QualityConstants.AVG_COIL_THK).append("'), pdo.tgtCoilThk), ")
                .append("pdo.avgCoilWidth, ")
                .append("COALESCE((SELECT ppinsp.numval FROM PpInspCharEntity ppinsp ")
                .append(WHERE_CONDITION).append(QualityConstants.AVG_COIL_WIDTH).append("'), pdo.tgtCoilWidth), ")
               .append("ROUND(pdo.coilWgt / 1000, 2), ")
                .append("COALESCE((SELECT ppinsp.numval FROM PpInspCharEntity ppinsp ")
                .append(WHERE_CONDITION).append(QualityConstants.COIL_WGT).append("'), ROUND(pdo.coilWgt / 1000, 2)), ")
              
                .append("pdo.coilInnerDia, ")
                .append("COALESCE((SELECT ppinsp.numval FROM PpInspCharEntity ppinsp ")
                .append("WHERE TRIM(ppinsp.id.ppid) = TRIM(ppt.id.ppId) ")
                .append("AND ppinsp.id.ppctr = ppt.id.ppCtr AND ppinsp.id.taskstepid = ppt.id.taskstepId ")
                .append("AND ppinsp.id.atrid = '").append(QualityConstants.COIL_INNER_DIA).append("'), pdo.coilInnerDia), ")
                .append("pdo.coilOuterDia, ")
                .append("COALESCE((SELECT ppinsp.numval FROM PpInspCharEntity ppinsp ")
                .append("WHERE TRIM(ppinsp.id.ppid) = TRIM(ppt.id.ppId) ")
                .append("AND ppinsp.id.ppctr = ppt.id.ppCtr AND ppinsp.id.taskstepid = ppt.id.taskstepId ")
                .append("AND ppinsp.id.atrid = '").append(QualityConstants.COIL_OUTER_DIA).append("'), pdo.coilOuterDia), ")
                .append("ppt.cutFlag, ")
                .append("ppt.cutType, ")
                .append("ppt.holdRemark, ")
                .append("ppt.holdReason, ")
                .append("ppt.id.ppCtr, ")
                .append("ppt.id.taskstepId, ")
                .append("COALESCE((SELECT ppinsp.numval FROM PpInspCharEntity ppinsp ")
                .append(WHERE_CONDITION).append(QualityConstants.AVG_COIL_THK).append("'), sobd.thkaim), ")
                .append("COALESCE((SELECT ppinsp.numval FROM PpInspCharEntity ppinsp ")
                .append(WHERE_CONDITION).append(QualityConstants.AVG_COIL_WIDTH).append("'), sobd.wdtaim), ")
 //               .append("pphmt.thickness, ")
  //              .append("pphmt.width, ")
                .append("sobd.wgtaim) ")
                .append("FROM H1mh01Hm1millPdoLi pdo ")
                .append("JOIN PostProdTaskMtEntity ppt ON TRIM(pdo.id.coilid) = TRIM(ppt.id.ppId) ")
                .append("AND ppt.taskStatus = :taskStatus ")
                .append("AND ppt.latestFlag = 'Y' ")
                .append("AND ppt.tpiRequired IN (:tpiRequired, :HSMINSP, :REWORK) ")
                .append("AND (ppt.tpiRequired != :HSMINSP OR ppt.cutType IS NOT NULL) ")
                .append("JOIN QualityScheduleLinesEntity qcsch ON TRIM(qcsch.ppId) = TRIM(ppt.id.ppId) ")
                .append("JOIN Inventory pphmt ON TRIM(pphmt.id.ppid) = TRIM(ppt.id.ppId) ")
                .append("LEFT JOIN SalesOrderBomDetails sobd ON TRIM(qcsch.soId) = TRIM(sobd.id.soid) ")
                .append("AND qcsch.solId = sobd.id.solid ")
                .append("AND sobd.id.prdid = :hrcoil AND sobd.id.dimind = :codef ")

                .append("WHERE (")
                .append(":coilIdFrom IS NULL AND :coilIdTo IS NULL ")
                .append("OR (:coilIdFrom IS NOT NULL AND :coilIdTo IS NULL AND TO_NUMBER(TRIM(qcsch.ppId)) = TO_NUMBER(TRIM(:coilIdFrom))) ")
                .append("OR (:coilIdFrom IS NOT NULL AND :coilIdTo IS NOT NULL AND TO_NUMBER(TRIM(qcsch.ppId)) BETWEEN TO_NUMBER(:coilIdFrom) AND TO_NUMBER(:coilIdTo)) ")
                .append(")");

        return queryBuilder.toString();
    }


