        .append("ar.moMacAddr ")
        .append(") ")
        .append("FROM ArtyCs ar ")
        .append("ORDER BY ar.crDt");

        TypedQuery<AreaTypeDto> q = entityManager.createQuery(queryString.toString(), AreaTypeDto.class);
        logger.info("Number of results getAreaTypeData: {}", q.getResultList().size());
        return q.getResultList();
	}

