package com.hindindustec.fluenta.hsm.masters.repository;

import java.util.List;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Repository;

import com.hindindustec.fluenta.hsm.masters.dto.AreaDto;
import com.hindindustec.fluenta.hsm.masters.dto.AreaTypeDto;
import com.hindindustec.fluenta.hsm.masters.dto.ProdLineDto;
import com.hindindustec.fluenta.hsm.masters.dto.SiteDto;

import jakarta.persistence.EntityManager;
import jakarta.persistence.TypedQuery;

@Repository
public class FacilityOverviewCustRepository {
	
	private EntityManager entityManager;
	private static final Logger logger = LoggerFactory.getLogger(FacilityOverviewCustRepository.class);
	
	public FacilityOverviewCustRepository(EntityManager entityManager) {
		super();
		this.entityManager = entityManager;
	}

	public List<SiteDto> getSiteData() {
		logger.info("FacilityOverviewCustRepository: Fetching all Site data");
        StringBuilder queryString = new StringBuilder();
        queryString.append("SELECT new ").append(SiteDto.class.getName()).append("(")
        .append("st.stid, ")
        .append("st.country, ")
        .append("st.crBy, ")
        .append("st.crDt, ")
        .append("st.crMacAddr, ")
        .append("st.erpStid, ")
        .append("st.isactv, ")
        .append("st.logoImgPath, ")
        .append("st.moBy, ")
        .append("st.moDt, ")
        .append("st.moMacAddr, ")
        .append("st.staddr, ")
        .append("st.state, ")
        .append("st.stnm, ")
        .append("st.location ")
        .append(") ")
        .append("FROM StCs st ")
        .append("ORDER BY st.crDt");

        TypedQuery<SiteDto> q = entityManager.createQuery(queryString.toString(), SiteDto.class);
        logger.info("Number of results getSiteData: {}", q.getResultList().size());
        return q.getResultList();
	}

