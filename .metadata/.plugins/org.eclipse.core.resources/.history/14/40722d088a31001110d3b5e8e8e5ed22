	public List<ProdLineDto> getProdLineData() {
		logger.info("FacilityOverviewCustRepository: Fetching all Prod Line data");
        StringBuilder queryString = new StringBuilder();
        queryString.append("SELECT new ").append(ProdLineDto.class.getName()).append("(")
        .append("pl.plid, ")
