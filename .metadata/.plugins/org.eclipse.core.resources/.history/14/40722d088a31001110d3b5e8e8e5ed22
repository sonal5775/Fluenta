        .append("pl.erpplid, ")
        .append("pl.isactv, ")
        .append("pl.moBy, ")
        .append("pl.moDt, ")
        .append("pl.moMacAddr, ")
        .append("pl.pldesc, ")
        .append("pl.plnm, ")
        .append("pl.pltyid ")
        .append(") ")
        .append("FROM PlCm pl ")
        .append("ORDER BY pl.crDt");


        TypedQuery<ProdLineDto> q = entityManager.createQuery(queryString.toString(), ProdLineDto.class);
        logger.info("Number of results getProdLineData: {}", q.getResultList().size());
        return q.getResultList();
	}

}
