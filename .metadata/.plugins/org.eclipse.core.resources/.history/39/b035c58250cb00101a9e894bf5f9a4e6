		public List<CoilDetailsDto> getAllCoilData(CoilDetailsFilterRequestDto coilDetailsFilterRequestDto) {
		    String query = COIL_DETAILS_GENERATE_REPORT_QUERY +
		    		COIL_DETAILS_GENERATE_REPORT_QUERY_CONDITION+
		    		" WHERE 1=1"; 

		   
		    if (coilDetailsFilterRequestDto.getHeatid() != null) {
		        query += " AND ql.heatId = :"+OfsConstants.HEATID;
		    }


		    if (coilDetailsFilterRequestDto.getCoilid() != null) {
		        query += " AND ql.ppId = :"+OfsConstants.PPID;
		    }

		
		    if (coilDetailsFilterRequestDto.getFromDate() != null && coilDetailsFilterRequestDto.getToDate() != null) {
		      
		        query += " AND ql.createdDate BETWEEN :"+OfsConstants.FROM_DATE +" AND : "+OfsConstants.TO_DATE;
		    } else if (coilDetailsFilterRequestDto.getFromDate() != null) {
		        
		        query += " AND ql.createdDate >= :"+OfsConstants.FROM_DATE;
		    } else if (coilDetailsFilterRequestDto.getToDate() != null) {
		   
		        query += " AND ql.createdDate <= :"+OfsConstants.TO_DATE;
		    }

		    if (coilDetailsFilterRequestDto.getFromcoilid() != null && coilDetailsFilterRequestDto.getTocoilid() != null) {
			      
		        query += " AND ql.ppId BETWEEN :fromcoilid AND :tocoilid";
		    } else if (coilDetailsFilterRequestDto.getFromcoilid() != null) {
		        
		        query += " AND ql.ppId >= :"+OfsConstants.FROM_COIL_ID;
		    } else if (coilDetailsFilterRequestDto.getTocoilid() != null) {
		   
		        query += " AND ql.ppId <= :"+OfsConstants.TO_COIL_ID;
		    }
		 
		    TypedQuery<CoilDetailsDto> q = entityManager.createQuery(query, CoilDetailsDto.class);

		  
		    if (coilDetailsFilterRequestDto.getHeatid() != null) {
		        q.setParameter(OfsConstants.HEAT_ID, coilDetailsFilterRequestDto.getHeatid());
		    }
		    if (coilDetailsFilterRequestDto.getCoilid() != null) {
		        q.setParameter(OfsConstants.PPID, coilDetailsFilterRequestDto.getCoilid());
		    }
		    if (coilDetailsFilterRequestDto.getFromDate() != null) {
		        q.setParameter(OfsConstants.FROM_DATE, coilDetailsFilterRequestDto.getFromDate(), TemporalType.DATE);
		    }
		    if (coilDetailsFilterRequestDto.getToDate() != null) {
		        q.setParameter(OfsConstants.TO_DATE, coilDetailsFilterRequestDto.getToDate(), TemporalType.DATE);
		    }
		    if (coilDetailsFilterRequestDto.getFromDate() != null) {
		        q.setParameter(OfsConstants.FROM_COIL_ID, coilDetailsFilterRequestDto.getFromcoilid());
		    }
		    if (coilDetailsFilterRequestDto.getToDate() != null) {
		        q.setParameter(OfsConstants.TO_COIL_ID, coilDetailsFilterRequestDto.getTocoilid());
		    }

		    return q.getResultList();
		}

		
