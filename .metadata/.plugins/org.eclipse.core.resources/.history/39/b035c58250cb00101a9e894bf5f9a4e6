		public Page<Object[]> getGroupingListData(String queryForGrouping, String queryForGroupingAndFilteringCount,
				Integer page, Integer size, Integer skip, CoilDetailsFilterRequestDto request) {
		
		    Query queryCount = entityManager.createQuery(queryForGroupingAndFilteringCount);
		    queryCount.setParameter(OfsConstants.SELECTED_HEAT, request.getHeatid());
		    queryCount.setParameter(OfsConstants.SELECTED_COILID, request.getCoilid());
		    queryCount.setParameter(OfsConstants.SELECTED_SHIFT, request.getShiftid());
		    queryCount.setParameter(OfsConstants.FROM_DATE, request.getFromDate());
		    queryCount.setParameter(OfsConstants.TO_DATE, request.getToDate());
		    queryCount.setParameter(OfsConstants.FROM_COIL_ID, request.getFromcoilid()); // Add fromcoilid parameter
		    queryCount.setParameter(OfsConstants.TO_COIL_ID, request.getTocoilid());
		    
		    Number resultNumber = (Number) queryCount.getSingleResult();
		    int totalRows = resultNumber.intValue();

	
		    int effectiveOffset = page * size;
		    int effectivePageSize = size;

		    if (skip != null && skip > 0) {
		        if (skip >= size) {
		            effectiveOffset += skip; 
		            skip = 0; 
					LOGGER.info("skip : {} ",skip);
				} else {
		            effectiveOffset += skip;
		            effectivePageSize -= skip; 
		        }
		    }

		    Pageable pageable = PageRequest.of(page, size);


		    TypedQuery<Object[]> query = entityManager.createQuery(queryForGrouping, Object[].class);
		    query.setParameter(OfsConstants.SELECTED_HEAT, request.getHeatid());
		    query.setParameter(OfsConstants.SELECTED_COILID, request.getCoilid());
		    query.setParameter(OfsConstants.SELECTED_SHIFT, request.getShiftid());
		    query.setParameter(OfsConstants.FROM_DATE, request.getFromDate());
		    query.setParameter(OfsConstants.TO_DATE, request.getToDate());
		    query.setParameter(OfsConstants.FROM_COIL_ID, request.getFromcoilid()); // Add fromcoilid parameter
		    query.setParameter(OfsConstants.TO_COIL_ID, request.getTocoilid());
		    
		    query.setFirstResult(effectiveOffset); 
		    query.setMaxResults(effectivePageSize); 
		    
		  
		    List<Object[]> resultList = query.getResultList();
		    for (Object[] row : resultList) {
		        if (row[0] instanceof String) { 
		            String key = (String) row[0];
		            switch (key) {
		                case "A":
		                    row[0] = "B";
		                    break;
		                case "M":
		                    row[0] = "A";
		                    break;
		                case "N":
		                    row[0] = "C";
		                    break;
						default:
							break;
		            }
		        }
		    }
		    return new PageImpl<>(resultList, pageable, totalRows);
		}
		
