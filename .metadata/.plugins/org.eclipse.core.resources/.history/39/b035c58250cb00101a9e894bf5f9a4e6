	public static final String COIL_DETAILS_GENERATE_REPORT_QUERY_WHERE_CONDITION;

	static {
	    StringBuilder queryBuilder = new StringBuilder();
	    queryBuilder.append(" WHERE ")
	                .append("(:selectedHeat IS NULL OR UPPER(TRIM(ql.heatId)) = UPPER(TRIM(:selectedHeat))) ")
	                .append("AND (:selectedCoil IS NULL OR TRIM(ql.ppId) = TRIM(:selectedCoil)) ")
	                .append("AND (:selectedShift IS NULL OR ph.shiftid IN :selectedShift) ")
	                .append("AND (:fromDate IS NULL OR FUNCTION('TO_CHAR', ql.createdDate, 'YYYYMMDD') <= FUNCTION('TO_CHAR', :toDate, 'YYYYMMDD')) ")
	                .append("AND (:toDate IS NULL OR FUNCTION('TO_CHAR', ql.createdDate, 'YYYYMMDD') >= FUNCTION('TO_CHAR', :fromDate, 'YYYYMMDD')) ")
					.append( " AND (:fromcoilid IS NULL AND :tocoilid IS NULL")
					.append( " OR (:fromcoilid IS NOT NULL AND :tocoilid IS NULL AND TO_NUMBER(TRIM(ql.ppId)) = TO_NUMBER(TRIM(:fromcoilid)))")
					.append( " OR (:fromcoilid IS NOT NULL AND :tocoilid IS NOT NULL AND TO_NUMBER(TRIM(ql.ppId)) BETWEEN TO_NUMBER(:fromcoilid) AND TO_NUMBER(:tocoilid)))")
					.append("  AND ph.prdid =  'HRCOIL' ");
	    COIL_DETAILS_GENERATE_REPORT_QUERY_WHERE_CONDITION = queryBuilder.toString();
	}


