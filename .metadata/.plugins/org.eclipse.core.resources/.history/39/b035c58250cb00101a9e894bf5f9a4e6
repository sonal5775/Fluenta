		    Number resultNumber = (Number) queryCount.getSingleResult();
		    return resultNumber.longValue();
		}
		

		public Page<CoilDetailsDto> getCoilDetails(CoilDetailsFilterRequestDto request, int page, int size,String query,String countQueryParm,Integer skip){
		 
		    int effectiveOffset = page * size;
		    int effectivePageSize = size;

		    if (skip != null && skip > 0) {
		        if (skip >= size) {
		            effectiveOffset += skip; 
		            skip = 0; 
					LOGGER.info("skip : {} ",skip);
		        } else {
		            effectiveOffset += skip; 
		            effectivePageSize -= skip; 
		        }
		    }

		    TypedQuery<CoilDetailsDto> queryCount = entityManager.createQuery(query, CoilDetailsDto.class);

			queryCount.setParameter(OfsConstants.SELECTED_HEAT, request.getHeatid());
			  queryCount.setParameter(OfsConstants.SELECTED_COILID, request.getCoilid());
			    queryCount.setParameter(OfsConstants.SELECTED_SHIFT, request.getShiftid());		
			    queryCount.setParameter(OfsConstants.FROM_DATE, request.getFromDate());
			queryCount.setParameter(OfsConstants.TO_DATE, request.getToDate());
			queryCount.setParameter(OfsConstants.FROM_COIL_ID, request.getFromcoilid()); // Add fromcoilid parameter
			queryCount.setParameter(OfsConstants.TO_COIL_ID, request.getTocoilid());

			queryCount.setFirstResult(effectiveOffset);
			queryCount.setMaxResults(effectivePageSize);

		    List<CoilDetailsDto> resultList = queryCount.getResultList();
			for (CoilDetailsDto pdi : resultList) {
			
				if (pdi.getShiftid() != null) {
					if (pdi.getShiftid().equals("A")) {
						pdi.setShiftid("B");
					}
					if (pdi.getShiftid().equals("M")) {
						pdi.setShiftid("A");
					}
					if (pdi.getShiftid().equals("N")) {
						pdi.setShiftid("C");
					}
				}
			}
		    Query countQuery = entityManager.createQuery(countQueryParm);

		       
		    countQuery.setParameter(OfsConstants.SELECTED_HEAT, request.getHeatid());
			countQuery.setParameter(OfsConstants.SELECTED_COILID, request.getCoilid());
			  countQuery.setParameter(OfsConstants.SELECTED_SHIFT, request.getShiftid());	
			  countQuery.setParameter(OfsConstants.FROM_DATE, request.getFromDate());
		    countQuery.setParameter(OfsConstants.TO_DATE, request.getToDate());
		    countQuery.setParameter(OfsConstants.FROM_COIL_ID, request.getFromcoilid()); // Add fromcoilid parameter
		    countQuery.setParameter(OfsConstants.TO_COIL_ID, request.getTocoilid());
		    

		    Long totalRows = (Long) countQuery.getSingleResult();

		    Pageable pageable = PageRequest.of(page, size);
		    return new PageImpl<>(resultList, pageable, totalRows);
			
		}


	
