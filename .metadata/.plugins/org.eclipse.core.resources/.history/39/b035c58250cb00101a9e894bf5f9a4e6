			TypedQuery<CoilDetailsDto> q = entityManager.createQuery(
					query,CoilDetailsDto.class);
			 q.setParameter(OfsConstants.SELECTED_HEAT, request.getHeatid());
				q.setParameter(OfsConstants.SELECTED_COILID, request.getCoilid());
				  q.setParameter(OfsConstants.SELECTED_SHIFT, request.getShiftid());				q.setParameter(OfsConstants.FROM_DATE, request.getFromDate());
			q.setParameter(OfsConstants.TO_DATE, request.getToDate());
			q.setParameter(OfsConstants.FROM_COIL_ID, request.getFromcoilid()); // Add fromcoilid parameter
			q.setParameter(OfsConstants.TO_COIL_ID, request.getTocoilid());
			
			q.setFirstResult(page * size);
		    q.setMaxResults(size);
		    
		    List<CoilDetailsDto> resultList = q.getResultList();
		    Query countQuery = entityManager.createQuery(countQueryParm);	       
		    countQuery.setParameter(OfsConstants.SELECTED_HEAT, request.getHeatid());
			countQuery.setParameter(OfsConstants.SELECTED_COILID, request.getCoilid());
			  countQuery.setParameter(OfsConstants.SELECTED_SHIFT, request.getShiftid());	
		    countQuery.setParameter(OfsConstants.FROM_DATE, request.getFromDate());
		    countQuery.setParameter(OfsConstants.TO_DATE, request.getToDate());
		    countQuery.setParameter(OfsConstants.FROM_COIL_ID, request.getFromcoilid()); // Add fromcoilid parameter
		    countQuery.setParameter(OfsConstants.TO_COIL_ID, request.getTocoilid());
		    
		    Long totalRows = (Long) countQuery.getSingleResult();
		    Pageable pageable = PageRequest.of(page, size);
		    return new PageImpl<>(resultList, pageable, totalRows);
		}

