		TypedQuery<String> q = entityManager.createQuery(
				"SELECT distinct qsl.ppId FROM QualityScheduleListEntity qsl WHERE qsl.opprdid = 'HRCOIL' AND LOWER(qsl.ppId) LIKE LOWER(:query)",
				String.class);
		q.setMaxResults(10);
		q.setParameter(QUERY, "%" + query.toLowerCase() + "%");
		return q.getResultList();
	}


