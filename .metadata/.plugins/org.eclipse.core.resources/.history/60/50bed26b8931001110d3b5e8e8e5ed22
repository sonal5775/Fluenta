    public List<DelayDto> fetchDelayCat() {
        logger.info("DelayMasterRepository: Fetching all Delay data");
        StringBuilder queryString = new StringBuilder();
        
        queryString.append("SELECT new ").append(DelayDto.class.getName()).append("(")
            .append("dcc.dcatId, ")
            .append("dcc.catCtr, ")
            .append("dcc.catDesc, ")
            .append("dcc.catNm, ")
            .append("dcc.crBy, ")
            .append("dcc.crDt, ")
            .append("dcc.crMacAddr, ")
            .append("dcc.isActv, ")
            .append("dcc.isPm, ")
            .append("dcc.moBy, ")
            .append("dcc.moDt, ")
            .append("dcc.moMacAddr, ")
            .append("dcc.reserve2, ")
            .append("dcc.reserve3, ")
            .append("dcc.reserve4, ")
            .append("dcc.reserve5, ")
            .append("dcc.stId ")
            .append(") ")
            .append("FROM DelaycatCm dcc ")
            .append("ORDER BY dcc.crDt");

        TypedQuery<DelayDto> q = entityManager.createQuery(queryString.toString(), DelayDto.class);
        logger.info("Number of results fetchAllDelay: {}", q.getResultList().size());
        return q.getResultList();
    }
    
