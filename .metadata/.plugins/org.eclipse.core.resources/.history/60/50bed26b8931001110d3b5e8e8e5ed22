    public List<EquipResDto> fetchAllEquipRes(ERProdDto erpdto) {
        logger.info("DelayMasterRepository: Fetching all Equip Res data: {}", erpdto);
        TypedQuery<EquipResDto> q = entityManager.createQuery(OfsConstants.EQUIP_RES_DTO+"("
            + "erc.eqreid,"
            + "erc.eqrenm,"
            + "erc.eqredesc,"
            + "erc.delaytyid,"
            + "erc.plid,"
            + "erc.isactv,"
            + "erc.crDt,"
            + "erc.crBy,"
            + "erc.crMacAddr"
            + ") FROM EqredtlCm erc WHERE erc.plid = :plid AND erc.delaytyid = :delaytyid ORDER BY erc.crDt",
            EquipResDto.class
        );
        q.setParameter("plid", erpdto.getPlid());
        q.setParameter("delaytyid", erpdto.getDelaytyid());
        logger.info("Number of results fetchAllDelayType in EquipResDto: {}", q.getResultList().size());
        return q.getResultList();
    }

