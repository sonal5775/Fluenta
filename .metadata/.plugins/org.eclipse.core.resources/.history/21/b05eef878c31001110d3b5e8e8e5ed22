	public ExternalGradeMechTestReqRes getTestMethodData(String testName, String normid, String extgrdnm) {
		if (extgrdnm != null) {
			Optional<ExtGrdJmEntity> extgrd = extGrdRepository.findByExtGrdNm(extgrdnm);
			if (extgrd.isPresent()) {
				normid = extgrd.get().getNormid();
			}
		}
		logger.info("Getting test method data for testName: {} and normid: {} and extgrdnm: {}", testName, normid,
				extgrdnm);

		ExternalGradeMechTestReqRes response = new ExternalGradeMechTestReqRes();
		if (testName.equals(OfsConstants.TENSILE_TEST)) {
			response.setTensileList(externalMechanicalCustRepository.getAllNormTensile(normid));
		}
		if (testName.equals(OfsConstants.BEND_TEST)) {
			response.setBendList(externalMechanicalCustRepository.getAllNormBend(normid));
		}
		if (testName.equals(OfsConstants.DWTT)) {
			response.setDwttList(externalMechanicalCustRepository.getAllNormDwtt(normid));
		}
		if (testName.equals(OfsConstants.IMPACT)) {
			response.setImpactList(externalMechanicalCustRepository.getAllNormImpact(normid));
		}
		if (testName.equals(OfsConstants.HARDNESS)) {
			response.setHardnessList(externalMechanicalCustRepository.getAllNormHardness(normid));
		}
		if (testName.equals(OfsConstants.HTTT)) {
			response.setHtttList(externalMechanicalCustRepository.getAllNormHttt(normid));
		}
		if (testName.equals(OfsConstants.INCLUSION_RATING)) {
			response.setInclusionList(externalMechanicalCustRepository.getAllNormInclusion(normid));
		}
		if (testName.equals(OfsConstants.Z_TEST)) {
			response.setZtestList(externalMechanicalCustRepository.getAllNormZtest(normid));
		}
		if (testName.equals(OfsConstants.SHT_CYCLES)) {
			response.setShtList(externalMechanicalCustRepository.getAllNormSht(normid));
		} else {
			response.setOtherTestList(externalMechanicalCustRepository.getAllNormOthr(normid));
		}

		return response;

	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public ExternalGradeMechTestReqRes saveTestMethodData(ExternalGradeMechTestReqRes request) {
		logger.info("Saving test method data for request: {}", request);
		dbSessionService.setSessionInfo(this.getClass().getName());
		ExternalGradeMechTestReqRes reqRes = new ExternalGradeMechTestReqRes();

		Optional<ExtGrdJmEntity> optionalExtGrd = extGrdRepository.findById(request.getExtgrdnm());

		if (optionalExtGrd.isPresent()) {
			String computedNormId = null;
			ExtGrdJmEntity extGrdEntity = optionalExtGrd.get();
			if (extGrdEntity.getNormid() != null) {
				computedNormId = extGrdEntity.getNormid();
			} else {
				NormmastJmEntity normmastJmEntity = new NormmastJmEntity();
				String maxCount = normMastEntityRepository.generateNormId();
				long newId = Long.parseLong(maxCount) + 1;
				normmastJmEntity.setNormid(Long.toString(newId));
				normmastJmEntity.setNormty("EG");
				normmastJmEntity = normMastEntityRepository.save(normmastJmEntity);
				computedNormId = normmastJmEntity.getNormid();
//				entityManager.flush();
				normMastEntityRepository.flush();
				extGrdEntity.setNormid(normmastJmEntity.getNormid());
				extGrdRepository.save(extGrdEntity);
			}
			final String normId = computedNormId;
			if (request.getTensileList() != null && !request.getTensileList().isEmpty()) {
				request.getTensileList().stream().forEach(e -> e.setNormid(normId));
				saveTensileTest(request);
			}

			if (request.getBendList() != null && !request.getBendList().isEmpty()) {
				request.getBendList().stream().forEach(e -> e.setNormid(normId));
				saveBendTest(request);
			}

			if (request.getDwttList() != null && !request.getDwttList().isEmpty()) {
				request.getDwttList().stream().forEach(e -> e.setNormid(normId));
				saveDwttTest(request);
			}

			if (request.getHardnessList() != null && !request.getHardnessList().isEmpty()) {
				request.getHardnessList().stream().forEach(e -> e.setNormid(normId));
				saveHardnessTest(request);
			}

			if (request.getHtttList() != null && !request.getHtttList().isEmpty()) {
				request.getHtttList().stream().forEach(e -> e.setNormid(normId));
				saveHttTest(request);
			}

			if (request.getImpactList() != null && !request.getImpactList().isEmpty()) {
				request.getImpactList().stream().forEach(e -> e.setNormid(normId));
				saveImpactTest(request);
			}

			if (request.getInclusionList() != null && !request.getInclusionList().isEmpty()) {
				request.getInclusionList().stream().forEach(e -> e.setNormid(normId));
				saveInclusionTest(request);
			}

			if (request.getOtherTestList() != null && !request.getOtherTestList().isEmpty()) {
				request.getOtherTestList().stream().forEach(e -> e.setNormid(normId));
				saveOtherTest(request);
			}

			if (request.getShtList() != null && !request.getShtList().isEmpty()) {
				request.getShtList().stream().forEach(e -> e.setNormid(normId));
				saveShtTest(request);
			}

			if (request.getZtestList() != null && !request.getZtestList().isEmpty()) {
				request.getZtestList().stream().forEach(e -> e.setNormid(normId));
				saveZTest(request);
			}
		}
		return reqRes;
	}

	private void saveZTest(ExternalGradeMechTestReqRes request) {
		logger.info("Saving ZTest data");
		dbSessionService.setSessionInfo(this.getClass().getName());
		List<NormztestJmEntity> entities = new ArrayList<>();

		request.getZtestList().forEach(item -> {
			NormztestJmEntity entity = new NormztestJmEntity();
			Optional<NormztestJmEntity> findRecord = ztestRepository
					.findById(item.getZtestid() != null ? item.getZtestid() : " ");
			if (findRecord.isPresent()) {

				entity = findRecord.get();
				entity.setMoBy(ClientIpUtils.getClient());
				entity.setMoDt(new Date());
				entity.setMoMacAddr(ClientIpUtils.getClientIpAddress());

			} else {
				List<NormztestJmEntity> maxVal = ztestRepository.findAll();
				int nextId = maxVal.size() + 1;
				entity.setZtestid(String.valueOf(nextId));
				entity.setNormid(item.getNormid());
				entity.setCrDt(new Date());
				entity.setCrBy(ClientIpUtils.getClient());
				entity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
			}

			entity.setMaxopr(item.getMaxopr());
			entity.setMinopr(item.getMinopr());
			entity.setReductionareamin(item.getReductionareamin());
			entity.setThkmax(item.getThkmax());
			entity.setThkmin(item.getThkmin());
			entity.setSpecification(item.getSpecification());
			entity.setIsactv(BigDecimal.ONE);

			entities.add(entity);
			ztestRepository.save(entity);
		});
	}

