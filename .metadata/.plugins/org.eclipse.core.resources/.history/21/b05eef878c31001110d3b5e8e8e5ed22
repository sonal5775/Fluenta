	private void saveInclusionTest(ExternalGradeMechTestReqRes request) {
		logger.info("Saving InclusionTest data");
		dbSessionService.setSessionInfo(this.getClass().getName());
		List<NorminclusionJmEntity> entities = new ArrayList<>();
		request.getInclusionList().forEach(item -> {
			NorminclusionJmEntity entity = new NorminclusionJmEntity();
			NormmastJmEntity mastEntity = new NormmastJmEntity();
			Optional<NormmastJmEntity> mastRecord = mastRepository
					.findById(item.getNormid() != null ? item.getNormid() : " ");
			if (mastRecord.isPresent()) {

				mastEntity = mastRecord.get();
				entity.setMoBy(ClientIpUtils.getClient());
				entity.setMoDt(new Date());
				entity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				mastEntity.setTmremarks(item.getTmremarks());
				mastRepository.save(mastEntity);
			}

			if (item.getInclusionid() != null && (item.getTyathickmax() != null || item.getTyathinmax() != null
					|| item.getTybthickmax() != null || item.getTybthinmax() != null && item.getTycthickmax() != null
					|| item.getTycthinmax() != null || item.getTydthickmax() != null || item.getTydthinmax() != null
					|| item.getDirection() != null)) {
				Optional<NorminclusionJmEntity> findRecord = inclusionRepository
						.findById(item.getInclusionid() != null ? item.getInclusionid() : " ");
				if (mastRecord.isPresent()) {
					entity = findRecord.get();
					entity.setMoBy(ClientIpUtils.getClient());
					entity.setMoDt(new Date());
					entity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				} else {
					entity.setCrBy(ClientIpUtils.getClient());
					entity.setCrDt(new Date());
					entity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
				}

				entity.setTyathickmax(item.getTyathickmax());
				entity.setTyathinmax(item.getTyathinmax());
				entity.setTybthickmax(item.getTybthickmax());
				entity.setTybthinmax(item.getTybthinmax());
				entity.setTycthickmax(item.getTycthickmax());
				entity.setTycthinmax(item.getTycthinmax());
				entity.setTydthickmax(item.getTydthickmax());
				entity.setTydthinmax(item.getTydthinmax());
				entity.setDirection(
						OfsConstants.SELECT_OPTION.equals(item.getDirection()) ? null : item.getDirection());
				entity.setIsactv(BigDecimal.ONE);

				entities.add(entity);
				inclusionRepository.save(entity);

			} else if (item.getInclusionid() == null && item.getTyathickmax() != null || item.getTyathinmax() != null
					|| item.getTybthickmax() != null || item.getTybthinmax() != null || item.getTycthickmax() != null
					|| item.getTycthinmax() != null || item.getTydthickmax() != null || item.getTydthinmax() != null
					|| item.getDirection() != null) {
				// Set new ID only if the record is not found
				List<NorminclusionJmEntity> maxVal = inclusionRepository.findAll();
				int nextId = maxVal.size() + 1;
				entity.setInclusionid(String.valueOf(nextId));
				entity.setNormid(item.getNormid());
				entity.setTyathickmax(item.getTyathickmax());
				entity.setTyathinmax(item.getTyathinmax());
				entity.setTybthickmax(item.getTybthickmax());
				entity.setTybthinmax(item.getTybthinmax());
				entity.setTycthickmax(item.getTycthickmax());
				entity.setTycthinmax(item.getTycthinmax());
				entity.setTydthickmax(item.getTydthickmax());
				entity.setTydthinmax(item.getTydthinmax());
				entity.setDirection(
						OfsConstants.SELECT_OPTION.equals(item.getDirection()) ? null : item.getDirection());
				entity.setIsactv(BigDecimal.ONE);

				entities.add(entity);
				inclusionRepository.save(entity);
			}

		});
	}

