public Page<Object[]> getGroupingListData(String queryForGrouping, String queryForGroupingAndFilteringCount,
		Integer page, Integer size, Integer skip, OrderBookRequest request, String status) {
    // Step 1: Count Query
    Query queryCount = entityManager.createQuery(queryForGroupingAndFilteringCount);
    queryCount.setParameter(OfsConstants.SO_NUMBER, request.getSoNumber());
    queryCount.setParameter(OfsConstants.ITEM, request.getItem());
    queryCount.setParameter(OfsConstants.CUSTOMER_NAME, request.getCustomerName());
	queryCount.setParameter(OfsConstants.PRODUCT, request.getProduct());
	queryCount.setParameter(OfsConstants.SO_STATUS, request.getSoStatus());
	queryCount.setParameter(OfsConstants.THK_MIN, request.getThkmin());
	queryCount.setParameter(OfsConstants.THK_MAX, request.getThkmax());
	queryCount.setParameter(OfsConstants.WDT_MIN, request.getWdtmin());
	queryCount.setParameter(OfsConstants.WDT_MAX, request.getWdtmax());
	queryCount.setParameter(OfsConstants.SO_STATUS, request.getSoStatus());
	queryCount.setParameter(OfsConstants.PLANTCODE, OfsConstants.PLANT_CODE);
    
    Number resultNumber = (Number) queryCount.getSingleResult();
    int totalRows = resultNumber.intValue();

    // Step 2: Adjust effective offset considering SKIP and PAGE SIZE
    int effectiveOffset = page * size;
    int effectivePageSize = size;

    if (skip != null && skip > 0) {
        if (skip >= size) {
            effectiveOffset += skip; // Move to the next offset if skip exceeds size
            skip = 0; // Skip is already included in the offset
        } else {
            effectiveOffset += skip;
            effectivePageSize -= skip; // Adjust the size to consider the skip
        }
    }

    // Step 3: Pageable object for response
    Pageable pageable = PageRequest.of(page, size);

    // Step 4: Data Query
    TypedQuery<Object[]> query = entityManager.createQuery(queryForGrouping, Object[].class);
    query.setParameter(OfsConstants.SO_NUMBER, request.getSoNumber());
    query.setParameter(OfsConstants.ITEM, request.getItem());
    query.setParameter(OfsConstants.CUSTOMER_NAME, request.getCustomerName());
