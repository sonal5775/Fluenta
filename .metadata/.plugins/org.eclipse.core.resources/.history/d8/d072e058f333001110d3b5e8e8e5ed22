	public Page<OrderBookViewDto> getOrderBookViewDetails(OrderBookRequest request, int page, int size, String query,
			String countQueryParm) {

		
		TypedQuery<OrderBookViewDto> q = entityManager.createQuery(query, OrderBookViewDto.class);
		q.setParameter(OfsConstants.SO_NUMBER, request.getSoNumber());
		q.setParameter(OfsConstants.ITEM, request.getItem());
		q.setParameter(OfsConstants.CUSTOMER_NAME, request.getCustomerName());
		q.setParameter(OfsConstants.PRODUCT, request.getProduct());
		q.setParameter(OfsConstants.SO_STATUS, request.getSoStatus());
		q.setParameter(OfsConstants.THK_MIN, request.getThkmin());
		q.setParameter(OfsConstants.THK_MAX, request.getThkmax());
		q.setParameter(OfsConstants.WDT_MIN, request.getWdtmin());
		q.setParameter(OfsConstants.WDT_MAX, request.getWdtmax());
		q.setParameter(OfsConstants.SO_STATUS, request.getSoStatus());
		q.setParameter(OfsConstants.PLANTCODE, OfsConstants.PLANT_CODE);
		q.setParameter(OfsConstants.BATCH_DISPATCH, OfsConstants.BATCH_DISPATCHED.toUpperCase());
		q.setParameter(OfsConstants.BATCH_STS_AVAILABLE, OfsConstants.BATCH_AVAILABLE.toUpperCase());
		q.setParameter(OfsConstants.BATCH_STS_RFD, OfsConstants.BATCH_READY_FOR_DISPATCH.toUpperCase());
		q.setParameter(OfsConstants.STOCK_STATUS_LIST, invStatusListForStock);
		q.setFirstResult(page * size);
		q.setMaxResults(size);
		List<OrderBookViewDto> resultList = q.getResultList();

		Query countQuery = entityManager.createQuery(countQueryParm);
		countQuery.setParameter(OfsConstants.SO_NUMBER, request.getSoNumber());
		countQuery.setParameter(OfsConstants.ITEM, request.getItem());
		countQuery.setParameter(OfsConstants.CUSTOMER_NAME, request.getCustomerName());
		countQuery.setParameter(OfsConstants.PRODUCT, request.getProduct());
		countQuery.setParameter(OfsConstants.SO_STATUS, request.getSoStatus());
		countQuery.setParameter(OfsConstants.THK_MIN, request.getThkmin());
		countQuery.setParameter(OfsConstants.THK_MAX, request.getThkmax());
		countQuery.setParameter(OfsConstants.WDT_MIN, request.getWdtmin());
		countQuery.setParameter(OfsConstants.WDT_MAX, request.getWdtmax());
		countQuery.setParameter(OfsConstants.SO_STATUS, request.getSoStatus());
		countQuery.setParameter(OfsConstants.PLANTCODE, OfsConstants.PLANT_CODE);

		Long totalRows = (Long) countQuery.getSingleResult();

		Pageable pageable = PageRequest.of(page, size);
		return new PageImpl<>(resultList, pageable, totalRows);
	}

	public List<SegmentDto> getSegments(String prdid) {

		TypedQuery<SegmentDto> q = entityManager.createQuery("SELECT new com.hindindustec.fluenta.sales.dto.SegmentDto("
				+ "SUM(sol.soqty)," + "SUM(CASE WHEN UPPER(sol.sosegmt) = 'EXPORT' THEN sol.soqty ELSE 0 END),"
				+ "SUM(CASE WHEN UPPER(sol.sosegmt) = 'RETAIL' THEN sol.soqty ELSE 0 END),"
				+ "SUM(CASE WHEN UPPER(sol.sosegmt) = 'OEM' THEN sol.soqty ELSE 0 END),"
				+ "SUM(CASE WHEN UPPER(sol.sosegmt) = 'EXPORT' AND UPPER(sol.sosts) = :DISPATCHED THEN sol.soqty ELSE 0 END),"
				+ "SUM(CASE WHEN UPPER(sol.sosegmt) = 'RETAIL' AND UPPER(sol.sosts) = :DISPATCHED THEN sol.soqty ELSE 0 END),"
				+ "SUM(CASE WHEN UPPER(sol.sosegmt) = 'OEM' AND UPPER(sol.sosts) = :DISPATCHED THEN sol.soqty ELSE 0 END),"
				+ "SUM(CASE WHEN UPPER(sol.sosegmt) = 'EXPORT' AND UPPER(sol.sosts) = 'RFD' THEN sol.soqty ELSE 0 END),"
				+ "SUM(CASE WHEN UPPER(sol.sosegmt) = 'RETAIL' AND UPPER(sol.sosts) = 'RFD' THEN sol.soqty ELSE 0 END),"
				+ "SUM(CASE WHEN UPPER(sol.sosegmt) = 'OEM' AND UPPER(sol.sosts) = 'RFD' THEN sol.soqty ELSE 0 END)"
				+ ")" + " FROM SolSt sol" + " where sol.prdid = :prdid ", SegmentDto.class);

		q.setParameter("prdid", prdid);
		q.setParameter("DISPATCHED", OfsConstants.DISPATCHED);
		return q.getResultList();

	}

	public List<String> getSo() {
		TypedQuery<String> q = entityManager.createQuery("SELECT distinct (sl.id.soid) from SolSt sl"
				 + " order by sl.id.soid desc", String.class);
		return q.getResultList();
	}
	


	public List<String> getProductByType(String productType) {
		TypedQuery<String> q = entityManager.createQuery(
				"SELECT distinct (p.prdid) from PrdCs p"
						+ " where p.prdty = :productType"
						+ " order by p.prdid asc",
				String.class);
		q.setParameter("productType", productType);
		return q.getResultList();
	}

	public List<Long> getSoItem() {
		TypedQuery<Long> q = entityManager.createQuery("SELECT distinct (sl.id.solid) from SolSt sl"
				+ " where sl.id.solid is not null" + " order by sl.id.solid asc", Long.class);
		return q.getResultList();
	}

	public BigDecimal getSoqty(OrderBookRequest request) {
			TypedQuery<BigDecimal> q = entityManager.createQuery(
			    "SELECT ROUND(COALESCE(SUM(po2.poprqty), 0), 0) "
			    + "FROM PoprplSt po3, PoprlSt po2, PohSt po1, SolSt sol, SolbomdSt sob, SohSt soh "
			    + "WHERE po3.id.poid = po2.id.poid "
			    + "AND po3.id.poprctr = po2.id.poprctr "
			    + "AND po3.id.poid = po1.poid "
			    + "AND po1.soid = sol.id.soid "
			    + "AND po1.solid = sol.id.solid "
			    + "AND soh.soid = po1.soid "
			    + "AND po2.soid = sob.id.soid "
			    + "AND po2.solid = sob.id.solid "
			    + "AND po2.opprdid = sob.id.prdid "
			    + "AND po2.dimind = sob.id.dimind "
			    + "AND po3.id.plid = 'HSM1' "
			    + "AND sol.erpsosts = :soStatus "
			    + "AND sol.sosts = :soStatus "
			    + "AND (:soNumber IS NULL OR sol.id.soid = :soNumber) "
			    + "AND (:item IS NULL OR sol.id.solid = :item) "
			    + "AND (:product IS NULL OR sol.prdid = :product) "
			    + "AND (:thkmin IS NULL OR sob.thkaim >= :thkmin) "
			    + "AND (:thkmax IS NULL OR sob.thkaim <= :thkmax) "
			    + "AND (:wdtmin IS NULL OR sob.wdtaim >= :wdtmin) "
			    + "AND (:wdtmax IS NULL OR sob.wdtaim <= :wdtmax) "
			    + "AND (:customerName IS NULL OR sol.stcustnm = :customerName) "
			    + "GROUP BY sol.id.soid, sol.id.solid", BigDecimal.class);

			q.setParameter("soNumber", request.getSoNumber());
			q.setParameter("item", request.getItem());
			q.setParameter("customerName", request.getCustomerName());
			q.setParameter("thkmin", request.getThkmin());
			q.setParameter("thkmax", request.getThkmax());
			q.setParameter("wdtmin", request.getWdtmin());
			q.setParameter("wdtmax", request.getWdtmax());
			q.setParameter("soStatus", request.getSoStatus());
			q.setParameter("product", request.getProduct());
			return q.getSingleResult();

	}
	
