public Page<OrderBookViewDto> getSlabStocks(OrderBookRequest request,String status, int page, int size,String query,String countQueryParm,Integer skip){
    // Step 1: Calculate effective OFFSET and PAGE SIZE
    int effectiveOffset = page * size;
    int effectivePageSize = size;
    
    if (skip != null && skip > 0) {
        if (skip >= size) {
            effectiveOffset += skip; // Adjust the offset by skipping additional rows
            skip = 0; // Reset skip as it's already accounted for
        } else {
            effectiveOffset += skip; 
            effectivePageSize -= skip; // Adjust the size to exclude skipped rows
        }
    }

    // Step 2: Query for Results
    TypedQuery<OrderBookViewDto> q = entityManager.createQuery(query, OrderBookViewDto.class);
    q.setParameter(OfsConstants.SO_NUMBER, request.getSoNumber());
	q.setParameter(OfsConstants.ITEM, request.getItem());
	q.setParameter(OfsConstants.PRODUCT, request.getProduct());
	q.setParameter(OfsConstants.THK_MIN, request.getThkmin());
	q.setParameter(OfsConstants.THK_MAX, request.getThkmax());
	q.setParameter(OfsConstants.WDT_MIN, request.getWdtmin());
	q.setParameter(OfsConstants.WDT_MAX, request.getWdtmax());	
	q.setParameter(OfsConstants.CUSTOMER_NAME, request.getCustomerName());	
	q.setParameter(OfsConstants.SO_STATUS, request.getSoStatus());
	q.setParameter(OfsConstants.PLANTCODE, OfsConstants.PLANT_CODE);
	q.setParameter(OfsConstants.BATCH_DISPATCH, OfsConstants.BATCH_DISPATCHED.toUpperCase());
	q.setParameter(OfsConstants.BATCH_STS_AVAILABLE, OfsConstants.BATCH_AVAILABLE.toUpperCase());
	q.setParameter(OfsConstants.BATCH_STS_RFD, OfsConstants.BATCH_READY_FOR_DISPATCH.toUpperCase());
	q.setParameter(OfsConstants.STOCK_STATUS_LIST, invStatusListForStock);
	//q.setFirstResult(page * size);
	//q.setMaxResults(size);

    q.setFirstResult(effectiveOffset);
    q.setMaxResults(effectivePageSize);
    List<OrderBookViewDto> resultList = q.getResultList();

    // Step 3: Query for Count
    Query countQuery = entityManager.createQuery(countQueryParm);

       
    countQuery.setParameter(OfsConstants.SO_NUMBER, request.getSoNumber());
	countQuery.setParameter(OfsConstants.ITEM, request.getItem());
	countQuery.setParameter(OfsConstants.CUSTOMER_NAME, request.getCustomerName());
	countQuery.setParameter(OfsConstants.PRODUCT, request.getProduct());
	countQuery.setParameter(OfsConstants.SO_STATUS, request.getSoStatus());
	countQuery.setParameter(OfsConstants.THK_MIN, request.getThkmin());
	countQuery.setParameter(OfsConstants.THK_MAX, request.getThkmax());
	countQuery.setParameter(OfsConstants.WDT_MIN, request.getWdtmin());
	countQuery.setParameter(OfsConstants.WDT_MAX, request.getWdtmax());
	countQuery.setParameter(OfsConstants.SO_STATUS, request.getSoStatus());
	countQuery.setParameter(OfsConstants.PLANTCODE, OfsConstants.PLANT_CODE);
    

    Long totalRows = (Long) countQuery.getSingleResult();
    // Step 4: Pageable and PageImpl
    Pageable pageable = PageRequest.of(page, size);
    return new PageImpl<>(resultList, pageable, totalRows);
	
}

