	@SuppressWarnings("unchecked")
	private <T> T buildGroupedDataResponse(Page<Object[]> groupingListData, Long mainQueryCount, Long totalDistCount) {
	    GroupedDataResponse<OrderBookViewDto> result = new GroupedDataResponse<>(null, 0L, 0L);
	    List<Group<OrderBookViewDto>> list = new ArrayList<>();

	    for (Object[] row : groupingListData) {
	        String groupKey = row[0] instanceof BigDecimal
	                ? ((BigDecimal) row[0]).toPlainString()
	                : String.valueOf(row[0]);
	        Long count = row[1] instanceof BigDecimal
	                ? ((BigDecimal) row[1]).longValue()
	                : (Long) row[1];
	        list.add(new Group<>(groupKey, null, count));
	    }

	    result.setData(list);
	    result.setTotalCount(mainQueryCount);
	    result.setGroupCount(totalDistCount);
	    return (T) result;
	}
	
	
	
	private <T> T handleGroupOnly(OrderBookRequest slabStockRequest, List<String> groupList, int pageNumber,
			int pageSize, int skip, String status,Integer pageStore, Integer latestGroupCount) {
		pageSize = pageNumber + pageSize;
		pageNumber = 0;
		String groupQuery = getQueryForGrouping(groupList,status);
	    String groupCountQuery = getQueryForGroupingCount(groupList,status);
		String mainCountQuery = salesOrderBookCustRepository.countMainQuery;
		Long mainQueryCount = salesOrderBookCustRepository.getMainSlabeStockQueryCount(slabStockRequest,mainCountQuery,status);
	    Page<Object[]> groupingListData = salesOrderBookCustRepository.getGroupingListData(groupQuery, groupCountQuery,pageNumber,pageSize, skip,slabStockRequest,status);
		Long totalDistCount = salesOrderBookCustRepository.groupCountQuery(groupCountQuery,slabStockRequest,status);
		return buildGroupedDataResponse(groupingListData, mainQueryCount, totalDistCount);
	}
	
	
	
	
	private String getQueryForGrouping(List<String> groupList, String status) {
		if (groupList == null || groupList.isEmpty()) {
	        throw new IllegalArgumentException("groupList cannot be null or empty");
	    }
		
		String desc = groupList.get(3);
	    String groupColumn = groupList.get(1); 
	    StringBuilder query = new StringBuilder();
		query.append("SELECT ")
		.append(checkClassAleas().get(groupColumn))
		.append(groupColumn)	
		.append(" ,COUNT(*")
		.append(")")
		.append(salesOrderBookCustRepository.countFromQuery);

		query.append(" GROUP BY "+checkClassAleas().get(groupColumn)+""+groupColumn+" ");
		
		if ("true".equals(desc)) {
		    query.append(" ORDER BY ").append(checkClassAleas().get(groupColumn)).append(groupColumn).append(" DESC");
		} else {
		    query.append(" ORDER BY ").append(checkClassAleas().get(groupColumn)).append(groupColumn);
		}
		return query.toString();
	}
	
	
	
	
	private String getQueryForGroupingCount(List<String> groupList, String status) {
		String groupColumn = groupList.get(1); // Assuming the second element is the group column
		StringBuilder query = new StringBuilder();
		query.append("SELECT ")
		.append("COUNT( DISTINCT ")
		.append(checkClassAleas().get(groupColumn))
		.append(groupColumn)
		.append(")")
		.append(salesOrderBookCustRepository.countFromQuery);
		return query.toString();
	}

