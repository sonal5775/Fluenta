	@Override
	public <T> T getSlabStocks(OrderBookRequest slabStockRequest, String status, int pageNumber, int pageSize,
			String filter, String sort, String group, int skip, boolean requireTotalCount, boolean requireGroupCount,
			String searchValue, Integer pageStore, Integer latestGroupCount) {
		
		if(slabStockRequest.getSoStatus()==null || "".equals(slabStockRequest.getSoStatus())) {
			slabStockRequest.setSoStatus(OfsConstants.SO_STATUS_OPEN);;
		}
		
		List<String> filterList = DevExtGridFilterUtils.extractElements(filter);

		// new
		int[] pageSizeArr = processPageAndSize(pageNumber, pageSize, pageStore);
		pageNumber = pageSizeArr[0];
		pageSize = pageSizeArr[1];

		List<String> groupList = DevExtGridFilterUtils.getSortListFromString(group);

		List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);
		 if (DevExtGridFilterUtils.isGroupWithoutFilterOrSort(group, filter, sort)) {
		     return handleGroupOnly(slabStockRequest, groupList, pageNumber, pageSize, skip,status,pageStore,latestGroupCount);
		 }
		 
		 if (DevExtGridFilterUtils.isGroupWithFilterOrSort(group, filter, sort)) {
		     return handleGroupWithFilterOrSort(slabStockRequest, groupList, filterList, sortList, pageNumber, pageSize, skip,requireTotalCount,status,pageStore,latestGroupCount);
		 }

		if (DevExtGridFilterUtils.isFilterOrSortOnly(group, filter, sort)) {
			return handleFilterOrSort(slabStockRequest, filterList, sortList, pageNumber, pageSize, skip,
					requireTotalCount, status, pageStore, latestGroupCount);
		}

		return null;
		// old
	}

	public String filterQueryUsingFilterList(List<String> filterList, String query, OrderBookRequest request) {
		String productType = request.getProduct();
		StringBuilder queryBuilder = new StringBuilder(query);
		queryBuilder.append(" AND (");

		List<String> columnNames = DevExtGridFilterUtils.getAllFields(OrderBookViewDto.class);

		Map<String, String> columnDataTypesKeyValuePair = DevExtGridFilterUtils
				.getAllFieldsWithTypes(OrderBookViewDto.class);
		Map<String, String> columnAlise = checkClassAleas();
		boolean isClobObject = false;
		boolean isStringObject = false;
		boolean isDateObject = false;
		boolean isContains = false;
		boolean isNotContains = false;
		boolean isStartWith = false;
		boolean isEndWith = false;

		for (int i = 0; i < filterList.size(); i++) {
			String item = filterList.get(i);

			if (columnNames.contains(item)) {
				if (columnDataTypesKeyValuePair.get(item).equals("CLOB")) {
					queryBuilder.append("DBMS_LOB.INSTR(").append(columnAlise.get(item)).append(item).append(",");
					isClobObject = true;
				} else if (columnDataTypesKeyValuePair.get(item).equals("DATE")) {
					queryBuilder.append(" TO_CHAR(").append(columnAlise.get(item)).append(item)
							.append(", 'YYYY-MM-DD')");
					isDateObject = true;
				} else if (columnDataTypesKeyValuePair.get(item).equals("VARCHAR2")) {
					if (item.equals("externalGrade")) {
						int ind = filterList.indexOf(item);
						if (CONTAINS.equalsIgnoreCase(filterList.get(ind + 1))) {
							queryBuilder.append(" CONCAT(sol.eqSpec, sol.eqSpecGroup, sol.eqSpecSubGroup) LIKE '%")
									.append(filterList.get(ind + 2)).append("%' ");
						}
						i += 2;
					} else {
						queryBuilder.append(columnAlise.get(item)).append(item);
					}
					isStringObject = true;
				}

				else {
					if (item.equals("dispatchWgt")) {
						int btrQtyindez = filterList.indexOf("dispatchWgt");
						String dispatchWgtQuery = String.format("""
								ROUND(COALESCE((
								    SELECT SUM(PPH.wgt * PPRT.bwyld)
								    FROM PphMt PPH, PpRouteDtlEntity PPRT
								    WHERE PPH.poid = po2.id.poid
								      AND PPH.poprctr = po2.id.poprctr
								      AND PPH.ppsts = 'DISPATCHED'
								      AND PPH.id.ppid = PPRT.id.ppid
								      AND PPH.id.ppctr = PPRT.id.ppctr
								      AND PPRT.prdid = '%s'
								      AND PPRT.completionsts = 'COMPLETE'
								), 0), 0)
								""", productType);

						queryBuilder.append(dispatchWgtQuery).append(filterList.get(btrQtyindez + 1)).append(" ")
								.append(filterList.get(btrQtyindez + 2));
						i += 2;
					} else if (item.equals("stockWgt")) {
						int stockWgtIndex = filterList.indexOf("stockWgt");
						String stockWgtQuery = String.format(
								"""
										ROUND(COALESCE((
										    SELECT SUM(PPH.wgt * PPRT.bwyld)
										    FROM PphMt PPH, PpRouteDtlEntity PPRT
										    WHERE PPH.poid = po2.id.poid
										      AND PPH.poprctr = po2.id.poprctr
										      AND PPH.ppsts IN ('PRODUCED', 'CONF PENDING@PROD', 'CONF PENDING@QA', 'HOLD', 'INSP PENDING', 'AVAILABLE', 'SCHEDULED', 'IDENTIFIED', 'CHARGED', 'CONS PENDING', 'CONSUMED', 'READY FOR DISPATCH', 'DISPATCHED', 'MATERIAL RELEASED', 'LOADED')
										      AND PPH.id.ppid = PPRT.id.ppid
										      AND PPH.id.ppctr = PPRT.id.ppctr
										      AND PPRT.prdid = '%s'
										      AND PPRT.completionsts = 'DISPATCHED'
										), 0), 0)
										""",
								productType);

						queryBuilder.append(stockWgtQuery).append(filterList.get(stockWgtIndex + 1)).append(" ")
								.append(filterList.get(stockWgtIndex + 2));
						i += 2;
					} else if (item.equals("scheduledQty")) {
						int scheduledQtyIndex = filterList.indexOf(item);
						String scheduledQtyQuery = String.format("""
								ROUND(COALESCE((
								    SELECT SUM(sh3.slbwgt)
								    FROM HsmSchOrderEntity sh2, HsmSchSlabDtlEntity sh3
								    WHERE sh2.poid = po2.id.poid
								      AND sh2.poprctr = po2.id.poprctr
								      AND sh2.id.schdid = sh3.id.schdid
								      AND sh2.id.poseqid = sh3.poseqid
								      AND sh3.schdslbsts IN ('SCHEDULED', 'IDENTIFIED', 'CHARGED')
								), 0), 0)
								""");
						queryBuilder.append(scheduledQtyQuery).append(filterList.get(scheduledQtyIndex + 1)).append(" ")
								.append(filterList.get(scheduledQtyIndex + 2));

						i += 2;
					} else if (item.equals("availableWgt")) {
						int availableWgtIndex = filterList.indexOf("availableWgt");
						String availableWgtQuery = String.format("""
								ROUND(COALESCE((
								    SELECT SUM(p.wgt)
								    FROM PphMt p
								    WHERE p.poid = po2.id.poid
								      AND p.poprctr = po2.id.poprctr
								      AND p.ppsts = 'AVAILABLE'
								), 0), 0)
								""");

						queryBuilder.append(availableWgtQuery).append(filterList.get(availableWgtIndex + 1)).append(" ")
								.append(filterList.get(availableWgtIndex + 2));
						i += 2;

					} else if ("rfdWgt".equals(item)) {
						int rfdWgtIndex = filterList.indexOf("rfdWgt");
						String rfdWgtQuery = String.format("""
								ROUND(COALESCE((
								    SELECT SUM(p.wgt)
								    FROM PphMt p
								    WHERE p.poid = po2.id.poid
								      AND p.poprctr = po2.id.poprctr
								      AND p.ppsts = 'READY FOR DISPATCH'
								), 0), 0)
								""");

						queryBuilder.append(rfdWgtQuery).append(filterList.get(rfdWgtIndex + 1)).append(" ")
								.append(filterList.get(rfdWgtIndex + 2));
						i += 2;
					} else {
						// Check the data type before applying TRIM()
						String dataType = columnDataTypesKeyValuePair.get(item);
						if ("VARCHAR2".equalsIgnoreCase(dataType) || "STRING".equalsIgnoreCase(dataType)) {
							queryBuilder.append("UPPER(TRIM(").append(columnAlise.get(item)).append(item).append("))");
						} else {
							// For non-string fields, just append the column alias and item
							queryBuilder.append(columnAlise.get(item)).append(item);
						}
					}
				}
			} else if (item.equals(CONTAINS) || item.equals(NOTCONTAINS) || item.equals(STARTSWITH)
					|| item.equals(ENDSWITH)) {
				if (isClobObject) {
					//
				} else if (isDateObject) {
					queryBuilder.append(LIKE);
				} else {
					if (item.equals(CONTAINS)) {
						queryBuilder.append(LIKE);
						isContains = true;
					} else if (item.equals(NOTCONTAINS)) {
						queryBuilder.append(NOT_LIKE);
						isNotContains = true;
					} else if (item.equals(STARTSWITH)) {
						queryBuilder.append(LIKE);
						isStartWith = true;
					} else if (item.equals(ENDSWITH)) {
						queryBuilder.append(LIKE);
						isEndWith = true;
					} else {
						queryBuilder.append(" = ");
					}
				}
			} else if (item.equals("or") || item.equals("and")) {
				queryBuilder.append(" ").append(item).append(" ");
			} else if (item.equals("=") || item.equals("<>") || item.equals(">=") || item.equals("<")
					|| item.equals(">")) {
				queryBuilder.append(" ").append(item);
			} else {
				if (isClobObject) {
					queryBuilder.append("'").append(item).append("') > 0");
					isClobObject = false;
				} else if (isStringObject) {
					if (isContains) {
						queryBuilder.append(" UPPER(TRIM('%").append(item).append("%'))");
						isContains = false;
					} else if (isNotContains) {
						queryBuilder.append(" UPPER(TRIM('%").append(item).append("%'))");
						isNotContains = false;
					} else if (isStartWith) {
						queryBuilder.append(" UPPER(TRIM('").append(item).append("%'))");
						isStartWith = false;
					} else if (isEndWith) {
						queryBuilder.append(" UPPER(TRIM('%").append(item).append("'))");
						isEndWith = false;
					} else {
						queryBuilder.append(" UPPER(TRIM('").append(item).append("'))");
					}

					isStringObject = false;
				} else if (isDateObject) {
					try {
						DateTimeFormatter formatter = DateTimeFormatter.ISO_OFFSET_DATE_TIME;
						OffsetDateTime dateTime = OffsetDateTime.parse(item, formatter);
						String dateOnly = dateTime.toLocalDate().toString();
						queryBuilder.append(" '").append(dateOnly).append("'");
					} catch (Exception e) {
						LocalDateTime dateTime = LocalDate.parse(item, DateTimeFormatter.ISO_LOCAL_DATE).atStartOfDay();
						String dateString = dateTime.toLocalDate().toString();
						queryBuilder.append(" '").append(dateString).append("'");
					}
					isDateObject = false;
				} else {
					queryBuilder.append(" ").append(item);
				}
			}
		}
		queryBuilder.append(" )");
		return queryBuilder.toString();
	}

	private void appendFilterCondition(StringBuilder queryBuilder, List<String> filterList, int index) {
		String operator = filterList.get(index + 1).toLowerCase();
		String value = filterList.get(index + 2);

		switch (operator) {
		case CONTAINS:
			queryBuilder.append("LIKE '%").append(value).append("%'");
			break;
		case NOTCONTAINS:
			queryBuilder.append("NOT LIKE '%").append(value).append("%'");
			break;
		case STARTSWITH:
			queryBuilder.append("LIKE '").append(value).append("%'");
			break;
		case ENDSWITH:
			queryBuilder.append("LIKE '%").append(value).append("'");
			break;
		default:
			queryBuilder.append(" = '").append(value).append("'");
			break;
		}
	}

