@Service
public class QcMtestBulkRecordServiceImpl implements QcMtestBulkRecordService {

	private static final Logger LOGGER = LoggerFactory.getLogger(QcMtestBulkRecordServiceImpl.class);

	private QcMtestBulkRecordCustRepository bulkRecordCustRepository;
	private DBSessionService dbSessionService;
	private TestordlQtRepository lineQtRepository;
	private PostProdTaskMtRepository postProdTaskMtRepository;
	private SpecimenQualityTransactionRepository specimenQtRepository;
	private PpspecimanMapQtRepository ppspecimanMapQtRepository;
	private SapServiceClient sapServiceClient;
	private SapInterface sapInterface;
	private EntityManager entityManager;

	public QcMtestBulkRecordServiceImpl(QcMtestBulkRecordCustRepository bulkRecordCustRepository,
			DBSessionService dbSessionService, TestordlQtRepository lineQtRepository,
			PostProdTaskMtRepository postProdTaskMtRepository,
			SpecimenQualityTransactionRepository specimenQtRepository,
			PpspecimanMapQtRepository ppspecimanMapQtRepository, SapServiceClient sapServiceClient,
			SapInterface sapInterface,EntityManager entityManager) {
		super();
		this.bulkRecordCustRepository = bulkRecordCustRepository;
		this.dbSessionService = dbSessionService;
		this.lineQtRepository = lineQtRepository;
		this.postProdTaskMtRepository = postProdTaskMtRepository;
		this.specimenQtRepository = specimenQtRepository;
		this.ppspecimanMapQtRepository = ppspecimanMapQtRepository;
		this.sapServiceClient = sapServiceClient;
		this.sapInterface = sapInterface;
		this.entityManager = entityManager;
	}

	@Override
	public List<TestedCoilsDto> getMtestBulkRecords(TestedCoilRequest request) {
		return bulkRecordCustRepository.getMtestBulkRecords(request);
	}

	@Override
	public ResponseEntity<FluentaApiResponse<List<String>>> getHeatId() {
		List<String> heatId = bulkRecordCustRepository.getHeatId();
		return ResponseUtil.createResponse(heatId, "Fetching Heat Ids", true);
	}

	@Override
	public ResponseEntity<FluentaApiResponse<List<MappedCoilsDto>>> getMappedCoils(MappedCoilRequest request) {
		List<MappedCoilsDto> list = bulkRecordCustRepository.getMappedCoils(request);
		return ResponseUtil.createResponse(list, "Fetching Mapped Coils", true);
	}

	@Override
	public ResponseEntity<FluentaApiResponse<List<AssociateCoilsDto>>> getMappingPendingCoils(
			MappedCoilRequest request) {
		List<AssociateCoilsDto> list = bulkRecordCustRepository.getMappingPendingCoils(request);
		return ResponseUtil.createResponse(list, "Fetching Pending Mapped Coils", true);
	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public ResponseEntity<FluentaApiResponse<List<AssociateCoilsDto>>> save(List<AssociateCoilsDto> request) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		ResponseEntity<FluentaApiResponse<List<AssociateCoilsDto>>> response = null;
		List<HsmQualityChemicalDto> payload = new ArrayList<>();
		List<HsmQualityMechanicalDto> mechpayload = new ArrayList<>();
		for (AssociateCoilsDto dto : request) {
			Optional<TestOrderLineQualityListEntity> testOrderEntities = lineQtRepository.findTestOrdIdByPpidAndTpiFlag(
					dto.getTestedCoilPpId(), QualityConstants.HSM_LAB.equals(dto.getTpiRequired()) ? "N" : "Y");

			if (!testOrderEntities.isEmpty()) {
				TestOrderLineQualityListEntity existingEntity = testOrderEntities.get();
				TestOrderLineQualityListEntity lineEntity = null;
				Optional<TestOrderLineQualityListEntity> lineByTestOrdIdAndPpid = lineQtRepository.getLineByTestOrdIdAndPpid(existingEntity.getId().gettestOrderId(),dto.getCoilId());
				if(lineByTestOrdIdAndPpid.isPresent()) {
					lineEntity = lineByTestOrdIdAndPpid.get();
					lineEntity.setModifiedBy(ClientIpUtils.getClient());
					lineEntity.setModifiedDate(new Date());
					lineEntity.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());
				}else {
					lineEntity = new TestOrderLineQualityListEntity();
					TestOrderLineQualityListPkEntity pk = new TestOrderLineQualityListPkEntity();
					pk.settestOrderId(existingEntity.getId().gettestOrderId());
					Long findMaxPpSlNo = lineQtRepository.findMaxPpSlNo(existingEntity.getId().gettestOrderId());
					pk.setppslNo(findMaxPpSlNo + 1);
					lineEntity.setId(pk);
					lineEntity.setCreatedBy(ClientIpUtils.getClient());
					lineEntity.setCreatedDate(new Date());
					lineEntity.setCreatedMacAddress(ClientIpUtils.getClientIpAddress());
				}
				lineEntity.setPpId(dto.getCoilId());
				lineEntity.setPpCtr(0l);
				lineEntity.setSlabId(dto.getSlabId());
				lineEntity.setPoid(existingEntity.getPoid());
				lineEntity.setScheduleId(dto.getScheduleNo());
				lineEntity.setScheduleSequenceId(dto.getSchdSeqId());
				lineEntity.setSampleCutFlag("N");
				lineEntity.setIsActive(BigDecimal.ONE);
				lineEntity.setSampleId(existingEntity.getSampleId());
				lineEntity.setOrderItemId(existingEntity.getOrderItemId());
				lineEntity.setOrderItemListId(existingEntity.getOrderItemListId());
				lineEntity.setTaskStepId(existingEntity.getTaskStepId());
				lineEntity.setTestppSts(QualityConstants.STATUS_MAPPED);
				lineQtRepository.save(lineEntity);
				lineQtRepository.flush();
				entityManager.flush();
				Optional<PostProdTaskMtEntity> optional = postProdTaskMtRepository
						.getTasksByPpidAndPrid(dto.getCoilId(), dto.getTpiRequired(),QualityConstants.INSP_FLAG_YES);
				Optional<PostProdTaskMtEntity> testedCoilTaskOptional = postProdTaskMtRepository
						.getTasksByPpidAndPrid(dto.getTestedCoilPpId(), dto.getTpiRequired(),QualityConstants.INSP_FLAG_YES);
				if (optional.isPresent() && testedCoilTaskOptional.isPresent()) {
					PostProdTaskMtEntity task = optional.get();
					PostProdTaskMtEntity testedCoilTask = testedCoilTaskOptional.get();
					task.setFinalResult(testedCoilTask.getFinalResult());
					task.setManualDecision(testedCoilTask.getManualDecision());
					task.setTaskStatus(testedCoilTask.getTaskStatus());
					task.setMapSampleId(existingEntity.getSampleId());
					task.setModifiedBy(ClientIpUtils.getClient());
					task.setModifiedDate(new Date());
					task.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());
					task.setIsActive(BigDecimal.ONE);
					postProdTaskMtRepository.save(task);
				}

				List<String> specimenList = specimenQtRepository.findSpecimenBySampleId(existingEntity.getSampleId(),
						QualityConstants.STATUS_COMPLETE);

				for (String list : specimenList) {
					PpspecimanmapQtEntity ppspecimanmapQtEntity = new PpspecimanmapQtEntity();
					PpspecimanmapQtPKEntity mapPk = new PpspecimanmapQtPKEntity();

					mapPk.setppId(dto.getCoilId());
					mapPk.setspecimanId(list);
					mapPk.setppCounter(dto.getPpCtr());
					ppspecimanmapQtEntity.setId(mapPk);
					ppspecimanmapQtEntity.setPpMapStatus(QualityConstants.STATUS_MAPPED);
					ppspecimanmapQtEntity.setTaskStepId(existingEntity.getTaskStepId());
					ppspecimanmapQtEntity.setCreatedBy(ClientIpUtils.getClient());
					ppspecimanmapQtEntity.setCreatedDate(new Date());
					ppspecimanmapQtEntity.setCreatedMacAddress(ClientIpUtils.getClientIpAddress());
					ppspecimanmapQtEntity.setIsActive(BigDecimal.ONE);
					ppspecimanMapQtRepository.save(ppspecimanmapQtEntity);
				}

				response = ResponseUtil.createResponse(request, "Update Successful", false);

				/*
				 * SAP CODE FOR MECH AND CHEM DATA
				 */
				HsmQualityMechanicalDto dtoMechDataSAP = new HsmQualityMechanicalDto();
				HsmQualityMechanicalDto dtoMechData = sapInterface.buildHsmQualityMechanicalDto(dtoMechDataSAP,
						dto.getCoilId(), dto.getHeatId(), existingEntity.getSampleId());
				mechpayload.add(dtoMechData);

				HsmQualityChemicalDto dtoDataSAP = new HsmQualityChemicalDto();
				HsmQualityChemicalDto dtoData = sapInterface.buildHsmQualityChemicalDto(dtoDataSAP, dto.getCoilId(),dto.getSlabId(),
						dto.getHeatId(), existingEntity.getSampleId());
				LOGGER.info("dtoData: {}", dtoData);
				payload.add(dtoData);

				try {
					JsonFormatMechSapDto jsonFormatMechSapDto = new JsonFormatMechSapDto();
					jsonFormatMechSapDto.setMechDto(mechpayload);
					String convertObjectToMechJson = JsonUtil.convertObjectToJson(jsonFormatMechSapDto);
					sapServiceClient.sendHsmMechTestData(convertObjectToMechJson);

					JsonFormatSapDto jsonFormatSapDto = new JsonFormatSapDto();
					jsonFormatSapDto.setChemDto(payload);
					String convertObjectToJson = JsonUtil.convertObjectToJson(jsonFormatSapDto);
					sapServiceClient.sendHsmChemTestData(convertObjectToJson);

				} catch (Exception e) {

				}
			} else {
				response = ResponseUtil.createErrorResponse(
						new ResourceNotFoundException("QualitySchdlEntity", null, testOrderEntities), "Saving Failed",
						LOGGER);
			}
		}

		return response;
	}

	onSendToSap() {

		  console.log('selectedRows', this.selectedRows);
		  console.log('mappedCoilList', this.mappedCoilList);

		  const combinedList = [
		    ...this.selectedRows,
		    ...this.mappedCoilList
		  ];

		  console.log('combinedList', combinedList);

		  this.service.sentSap(combinedList).subscribe({
		    next: (response) => {
		      this.notify.clear();
		      this.notify.showSuccess('SAP Records sent successfully!');

		      this.selectedPendingCoils = [];
		      this.isPendingCoilSelected = false;

		      this.fetchMappedCoils(this.mappedCoilRequest);
		      this.fetchMappingPendingCoils(this.mappedCoilRequest);
		    },
		    error: (error) => {
		      this.notify.clear();
		      this.notify.showError('Failed to send SAP records.');
		    }
		  });

		}
}
