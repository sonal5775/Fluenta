	/**
	 * Fetches the dimension tolerance data for the loading confirmation screen.
	 * <p>
	 * This endpoint accepts a {@link DimensionRangeRequestDto} request along with
	 * multiple query parameters for filtering, sorting, grouping, and pagination.
	 * It returns paginated and optionally grouped results according to the provided
	 * parameters.
	 * </p>
	 *
	 * @param request            The dimension range request payload.
	 * @param pageStore          The default page size if not provided explicitly.
	 * @param latestGroupCount   The latest group count for grouping results.
	 * @param status             The status filter (optional).
	 * @param skip               The number of records to skip (optional).
	 * @param take               The number of records to take (optional).
	 * @param filter             The filter criteria (optional, encoded).
	 * @param sort               The sort criteria (optional, encoded).
	 * @param searchValue        The search keyword (optional).
	 * @param group              The group criteria (optional, encoded).
	 * @param requireTotalCount  Whether total count is required in the response.
	 * @param requireGroupCount  Whether group count is required in the response.
	 * @param httpServletRequest The HTTP request object.
	 * @return The paginated and optionally grouped dimension tolerance data.
	 * @throws JsonProcessingException if there is an error while processing JSON.
	 */
	@Operation(summary = "Fetch Dimension Tolerance List", description = "Fetches paginated, filtered, sorted, and grouped dimension tolerance data for loading confirmation.")
	@ApiResponses(value = {
			@ApiResponse(responseCode = "200", description = "Successfully fetched dimension tolerance list."),
			@ApiResponse(responseCode = "400", description = "Invalid input parameters."),
			@ApiResponse(responseCode = "500", description = "Internal server error.") })
	@PostMapping("/dimension-tolerance-list")
	public <T> T fetchDimensionData(@RequestBody FlatnessToleranceRequestDto request,
			@RequestParam(value = OfsConstants.GROUPING_PAGESTORE) Integer pageStore,
			@RequestParam(value = OfsConstants.GROUPING_LATEST_GROUP_COUNT) Integer latestGroupCount,
			@RequestParam(value = OfsConstants.GROUPING_STATUS, required = false) String status,
			@RequestParam(value = OfsConstants.GROUPING_SKIP, required = false) Integer skip,
			@RequestParam(value = OfsConstants.GROUPING_TAKE, required = false) Integer take,
			@RequestParam(value = OfsConstants.GROUPING_FILTER, required = false) String filter,
			@RequestParam(value = OfsConstants.GROUPING_SORT, required = false) String sort,
			@RequestParam(value = OfsConstants.GROUPING_SEARCH_VALUE, required = false) String searchValue,
			@RequestParam(value = OfsConstants.GROUPING_GROUP, required = false) String group,
			@RequestParam(value = OfsConstants.GROUPING_REQUIRE_TOTAL_COUNT, required = false) boolean requireTotalCount,
			@RequestParam(value = OfsConstants.GROUPING_REQUIRE_GROUP_COUNT, required = false) boolean requireGroupCount,
			HttpServletRequest httpServletRequest) throws JsonProcessingException {
		try {

			String filterPathString = DevExtGridFilterUtils.decodeFilter(filter, httpServletRequest.getQueryString());
			String groupString = DevExtGridFilterUtils.decodeGroup(group, httpServletRequest.getQueryString());
			String decodedSort = sort != null ? URLDecoder.decode(sort, OfsConstants.UTF_8) : null;

			int[] pageSizeArr = processPageAndSize(skip, take, pageStore);
			skip = pageSizeArr[0];
			take = pageSizeArr[1];
			return service.fetchDimensionData(request, status, skip, take, filterPathString, decodedSort, groupString,
					skip, requireTotalCount, requireGroupCount, searchValue, pageStore, latestGroupCount);

		}catch (Exception e) {
			throw new BadRequestException("Unable to fetch flatness Dimension range data", e);
		}

	}

	private int[] processPageAndSize(Integer pageNumber, Integer pageSize, Integer pageStore) {
		if (pageNumber == null) {
			pageNumber = 0;
		}
		if (pageSize == null) {
			pageSize = pageStore;
		}
		return new int[] { pageNumber, pageSize };
	}

