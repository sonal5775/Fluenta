	/**
	 * Adds new or updates existing Flatness Tolerance Dimension records.
	 * <p>
	 * This endpoint accepts a list of {@link FlatnessToleranceDimensionDto}
	 * objects. For each DTO:
	 * <ul>
	 * <li>If the record exists, it will be updated with the new details and version
	 * incremented.</li>
	 * <li>If the record does not exist, a new record will be created with version
	 * 1.</li>
	 * </ul>
	 * </p>
	 *
	 * @param dtoList A list of FlatnessToleranceDimensionDto objects containing
	 *                flatness tolerance data.
	 * @return A list of saved FlatnessToleranceDimensionDto objects after
	 *         processing.
	 *
	 * @apiNote This method is transactional and ensures that all updates are rolled
	 *          back if an exception occurs.
	 */
	@Operation(summary = "Add or update flatness tolerance dimension records", description = "Accepts a list of FlatnessToleranceDimensionDto objects and either updates existing records "
			+ "or creates new ones with appropriate versioning.")
	@ApiResponses(value = {
			@ApiResponse(responseCode = "200", description = "List of processed FlatnessToleranceDimensionDto returned successfully"),
			@ApiResponse(responseCode = "400", description = "Invalid request body or JSON format"),
			@ApiResponse(responseCode = "500", description = "Internal server error while processing records") })
	@PostMapping("/add-or-update")
	public ResponseEntity<List<FlatnessToleranceDimensionDto>> addOrUpdate(
			@RequestBody List<FlatnessToleranceDimensionDto> dtoList) {
		LOGGER.info("Received request to add/update FlatnessToleranceDimensionDto list. Size: {}", dtoList.size());
		List<FlatnessToleranceDimensionDto> savedDtos = service.addOrUpdate(dtoList);
		LOGGER.info("Successfully processed {} FlatnessToleranceDimensionDto records", savedDtos.size());
		return ResponseEntity.ok(savedDtos);
	}

