package com.hindindustec.fluenta.tdc.model;

import java.io.Serializable;

import jakarta.persistence.Column;
import jakarta.persistence.Embeddable;

/**
 * The primary key class for the TDCDIMTOL_JM database table.
 * 
 */
@Embeddable
public class TdcdimtolJmEntityPK implements Serializable {
	//default serial version id, required for serializable classes.
	private static final long serialVersionUID = 1L;

	@Column(insertable=false, updatable=false)
	private String tdcid;

	@Column(insertable=false, updatable=false)
	private long revid;

	@Column(insertable=false, updatable=false)
	private String dimatr;

	public TdcdimtolJmEntityPK() {
		//empty constructor
	}
	public String getTdcid() {
		return this.tdcid;
	}
	public void setTdcid(String tdcid) {
		this.tdcid = tdcid;
	}
	public long getRevid() {
		return this.revid;
	}
	public void setRevid(long revid) {
		this.revid = revid;
	}
	public String getDimatr() {
		return this.dimatr;
	}
	public void setDimatr(String dimatr) {
		this.dimatr = dimatr;
	}

	public boolean equals(Object other) {
		if (this == other) {
			return true;
		}
		if (!(other instanceof TdcdimtolJmEntityPK)) {
			return false;
		}
		TdcdimtolJmEntityPK castOther = (TdcdimtolJmEntityPK)other;
		return 
			this.tdcid.equals(castOther.tdcid)
			&& (this.revid == castOther.revid)
			&& this.dimatr.equals(castOther.dimatr);
	}

	public int hashCode() {
		final int prime = 31;
		int hash = 17;
		hash = hash * prime + this.tdcid.hashCode();
		hash = hash * prime + ((int) (this.revid ^ (this.revid >>> 32)));
		hash = hash * prime + this.dimatr.hashCode();
		
		return hash;
	}
}