    public static String decodeFilter(String filter, String queryString) throws UnsupportedEncodingException {
        if (filter == null) {
            return null;
        }

        String temp = decodeFunctionForFilter(queryString);
        String decodedFilter = URLDecoder.decode(temp, OfsConstants.UTF_8);
        return URLDecoder.decode(decodedFilter, "UTF-8");
    }

    public static String decodeFunctionForFilter(String queryString) {
        // Extract the part after "group="
        String groupValue = null;
        if (queryString.contains(OfsConstants.FILTER)) {
            int startIndex = queryString.indexOf("filter=") + "filter=".length();
            int endIndex = queryString.indexOf('&', startIndex);
            if (endIndex == -1) {
                groupValue = queryString.substring(startIndex);
            } else {
                groupValue = queryString.substring(startIndex, endIndex);
            }
        }

        // Decode the group value
        if (groupValue != null) {
        	return URLDecoder.decode(groupValue, StandardCharsets.UTF_8);
        } else {
            return null;
        }
    }

    public static String decodeGroup(String group, String queryString) throws UnsupportedEncodingException {
        if (group == null) {
            return null;
        }

        String firstDecode = decodeFunctionForGroup(queryString);
        String decodedGroup = URLDecoder.decode(firstDecode, "UTF-8");

        return decodedGroup != null ? decodedGroup : group;
    }

    public static String decodeFunctionForGroup(String queryString) {
        // Extract the part after "group="
        String groupValue = null;
        if (queryString.contains(OfsConstants.GROUP_DEVEXTGRID)) {
            int startIndex = queryString.indexOf("group=") + "group=".length();
            int endIndex = queryString.indexOf('&', startIndex);
            if (endIndex == -1) {
