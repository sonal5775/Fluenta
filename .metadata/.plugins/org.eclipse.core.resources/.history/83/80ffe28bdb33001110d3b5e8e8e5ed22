    public static String extractFilterValue(String queryString) {
        if (queryString == null) {
            return null; // Early exit if queryString is null
        }

        String prefix = OfsConstants.FILTER;
        String suffix = "&";

        // Check if queryString contains 'filter' parameter
        if (!queryString.contains(prefix)) {
            return null; // 'filter' parameter not found
        }

        // Find the start index of the 'filter' parameter
        int startIndex = queryString.indexOf(prefix);
        if (startIndex == -1) {
            return null; // 'filter' parameter not found
        }

        // Adjust startIndex to the actual start of the value
        startIndex += prefix.length();

        // Find the end index of the 'filter' parameter value
        int endIndex = queryString.indexOf(suffix, startIndex);
        if (endIndex == -1) {
            endIndex = queryString.length(); // 'filter' parameter is the last one
        }

        // Extract the value of the 'filter' parameter
        return queryString.substring(startIndex, endIndex);
    }

    public static String listToJsonString(List<Object> list) throws JsonProcessingException {
        ObjectMapper mapper = new ObjectMapper();
        return mapper.writeValueAsString(list);
    }

    public static List<String> extractElements(String jsonString) {

        List<String> result = new ArrayList<>();
        if (jsonString != null) {
            StringBuilder sb = new StringBuilder();
            boolean inQuotes = false;

            for (int i = 0; i < jsonString.length(); i++) {
                char c = jsonString.charAt(i);

                if (c == '"') {
                    inQuotes = !inQuotes; // Toggle the inQuotes flag
                    toggleInQuotes(result, sb, inQuotes);
                } else if (inQuotes) {
                    sb.append(c);
                } else if (Character.isLetterOrDigit(c) || c == '.' || c == '-' || c == '_') {
                    sb.append(c);
                } else if (!sb.isEmpty()) {
                    result.add(sb.toString());
                    sb.setLength(0); // Clear the StringBuilder
                }
            }

            if (!sb.isEmpty()) {
                result.add(sb.toString()); // Add remaining buffer if any
            }

        }
        return result;
    }

    private static void toggleInQuotes(List<String> result, StringBuilder sb, boolean inQuotes) {
        if (!inQuotes && !sb.isEmpty()) {
            result.add(sb.toString());
            sb.setLength(0); // Clear the StringBuilder
        }
    }

    public static List<String> getSortListFromString(String sort) {

        List<String> resultList = new ArrayList<>();
        if (sort != null) {
            String cleanedInput = sort.replaceAll("[\\[\\]{}]", "");

            String[] parts = cleanedInput.split(",");

            for (String part : parts) {
                String[] keyValue = part.split(":");
                for (String element : keyValue) {
                    resultList.add(element.replace("\"", "").trim());
                }
            }


        }
        return resultList;
    }

    public static boolean isNumberOrStringCheck(String str) {
        Pattern numberPattern = Pattern.compile("-?\\d+(\\.\\d+)?");
        if (str == null || str.isEmpty()) {
            return false;
        }
        return numberPattern.matcher(str).matches();
    }

    public static String urlDecoderForFilter(String tempFilter, StringBuilder requestURL, String queryString) throws JsonProcessingException {

        LOGGER.info("In the urlDecoderForFilter : {}", requestURL);
        String s = DevExtGridFilterUtils.extractFilterValue(queryString);
        String filterPathString = null;
        if (s != null) {
            String decodedFilter = "";
            try {
                decodedFilter = URLDecoder.decode(tempFilter, OfsConstants.UTF_8);
            } catch (UnsupportedEncodingException e) {
                e.printStackTrace();
            }

            ObjectMapper mapper = new ObjectMapper();

            if (decodedFilter != null) {
                JsonNode rootNode = mapper.readTree(decodedFilter);

                List<Object> flattenedList = new ArrayList<>();
                flattenJson(rootNode, flattenedList);

                String flattenedJsonString = listToJsonString(flattenedList);
                filterPathString = flattenedJsonString;
            }
        }
        return filterPathString;
    }

    public static void flattenJson(JsonNode node, List<Object> flatList) {
        if (node.isArray()) {
            for (JsonNode element : node) {
                flattenJson(element, flatList);
            }
        } else {
            if (node.isTextual()) {
                flatList.add(node.textValue());
            } else if (node.isNumber()) {
                flatList.add(node.numberValue());
            } else if (node.isBoolean()) {
                flatList.add(node.booleanValue());
            }
        }
    }

    public static List<String> getAllFields(Class<?> clazz) {
        List<String> fieldNames = new ArrayList<>();
        Field[] fields = clazz.getDeclaredFields();

        for (Field field : fields) {
            fieldNames.add(field.getName());
        }

        return fieldNames;
    }

    public static Map<String, String> getAllFieldsWithTypes(Class<?> clazz) {
        Map<String, String> fieldMap = new HashMap<>();
        Field[] fields = clazz.getDeclaredFields();

        for (Field field : fields) {
            String fieldType;
            if (field.getType().equals(String.class)) {
                fieldType = "VARCHAR2";
            } else if (field.getType().equals(int.class) || field.getType().equals(Integer.class) ||
                    field.getType().equals(long.class) || field.getType().equals(Long.class) ||
                    field.getType().equals(float.class) || field.getType().equals(Float.class) ||
                    field.getType().equals(double.class) || field.getType().equals(Double.class) ||
                    field.getType().equals(BigDecimal.class) ||
                    field.getType().equals(short.class) || field.getType().equals(Short.class) ||
                    field.getType().equals(byte.class) || field.getType().equals(Byte.class)) {
                fieldType = "NUMBER";
            } else if (field.getType().equals(Date.class) || field.getType().equals(java.sql.Date.class) ||
                    field.getType().equals(java.sql.Timestamp.class)) {
                fieldType = "DATE";
            } else {
                fieldType = "UNKNOWN"; // Default value for types not specified
            }
            fieldMap.put(field.getName(), fieldType);
        }

        return fieldMap;
    }

    public static List<String> removeNumberFieldsFromString(List<String> listForFilter, Class<?> clazz) {

        List<String> columnNames = getAllFields(clazz);

        Map<String, String> columnDataTypesKeyValuePair = getAllFieldsWithTypes(clazz);


        List<String> updatedList = new ArrayList<>(listForFilter);
        Iterator<String> iterator = updatedList.iterator();

        while (iterator.hasNext()) {
            String field = iterator.next();
            boolean isRemove = false;

            // Check if field matches the condition
            if (columnNames.contains(field) &&
                    "NUMBER".equals(columnDataTypesKeyValuePair.get(field))) {
                iterator.remove();  // Remove the current field
                isRemove = true;
            }

            // If a field is removed, remove the next two elements
            if (isRemove) {
                for (int i = 0; i < 3; i++) {
                    if (iterator.hasNext()) {
                        iterator.next();
                        iterator.remove();
                    }
                }
            }
        }

        return updatedList;
    }

