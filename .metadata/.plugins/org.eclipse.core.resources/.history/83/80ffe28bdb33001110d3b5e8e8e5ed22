            } else {
                groupValue = queryString.substring(startIndex, endIndex);
            }
        }

        // Decode the group value
        if (groupValue != null) {
        	return URLDecoder.decode(groupValue, StandardCharsets.UTF_8);

        } else {
            return null;
        }
    }

    /**
     * Check if the request is for grouping without filter or sort.
     */
    public static boolean isGroupWithoutFilterOrSort(String group, String filterPathString, String sort) {
        return group != null && filterPathString == null && sort == null;
    }

    /**
     * Check if the request is for grouping with filter or sort.
     */
    public static boolean isGroupWithFilterOrSort(String group, String filterPathString, String sort) {
        return group != null && (filterPathString != null || sort != null);
    }

    /**
     * Check if the request is for filter or sort only.
     */
    @SuppressWarnings("java:S2589")
    public static boolean isFilterOrSortOnly(String group, String filterPathString, String sort) {
        return group == null && ((filterPathString != null || sort != null) || (filterPathString == null && sort == null));
    }
    
