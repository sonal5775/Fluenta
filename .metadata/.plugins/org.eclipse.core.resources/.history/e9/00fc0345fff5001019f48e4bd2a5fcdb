	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<SpecimenGenerationDto> saveSpecimenGeneration(List<SpecimenGenerationDto> list) {
		LOGGER.info("Starting the process to save specimen generation details. List size: {}", list.size());
		LOGGER.info("specimen generation details. List : {}", list);
		checkListValidity(list);
		try {
			dbSessionService.setSessionInfo(this.getClass().getName());
			for (SpecimenGenerationDto dto : list) {
				generateSpecimenIdForNonChildParent(dto);
				if (dto.getSpecimenId() != null && !dto.getSpecimenId().trim().isEmpty()) {
					processSpecimenUpdate(dto);
				} else {
					LOGGER.info("specimen parent child type found : {}", dto);
					processChildExistingParent(dto);
				}
			}

			LOGGER.info("Successfully saved specimen generation details.");
			return list;
		} catch (Exception e) {
			LOGGER.error("Error occurred while saving specimen generation details", e);
			return list;
		}
	}

	private void processChildExistingParent(SpecimenGenerationDto dto) {
		if (QualityConstants.Z_TEST.equals(dto.getTestType()) || QualityConstants.DWTT.equals(dto.getTestType())
				|| QualityConstants.IMPACT_CVN.equals(dto.getTestType())
				|| QualityConstants.IMPACT_CUN.equals(dto.getTestType())) {
			switch (dto.getTestType()) {
			case QualityConstants.Z_TEST -> processZTest(dto);
			case QualityConstants.DWTT -> processDwtt(dto);
			case QualityConstants.IMPACT_CVN -> processImpact(dto);
			case QualityConstants.IMPACT_CUN -> processImpact(dto);
			default -> throw new IllegalArgumentException("Unknown test type: " + dto.getTestType());
			}
		}
	}

	private void generateSpecimenIdForNonChildParent(SpecimenGenerationDto dto) {
		if ((dto.getSpecimenId() == null || dto.getSpecimenId().trim().isEmpty())
				&& !(QualityConstants.Z_TEST.equals(dto.getTestType())
						|| QualityConstants.DWTT.equals(dto.getTestType())
						|| QualityConstants.IMPACT_CVN.equals(dto.getTestType())
						|| QualityConstants.IMPACT_CUN.equals(dto.getTestType()))) {
			LOGGER.info("specimen ID prev : {}", dto.getSpecimenId());
			specimenIdGeneration(dto);
		}

	}

	private void processSpecimenUpdate(SpecimenGenerationDto dto) {
		Optional<SpecimenQualityTransactionEntity> optionalEntity = specimenQualityTransactionRepository
				.findById(dto.getSpecimenId().trim());

		SpecimenQualityTransactionEntity specimenQualityTransactionEntity = optionalEntity
				.orElseGet(SpecimenQualityTransactionEntity::new);

		if (optionalEntity.isEmpty()) {
			BigDecimal newSpecimenCounter = BigDecimal
					.valueOf(specimenQualityTransactionRepository.findMaxSpecimenCtr(dto.getSampleId()) + 1);
			specimenQualityTransactionEntity.setSpecimenCounter(newSpecimenCounter);
		}

		specimenQualityTransactionEntity.setSampleId(dto.getSampleId());
		specimenQualityTransactionEntity.setSpecimenId(dto.getSpecimenId());
		specimenQualityTransactionEntity.setSpecification(dto.getSpecification());
		specimenQualityTransactionEntity.setTestType(dto.getTestType());
		specimenQualityTransactionEntity.setTestSpecimenType(dto.getTestSpecimenType());
		specimenQualityTransactionEntity.setThickness(dto.getThickness());
		specimenQualityTransactionEntity.setLength(dto.getLength());
		specimenQualityTransactionEntity.setWidth(dto.getWidth());
		if (dto.getTestMethod() != null && QualityConstants.SPECIMEN_TYPE_CHILD.equals(dto.getTestMethod())) {
			specimenQualityTransactionEntity.setTestMethod(QualityConstants.SPECIMEN_TYPE_CHILD);
		} else {
			specimenQualityTransactionEntity.setTestMethod(QualityConstants.SPECIMEN_TYPE_PARENT);
		}
		specimenQualityTransactionEntity.setSpecimenStatus(QualityConstants.PENDING);
		specimenQualityTransactionEntity.setPreparationMethod(dto.getPreparationMethod());
		specimenQualityTransactionEntity.setDirection(dto.getDirection());
		specimenQualityTransactionEntity.setCondition(dto.getCondition());
		specimenQualityTransactionEntity.setTemperature(dto.getTemperature());
		specimenQualityTransactionEntity.setTestSource(dto.getTestSource());
		LOGGER.info("saving entity {}", specimenQualityTransactionEntity);
		specimenQualityTransactionRepository.save(specimenQualityTransactionEntity);
	}

	private void processImpact(SpecimenGenerationDto dto) {
		Optional<SpecimenQualityTransactionEntity> parentSpecimenOpt = specimenQualityTransactionRepository
				.getParentSpecimenBySampleIdAndTestTypeAndTestMethod(dto.getSampleId(), dto.getTestType(),
						QualityConstants.SPECIMEN_TYPE_PARENT);
		if (parentSpecimenOpt.isPresent()) {
			SpecimenQualityTransactionEntity parentSpecimen = parentSpecimenOpt.get();
			Long totalNoOfChildCount = specimenQualityTransactionRepository.getTotalNoOfChildCount(dto.getSampleId(),
					dto.getTestType(), QualityConstants.SPECIMEN_TYPE_CHILD);
			if (totalNoOfChildCount == null) {
				totalNoOfChildCount = 0L;
			}

			dto.setSpecimenId(generateChildSpecimenByParentId(parentSpecimen.getSpecimenId(), totalNoOfChildCount + 1));
			sampleRecieptRepo.generatePredefinedChildSpecimens(dto);
		} else {
			List<UserGrpCodeDtlEntity> userGroupCodeList = userGrpCodeDtlRepository
					.findByLovid(QualityConstants.IMPACT_CHILD_SAMP);
			UserGrpCodeDtlEntity userGrpCodeDtlEntity = userGroupCodeList.get(0);

			if (true) {
				ArrayList<SpecimenGenerationDto> parentList = new ArrayList<>();
				parentList.add(dto);
				List<SpecimenGenerationDto> generatedPredefinedSpecimens = sampleRecieptRepo
						.generatePredefinedSpecimens(parentList);
				SpecimenGenerationDto parentSpecimen = generatedPredefinedSpecimens.get(0);
				String parentSpecimenId = parentSpecimen.getSpecimenId();
				for (int i = 0; i < Long.valueOf(userGrpCodeDtlEntity.getValdesc()); i++) {
					dto.setSpecimenId(generateChildSpecimenByParentId(parentSpecimenId, i + 1l));
					sampleRecieptRepo.generatePredefinedChildSpecimens(dto);
				}
			}
		}

	}

