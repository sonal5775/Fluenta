	private void checkListValidity(List<SpecimenGenerationDto> list) {
		if (list == null || list.isEmpty()) {
			LOGGER.warn("Provided list is null or empty.");
			throw new IllegalArgumentException("The list of specimen generation details cannot be null or empty.");
		}
	}

	private void specimenIdGeneration(SpecimenGenerationDto dto) {
		if (dto.getSpecimenId() == null || dto.getSpecimenId().isEmpty()) {
			Long maxSuffix = specimenQualityTransactionRepository.findMaxSpecimenSuffix(dto.getSampleId());
			if (maxSuffix == null) {
				maxSuffix = 0L;
			}
			Long newSuffix = maxSuffix + 1;
			String formattedSuffix = String.format("%02d", newSuffix);
			String specimenId = dto.getSampleId() + "-" + formattedSuffix;
			LOGGER.info("specimenId-----{}", specimenId);
			dto.setSpecimenId(specimenId);
		}
	}

