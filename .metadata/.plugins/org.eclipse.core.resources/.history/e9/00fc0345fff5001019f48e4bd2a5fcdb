	@Override
	@Transactional(rollbackFor = Exception.class)
	public ResponseEntity<FluentaApiResponse<List<SpecimenGenerationDto>>> getPreDefinedSpecimens(
			SampleRecieptDto request) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		List<SpecimenGenerationDto> specimenDetails = sampleRecieptRepo.getSpecimenDetails(request);
		ResponseEntity<FluentaApiResponse<List<SpecimenGenerationDto>>> response = null;
		if (specimenDetails.isEmpty()) {
			InventoryPk pk = new InventoryPk();
			pk.setPpid(request.getCoilid());
			pk.setPpctr(0);
			Optional<Inventory> pphMtOptional = this.pphMtRepository.findByPpId(request.getCoilid());
			Inventory inventory = new Inventory();
			QualityScheduleLinesEntity qualityScheduleLinesEntity = new QualityScheduleLinesEntity();
			TdcJmEntity tdcJmEntity = new TdcJmEntity();
			inventory = checkAndGetInventory(pphMtOptional, inventory);
			Optional<QualityScheduleLinesEntity> qcLineItemOptional = this.qualityScheduleLineItemRepository
					.findByPpid(request.getCoilid().trim());
			qualityScheduleLinesEntity = checkAndGetQcSchdLine(qualityScheduleLinesEntity, qcLineItemOptional);
			SalesOrderBomDetailsPK bomPk = new SalesOrderBomDetailsPK();
			bomPk.setSoid(qualityScheduleLinesEntity.getSoId());
			bomPk.setSolid(qualityScheduleLinesEntity.getSolId().longValue());
			bomPk.setDimind("F");
			bomPk.setPrdid("HRCOIL");
			Optional<SalesOrderBomDetails> bomOpt = salesOrderBomDetailsRepository.findById(bomPk);
			SalesOrderBomDetails bomDetails = bomOpt.orElse(new SalesOrderBomDetails());
			TdcJmEntityPK tdcJmEntityPK = new TdcJmEntityPK();
			tdcJmEntityPK.settdcId(qualityScheduleLinesEntity.getTdcId());
			Optional<TdcJmEntity> tdcOptional = this.tdcJmRepository.findById(tdcJmEntityPK);
			tdcJmEntity = checkAndGetTdc(tdcJmEntity, tdcOptional);
			LOGGER.info(tdcJmEntity.getNormId());
			NormtestdtlJmEntityPK normtestdtlJmEntityPK = new NormtestdtlJmEntityPK();
			normtestdtlJmEntityPK.setnormId(tdcJmEntity.getNormId());
			normtestdtlJmEntityPK.settestMethod(QualityConstants.PRODUCT_SAMPLE);
			Optional<NormtestdtlJm> prodChemOptional = normtestdtlJmRepository.findById(normtestdtlJmEntityPK);
			List<NormtensileJmEntity> normTensile = externalGradeNormTensileRepository
					.findByNormidAndThk(tdcJmEntity.getNormId());
			List<NormImpactJmEntity> normImpactCvn = externalGradeNormImpactRepository
					.findCvnByNormidAndThk(tdcJmEntity.getNormId());
			List<NormImpactJmEntity> normImpactCun = externalGradeNormImpactRepository
					.findCunByNormidAndThk(tdcJmEntity.getNormId());
			List<NormHardnessJmEntity> normHardness = externalGradeNormHardnessRepository
					.findByNormidAndThk(tdcJmEntity.getNormId());
			List<NorminclusionJmEntity> normIncl = externalGradeNormInclusionRepository
					.findByNormidAndThk(tdcJmEntity.getNormId());
			List<NormztestJmEntity> normZtest = externalGradeNormZtestRepository
					.findByNormidAndThk(tdcJmEntity.getNormId());
			List<NormhtttJmEntity> normHttt = externalGradeNormHtttRepository
					.findByNormidAndThk(tdcJmEntity.getNormId());
			List<NormbendJmEntity> normBend = externalGradeNormBendRepository
					.findByNormidAndThk(tdcJmEntity.getNormId());
			List<NormdwttJmEntity> normDwtt = externalGradeNormDwttRepository
					.findByNormidAndThk(tdcJmEntity.getNormId());
			List<NormshtJmEntity> normSht = externalGradeNormShtRepository
					.findByNormidAndThk(tdcJmEntity.getNormId());
			List<NormothrtestJmEntity> normOthers = externalGradeNormOthrtestRepository
					.findByNormId(tdcJmEntity.getNormId());
			List<SpecimenGenerationDto> list = new ArrayList<>();
			processChemistrySpecimenGeneration(request, tdcJmEntity, prodChemOptional, list,bomDetails);
			processTensileSpecimenGeneration(request, normTensile,  list,bomDetails);
			processImpactSpecimenGeneration(request, tdcJmEntity,  normImpactCvn, list,
					QualityConstants.IMPACT_CVN,bomDetails);
			processImpactSpecimenGeneration(request, tdcJmEntity,  normImpactCun, list,
					QualityConstants.IMPACT_CUN,bomDetails);
			processHardnessSpecimenGeneration(request, normHardness,  list,bomDetails);
			processInclSpecimenGeneration(request, normIncl,  list,bomDetails);
			processZTestSpecimenGeneration(request, tdcJmEntity, normZtest,  list,bomDetails);
			processHtttSpecimenGeneration(request, normHttt,  list,bomDetails);
			processBendSpecimenGeneration(request, normBend,  list,bomDetails);
			processDwttSpecimenGeneration(request, tdcJmEntity, normDwtt,  list,bomDetails);
			processOtherTestSpecimenGeneration(request, normOthers,  list,bomDetails);
			processShtSpecimenGeneration(request, normSht,  list,bomDetails);
			LOGGER.info("{}", list);
			sampleRecieptRepo.generatePredefinedSpecimens(list);
			Optional<SampleQualityEntity> sampleOptional = sampleQtMasterRepository.findById(request.getSampleId());
			if (sampleOptional.isPresent()) {
				SampleQualityEntity sampleQualityEntity = sampleOptional.get();
				sampleQualityEntity.setSampleGenerationFlag(QualityConstants.SAMPLE_FLAG_YES);
				sampleQtMasterRepository.save(sampleQualityEntity);
			}
			specimenDetails = sampleRecieptRepo.getSpecimenDetails(request);
		}
		if (!specimenDetails.isEmpty()) {
			response = ResponseUtil.createResponse(specimenDetails, "fetch Successful", true);
		} else {
			response = ResponseUtil.createErrorResponse(
					new ResourceNotFoundException("Specimen List", null, specimenDetails), "Saving Failed", LOGGER);
		}
