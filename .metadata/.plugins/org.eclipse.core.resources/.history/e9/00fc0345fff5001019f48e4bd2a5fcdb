	private boolean isThicknessInRange(BigDecimal thickness, BigDecimal thkmin, String minopr, BigDecimal thkmax,
			String maxopr) {
		if (thickness == null) {
			return false;
		}
		if (isAllNull(thkmin, minopr, thkmax, maxopr)) {
			return true;
		}
		if (hasMinConditionOnly(thkmin, minopr, thkmax, maxopr)) {
			return evaluateOperator(thickness, thkmin, minopr);
		}
		if (hasMaxConditionOnly(thkmin, minopr, thkmax, maxopr)) {
			return evaluateOperator(thickness, thkmax, maxopr);
		}
		if (hasBothConditions(thkmin, minopr, thkmax, maxopr)) {
			return evaluateOperator(thickness, thkmin, minopr) && evaluateOperator(thickness, thkmax, maxopr);
		}
		return false;
	}

	private boolean isAllNull(BigDecimal thkmin, String minopr, BigDecimal thkmax, String maxopr) {
		return thkmin == null && minopr == null && thkmax == null && maxopr == null;
	}

	private boolean hasMinConditionOnly(BigDecimal thkmin, String minopr, BigDecimal thkmax, String maxopr) {
		return thkmin != null && minopr != null && thkmax == null && maxopr == null;
	}

	private boolean hasMaxConditionOnly(BigDecimal thkmin, String minopr, BigDecimal thkmax, String maxopr) {
		return thkmin == null && minopr == null && thkmax != null && maxopr != null;
	}

	private boolean hasBothConditions(BigDecimal thkmin, String minopr, BigDecimal thkmax, String maxopr) {
		return thkmin != null && minopr != null && thkmax != null && maxopr != null;
	}

	private boolean evaluateOperator(BigDecimal value, BigDecimal limit, String operator) {
		switch (operator) {
		case ">":
			return value.compareTo(limit) > 0;
		case ">=":
			return value.compareTo(limit) >= 0;
		case "<":
			return value.compareTo(limit) < 0;
		case "<=":
			return value.compareTo(limit) <= 0;
		case "=":
			return value.compareTo(limit) == 0;
		default:
			return false;
		}
	}

