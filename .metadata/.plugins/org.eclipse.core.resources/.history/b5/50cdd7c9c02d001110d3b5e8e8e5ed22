	public static final String DIM_QUERY;
	static {
		StringBuilder queryBuilder = new StringBuilder();
		queryBuilder.append("SELECT NEW com.hindindustec.fluenta.hsm.masters.dto.FlatnessToleranceDimensionDto(")
				.append("cr.rangeCode, ") // from FlattolRngCm
				.append("fr.id.version, ").append("cr.currentVersion, ").append("fr.modItemStamp, ")
				.append("fr.thicknessMin, ").append("fr.thicknessMinOperator, ").append("fr.thicknessMaxOperator, ")
				.append("fr.thicknessMax, ").append("fr.widthMin, ").append("fr.widthMinOperator, ")
				.append("fr.widthMaxOperator, ").append("fr.widthMax, ").append("fr.validPgCode, ")
				.append("fr.isActive, ").append("fr.createdDate, ").append("fr.createdBy, ").append("fr.modifiedDate, ")
				.append("fr.modifiedBy, ").append("fr.createdMacAddress, ").append("fr.modifiedMacAddress")
				.append(") ");
		DIM_QUERY = queryBuilder.toString();
	}

	public static final String DIM_QUERY_CONDITION;
	static {
		StringBuilder queryBuilder = new StringBuilder();
		queryBuilder.append("FROM FlattolRngCa fr ").append("JOIN FlattolrngCm cr ON fr.id.rangeCode = cr.rangeCode ");
		DIM_QUERY_CONDITION = queryBuilder.toString();
	}

	public static final String DIM_QUERY_WHERE_CONDITION;
	static {
		StringBuilder queryBuilder = new StringBuilder();
		queryBuilder.append("WHERE 1=1 ");
		queryBuilder.append("AND (:rangeCode IS NULL OR fr.id.rangeCode = :rangeCode) ");
		queryBuilder.append("AND (:version IS NULL OR fr.id.version = :version) ");
		DIM_QUERY_WHERE_CONDITION = queryBuilder.toString();
	}

	public Page<FlatnessToleranceDimensionDto> getDetails(FlatnessToleranceRequestDto request, Integer page,
			Integer size, String query, String countQueryParm, Integer skip) {
		int effectiveOffset = page * size;
		int effectivePageSize = size;
		if (skip != null && skip > 0) {
			if (skip >= size) {
				effectiveOffset += skip;
				@SuppressWarnings("unused")
				skip = 0;
			} else {
				effectiveOffset += skip;
				effectivePageSize -= skip;
			}
		}

		TypedQuery<FlatnessToleranceDimensionDto> queryCount = entityManager.createQuery(query,
				FlatnessToleranceDimensionDto.class);

		queryCount.setParameter(OfsConstants.RANGE_CODE, request.getRangeCode());
		queryCount.setParameter(OfsConstants.VERSION, request.getVersion());

		queryCount.setFirstResult(effectiveOffset);
		queryCount.setMaxResults(effectivePageSize);
		List<FlatnessToleranceDimensionDto> resultList = queryCount.getResultList();
		Query countQuery = entityManager.createQuery(countQueryParm);

		countQuery.setParameter(OfsConstants.RANGE_CODE, request.getRangeCode());
		countQuery.setParameter(OfsConstants.VERSION, request.getVersion());
		Long totalRows = (Long) countQuery.getSingleResult();
		Pageable pageable = PageRequest.of(page, size);
		return new PageImpl<>(resultList, pageable, totalRows);

	}

