package com.hindindustec.fluenta.hsm.masters.entities;

import java.io.Serializable;

import jakarta.persistence.Column;
import jakarta.persistence.Embeddable;

/**
 * The primary key class for the DELAYTY_CM database table.
 * 
 */
@Embeddable
public class DelaytyCmPK implements Serializable {
	//default serial version id, required for serializable classes.
	private static final long serialVersionUID = 1L;

	@Column(name = "ARTYID")
	private String artyId;

	@Column(name = "DCATID")
	private String dcatId;

	@Column(insertable=false, updatable=false,name = "DELAYTYNM")
	private String delayTyNm;

	
	public String getartyId() {
		return this.artyId;
	}
	public void setartyId(String artyId) {
		this.artyId = artyId;
	}
	public String getdcatId() {
		return this.dcatId;
	}
	public void setdcatId(String dcatId) {
		this.dcatId = dcatId;
	}
	public String getdelayTyNm() {
		return this.delayTyNm;
	}
	public void setdelayTyNm(String delayTyNm) {
		this.delayTyNm = delayTyNm;
	}

	public boolean equals(Object other) {
		if (this == other) {
			return true;
		}
		if (!(other instanceof DelaytyCmPK)) {
			return false;
		}
		DelaytyCmPK castOther = (DelaytyCmPK)other;
		return 
			this.artyId.equals(castOther.artyId)
			&& this.dcatId.equals(castOther.dcatId)
			&& this.delayTyNm.equals(castOther.delayTyNm);
	}

	public int hashCode() {
		final int prime = 31;
		int hash = 17;
		hash = hash * prime + this.artyId.hashCode();
		hash = hash * prime + this.dcatId.hashCode();
		hash = hash * prime + this.delayTyNm.hashCode();
		
		return hash;
	}
}