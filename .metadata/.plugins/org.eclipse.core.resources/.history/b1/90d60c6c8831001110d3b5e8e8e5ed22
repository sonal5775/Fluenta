		this.hrwdtmax = hrwdtmax;
		this.furextemp = furextemp;
		this.rmextemp = rmextemp;
		this.fmextemp = fmextemp;
		this.fmentemp = fmentemp;
		this.fmtemptgt = fmtemptgt;
		this.fmalttemptgt = fmalttemptgt;
		this.midtemp = midtemp;
		this.fmextemppvetol = fmextemppvetol;
		this.fmextempnvetol = fmextempnvetol;
		this.coilalttemptgt = coilalttemptgt;
		this.coiltemppvetol = coiltemppvetol;
		this.coiltempnvetol = coiltempnvetol;
