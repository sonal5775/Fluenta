	private BigDecimal hrthkmin; //HR Thickness Range(mm) min
	private BigDecimal inIthrthkmin;
	private BigDecimal hrthkmax; //HR Thickness Range(mm) max
	private BigDecimal hrwdtmin; //HR Width Range(mm) min
	private BigDecimal inIthrwdtmin;
