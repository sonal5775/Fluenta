	public Boolean getAllSalesEnquiryItemsDetailsWithApprovedTdc(SalesEnquiryDto request) {
	    TypedQuery<SalesEnquiryItemDto> q = entityManager.createQuery(
	    		OfsConstants.SALES_ENQUIRY_ITEM_DTO+OfsConstants.getCommonFieldList() +
	        "FROM SelStEntity selSt WHERE selSt.id.seid = :seid AND selSt.isactv = 1",
	        SalesEnquiryItemDto.class);

	    q.setParameter("seid", request.getSeid());
	    List<SalesEnquiryItemDto> resultList = q.getResultList();

	    for (SalesEnquiryItemDto dto : resultList) {
	        boolean isTdcApproved = isTdcApproved(dto);
	        if (!isTdcApproved) {
	            return false;
	        }
	    }
	    return true;
	}
	private boolean isTdcApproved(SalesEnquiryItemDto dto) {
	    TypedQuery<Boolean> query = entityManager.createQuery(
	        "SELECT CASE WHEN (COUNT(selSt) > 0) THEN true ELSE false END " +
	        "FROM SelStEntity selSt, TdcJmEntity tdc " +
	        "WHERE selSt.id.seid = :seId AND selSt.id.selid = :selId AND selSt.tdcid = tdc.id.tdcid " +
	        "AND tdc.tdcsts = :status AND selSt.isactv = 1", Boolean.class);

	    query.setParameter("seId", dto.getSeid());
	    query.setParameter("selId", dto.getSelid());
	    query.setParameter("status", OfsStatusConstants.TDC_STATUS_APPROVED);

	    return query.getSingleResult();
	}
