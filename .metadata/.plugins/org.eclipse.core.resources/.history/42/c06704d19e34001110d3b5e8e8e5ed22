	/**
	 * This method returns all sales enquiry details
	 *
	 * @author Pinaki Samal
	 * @param request - status data
	 */
	public Page<SalesEnquiryDto> getAllPaginatedSalesEnquiryDetails(StatusRequest request,
	        Integer page, Integer size, String query, String countQuery) {
		
		List<String> statusList = request.getStatus();
		String statusFlag = null;
		if (request.getStatus() != null && !request.getStatus().isEmpty()) {
			statusFlag = OfsStatusConstants.AVAILABLE;
		}
		
	    // Count Query
	    Query queryCount = entityManager.createQuery(countQuery);
	    queryCount.setParameter(OfsConstants.STATUS_FLAG, statusFlag);
		queryCount.setParameter(OfsConstants.STATUS, statusList);

	    // Get total count
	    Number resultNumber = (Number) queryCount.getSingleResult();
	    int totalRows = resultNumber.intValue();

	    // Pageable
	    Pageable pageable = PageRequest.of(page, size);

	    // Data Query
	    TypedQuery<SalesEnquiryDto> q = entityManager.createQuery(query, SalesEnquiryDto.class);
	    q.setFirstResult(pageable.getPageNumber() * pageable.getPageSize());
	    q.setMaxResults(pageable.getPageSize());
	    q.setParameter(OfsConstants.STATUS_FLAG, statusFlag);
		q.setParameter(OfsConstants.STATUS, statusList);

	    // Execute query and get the result list
	    List<SalesEnquiryDto> resultList = q.getResultList();

	    // Return paginated result
	    return new PageImpl<>(resultList, pageable, totalRows);
	}

