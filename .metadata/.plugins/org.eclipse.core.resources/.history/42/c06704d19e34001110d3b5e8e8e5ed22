	/**
	 * This method returns all sales enquiry highest
	 *
	 * @author Pinaki Samal
	 */
	public Long getSalesEnquiryHighest() {
		LOGGER.info("Inside SalesEnquiryRepository:: getSalesEnquiryHighest ");

		TypedQuery<Long> q = entityManager.createQuery("SELECT CAST(SUBSTRING(s.seid, LENGTH(s.seid) - 4, 5) AS long) "
				+ "FROM SehStEntity s " + "ORDER BY CAST(SUBSTRING(s.seid, LENGTH(s.seid) - 4, 5) AS long) DESC",
				Long.class);
		q.setMaxResults(1);
		List<Long> resultList = q.getResultList();
		return resultList.isEmpty() ? 0L : resultList.get(0);
	}

