	/**
	 *  filtering, grouping,sorting in  sales enquiry details 
	 * @Author - Sonal patil 
	 */
	public Page<Object[]> getGroupingListDataSalesEnquiryDetails(String queryForGrouping, String queryForGroupingAndFilteringCount,
			Integer page, Integer size, Integer skip, StatusRequest request) {
		List<String> statusList = request.getStatus();
		String statusFlag = null;
		if (request.getStatus() != null && !request.getStatus().isEmpty()) {
			statusFlag = OfsStatusConstants.AVAILABLE;
		} 
	    Query queryCount = entityManager.createQuery(queryForGroupingAndFilteringCount);
	    queryCount.setParameter(OfsConstants.STATUS_FLAG, statusFlag);
		queryCount.setParameter(OfsConstants.STATUS, statusList);
	    Number resultNumber = (Number) queryCount.getSingleResult();
	    int totalRows = resultNumber.intValue();
	    int effectiveOffset = page * size;
	    int effectivePageSize = size;

	    if (skip != null && skip > 0) {
	        if (skip >= size) {
	            effectiveOffset += skip; 
	            skip = 0;
	        } else {
	            effectiveOffset += skip;
	            effectivePageSize -= skip; 
	        }
	    }
	    Pageable pageable = PageRequest.of(page, size);
	    TypedQuery<Object[]> query = entityManager.createQuery(queryForGrouping, Object[].class);
	    query.setParameter(OfsConstants.STATUS_FLAG, statusFlag);
	    query.setParameter(OfsConstants.STATUS, statusList);
	    query.setFirstResult(effectiveOffset); // Correct OFFSET
	    query.setMaxResults(effectivePageSize); // Adjusted PAGE SIZE
	    List<Object[]> resultList = query.getResultList();
	    return new PageImpl<>(resultList, pageable, totalRows);
	}
