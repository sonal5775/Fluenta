	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<ProductDefinitionDto> updateProductDefinition(List<ProductDefinitionDto> list) {
		LOGGER.info("Updating product definitions: {}", list);
		dbSessionService.setSessionInfo(this.getClass().getName());

		for (ProductDefinitionDto dto : list) {
			LOGGER.debug("Processing product definition DTO: {}", dto);
			if (dto.getPrdid() != null && !dto.getPrdid().trim().isEmpty()) {
				Optional<PrdCs> productDef = productDefinationJPARepository.findById(dto.getPrdid().trim());
				PrdCs entity = productDef.orElseGet(() -> {
					LOGGER.debug("Creating new product definition entity for product ID: {}", dto.getPrdid());
					PrdCs newEntity = new PrdCs();
					newEntity.setPrdid(dto.getPrdid());
					return newEntity;
				});

				entity.setPrdnm(dto.getPrdnm());
				entity.setPrdfmly(dto.getPrdfmly());
				entity.setPrdcat(dto.getPrdcat());
				entity.setPrdshp(dto.getPrdshp());
				entity.setQtymin(dto.getQtymin());
				entity.setQtymax(dto.getQtymax());
				entity.setIsactv(dto.getIsactv());

				productDefinationJPARepository.save(entity);
				LOGGER.debug("Saved product definition entity: {}", entity);
			}
		}

		LOGGER.info("Completed updating product definitions: {}", list);
		return list;
	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<ProductDefinitionDto> saveProductDefinationDetails(List<ProductDefinitionDto> list) {
		LOGGER.info("Saving product definition details: {}", list);
		dbSessionService.setSessionInfo(this.getClass().getName());

		for (ProductDefinitionDto dto : list) {
			LOGGER.debug("Processing product definition DTO: {}", dto);
			if (dto.getPrdid() != null && !dto.getPrdid().trim().isEmpty()
					&& !productDefinationJPARepository.existsById(dto.getPrdid().trim())) {
				PrdCs entity = new PrdCs();
				entity.setPrdid(dto.getPrdid());
				entity.setPrdnm(dto.getPrdnm());
				entity.setPrdfmly(dto.getPrdfmly());
				entity.setPrdcat(dto.getPrdcat());
				entity.setPrdshp(dto.getPrdshp());
				entity.setQtymin(dto.getQtymin());
				entity.setQtymax(dto.getQtymax());
				entity.setIsactv(dto.getIsactv());

				productDefinationJPARepository.save(entity);
				LOGGER.debug("Saved product definition entity: {}", entity);
			}
		}

		LOGGER.info("Completed saving product definition details: {}", list);
		return list;
	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<ProductCodeDetailsDto> updateProductCodeDetails(List<ProductCodeDetailsDto> list) {
		LOGGER.info("Updating product code details: {}", list);
		dbSessionService.setSessionInfo(this.getClass().getName());

		for (ProductCodeDetailsDto dto : list) {
			LOGGER.debug("Processing product code details DTO: {}", dto);
			if (dto.getPrdcdeid() != null && !dto.getPrdcdeid().trim().isEmpty()) {
				Optional<PrdcdeCm> productCode = productCodeJPARepository.findById(dto.getPrdcdeid().trim());
				PrdcdeCm entity = productCode.orElseGet(() -> {
					LOGGER.debug("Creating new product code entity for code ID: {}", dto.getPrdcdeid());
					PrdcdeCm newEntity = new PrdcdeCm();
					newEntity.setPrdcdeid(dto.getPrdcdeid().trim());
					return newEntity;
				});

				if (dto.getGrdid() != null && !dto.getGrdid().trim().isEmpty()) {
					Optional<GrdCm> grd = grdCmRepository.findById(dto.getGrdid().trim());
					if (grd.isPresent()) {
						entity.setGrdid(grd.get().getGrdid());
					} else {
						LOGGER.info("Grade not found for grade ID: {}", dto.getGrdid());
					}
				}
				entity.setMoDt(new Date());
				entity.setMoBy(ClientIpUtils.getClient());
				entity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				entity.setThkmin(dto.getThkmin());
				entity.setThkmax(dto.getThkmax());
				entity.setWdtmin(dto.getWdtmin());
				entity.setWdtmax(dto.getWdtmax());
				entity.setIsactv(dto.getIsactv());

				productCodeJPARepository.save(entity);
				LOGGER.debug("Saved product code entity: {}", entity);
			}
		}

		LOGGER.info("Completed updating product code details: {}", list);
		return list;
	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<ProductCodeDetailsDto> saveProductCodeDetails(String prdid, List<ProductCodeDetailsDto> list) {
		LOGGER.info("Saving product code details for product ID: {}", prdid);
		dbSessionService.setSessionInfo(this.getClass().getName());

		if (list != null) {
			for (ProductCodeDetailsDto dto : list) {
				LOGGER.debug("Processing product code details DTO: {}", dto);
				if (dto != null && dto.getPrdcdeid() != null && !dto.getPrdcdeid().trim().isEmpty()
						&& !productCodeJPARepository.existsById(dto.getPrdcdeid().trim())) {
					PrdcdeCm entity = new PrdcdeCm();

					entity.setPrdcdeid(dto.getPrdcdeid().trim());
					entity.setThkmin(dto.getThkmin());
					entity.setThkmax(dto.getThkmax());
					entity.setWdtmin(dto.getWdtmin());
					entity.setWdtmax(dto.getWdtmax());
					entity.setIsactv(dto.getIsactv());
					entity.setPrdid(prdid);

					if (dto.getGrdid() != null) {
						Optional<GrdCm> grdCmOptional = grdCmRepository.findById(dto.getGrdid());
						GrdCm grdCm = grdCmOptional.orElseGet(() -> {
							GrdCm newGrdCm = new GrdCm();
							newGrdCm.setGrdid(dto.getGrdid());
							return grdCmRepository.save(newGrdCm);
						});

						entity.setGrdid(grdCm.getGrdid());
					}

					BigDecimal lastPrdcdectr = productCodeJPARepository.findLastPrdcdectr();
					BigDecimal newPrdcdectr = lastPrdcdectr != null ? lastPrdcdectr.add(BigDecimal.ONE) : BigDecimal.ONE;
					entity.setPrdcdectr(newPrdcdectr);

					productCodeJPARepository.save(entity);
					LOGGER.debug("Saved product code entity: {}", entity);
				}
			}
		} else {
			LOGGER.error("No product code details to save");
		}

		LOGGER.info("Completed saving product code details for product ID: {}", prdid);
		return list;
	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<AttributeMastermapDto> saveAttributeMapDetails(String prdid, List<AttributeMastermapDto> list) {
		LOGGER.info("Saving attribute map details for product ID: {}", prdid);
		dbSessionService.setSessionInfo(this.getClass().getName());

		if (list != null) {
			for (AttributeMastermapDto dto : list) {
				LOGGER.debug("Processing attribute map details DTO: {}", dto);
				PrdatrMapCsPK prdMapPK = new PrdatrMapCsPK(prdid, dto.getAtrid());

				Optional<PrdatrMapCs> existingEntity = attributeMapJPARepository.findById(prdMapPK);

				PrdatrMapCs entity = existingEntity.orElseGet(() -> {
					PrdatrMapCs newEntity = new PrdatrMapCs();
					newEntity.setId(prdMapPK);
					newEntity.setCrBy("Admin");
					return newEntity;
				});
				entity.setIsactv(dto.getIsactv());

				attributeMapJPARepository.save(entity);
				LOGGER.debug("Saved attribute map entity: {}", entity);
			}
		}

		LOGGER.info("Completed saving attribute map details for product ID: {}", prdid);
		return list;
	}

