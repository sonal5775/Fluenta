	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<ForcastCodeDto> saveForcastCodeDetails(String spec, String prdid, List<ForcastCodeDto> list) {
		LOGGER.info("Saving forecast code details for specification: {} and product ID: {}", spec, prdid);
		dbSessionService.setSessionInfo(this.getClass().getName());

		for (ForcastCodeDto dto : list) {
			LOGGER.debug("Processing forecast code details DTO: {}", dto);
			if (dto.getFcprodcde() != null && !dto.getFcprodcde().trim().isEmpty()) {
				Optional<FcprodcdeJm> forcastCodeOptional = forcastCodeRepository.findById(dto.getFcprodcde().trim());
				FcprodcdeJm entity = forcastCodeOptional.orElseGet(() -> {
					LOGGER.debug("Creating new forecast code entity for code: {}", dto.getFcprodcde());
					FcprodcdeJm newEntity = new FcprodcdeJm();
					newEntity.setFcprodcde(dto.getFcprodcde().trim());
					return newEntity;
				});

				entity.setThkmax(dto.getThkmax());
				entity.setThkmin(dto.getThkmin());
				entity.setWdtmax(dto.getWdtmax());
				entity.setWdtmin(dto.getWdtmin());
				entity.setIsactv(dto.getIsactv());
				entity.setPrdid(prdid);

				List<ExtGrdJmEntity> extgrdJm = extgrdJmRepository.findBySpec(spec);
				if (extgrdJm != null) {
					if (entity.getExtgrdnm() == null) {
						entity.setExtgrdnm(extgrdJm.get(0).getExtgrdnm());
					}
					entity.setExtgrdnm(extgrdJm.get(0).getExtgrdnm());
				}

				forcastCodeRepository.save(entity);
				LOGGER.debug("Saved forecast code entity: {}", entity);
			}
		}

		LOGGER.info("Completed saving forecast code details for specification: {} and product ID: {}", spec, prdid);
		return list;
	}

