	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public ResponseEntity<FluentaApiResponse<List<SampleDetailsDto>>> updateManualDecision(
			List<SampleDetailsDto> request) {

		dbSessionService.setSessionInfo(this.getClass().getName());

		ResponseEntity<FluentaApiResponse<List<SampleDetailsDto>>> response = null;
		List<HsmQualityChemicalDto> payload = new ArrayList<>();
		List<HsmQualityMechanicalDto> mechpayload = new ArrayList<>();
		for (SampleDetailsDto dto : request) {
			Optional<PostProdTaskMtEntity> optional = postProdTaskMtEntityJpaRepository
					.getTasksByPpidAndPrid(dto.getPpId(), dto.getTpiRequired(), QualityConstants.INSP_FLAG_YES);
			PostProdTaskMtEntity task = null;
			if (optional.isPresent()) {
				task = optional.get();
				task.setFinalResult(dto.getFinalResult());
				task.setManualDecision(dto.getManualDecision());
				task.setTaskStatus(QualityConstants.STATUS_COMPLETE);
				task.setModifiedBy(ClientIpUtils.getClient());
				task.setModifiedDate(new Date());
				task.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());
				task.setReleaseRemark(dto.getReleaseRemark());
				response = ResponseUtil.createResponse(request, "Update", false);
			} else {
				response = ResponseUtil.createErrorResponse(
						new ResourceNotFoundException("QualitySchdlEntity", null, optional), "Saving Failed", logger);
			}

			updateManualDecisionForMappedCoils(dto, task);

			Optional<SampleQualityEntity> findById = sampleQtMasterRepository.findById(dto.getSampleId().trim());
			if (findById.isPresent()) {
				SampleQualityEntity sampleQualityEntity = findById.get();
				sampleQualityEntity.setSampleStatus(QualityConstants.STATUS_COMPLETED);
			}

			List<String> specimenList = specimenQualityTransactionRepository.findSpecimenBySampleId(dto.getSampleId(),
					QualityConstants.STATUS_COMPLETE);

			for (String list : specimenList) {
				PpspecimanmapQtEntity ppspecimanmapQtEntity = new PpspecimanmapQtEntity();
				PpspecimanmapQtPKEntity mapPk = new PpspecimanmapQtPKEntity();

				mapPk.setppId(dto.getPpId());
				mapPk.setspecimanId(list);
				mapPk.setppCounter(dto.getPpCtr());

				Optional<PpspecimanmapQtEntity> findById2 = ppspecimanMapQtRepository.findById(mapPk);
				if (findById2.isPresent()) {
					ppspecimanmapQtEntity = findById2.get();
				}

				ppspecimanmapQtEntity.setId(mapPk);
				ppspecimanmapQtEntity.setPpMapStatus(QualityConstants.STATUS_MAPPED);
				ppspecimanmapQtEntity.setTaskStepId(dto.getTaskstepId());

			}

			if (dto.getFinalResult().equals(QualityConstants.FAIL)) {
				List<TestOrderLineQualityListEntity> findTestOrdByPpId = testordlQtRepository
						.findTestOrdByPpId(dto.getPpId());

				if (!findTestOrdByPpId.isEmpty()) {
					TestOrderLineQualityListEntity testOrderLine = findTestOrdByPpId.get(0);
					testOrderLine.setTestppSts(QualityConstants.REJECTED);
					testordlQtRepository.save(testOrderLine);
					List<TestOrderLineQualityListEntity> findTestOrderByIdAndStatus = testordlQtRepository
							.findTestOrderByIdAndStatus(testOrderLine.getId().gettestOrderId(),
									QualityConstants.MAPPED);

					if (!findTestOrderByIdAndStatus.isEmpty()) {

						for (TestOrderLineQualityListEntity testorder : findTestOrderByIdAndStatus) {

							testorder.setTestppSts(QualityConstants.PENDING);

							Optional<PostProdTaskMtEntity> tasksByPpidAndPrid = postProdTaskMtEntityJpaRepository
									.getTasksByPpidAndPrid(testorder.getPpId(), dto.getTpiRequired(),
											QualityConstants.INSP_FLAG_YES);

							if (tasksByPpidAndPrid.isPresent()) {
								PostProdTaskMtEntity postProdTaskMtEntity = tasksByPpidAndPrid.get();
								postProdTaskMtEntity.setMapSampleId(null);
							}
						}
					}
				}
			}
			/*
			 * SAP CODE FOR MECH AND CHEM DATA
			 */
			HsmQualityMechanicalDto dtoMechDataSAP = new HsmQualityMechanicalDto();
			HsmQualityMechanicalDto dtoMechData = sapInterface.buildHsmQualityMechanicalDto(dtoMechDataSAP,
					dto.getPpId(), dto.getHeatId(), dto.getSampleId());
			mechpayload.add(dtoMechData);

			HsmQualityChemicalDto dtoDataSAP = new HsmQualityChemicalDto();
			HsmQualityChemicalDto dtoData = sapInterface.buildHsmQualityChemicalDto(dtoDataSAP, dto.getPpId(),
					dto.getSlabid(), dto.getHeatId(), dto.getSampleId());
			logger.info("dtoData: {}", dtoData);
			payload.add(dtoData);

		}
		try {
			JsonFormatMechSapDto jsonFormatMechSapDto = new JsonFormatMechSapDto();
			jsonFormatMechSapDto.setMechDto(mechpayload);
			String convertObjectToMechJson = JsonUtil.convertObjectToJson(jsonFormatMechSapDto);
			sapServiceClient.sendHsmMechTestData(convertObjectToMechJson);

			JsonFormatSapDto jsonFormatSapDto = new JsonFormatSapDto();
			jsonFormatSapDto.setChemDto(payload);
			String convertObjectToJson = JsonUtil.convertObjectToJson(jsonFormatSapDto);
			sapServiceClient.sendHsmChemTestData(convertObjectToJson);

		} catch (Exception e) {

		}
		return response;
	}

	private void updateManualDecisionForMappedCoils(SampleDetailsDto dto, PostProdTaskMtEntity testedTask) {
		List<PostProdTaskMtEntity> mappedCoils = postProdTaskMtEntityJpaRepository
				.getTasksByMappedSampleId(testedTask.getId().getPpId(), testedTask.getMapSampleId());
		for (PostProdTaskMtEntity task : mappedCoils) {
			task.setFinalResult(dto.getFinalResult());
			task.setManualDecision(dto.getManualDecision());
			task.setTaskStatus(QualityConstants.STATUS_LAB_COMPLETED);
			task.setModifiedBy(ClientIpUtils.getClient());
			task.setModifiedDate(new Date());
			task.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());
			task.setReleaseRemark(dto.getReleaseRemark());
			postProdTaskMtEntityJpaRepository.save(task);
		}

	}

	@Override
	public ResponseEntity<FluentaApiResponse<List<ChemicalTestingDto>>> fetchChemical(String internalGrd, String extGrd,
			String ppId, String slabId, String sampleId) {

		List<MechanicalTestDto> testBySampleIdAndName = custRepository.getTestBySampleIdAndName(sampleId,
				QualityConstants.SPECTRO_TEST);

		if (testBySampleIdAndName != null && !testBySampleIdAndName.isEmpty()) {
			MechanicalTestDto mechanicalTestDto = testBySampleIdAndName.get(0);
			List<ChemicalTestingDto> list = custRepository.fetchChemical(internalGrd, extGrd, ppId, slabId,
					mechanicalTestDto.getSpecimenId());
			list.forEach(dto -> dto.setSpecimanId(mechanicalTestDto.getSpecimenId()));
			return ResponseUtil.createResponse(list, "Fetching Mapped Coils", true);
		}
		return ResponseUtil.createResponse(null, "Fetching Mapped Coils", true);

	}

	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public void saveChemTesting(List<ChemicalTestingDto> dto) {
		dbSessionService.setSessionInfo(this.getClass().getName());

		if (dto != null && !dto.isEmpty()) {
			for (ChemicalTestingDto chemicalTestingDto : dto) {
				if (chemicalTestingDto.getElement() != null) {
					ChemResultQtEntity existingEntity = chemResultQtRepository
							.findBySpecAndEle(chemicalTestingDto.getElement(), chemicalTestingDto.getSpecimanId());
					ChemResultQtPkEntity pk = new ChemResultQtPkEntity();
					pk.setElement(chemicalTestingDto.getElement());
					pk.setspecimanId(chemicalTestingDto.getSpecimanId());

					if (existingEntity != null) {
						existingEntity.setElementValue(chemicalTestingDto.getTpaRecValue());
						chemResultQtRepository.save(existingEntity);
					} else {
						ChemResultQtEntity newEntity = new ChemResultQtEntity();
						newEntity.setId(pk);
						newEntity.setElementValue(chemicalTestingDto.getTpaRecValue());
						chemResultQtRepository.save(newEntity);
					}
				}

			}
		}
	}

