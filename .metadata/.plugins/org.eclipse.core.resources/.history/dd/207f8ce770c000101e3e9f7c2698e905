	public void saveOtherTestResult(String specimanId, List<OtherTestResultLabTestingDto> othrTestResult) {
		logger.info("Entering saveOtherTestResult with specimenId: {}, otherTestResult: {}", specimanId,
				othrTestResult);

		dbSessionService.setSessionInfo(this.getClass().getName());
		for (OtherTestResultLabTestingDto item : othrTestResult) {
			OtherTestResultQualityTransactionEntity othrTstRsltEntity = new OtherTestResultQualityTransactionEntity();
			Optional<OtherTestResultQualityTransactionEntity> optional = otherTestResultQualityTransactionRepository
					.findById(specimanId);
			if (optional.isPresent()) {
				othrTstRsltEntity = optional.get();
			} else {
				othrTstRsltEntity.setSpecimanId(specimanId);
				othrTstRsltEntity.setCreatedDate(new Date());
				othrTstRsltEntity.setCreatedBy(ClientIpUtils.getClient());
				othrTstRsltEntity.setIsActive(BigDecimal.ONE);
				othrTstRsltEntity.setCreatedMacAddress(ClientIpUtils.getClientIpAddress());
			}
			othrTstRsltEntity.setTestRemarks(item.getTestRemarks());
			othrTstRsltEntity.setModifiedBy(ClientIpUtils.getClient());
			othrTstRsltEntity.setModifiedDate(new Date());
			othrTstRsltEntity.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());
			otherTestResultQualityTransactionRepository.save(othrTstRsltEntity);
			updateSpecimanForOtherTest(specimanId, item);
		}
	}

	private void updateSpecimanForOtherTest(String specimanId, OtherTestResultLabTestingDto item) {
		SpecimenQualityTransactionEntity specimnQltyTrsnEntity = new SpecimenQualityTransactionEntity();
		Optional<SpecimenQualityTransactionEntity> isCheckSpecimanId = specimenQualityTransactionRepository
				.findById(specimanId);
		if (isCheckSpecimanId.isPresent()) {
			specimnQltyTrsnEntity = isCheckSpecimanId.get();
			specimnQltyTrsnEntity.setSpecimenStatus(item.getSpecimenStatus());
		} else {
			specimnQltyTrsnEntity.setSpecimenId(specimanId);
		}
		specimnQltyTrsnEntity.setFinalResult(item.getFinalResult());
		if (item.getManualDecision() != null && QualityConstants.PASS.equals(item.getManualDecision())) {
			specimnQltyTrsnEntity.setReleaseRemark(item.getReleaseRemark());
		} else {
			specimnQltyTrsnEntity.setHoldRemark(item.getReleaseRemark());
		}
		specimnQltyTrsnEntity.setManualDecision(item.getManualDecision());
		specimenQualityTransactionRepository.save(specimnQltyTrsnEntity);
	}

	@Transactional
	@Override
	public FluentaApiResponse<Void> retest(String sampleId, String specimanId, String baseSpecimenId) {
		logger.info("Entering retest with sampleId: {}, specimenId: {}", sampleId, specimanId);

		dbSessionService.setSessionInfo(this.getClass().getName());
		FluentaApiResponse<Void> response = new FluentaApiResponse<>();
		SpecimenQualityTransactionEntity specimnQltyTrsnEntity;
		Optional<SpecimenQualityTransactionEntity> isCheckSpecimanId = specimenQualityTransactionRepository
				.findById(specimanId);

		if (isCheckSpecimanId.isPresent()) {

			specimnQltyTrsnEntity = isCheckSpecimanId.get();
			specimnQltyTrsnEntity.setSpecimenStatus(QualityConstants.REJECTED);
			specimenQualityTransactionRepository.save(specimnQltyTrsnEntity);
			response.addMessage(MessageType.SUCCESS, "Resample Successfully Completed");

		} else {
			response.addMessage(MessageType.ERROR, "No valid testOrderId records found to update.");

		}
		List<SpecimenQualityTransactionEntity> findChildSpecimanId = specimenQualityTransactionRepository
				.findChildBySpecimanId(baseSpecimenId);

		if (!findChildSpecimanId.isEmpty()) {

			for (SpecimenQualityTransactionEntity sqt : findChildSpecimanId) {
				sqt.setSpecimenStatus(QualityConstants.REJECTED);
				specimenQualityTransactionRepository.save(sqt);
			}
			response.addMessage(MessageType.SUCCESS, "Resample Successfully Completed");

		} else {
			response.addMessage(MessageType.ERROR, "No valid testOrderId records found to update.");

		}

		saveSpecimenGeneration(sampleId, specimanId, findChildSpecimanId);
		return response;
	}

	public void saveSpecimenGeneration(String sampleId, String specimanId,
			List<SpecimenQualityTransactionEntity> childSpecimanIdList) {
		SpecimenQualityTransactionEntity data = null;

		dbSessionService.setSessionInfo(this.getClass().getName());
		SpecimenQualityTransactionEntity specimanEntity = new SpecimenQualityTransactionEntity();

		Optional<SpecimenQualityTransactionEntity> findById = specimenQualityTransactionRepository.findById(specimanId);
		if (findById.isPresent()) {
			data = findById.get();
		}

		BigDecimal specimenCounter = null;
		if (sampleId != null) {
			BigDecimal maxCount = specimenQualityTransactionRepository.findMaxSpecimenCounterBySampleId(sampleId);
			specimanEntity.setSpecimenId(getNextId(specimanId));
			specimenCounter = maxCount.add(BigDecimal.ONE);
			specimanEntity.setSpecimenCounter(specimenCounter);
		}

		if (data != null) {
			specimanEntity.setSampleId(data.getSampleId());
			specimanEntity.setSpecification(data.getSpecification());
			specimanEntity.setTestType(data.getTestType());
			specimanEntity.setTestSpecimenType(data.getTestSpecimenType());
			specimanEntity.setThickness(data.getThickness());
			specimanEntity.setLength(data.getLength());
			specimanEntity.setWidth(data.getWidth());
			specimanEntity.setTestMethod(data.getTestMethod());
			specimanEntity.setSpecimenStatus(QualityConstants.PENDING);
			specimanEntity.setPreparationMethod(data.getPreparationMethod());
			specimanEntity.setCondition(data.getCondition());
			specimanEntity.setTestSource(data.getTestSource());
			specimanEntity.setTemperature(data.getTemperature());
			specimanEntity.setDirection(data.getDirection());
			specimanEntity.setDegrees(data.getDegrees());

		}

		specimenQualityTransactionRepository.save(specimanEntity);

		if (!childSpecimanIdList.isEmpty()) {

			int size = childSpecimanIdList.size();

			for (SpecimenQualityTransactionEntity sqt : childSpecimanIdList) {

				SpecimenQualityTransactionEntity specimenety = new SpecimenQualityTransactionEntity();

				String childSpecimenId = incrementLastNumber(sqt.getSpecimenId(), size);

				specimenety.setSpecimenId(childSpecimenId);
				if (specimenCounter != null) {
					specimenCounter = specimenCounter.add(BigDecimal.ONE);

				}
				specimenety.setSpecimenCounter(specimenCounter);
				specimenety.setSampleId(sqt.getSampleId());
				specimenety.setSpecification(sqt.getSpecification());
				specimenety.setTestType(sqt.getTestType());
				specimenety.setTestSpecimenType(sqt.getTestSpecimenType());
				specimenety.setThickness(sqt.getThickness());
				specimenety.setLength(sqt.getLength());
				specimenety.setWidth(sqt.getWidth());
				specimenety.setTestMethod(sqt.getTestMethod());
				specimenety.setSpecimenStatus(QualityConstants.PENDING);
				specimenety.setPreparationMethod(sqt.getPreparationMethod());
				specimenety.setCondition(sqt.getCondition());
				specimenety.setTestSource(sqt.getTestSource());
				specimenQualityTransactionRepository.save(specimenety);

			}
		}
	}

	private static String incrementLastNumber(String str, int size) {

		int lastDotIndex = str.lastIndexOf('.');
		String base = str.substring(0, lastDotIndex);
		int lastNumber = Integer.parseInt(str.substring(lastDotIndex + 1));
		String incrementedNumber = String.format("%02d", lastNumber + size);
		return base + "." + incrementedNumber;
	}

	public static String getNextId(String currentId) {
		String baseId;
		int nextSuffix;

		if (currentId.matches(".*R\\d+$")) {
			baseId = currentId.substring(0, currentId.lastIndexOf('R'));
			String suffixStr = currentId.substring(currentId.lastIndexOf('R') + 1);
			int currentSuffix = Integer.parseInt(suffixStr);
			nextSuffix = currentSuffix + 1;
		} else {
			baseId = currentId;
			nextSuffix = 1;
		}
		return baseId + "R" + nextSuffix;
	}

