	public MechanicalTestResultDto saveMechanicalTestResult(MechanicalTestResultDto request) {

		logger.info("Saving mechanical test result...");

		if (request.getTensileResult() != null && !request.getTensileResult().isEmpty()) {
			labTestingServiceImpl.saveTensileResult(request.getTensileResult());
		}

		if (request.getImpactResultCun() != null && !request.getImpactResultCun().isEmpty()) {
			labTestingServiceImpl.saveImpactResult(request.getImpactResultCun());

		}
		if (request.getImpactResultCvn() != null && !request.getImpactResultCvn().isEmpty()) {
			labTestingServiceImpl.saveImpactResult(request.getImpactResultCvn());

		}
		if (request.getBendResult() != null && !request.getBendResult().isEmpty()) {
			labTestingServiceImpl.saveBendResult(request.getBendResult());

		}
		if (request.getHighTempTensileTestResult() != null && !request.getHighTempTensileTestResult().isEmpty()) {
			labTestingServiceImpl.saveHighTempTensileResult(

					request.getHighTempTensileTestResult());

		}
		if (request.getZtestResult() != null && !request.getZtestResult().isEmpty()) {
			labTestingServiceImpl.saveZTestResult(request.getZtestResult());

		}
		if (request.getInclusionRatingResult() != null && !request.getInclusionRatingResult().isEmpty()) {
			labTestingServiceImpl.saveInclusionRatingResult(request.getInclusionRatingResult());

		}
		if (request.getDwttResult() != null && !request.getDwttResult().isEmpty()) {
			labTestingServiceImpl.saveDWTTResult(request.getDwttResult());

		}
		if (request.getHardnessResult() != null && !request.getHardnessResult().isEmpty()) {
			labTestingServiceImpl.saveHardnessResult(request.getHardnessResult());
		}

		logger.info("Mechanical test result saved successfully.");
		return request;
	}

