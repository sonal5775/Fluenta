	public List<String> searchMatchingSlab(String query){
		TypedQuery<String> q = entityManager.createQuery(
				"SELECT distinct ph.id.ppid FROM PphMt ph WHERE ph.prdid = 'SLAB' AND LOWER(ph.id.ppid) LIKE LOWER(:query)",String.class);
		q.setMaxResults(10);
		q.setParameter(QUERY, "%" + query.toLowerCase() + "%");
		return q.getResultList();
	}
	
