		}
		if (request.getMultiLocationList() != null && !request.getMultiLocationList().isEmpty()) {
			locationFlag = OfsStatusConstants.AVAILABLE;
		}
		
		
		StringBuilder query = new StringBuilder();
		query.append("SELECT count(ph) ")
                .append("FROM PphMt ph LEFT JOIN PppostprodtaskMt pppt ON ph.id.ppid = pppt.id.ppid AND ph.id.ppctr = (select MAX(phh.id.ppctr) from PphMt phh where ph.id.ppid=phh.id.ppid) AND pppt.id.taskstepid = (select MAX(pt.id.taskstepid) from PppostprodtaskMt pt where pt.id.ppid=pppt.id.ppid AND pt.id.ppctr = pppt.id.ppctr) AND pppt.prid = :prid ")
                .append("LEFT JOIN PpqcmassbalQt mbl ON pppt.id.ppid = mbl.id.ppid AND pppt.id.ppctr = mbl.id.ppctr AND pppt.id.taskstepid = mbl.id.taskstepid AND mbl.prdid = :slab ")
                .append("LEFT JOIN PoprlSt pos ON ph.poid = pos.id.poid AND ph.poprctr = pos.id.poprctr AND pos.opprdid = :slab ")
                .append("LEFT JOIN SolSt sos ON pos.soid = sos.id.soid AND pos.solid = sos.id.solid ")
                .append(CONDITION_SELECTED_HEAT)
                .append("AND (:selectedSlab IS NULL OR ph.id.ppid IN :selectedSlab) ")
                .append("AND (:slabIdFlag IS NULL OR ph.id.ppid IN :multiSlab) ")
                .append("AND (:statusFlag IS NULL OR UPPER(TRIM(ph.ppsts)) IN :multiStatus) ")
                .append("AND (:locationFlag IS NULL OR ph.slocid IN :multiLocation) ")
                .append("AND (:selectedStatus IS NULL OR UPPER(TRIM(ph.ppsts)) IN :selectedStatus) ")
                .append(CONDITION_SELECTED_SHIFT)
                .append("  AND (:fromDate IS NULL OR ph.prodDt >= :fromDate)")
       		 	.append("  AND (:toDate IS NULL OR ph.prodDt<= :toDate )")
                .append("AND (:selectedSource IS NULL OR ph.source IN :selectedSource)  ")
                .append("AND (:selectedIntgrd IS NULL OR ph.grdid IN :selectedIntgrd)  ")
                .append(CONDITION_SELECTED_LOCATION)
                .append("AND UPPER(TRIM(ph.prdid)) = :slab ") 
                .append(CONDITION_PPSTS_IN)
			    .append("AND (:selectedThkFrom IS NULL OR ph.thk >= :selectedThkFrom) ")
			    .append("AND (:selectedThkTo IS NULL OR ph.thk <= :selectedThkTo) ")
			    .append("AND (:selectedFromSlabWidth IS NULL OR ph.wdt >= :selectedFromSlabWidth) ")
			    .append("AND (:selectedToSlabWidth IS NULL OR ph.wdt <= :selectedToSlabWidth) ")
			    .append("AND (:selectedFromSlabLength IS NULL OR ph.len >= :selectedFromSlabLength) ")
			    .append("AND (:selectedToSlabLength IS NULL OR ph.len <= :selectedToSlabLength) ")
				.append("order by ph.prodDt desc");
		 
		TypedQuery<Long> q = entityManager.createQuery(query.toString(),Long.class);
		q.setParameter(SELECTED_HEAT, request.getHeatid());
		q.setParameter(SELECTED_SLAB, request.getPpid());
		q.setParameter(SELECTED_STATUS, request.getPpsts());
		q.setParameter(OfsConstants.SELECTED_SOURCE, request.getSource());
		q.setParameter(OfsConstants.SELECTED_SHIFT, request.getShiftid());
		q.setParameter(OfsConstants.FROM_DATE, request.getFromDate());
		q.setParameter(OfsConstants.TO_DATE, request.getToDate());
		q.setParameter(OfsConstants.SELECTED_LOCATION, request.getSlocid());
		q.setParameter(OfsConstants.SELECTED_INTGRD, request.getGrdid());
		q.setParameter(OfsConstants.SELECTED_THKFROM, request.getSelectedThkFrom());
		q.setParameter(OfsConstants.SELECTED_THKTO, request.getSelectedThkTo());
		q.setParameter(OfsConstants.SELECTED_WIDTHFROM, request.getSelectedFromSlabWidth());
		q.setParameter(OfsConstants.SELECTED_WIDTHTO, request.getSelectedToSlabWidth());
		q.setParameter(OfsConstants.SELECTED_LENGTHFROM, request.getSelectedFromSlabLength());
		q.setParameter(OfsConstants.SELECTED_LENGTHTO, request.getSelectedToSlabLength());
		q.setParameter(OfsConstants.SELECTED_MULTI_SLAB, request.getMultiSlabList() != null ? request.getMultiSlabList() : null);
		q.setParameter(OfsConstants.SELECTED_MULTI_STATUS, request.getMultiStatusList() != null ? request.getMultiStatusList() : null);
		q.setParameter(OfsConstants.SELECTED_MULTI_LOCATION, request.getMultiLocationList() != null ? request.getMultiLocationList() : null);
		q.setParameter(OfsConstants.SLAB_ID_FLAG, slabIdFlag);
		q.setParameter(OfsConstants.STATUS_FLAG, statusFlag);
