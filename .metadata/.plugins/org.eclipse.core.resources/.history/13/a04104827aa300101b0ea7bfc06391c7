	public Page<SlabStockDto> getSlabStocks(SlabStockRequest request,String status, int page, int size,String query,String countQueryParm,Integer skip){
		logger.info(STATUS_LOG,status);
	    // Step 1: Calculate effective OFFSET and PAGE SIZE
	    int effectiveOffset = page * size;
	    int effectivePageSize = size;

	    if (skip != null && skip > 0) {
	        if (skip >= size) {
	            effectiveOffset += skip; // Adjust the offset by skipping additional rows
	            skip = 0; // Reset skip as it's already accounted for
				logger.info("skip : {} ",skip);
	        } else {
	            effectiveOffset += skip; 
	            effectivePageSize -= skip; // Adjust the size to exclude skipped rows
	        }
	    }

	    TypedQuery<SlabStockDto> q = entityManager.createQuery(query, SlabStockDto.class);

	    q.setParameter(SELECTED_HEAT, request.getHeatid());
	    q.setParameter(SELECTED_SLAB, request.getPpid());
	    q.setParameter(SELECTED_STATUS, request.getPpsts());
	    q.setParameter(SELECTED_SOURCE, request.getSource());
	    q.setParameter(SELECTED_SHIFT, request.getShiftid());
	    q.setParameter(FROM_DATE, request.getFromDate());
	    q.setParameter(TO_DATE, request.getToDate());
	    q.setParameter(SELECTED_LOCATION, request.getSlocid());
	    q.setParameter(OfsConstants.PRID, OfsConstants.SMSINSP);

	    q.setFirstResult(effectiveOffset);
	    q.setMaxResults(effectivePageSize);

	    List<SlabStockDto> resultList = q.getResultList();

	    // Step 3: Query for Count
	    Query countQuery = entityManager.createQuery(countQueryParm);

	       
	    countQuery.setParameter(SELECTED_HEAT, request.getHeatid());
	    countQuery.setParameter(SELECTED_SLAB, request.getPpid());
	    countQuery.setParameter(SELECTED_STATUS, request.getPpsts());
	    countQuery.setParameter(OfsConstants.SELECTED_SOURCE, request.getSource());
	    countQuery.setParameter(OfsConstants.SELECTED_SHIFT, request.getShiftid());
	    countQuery.setParameter(OfsConstants.FROM_DATE, request.getFromDate());
	    countQuery.setParameter(OfsConstants.TO_DATE, request.getToDate());
	    countQuery.setParameter(OfsConstants.SELECTED_LOCATION, request.getSlocid());
	    

	    Long totalRows = (Long) countQuery.getSingleResult();

	    Pageable pageable = PageRequest.of(page, size);
	    return new PageImpl<>(resultList, pageable, totalRows);
		
	}
	
	public List<String> searchStringFilter(String filterValue,String tableName,String columnName) {
		TypedQuery<String> q = entityManager.createQuery("SELECT distinct (fn."+columnName+") from "+tableName+" fn"
				+ " where (lower(:filterValue) is null or lower(fn."+columnName+") like lower(concat('%', :filterValue,'%')))"
				+ " and fn."+columnName+" is not null"
				+ " and fn.ppsts IN :slabStatusList"
				+ " order by fn."+columnName+" desc"
				,String.class);
		q.setParameter("filterValue", filterValue);
		q.setParameter("slabStatusList", slabStatusList);
		return q.getResultList();
	}
	public List<Long> searchNumberFilter(String filterValue,String tableName,String columnName) {
		TypedQuery<Long> q = entityManager.createQuery("SELECT distinct (fn."+columnName+") from "+tableName+" fn"
				+ " where (:filterValue is null or cast(fn."+columnName+" as string) like concat('%', :filterValue,'%'))"
				+ " and fn."+columnName+" is not null"
				+ " order by fn."+columnName+" desc"
				,Long.class);
		q.setParameter("filterValue", filterValue);
		q.setParameter("slabStatusList", slabStatusList);
		
		return q.getResultList();
	}
	
