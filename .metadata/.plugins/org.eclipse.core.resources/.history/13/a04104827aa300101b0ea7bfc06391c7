	public List<PphMt> findRecordUsingLocationAndSequenceTyped(String location, BigDecimal sequence) {
	    StringBuilder queryBuilder = new StringBuilder();
	    queryBuilder.append("SELECT p FROM PphMt p ")
	                .append("WHERE p.slocid = :location ")
	                .append("AND p.slocseq = :sequence ")
	                .append("AND (UPPER(TRIM(p.ppsts)) = :freestock OR UPPER(TRIM(p.ppsts)) = :available OR UPPER(TRIM(p.ppsts)) = :hold)");

	    TypedQuery<PphMt> query = entityManager.createQuery(queryBuilder.toString(), PphMt.class);

	    query.setParameter(OfsStatusConstants.SLOCATION, location);
	    query.setParameter(OfsStatusConstants.SSEQUENCE, sequence);
	    query.setParameter(OfsStatusConstants.SFREESTOCK, OfsStatusConstants.FREE_STOCK);
	    query.setParameter(OfsStatusConstants.SAVAILABLE, OfsStatusConstants.AVAILABLE);
	    query.setParameter(OfsStatusConstants.SHOLD, OfsStatusConstants.HOLD);

	    return query.getResultList();
	}
	
	public long getTotalRecordCount(SlabStockRequest request) {
