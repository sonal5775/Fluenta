		String statusFlag = null;
		String locationFlag = null;
		
		
		if (request.getMultiSlabList() != null && !request.getMultiSlabList().isEmpty()) {
			slabIdFlag = OfsStatusConstants.AVAILABLE;
		}
		if (request.getMultiStatusList() != null && !request.getMultiStatusList().isEmpty()) {
