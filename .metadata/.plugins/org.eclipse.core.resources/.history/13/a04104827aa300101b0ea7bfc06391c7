	public Page<Object[]> getGroupingListData(String queryForGrouping, String queryForGroupingAndFilteringCount,
			Integer page, Integer size, Integer skip, SlabStockRequest request, String status) {
		logger.info(STATUS_LOG,status);

		
	    Query queryCount = entityManager.createQuery(queryForGroupingAndFilteringCount);
	    queryCount.setParameter(SELECTED_HEAT, request.getHeatid());
	    queryCount.setParameter(SELECTED_SLAB, request.getPpid());
	    queryCount.setParameter(SELECTED_STATUS, request.getPpsts());
	    queryCount.setParameter(SELECTED_SOURCE, request.getSource());
	    queryCount.setParameter(SELECTED_SHIFT, request.getShiftid());
	    queryCount.setParameter(FROM_DATE, request.getFromDate());
	    queryCount.setParameter(TO_DATE, request.getToDate());
	    queryCount.setParameter(SELECTED_LOCATION, request.getSlocid());
	    
	    Number resultNumber = (Number) queryCount.getSingleResult();
	    int totalRows = resultNumber.intValue();

	    // Step 2: Adjust effective offset considering SKIP and PAGE SIZE
	    int effectiveOffset = page * size;
	    int effectivePageSize = size;

	    if (skip != null && skip > 0) {
	        if (skip >= size) {
	            effectiveOffset += skip; // Move to the next offset if skip exceeds size
	            skip = 0; // Skip is already included in the offset
				logger.info("skip : {} ",skip);
	        } else {
	            effectiveOffset += skip;
	            effectivePageSize -= skip; // Adjust the size to consider the skip
	        }
	    }

	    // Step 3: Pageable object for response
	    Pageable pageable = PageRequest.of(page, size);

	    // Step 4: Data Query
	    TypedQuery<Object[]> query = entityManager.createQuery(queryForGrouping, Object[].class);
	    query.setParameter(SELECTED_HEAT, request.getHeatid());
	    query.setParameter(SELECTED_SLAB, request.getPpid());
	    query.setParameter(SELECTED_STATUS, request.getPpsts());
	    query.setParameter(SELECTED_SOURCE, request.getSource());
	    query.setParameter(SELECTED_SHIFT, request.getShiftid());
	    query.setParameter(FROM_DATE, request.getFromDate());
	    query.setParameter(TO_DATE, request.getToDate());
	    query.setParameter(SELECTED_LOCATION, request.getSlocid());
	    query.setFirstResult(effectiveOffset); // Correct OFFSET
	    query.setMaxResults(effectivePageSize); // Adjusted PAGE SIZE
	    
	    // Step 5: Fetch results
	    List<Object[]> resultList = query.getResultList();
	   
	    for (Object[] row : resultList) {
	        if (row[0] instanceof String) { // Ensure first column is a String
	            String key = (String) row[0];
	            // Replace values as per your condition
	            switch (key) {
	                case "A":
	                    row[0] = "B";
	                    break;
	                case "M":
	                    row[0] = "A";
	                    break;
	                case "N":
	                    row[0] = "C";
	                    break;
					default:
						break;
	            }
	        }
	    }
	    List<Object[]> uniqueResults = resultList.stream()
	            .collect(Collectors.collectingAndThen(
	                    Collectors.toMap(row -> (String) row[0], row -> row, (a, b) -> a),
	                    m -> new ArrayList<>(m.values())
	            ));
	    return new PageImpl<>(resultList, pageable, totalRows);    
	}

