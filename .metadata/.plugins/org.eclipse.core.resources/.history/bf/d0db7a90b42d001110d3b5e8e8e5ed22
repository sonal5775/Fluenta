	public String filterQueryUsingFilterListFlatnessTolerance(List<String> filterList, String query) {
		StringBuilder queryBuilder = new StringBuilder(query);
		queryBuilder.append(" AND ( ");

		List<String> columnNames = DevExtGridFilterUtils.getAllFields(FlatnessToleranceDto.class);

		Map<String, String> columnDataTypesKeyValuePair = DevExtGridFilterUtils
				.getAllFieldsWithTypes(FlatnessToleranceDto.class);
		Map<String, String> columnAlise = checkClassAleasFlatnessTolerance();

		boolean isClobObject = false;
		boolean isStringObject = false;
		boolean isDateObject = false;
		boolean isContains = false;
		boolean isNotContains = false;
		boolean isStartWith = false;
		boolean isEndWith = false;

		extractedFilterQueryUsingFilterList(filterList, queryBuilder, columnNames, columnDataTypesKeyValuePair,
				columnAlise, isClobObject, isStringObject, isDateObject, isContains, isNotContains, isStartWith,
				isEndWith);
		queryBuilder.append(" ) ");
		return queryBuilder.toString();
	}

	private void extractedFilterQueryUsingFilterList(List<String> filterList, StringBuilder queryBuilder,
			List<String> columnNames, Map<String, String> columnDataTypesKeyValuePair, Map<String, String> columnAlise,
			boolean isClobObject, boolean isStringObject, boolean isDateObject, boolean isContains,
			boolean isNotContains, boolean isStartWith, boolean isEndWith) {
		for (int i = 0; i < filterList.size(); i++) {
			String item = filterList.get(i);
			if (columnNames.contains(item)) {
				if ("CLOB".equals(columnDataTypesKeyValuePair.get(item))) {
					queryBuilder.append("DBMS_LOB.INSTR(").append(columnAlise.get(item)).append(",");
					isClobObject = true;
				} else if ("DATE".equals(columnDataTypesKeyValuePair.get(item))) {
					queryBuilder.append(" TO_CHAR(").append(columnAlise.get(item)).append(", 'YYYY-MM-DD')");
					isDateObject = true;
				} else if ("VARCHAR2".equals(columnDataTypesKeyValuePair.get(item))) {
					queryBuilder.append("UPPER(TRIM(").append(columnAlise.get(item)).append("))");
					isStringObject = true;
				} else {
					queryBuilder.append(columnAlise.get(item));
				}

			} else if (item.equals(CONTAINS) || item.equals(NOTCONTAINS) || item.equals(STARTSWITH)
					|| item.equals(ENDSWITH)) {
				if (isClobObject) {
					//
				} else if (isDateObject) {
					queryBuilder.append(LIKE);
				} else {
					if (item.equals(CONTAINS)) {
						queryBuilder.append(LIKE);
						isContains = true;
					} else if (item.equals(NOTCONTAINS)) {
						queryBuilder.append(NOT_LIKE);
						isNotContains = true;
					} else if (item.equals(STARTSWITH)) {
						queryBuilder.append(LIKE);
						isStartWith = true;
					} else if (item.equals(ENDSWITH)) {
						queryBuilder.append(LIKE);
						isEndWith = true;
					} else {
						queryBuilder.append(" = ");
					}
				}
			} else if (item.equals("or") || item.equals("and")) {
				queryBuilder.append(" ").append(item).append(" ");
			} else if (item.equals("=") || item.equals("<>") || item.equals(">=") || item.equals("<")
					|| item.equals(">")) {
				queryBuilder.append(" ").append(item);
			} else {
				if (isClobObject) {
					queryBuilder.append("'").append(item).append("') > 0");
					isClobObject = false;
				} else if (isStringObject) {
					if (isContains) {
						queryBuilder.append(UPPER_TRIM_LIKE_PREFIX).append(item).append(UPPER_TRIM_SUFFIX);
						isContains = false;
					} else if (isNotContains) {
						queryBuilder.append(UPPER_TRIM_LIKE_PREFIX).append(item).append(UPPER_TRIM_SUFFIX);
						isNotContains = false;
					} else if (isStartWith) {
						queryBuilder.append(UPPER_TRIM_START_WITH).append(item).append("%'))");
						isStartWith = false;
					} else if (isEndWith) {
						queryBuilder.append(UPPER_TRIM_LIKE_PREFIX).append(item).append("'))");
						isEndWith = false;
					} else {
						queryBuilder.append(UPPER_TRIM_START_WITH).append(item).append("'))");
					}
					isStringObject = false;

				} else if (isDateObject) {
					item = item.replace(" ", "+");
					DateTimeFormatter formatter = DateTimeFormatter.ISO_OFFSET_DATE_TIME;
					OffsetDateTime dateTime = OffsetDateTime.parse(item, formatter);
					String dateOnly = dateTime.toLocalDate().toString();

					queryBuilder.append(" '").append(dateOnly).append("'");

					isDateObject = false;
				} else {
					queryBuilder.append(" ").append(item);
				}
			}
		}
	}
