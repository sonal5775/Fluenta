	@SuppressWarnings("unchecked")
	private <T> T buildGroupedDataResponseFlatnessTolerance(Page<Object[]> groupingListData, Long mainQueryCount, Long totalDistCount) {
		GroupedDataResponse<FlatnessToleranceDto> result = new GroupedDataResponse<>(null, 0L, 0L);
		List<Group<FlatnessToleranceDto>> list = new ArrayList<>();

		if (groupingListData != null && !groupingListData.isEmpty()) {
			extractedLoopForBuildGroupedData(groupingListData, list);
		}

		result.setData(list);
		result.setTotalCount(mainQueryCount);
		result.setGroupCount(totalDistCount);
		return (T) result;
	}

	private void extractedLoopForBuildGroupedData(Page<Object[]> groupingListData,
			List<Group<FlatnessToleranceDto>> list) {
		for (Object[] row : groupingListData) {
			if (row == null || row.length < 2) {
				continue;
			}

			String groupKey;
			if (row[0] instanceof BigDecimal bigDecimal) {
				groupKey = bigDecimal.toPlainString();
			} else {
				groupKey = String.valueOf(row[0]);
			}

			Long count;
			if (row[1] instanceof BigDecimal bigDecimalCount) {
				count = bigDecimalCount.longValue();
			} else {
				count = (Long) row[1];
			}

			list.add(new Group<>(groupKey, null, count));
		}
	}

	private <T> T handleGroupWithFilterOrSortFlatnessTolerance(FlatnessToleranceRequestDto request, List<String> groupList,
			List<String> filterList, Integer page, Integer size, Integer skip, boolean requireTotalCount,
			Integer pageStore, Integer latestGroupCounts) {
		if (requireTotalCount && size == null) {
			size = pageStore;
		} else {
			size = page + size;
			page = 0;
		}

		String queryForGrouping = getDetailsQueryForGroupingAndFilteringFlatnessTolerance(groupList, filterList);
		String queryForGroupingAndFilteringCount = getDetailsQueryForGroupingAndFilteringCountFlatnessTolerance(groupList, filterList);
		String mainCountQuery = getMaindetailsQueryCountFlatnessTolerance();
		Long mainQueryCount = custRepository.getMaindetailsQueryCountFlatnessTolerance(request, mainCountQuery);
		Page<Object[]> groupingListData = custRepository.getGroupingListDataFlatnessTolerance(queryForGrouping,
				queryForGroupingAndFilteringCount, page, size, skip, request);
		Long totalDistCount = custRepository.groupCountQueryFlatnessTolerance(queryForGroupingAndFilteringCount, request);
		return buildGroupedDataResponseFlatnessTolerance(groupingListData, mainQueryCount,
				(totalDistCount != null && totalDistCount != 0) ? (long) totalDistCount : latestGroupCounts);
	}

