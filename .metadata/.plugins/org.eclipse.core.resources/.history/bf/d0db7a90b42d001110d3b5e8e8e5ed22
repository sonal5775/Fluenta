	@Override
	public <T> T fetchFlatnessToleranceData(FlatnessToleranceRequestDto request, String status, int pageNumber, int pageSize,
			String filter, String sort, String group, int skip, boolean requireTotalCount, boolean requireGroupCount,
			String searchValue, Integer pageStore, Integer latestGroupCount) {
		
		List<String> filterList = DevExtGridFilterUtils.extractElements(filter);
		int[] pageSizeArr = processPageAndSize(pageNumber, pageSize, pageStore);
		pageNumber = pageSizeArr[0];
		pageSize = pageSizeArr[1];

		List<String> groupList = DevExtGridFilterUtils.getSortListFromString(group);

		List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);
		if (DevExtGridFilterUtils.isGroupWithoutFilterOrSort(group, filter, sort)) {
			return handleGroupOnlyFlatnessTolerance(request, groupList, pageNumber, pageSize, skip);

		}

		if (DevExtGridFilterUtils.isGroupWithFilterOrSort(group, filter, sort)) {
			return handleGroupWithFilterOrSortFlatnessTolerance(request, groupList, filterList, pageNumber, pageSize, skip,
					requireTotalCount, pageStore, latestGroupCount);
		}

		if (DevExtGridFilterUtils.isFilterOrSortOnly(group, filter, sort)) {
			return handleFilterOrSortFlatnessTolerance(request, filterList, sortList, pageNumber, pageSize, skip, requireTotalCount);
		}

		return null;
	}

	@SuppressWarnings("unchecked")
	private <T> T handleFilterOrSortFlatnessTolerance(FlatnessToleranceRequestDto request, List<String> filterList,
			List<String> sortList, Integer page, Integer size, Integer skip, boolean requireTotalCount) {

		if (!requireTotalCount) {
			size = page + size;
			page = 0;
		}
	
		String query = getMainDetailsQueryFlatnessTolerance();
		String countQuery = getMaindetailsQueryCountFlatnessTolerance();
		if (!filterList.isEmpty()) {
			query = filterQueryUsingFilterListFlatnessTolerance(filterList, query);
			countQuery = filterQueryUsingFilterListFlatnessTolerance(filterList, countQuery);
		}

		query = applySortingFlatnessTolerance(sortList, query);
		Page<FlatnessToleranceDto> paginatedResult = custRepository.getDetailsFlatnessTolerance(request, page, size, query,
				countQuery, skip);
		return (T) new FluentaPaginatedResponse<>(paginatedResult.getContent(), paginatedResult.getTotalElements());
	}

	private String applySortingFlatnessTolerance(List<String> sortList, String query) {
		StringBuilder queryBuilder = new StringBuilder(query);

		if (!sortList.isEmpty()) {
			Map<String, String> columnAlias = checkClassAleasWithNoStopFlatnessTolerance();
			String sortColumn = columnAlias.get(sortList.get(1));

			queryBuilder.append(OfsConstants.ORDER_BY).append(sortColumn);

			if ("true".equals(sortList.get(3))) {
				queryBuilder.append(" ").append(OfsConstants.DESC).append(" ");
			}
		} else {
			queryBuilder.append(" ORDER BY ca.id.rangeCode ASC, ca.id.version desc ");
		}

		return queryBuilder.toString();
	}

