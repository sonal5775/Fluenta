	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<FlatnessToleranceDimensionDto> addOrUpdate(List<FlatnessToleranceDimensionDto> dtoList) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		List<FlatnessToleranceDimensionDto> savedDtos = new ArrayList<>();
		for (FlatnessToleranceDimensionDto dto : dtoList) {
			Long maxVersion = caRngRepository.findMaxVersionByRangeCode(dto.getRangeCode());
			if (maxVersion == null) {
				maxVersion = 0L;
			}
			long newVersion = maxVersion + 1;
			Optional<FlattolrngCm> existingCmOpt = cmRngRepository.findById(dto.getRangeCode());
			if (existingCmOpt.isPresent()) {
				FlattolrngCm cmEntity = existingCmOpt.get();
				cmEntity.setModifiedBy(ClientIpUtils.getClient());
				cmEntity.setModifiedDate(new Date());
				cmEntity.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());
				cmEntity.setCurrentVersion(newVersion);
				cmEntity.setValidPgCode(dto.getValidPgCode());
				cmRngRepository.save(cmEntity);
			}

			FlattolRngCaPK caEntityPK = new FlattolRngCaPK();
			caEntityPK.setRangeCode(dto.getRangeCode());
			caEntityPK.setVersion(dto.getVersion());

			// 1️⃣ Update existing row if found
			Optional<FlattolRngCa> existingOpt = caRngRepository.findById(caEntityPK);

			if (existingOpt.isPresent()) {
				FlattolRngCa existingEntity = existingOpt.get();
				existingEntity.setModifiedBy(ClientIpUtils.getClient());
				existingEntity.setModifiedDate(new Date());
				existingEntity.setIsActive(BigDecimal.ZERO);
				existingEntity.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());

				caRngRepository.save(existingEntity);
			}

			// 2️⃣ Insert new row with new version
			FlattolRngCa newEntity = new FlattolRngCa();
			FlattolRngCaPK newEntityPK = new FlattolRngCaPK();
			newEntityPK.setRangeCode(dto.getRangeCode());
			newEntityPK.setVersion(newVersion);

			newEntity.setId(newEntityPK);
			newEntity.setModItemStamp(dto.getModItemStamp());
			newEntity.setThicknessMin(dto.getThicknessMin());
			newEntity.setThicknessMinOperator(dto.getThicknessMinOperator());
			newEntity.setThicknessMaxOperator(dto.getThicknessMaxOperator());
			newEntity.setThicknessMax(dto.getThicknessMax());
			newEntity.setWidthMin(dto.getWidthMin());
			newEntity.setWidthMinOperator(dto.getWidthMinOperator());
			newEntity.setWidthMaxOperator(dto.getWidthMaxOperator());
			newEntity.setWidthMax(dto.getWidthMax());
			newEntity.setValidPgCode(dto.getValidPgCode());
			newEntity.setIsActive(BigDecimal.ONE);

			// Audit fields for NEW record
			newEntity.setCreatedBy(ClientIpUtils.getClient());
			newEntity.setCreatedDate(new Date());
			newEntity.setCreatedMacAddress(ClientIpUtils.getClientIpAddress());

			caRngRepository.save(newEntity);

			savedDtos.add(dto);
		}
		return savedDtos;

	}
	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<FlatnessToleranceDto> saveFlatnessTolerance(List<FlatnessToleranceDto> dtoList) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		List<FlatnessToleranceDto> savedDtos = new ArrayList<>();
		 logger.info("Received dtoList size={} data={}", dtoList.size(), dtoList);
		for (FlatnessToleranceDto dto : dtoList) {
			  logger.info("Processing DTO: {}", dto);
			Long maxVersion = caValRepository.findMaxVersionByRangeCode(dto.getRangeCode(), dto.getProductGaranteeCode());
			if (maxVersion == null) {
				maxVersion = 0L;
			}
			long newVersion = maxVersion + 1;
			logger.info("Calculated new version={} for rangeCode={}, pgCode={}", 
                    newVersion, dto.getRangeCode(), dto.getProductGaranteeCode());

			Optional<FlattolvalCm> existingCmOpt = cmValRepository.findById(new FlattolvalCmPK(dto.getRangeCode(), dto.getProductGaranteeCode()) 	); 
			if (existingCmOpt.isPresent()) {
				FlattolvalCm cmEntity = existingCmOpt.get();
				cmEntity.setModifiedBy(ClientIpUtils.getClient());
				cmEntity.setModifiedDate(new Date());
				cmEntity.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());
				cmEntity.setInputUnitPositive(dto.getInputUnitPositive());
				cmEntity.setInputUnitNegative(dto.getInputUnitNegative());
				cmEntity.setCurrentVersion(newVersion);
				cmValRepository.save(cmEntity);
			} 
			logger.info("Calculated old version={} for rangeCode={}, pgCode={}", 
                    dto.getVersion(), dto.getRangeCode(), dto.getProductGaranteeCode());
			FlattolvalCaPK caEntityPK = new FlattolvalCaPK(dto.getRangeCode(), dto.getProductGaranteeCode(), dto.getVersion());
			Optional<FlattolvalCa> existingCaOpt = caValRepository.findById(caEntityPK);

			if (existingCaOpt.isPresent()) {
				FlattolvalCa existingEntity = existingCaOpt.get();
				existingEntity.setModifiedBy(ClientIpUtils.getClient());
				existingEntity.setModifiedDate(new Date());
				existingEntity.setIsActive(BigDecimal.ZERO);
				existingEntity.setModifiedMacAddress(ClientIpUtils.getClientIpAddress());

				caValRepository.save(existingEntity);
			}

			FlattolvalCa newEntity = new FlattolvalCa();
			FlattolvalCaPK newEntityPK = new FlattolvalCaPK(dto.getRangeCode(), dto.getProductGaranteeCode(), newVersion);
			newEntity.setId(newEntityPK);
			newEntity.setInputUnitPositive(dto.getInputUnitPositive());
			newEntity.setInputUnitNegative(dto.getInputUnitNegative());
			newEntity.setIsActive(BigDecimal.ONE);
			newEntity.setCreatedBy(ClientIpUtils.getClient());
			newEntity.setCreatedDate(new Date());
			newEntity.setCreatedMacAddress(ClientIpUtils.getClientIpAddress());

			caValRepository.save(newEntity);
		    logger.info("Completed saving FlatnessTolerance. Total saved={}", savedDtos.size());
			savedDtos.add(dto);
		}
		return savedDtos;
	}

