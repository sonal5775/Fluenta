	private <T> T handleGroupOnly(FlatnessToleranceRequestDto request, List<String> groupList, int pageNumber,
			int pageSize, int skip) {
		pageSize = pageNumber + pageSize;
		pageNumber = 0;
		String groupQuery = getQueryForGrouping(groupList);
		String groupCountQuery = getQueryForGroupingCount(groupList);
		String mainCountQuery = getMaindetailsQueryCount();
		Long mainQueryCount = custRepository.getMaindetailsQueryCount(request, mainCountQuery);

		Page<Object[]> groupingListData = custRepository.getGroupingListData(groupQuery, groupCountQuery, pageNumber,
				pageSize, skip, request);
		Long totalDistCount = custRepository.groupCountQuery(groupCountQuery, request);

		return buildGroupedDataResponse(groupingListData, mainQueryCount, totalDistCount);
	}

	private String getQueryForGrouping(List<String> groupList) {
		if (groupList == null || groupList.isEmpty()) {
			throw new IllegalArgumentException("groupList cannot be null or empty");
		}

		String descFlag = groupList.get(3);
		String groupColumn = groupList.get(1);

		StringBuilder query = new StringBuilder().append(OfsConstants.SELECT).append(" ")
				.append(checkClassAleas().get(groupColumn)).append(", COUNT(*) ")
				.append(FlatnessToleranceCustRepository.DIM_QUERY_CONDITION)
				.append(FlatnessToleranceCustRepository.DIM_QUERY_WHERE_CONDITION).append(" ")
				.append(OfsConstants.GROUP_BY).append(" ").append(checkClassAleas().get(groupColumn)).append(" ")
				.append(OfsConstants.ORDER_BY).append(" ").append(checkClassAleas().get(groupColumn));

		if ("true".equalsIgnoreCase(descFlag)) {
			query.append(" ").append(OfsConstants.DESC);
		}

		return query.toString();
	}

	private String getQueryForGroupingCount(List<String> groupList) {
		String groupColumn = groupList.get(1); // Assuming the second element is the group column

		StringBuilder query = new StringBuilder().append(OfsConstants.SELECT).append(" ")
				.append(OfsConstants.COUNT_DISTINCT).append(checkClassAleas().get(groupColumn)).append(")")
				.append(FlatnessToleranceCustRepository.DIM_QUERY_CONDITION)
				.append(FlatnessToleranceCustRepository.DIM_QUERY_WHERE_CONDITION);

		return query.toString();
	}

	@SuppressWarnings("unchecked")
	private <T> T buildGroupedDataResponse(Page<Object[]> groupingListData, Long mainQueryCount, Long totalDistCount) {
		GroupedDataResponse<FlatnessToleranceDimensionDto> result = new GroupedDataResponse<>(null, 0L, 0L);
		List<Group<FlatnessToleranceDimensionDto>> list = new ArrayList<>();

		if (groupingListData != null && !groupingListData.isEmpty()) {
			for (Object[] row : groupingListData) {
				if (row == null || row.length < 2) {
					continue;
				}

				String groupKey;
				if (row[0] instanceof BigDecimal bigDecimal) {
					groupKey = bigDecimal.toPlainString();
				} else {
					groupKey = String.valueOf(row[0]);
				}

				Long count;
				if (row[1] instanceof BigDecimal bigDecimalCount) {
					count = bigDecimalCount.longValue();
				} else {
					count = (Long) row[1];
				}

				list.add(new Group<>(groupKey, null, count));
			}
		}

		result.setData(list);
		result.setTotalCount(mainQueryCount);
		result.setGroupCount(totalDistCount);
		return (T) result;
	}

	private <T> T handleGroupWithFilterOrSort(FlatnessToleranceRequestDto request, List<String> groupList,
			List<String> filterList, Integer page, Integer size, Integer skip, boolean requireTotalCount,
			Integer pageStore, Integer latestGroupCounts) {
		if (requireTotalCount && size == null) {
			size = pageStore;
		} else {
			size = page + size;
			page = 0;
		}

		String queryForGrouping = getDetailsQueryForGroupingAndFiltering(groupList, filterList);
		String queryForGroupingAndFilteringCount = getDetailsQueryForGroupingAndFilteringCount(groupList, filterList);
		String mainCountQuery = getMaindetailsQueryCount();
		Long mainQueryCount = custRepository.getMaindetailsQueryCount(request, mainCountQuery);
		Page<Object[]> groupingListData = custRepository.getGroupingListData(queryForGrouping,
				queryForGroupingAndFilteringCount, page, size, skip, request);
		Long totalDistCount = custRepository.groupCountQuery(queryForGroupingAndFilteringCount, request);
		return buildGroupedDataResponse(groupingListData, mainQueryCount,
				(totalDistCount != null && totalDistCount != 0) ? (long) totalDistCount : latestGroupCounts);
	}

	public String getDetailsQueryForGroupingAndFiltering(List<String> groupList, List<String> filterList) {
		String groupColumn = groupList.get(1);
		String desc = groupList.get(3);
		
		StringBuilder query = new StringBuilder();
		query.append(OfsConstants.SELECT).append(" ").append(checkClassAleas().get(groupColumn)).append(" ,COUNT(*)")
				.append(FlatnessToleranceCustRepository.DIM_QUERY_CONDITION)
				.append(FlatnessToleranceCustRepository.DIM_QUERY_WHERE_CONDITION);

		String filterQueryUsingFilterList = query.toString();

		if (!filterList.isEmpty()) {
			filterQueryUsingFilterList = filterQueryUsingFilterList(filterList, query.toString());
		}
		filterQueryUsingFilterList = new StringBuilder(filterQueryUsingFilterList).append(" ")
				.append(OfsConstants.GROUP_BY).append(" ").append(checkClassAleas().get(groupColumn)).append(" ")
