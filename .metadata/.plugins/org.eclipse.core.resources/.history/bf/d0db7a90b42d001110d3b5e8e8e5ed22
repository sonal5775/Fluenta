	public String filterQueryUsingFilterList(List<String> filterList, String query) {
		StringBuilder queryBuilder = new StringBuilder(query);
		queryBuilder.append(" AND ( ");

		List<String> columnNames = DevExtGridFilterUtils.getAllFields(FlatnessToleranceDimensionDto.class);

		Map<String, String> columnDataTypesKeyValuePair = DevExtGridFilterUtils
				.getAllFieldsWithTypes(FlatnessToleranceDimensionDto.class);
		Map<String, String> columnAlise = checkClassAleas();

		boolean isClobObject = false;
		boolean isStringObject = false;
		boolean isDateObject = false;
		boolean isContains = false;
		boolean isNotContains = false;
		boolean isStartWith = false;
		boolean isEndWith = false;

		extractedFilterQueryUsingFilterList(filterList, queryBuilder, columnNames, columnDataTypesKeyValuePair,
				columnAlise, isClobObject, isStringObject, isDateObject, isContains, isNotContains, isStartWith,
				isEndWith);
		queryBuilder.append(" ) ");
		return queryBuilder.toString();
	}



	@Override
	public <T> T fetchDimensionData(FlatnessToleranceRequestDto request, String status, int pageNumber, int pageSize,
			String filter, String sort, String group, int skip, boolean requireTotalCount, boolean requireGroupCount,
			String searchValue, Integer pageStore, Integer latestGroupCount) {

		List<String> filterList = DevExtGridFilterUtils.extractElements(filter);
		int[] pageSizeArr = processPageAndSize(pageNumber, pageSize, pageStore);
		pageNumber = pageSizeArr[0];
		pageSize = pageSizeArr[1];

		List<String> groupList = DevExtGridFilterUtils.getSortListFromString(group);

		List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);
		if (DevExtGridFilterUtils.isGroupWithoutFilterOrSort(group, filter, sort)) {
			return handleGroupOnly(request, groupList, pageNumber, pageSize, skip);

		}

		if (DevExtGridFilterUtils.isGroupWithFilterOrSort(group, filter, sort)) {
			return handleGroupWithFilterOrSort(request, groupList, filterList, pageNumber, pageSize, skip,
					requireTotalCount, pageStore, latestGroupCount);
		}

		if (DevExtGridFilterUtils.isFilterOrSortOnly(group, filter, sort)) {
			return handleFilterOrSort(request, filterList, sortList, pageNumber, pageSize, skip, requireTotalCount);
		}

		return null;
	}

	private int[] processPageAndSize(Integer pageNumber, Integer pageSize, Integer pageStore) {
		if (pageNumber == null) {
			pageNumber = 0;
		}
		if (pageSize == null) {
			pageSize = pageStore;
		}
		return new int[] { pageNumber, pageSize };
	}

	@SuppressWarnings("unchecked")
	private <T> T handleFilterOrSort(FlatnessToleranceRequestDto request, List<String> filterList,
			List<String> sortList, Integer page, Integer size, Integer skip, boolean requireTotalCount) {

		if (!requireTotalCount) {
			size = page + size;
			page = 0;
		}
	
		String query = getMainDetailsQuery();
		String countQuery = getMaindetailsQueryCount();
		if (!filterList.isEmpty()) {
			query = filterQueryUsingFilterList(filterList, query);
			countQuery = filterQueryUsingFilterList(filterList, countQuery);
		}

		query = applySorting(sortList, query);
		Page<FlatnessToleranceDimensionDto> paginatedResult = custRepository.getDetails(request, page, size, query,
				countQuery, skip);
		return (T) new FluentaPaginatedResponse<>(paginatedResult.getContent(), paginatedResult.getTotalElements());
	}

	private String applySorting(List<String> sortList, String query) {
		StringBuilder queryBuilder = new StringBuilder(query);

		if (!sortList.isEmpty()) {
			Map<String, String> columnAlias = checkClassAleasWithNoStop();
			String sortColumn = columnAlias.get(sortList.get(1));

			queryBuilder.append(OfsConstants.ORDER_BY).append(sortColumn);

			if ("true".equals(sortList.get(3))) {
				queryBuilder.append(" ").append(OfsConstants.DESC).append(" ");
			}
		} else {
			queryBuilder.append(" ORDER BY fr.id.rangeCode ASC ");
		}

		return queryBuilder.toString();
	}

	public String getMainDetailsQuery() {
		StringBuilder queryBuilder = new StringBuilder();
		queryBuilder.append(FlatnessToleranceCustRepository.DIM_QUERY)
