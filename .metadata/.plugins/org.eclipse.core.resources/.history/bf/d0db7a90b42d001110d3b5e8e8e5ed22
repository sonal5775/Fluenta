	private <T> T handleGroupOnlyFlatnessTolerance(FlatnessToleranceRequestDto request, List<String> groupList, int pageNumber,
			int pageSize, int skip) {
		pageSize = pageNumber + pageSize;
		pageNumber = 0;
		String groupQuery = getQueryForGroupingFlatnessTolerance(groupList);
		String groupCountQuery = getQueryForGroupingCountFlatnessTolerance(groupList);
		String mainCountQuery = getMaindetailsQueryCountFlatnessTolerance();
		Long mainQueryCount = custRepository.getMaindetailsQueryCountFlatnessTolerance(request, mainCountQuery);

		Page<Object[]> groupingListData = custRepository.getGroupingListDataFlatnessTolerance(groupQuery, groupCountQuery, pageNumber,
				pageSize, skip, request);
		Long totalDistCount = custRepository.groupCountQueryFlatnessTolerance(groupCountQuery, request);

		return buildGroupedDataResponseFlatnessTolerance(groupingListData, mainQueryCount, totalDistCount);
	}

	private String getQueryForGroupingFlatnessTolerance(List<String> groupList) {
		if (groupList == null || groupList.isEmpty()) {
			throw new IllegalArgumentException("groupList cannot be null or empty");
		}

		String descFlag = groupList.get(3);
		String groupColumn = groupList.get(1);

		StringBuilder query = new StringBuilder().append(OfsConstants.SELECT).append(" ")
				.append(checkClassAleasFlatnessTolerance().get(groupColumn)).append(", COUNT(*) ")
				.append(FlatnessToleranceCustRepository.FLATNESS_TOL_QUERY_CONDITION)
				.append(FlatnessToleranceCustRepository.FLATNESS_TOL_QUERY_WHERE_CONDITION).append(" ")
				.append(OfsConstants.GROUP_BY).append(" ").append(checkClassAleasFlatnessTolerance().get(groupColumn)).append(" ")
				.append(OfsConstants.ORDER_BY).append(" ").append(checkClassAleasFlatnessTolerance().get(groupColumn));

		if ("true".equalsIgnoreCase(descFlag)) {
			query.append(" ").append(OfsConstants.DESC);
		}

		return query.toString();
	}

