	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public ResponseEntity<FluentaApiResponse<ProcessDefectPostDto>> saveInspectionDefects(
			ProcessDefectPostDto request) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		ResponseEntity<FluentaApiResponse<ProcessDefectPostDto>> response = null;
		PhysicalInspectionCoilDto coilDto = request.getCoilDto();
		List<ProcessInspDefectDto> defectList = request.getDefectList();
		PostProdTaskMtEntity task = null;
		Optional<PostProdTaskMtEntity> taskOptional = postProdTaskMtRepository.getTasksByPpidAndPrid(
				coilDto.getPpId().trim(), QualityConstants.PROCESS_INSP, QualityConstants.INSP_FLAG_YES);
		if (taskOptional.isPresent()) {
			task = taskOptional.get();
			for (ProcessInspDefectDto dto : defectList) {
				DefectHeaderEntity headerEntity = new DefectHeaderEntity();
				DefectHeaderEntityPK headerPk = new DefectHeaderEntityPK();
				headerPk.setPrid(QualityConstants.PROCESS_INSP);
				headerPk.setDefectid(dto.getDefectid());

				Optional<DefectHeaderEntity> headerOptional = defectHeaderRepository.findById(headerPk);
				if (headerOptional.isPresent()) {
					headerEntity = headerOptional.get();
					headerEntity.setMoBy(ClientIpUtils.getClient());
					headerEntity.setMoDt(new Date());
					headerEntity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
					headerEntity.setDefectdesc(dto.getDefectdesc());
				} else {
					headerEntity.setId(headerPk);
					headerEntity.setDefectdesc(dto.getDefectdesc());
					headerEntity.setCrBy(ClientIpUtils.getClient());
					headerEntity.setCrDt(new Date());
					headerEntity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
				}
				LOGGER.info("{}", "saving header");
				defectHeaderRepository.save(headerEntity);
				LOGGER.info("{}", "saved header");

				PpInspDefectEntity inspDefectEntity = new PpInspDefectEntity();
				PpInspDefectEntityPK inspDefectEntityPK = new PpInspDefectEntityPK();
				inspDefectEntityPK.setPpid(coilDto.getPpId());
				inspDefectEntityPK.setPpctr(0);
				inspDefectEntityPK.setTaskstepid(task.getId().getTaskstepId());
				inspDefectEntityPK.setDefectctr(dto.getDefectctr());
				Optional<PpInspDefectEntity> optional = ppInspDefectRepository.findById(inspDefectEntityPK);
				if (optional.isPresent()) {
					inspDefectEntity = optional.get();
					inspDefectEntity.setMoBy(ClientIpUtils.getClient());
					inspDefectEntity.setMoDt(new Date());
					inspDefectEntity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				} else {
					long maxDefectCtr = ppInspDefectRepository.getMaxDefectCtr(coilDto.getPpId());
					inspDefectEntityPK.setDefectctr(maxDefectCtr + 1);
					inspDefectEntity.setId(inspDefectEntityPK);
					inspDefectEntity.setCrBy(ClientIpUtils.getClient());
					inspDefectEntity.setCrDt(new Date());
					inspDefectEntity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
					inspDefectEntity.setPrid(QualityConstants.PROCESS_INSP);
					inspDefectEntity.setDefectid(dto.getDefectid());

				}
				inspDefectEntity.setDefectside(dto.getDefectside());
				inspDefectEntity.setDefectpos(dto.getDefectpos());
				inspDefectEntity.setStartlen(dto.getStartlen());
				inspDefectEntity.setEndlen(dto.getEndlen());
				LOGGER.info("{}", "saving insp");
				ppInspDefectRepository.save(inspDefectEntity);
				LOGGER.info("{}", "saved insp");
				response = ResponseUtil.createResponse(request, "Save/Update Successful ", false);
			}
		} else {
			response = ResponseUtil.createResponse(request, "Save/Update UnSuccessful Due To Task Unavailability ",
					false);
		}

		return response;
	}

	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public ResponseEntity<FluentaApiResponse<PdoAttributesPostDto>> savePdoAttributes(PdoAttributesPostDto request) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		ResponseEntity<FluentaApiResponse<PdoAttributesPostDto>> response = null;
		PhysicalInspectionCoilDto coilDto = request.getCoilDto();
		List<PhysicalInspPdoAttributesDto> checkListDto = request.getPdoAttributeList();
		PostProdTaskMtEntity task = null;
		Optional<PostProdTaskMtEntity> taskOptional = postProdTaskMtRepository.getTasksByPpidAndPrid(
				coilDto.getPpId().trim(), QualityConstants.PROCESS_INSP, QualityConstants.INSP_FLAG_YES);
		if (taskOptional.isPresent()) {
			task = taskOptional.get();
			for (PhysicalInspPdoAttributesDto dto : checkListDto) {
				PpInspCharEntityPK pk = new PpInspCharEntityPK();
				PpInspCharEntity entity = new PpInspCharEntity();
				pk.setPpid(coilDto.getPpId());
				pk.setPpctr(0);
				pk.setTaskstepid(task.getId().getTaskstepId());
				pk.setAtrid(dto.getAttribute());
				Optional<PpInspCharEntity> optional = ppInspCharRepository.findById(pk);
				if (optional.isPresent()) {
					entity = optional.get();
					entity.setMoBy(ClientIpUtils.getClient());
					entity.setMoDt(new Date());
					entity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
				} else {
					entity.setId(pk);
					entity.setCrBy(ClientIpUtils.getClient());
					entity.setCrDt(new Date());
					entity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
					entity.setIsactv(BigDecimal.ONE);
				}
				if (request.isBulkUpdate() ? optional.isEmpty() : (optional.isEmpty() || optional.isPresent())) {
					entity.setInsprslt(dto.getFinalResult());
					entity.setNumval(dto.getActualValue());
					entity.setStrval(dto.getStrval());
					ppInspCharRepository.save(entity);
				}
				response = ResponseUtil.createResponse(request, "Save/Update Successful", false);
			}
		} else {
			response = ResponseUtil.createResponse(request, "Save/Update UnSuccessful Due To Task Unavailability",
					false);
		}

		boolean isValid = this.validate(coilDto, taskOptional.get().getId().getTaskstepId());
		LOGGER.info("{}", isValid);
		if (!request.isBulkUpdate()) {
			processInspCustRepository.updateFinalResult(isValid, coilDto, taskOptional);
		}
		return response;
	}

	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public ResponseEntity<FluentaApiResponse<List<PhysicalInspectionCoilDto>>> saveManualDecision(
			List<PhysicalInspectionCoilDto> dto) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		ResponseEntity<FluentaApiResponse<List<PhysicalInspectionCoilDto>>> response = null;
		for (PhysicalInspectionCoilDto request : dto) {
			PostProdTaskMtEntity task = null;
			Optional<PostProdTaskMtEntity> taskOptional = postProdTaskMtRepository.getTasksByPpidAndPrid(
					request.getPpId().trim(), QualityConstants.PROCESS_INSP, QualityConstants.INSP_FLAG_YES);
			if (taskOptional.isPresent()) {
				task = taskOptional.get();
				task.setFinalResult(request.getFinalResult());
				task.setReleaseRemark(request.getProcessRemarks());
				task.setQaRemark(request.getProcessRemarks());
				postProdTaskMtRepository.save(task);
				if (request.isAllFlag()) {
					updateActualValueWithPdoValue(request);
				}
				response = ResponseUtil.createResponse(dto, "Update Successful", false);
			} else {
				response = ResponseUtil.createResponse(dto, "Update Failed Due to Task Unavailability", false);
				break;
			}

		}

		return response;
	}

	private void updateActualValueWithPdoValue(PhysicalInspectionCoilDto request) {
		List<PhysicalInspPdoAttributesDto> pdoAttributes = processInspCustRepository.getpdoAttributes(request);
		PdoAttributesPostDto pdoAttributesPostDto = new PdoAttributesPostDto();
		pdoAttributesPostDto.setCoilDto(request);
		for (PhysicalInspPdoAttributesDto pdo : pdoAttributes) {
			pdo.setActualValue(pdo.getPdoValue());
			if (pdo.getActualValue() != null && pdo.getMin() != null && pdo.getMax() != null
					&& pdo.getActualValue().compareTo(pdo.getMin()) >= 0
					&& pdo.getActualValue().compareTo(pdo.getMax()) <= 0) {
				pdo.setFinalResult("PASS");
			} else {
				pdo.setFinalResult("FAIL");
			}
		}
		pdoAttributesPostDto.setPdoAttributeList(pdoAttributes);
		pdoAttributesPostDto.setBulkUpdate(true);
		savePdoAttributes(pdoAttributesPostDto);
	}

