	public String filterQueryUsingFilterList(List<String> filterList, String query) {
	    StringBuilder queryBuilder = new StringBuilder(query);
	    queryBuilder.append(" AND ( ");

	    List<String> columnNames = DevExtGridFilterUtils.getAllFields(PhysicalInspectionCoilDto.class);
	    Map<String, String> columnDataTypesKeyValuePair = DevExtGridFilterUtils.getAllFieldsWithTypes(PhysicalInspectionCoilDto.class);
	    Map<String, String> columnAlise = checkClassAleas();

	    boolean isClobObject = false;
	    boolean isStringObject = false;
	    boolean isDateObject = false;
	    boolean isContains = false;
	    boolean isNotContains = false;
	    boolean isStartWith = false;
	    boolean isEndWith = false;

	    boolean negateNextGroup = false;
	    boolean hasOrCondition = false;
	    StringBuilder conditionBuffer = new StringBuilder();

	    for (int i = 0; i < filterList.size(); i++) {
	        String item = filterList.get(i);

	        // Handle "!" as NOT
	        if ("!".equals(item)) {
	            negateNextGroup = true;
	            continue;
	        }

	        // Handle logical operators
	        if ("or".equalsIgnoreCase(item)) {
	            conditionBuffer.append(" OR ");
	            hasOrCondition = true;
	            continue;
	        } else if ("and".equalsIgnoreCase(item)) {
	            if (conditionBuffer.length() > 0) {
	                if (negateNextGroup) {
	                    queryBuilder.append("NOT (").append(conditionBuffer.toString().trim()).append(") AND ");
	                    negateNextGroup = false;
	                } else {
	                    queryBuilder.append("(").append(conditionBuffer.toString().trim()).append(") AND ");
	                }
	                conditionBuffer.setLength(0);
	                hasOrCondition = false;
	            }
	            continue;
	        }

	        // Column handling
	        if (columnNames.contains(item)) {
	            if ("CLOB".equals(columnDataTypesKeyValuePair.get(item))) {
	                conditionBuffer.append("DBMS_LOB.INSTR(").append(columnAlise.get(item)).append(",");
	                isClobObject = true;
	            } else if ("DATE".equals(columnDataTypesKeyValuePair.get(item))) {
	                conditionBuffer.append(" TO_CHAR(").append(columnAlise.get(item)).append(", 'YYYY-MM-DD')");
	                isDateObject = true;
	            } else if ("VARCHAR2".equals(columnDataTypesKeyValuePair.get(item))) {
	                conditionBuffer.append("UPPER(TRIM(").append(columnAlise.get(item)).append("))");
	                isStringObject = true;
	            } else if ("unitWt".equals(item)) {
	                conditionBuffer.append(" ROUND(( (s.S_THICK_MM * s.S_WIDTH_MM * s.S_LENGTH_MM * 7.85) / 1e9 ), 3) ");
	            } else if ("noOfPcs".equals(item)) {
	                conditionBuffer.append(" (CASE WHEN s.S_THICK_MM > 0 AND s.S_WIDTH_MM > 0 AND s.S_LENGTH_MM > 0 AND s.QUANTITY IS NOT NULL ")
	                        .append(" THEN FLOOR(s.QUANTITY / ((s.S_THICK_MM * s.S_WIDTH_MM * s.S_LENGTH_MM * 7.85) / 1e9)) ELSE 0 END) ");
	            } else {
	                conditionBuffer.append(columnAlise.get(item));
	            }
	            continue;
	        }

	        // Operator handling
	        if (item.equals("=") || item.equals("<>") || item.equals("!=")
	                || item.equals(">=") || item.equals("<") || item.equals(">")) {
	            if ("!=".equals(item)) {
	                conditionBuffer.append(" <> ");
	            } else {
	                conditionBuffer.append(" ").append(item).append(" ");
	            }
	            continue;
	        } else if ("contains".equalsIgnoreCase(item)) {
	            isContains = true;
	            conditionBuffer.append(" LIKE ");
	            continue;
	        } else if ("notcontains".equalsIgnoreCase(item)) {
	            isNotContains = true;
	            conditionBuffer.append(" NOT LIKE ");
	            continue;
	        } else if ("startswith".equalsIgnoreCase(item)) {
	            isStartWith = true;
	            conditionBuffer.append(" LIKE ");
	            continue;
	        } else if ("endswith".equalsIgnoreCase(item)) {
	            isEndWith = true;
	            conditionBuffer.append(" LIKE ");
	            continue;
	        }

	        // Value handling
	        if (isClobObject) {
	            conditionBuffer.append("'").append(item).append("') > 0");
	            isClobObject = false;
	        } else if (isStringObject) {
	            if (isContains) {
	                conditionBuffer.append("'%").append(item.toUpperCase()).append("%'");
	                isContains = false;
	            } else if (isNotContains) {
	                conditionBuffer.append("'%").append(item.toUpperCase()).append("%'");
	                isNotContains = false;
	            } else if (isStartWith) {
	                conditionBuffer.append("'").append(item.toUpperCase()).append("%'");
	                isStartWith = false;
	            } else if (isEndWith) {
	                conditionBuffer.append("'%").append(item.toUpperCase()).append("'");
	                isEndWith = false;
	            } else {
	                conditionBuffer.append("'").append(item.toUpperCase()).append("'");
	            }
	            isStringObject = false;
	        } else if (isDateObject) {
	            try {
	                // Case 1: ISO or custom datetime (yyyy-MM-dd...)
	                if (item.matches("\\d{4}-\\d{2}-\\d{2}.*")) {
	                    DateTimeFormatter isoFormatter = DateTimeFormatter.ISO_DATE_TIME;
	                    DateTimeFormatter customFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss.S");
	                    LocalDateTime dateTime;
	                    try {
	                        dateTime = LocalDateTime.parse(item, isoFormatter);
	                    } catch (Exception e) {
	                        dateTime = LocalDateTime.parse(item, customFormatter);
	                    }
	                    String dateOnly = dateTime.toLocalDate().toString(); // yyyy-MM-dd
	                    conditionBuffer.append(" '").append(dateOnly).append("' ");
	                } 
	                // Case 2: dd-MM-yyyy with time (like 30-05-2025 02:22:00 pm)
	                else if (item.matches("\\d{2}-\\d{2}-\\d{4}.*")) {
	                    String[] parts = item.split(" ");
	                    String dayMonthYear = parts[0]; // '30-05-2025'
	                    DateTimeFormatter inputFormatter = DateTimeFormatter.ofPattern("dd-MM-yyyy");
	                    DateTimeFormatter outputFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");
	                    LocalDate date = LocalDate.parse(dayMonthYear, inputFormatter);
	                    String formattedDate = date.format(outputFormatter);
	                    conditionBuffer.append(" '").append(formattedDate).append("' ");
	                } 
	                // Case 3: fallback, keep value as-is
	                else {
	                    conditionBuffer.append(" '").append(item).append("' ");
	                }
	            } catch (Exception e) {
	                conditionBuffer.append(" '").append(item).append("' ");
	            }
	            isDateObject = false;
	        }
	         else {
	            conditionBuffer.append(item).append(" ");
	        }
	    }

	    // Append remaining buffer
	    if (conditionBuffer.length() > 0) {
	        if (negateNextGroup) {
	            queryBuilder.append("NOT (").append(conditionBuffer.toString().trim()).append(")");
	        } else {
	            queryBuilder.append(conditionBuffer.toString().trim());
	        }
	    }

	    queryBuilder.append(" ) ");
	    return queryBuilder.toString();
	}

