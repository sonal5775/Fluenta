	private <T> T buildGroupedDataResponse(Page<Object[]> groupingListData, Long mainQueryCount, Long totalDistCount) {
		GroupedDataResponse<HsmOnlineInspectionRequestDto> result = new GroupedDataResponse<>(null, 0L, 0L);
		List<Group<HsmOnlineInspectionRequestDto>> list = new ArrayList<>();

		for (Object[] row : groupingListData) {
			String groupKey = row[0] instanceof BigDecimal ? ((BigDecimal) row[0]).toPlainString()
					: String.valueOf(row[0]);
//			Long count = row[1] instanceof BigDecimal ? ((BigDecimal) row[1]).longValue() : (Long) row[1];
			Long count = null;
	        if (row[1] == null) {
	            count = 0L;
	        } else if (row[1] instanceof BigDecimal) {
	            count = ((BigDecimal) row[1]).longValue();
	        } else if (row[1] instanceof Number) {
	            count = ((Number) row[1]).longValue();
	        } else {
	            try {
	                count = Long.parseLong(row[1].toString());
	            } catch (NumberFormatException e) {
	                count = 0L; // fallback if string not numeric
	            }
	        }
			list.add(new Group<>(groupKey, null, count));
		}

		result.setData(list);
		result.setTotalCount(mainQueryCount);
		result.setGroupCount(totalDistCount);
		return (T) result;
	}

