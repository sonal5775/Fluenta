	@Override
	@Transactional(rollbackFor = TransactionException.class)
	public ResponseEntity<FluentaApiResponse<String>> releaseCoils(
	        List<PhysicalInspectionCoilDto> dto) {

	    dbSessionService.setSessionInfo(this.getClass().getName());

	    List<String> missingFinalResultCoils = new ArrayList<>();
	    List<String> missingRemarkCoils = new ArrayList<>();

	    for (PhysicalInspectionCoilDto request : dto) {

	        Optional<PostProdTaskMtEntity> taskOptional =
	                postProdTaskMtRepository.getTasksByPpidAndPrid(
	                        request.getPpId().trim(),
	                        QualityConstants.PROCESS_INSP,
	                        QualityConstants.INSP_FLAG_YES
	                );

	        if (taskOptional.isEmpty()) {
	            missingFinalResultCoils.add(request.getPpId());
	            continue;
	        }

	        PostProdTaskMtEntity task = taskOptional.get();

	        String finalResult = task.getFinalResult();
	        String releaseRemark = task.getReleaseRemark();

	        if (finalResult == null || finalResult.trim().isEmpty()) {
	            missingFinalResultCoils.add(request.getPpId());
	            continue;
	        }

	        if ("FAIL".equalsIgnoreCase(request.getFinalResult())
	                && (
	                    (releaseRemark == null || releaseRemark.trim().length() < 5)
	                    || (request.getProcessRemarks() == null || request.getProcessRemarks().trim().length() < 5)
	                )
	        ) {
	            missingRemarkCoils.add(request.getPpId());
	        }
	    }

	    if (!missingFinalResultCoils.isEmpty() || !missingRemarkCoils.isEmpty()) {

	        FluentaApiResponse<String> response = new FluentaApiResponse<>();
	        response.setStatus(FluentaApiResponse.Status.FAILURE);
	        response.setData(null);

	        if (!missingFinalResultCoils.isEmpty()) {
	            response.addMessage(
	                    MessageType.ERROR,
	                    "Submit Final Result for Coil(s): "
	                            + String.join(", ", missingFinalResultCoils)
	            );
	        }

	        if (!missingRemarkCoils.isEmpty()) {
	            response.addMessage(
	                    MessageType.ERROR,
	                    "Process remark is required (minimum 5 characters)"
	            );
	        }

	        return ResponseEntity.ok(response); // ✅ HTTP 200
	    }

	    for (PhysicalInspectionCoilDto request : dto) {
	        processInspCustRepository.savePostProduction(
	                request.getPpId().trim(),
	                QualityConstants.PROCESS_INSP,
	                QualityConstants.RELEASE
	        );
	    }

	    FluentaApiResponse<String> successResponse =
	            new FluentaApiResponse<>("Coil Released");

	    successResponse.addMessage(
	            MessageType.SUCCESS,
	            "Update Successful"
	    );

	    return ResponseEntity.ok(successResponse);
	}

	@Override
	public <T> T getProcessInspDetails(HsmOnlineInspectionRequestDto request, String status, int pageNumber,
			int pageSize, String filter, String sort, String group, int skip, boolean requireTotalCount,
			boolean requireGroupCount, String searchValue, Integer pageStore, Integer latestGroupCount) {

		List<String> filterList = DevExtGridFilterUtils.extractElements(filter);

		// new
		int[] pageSizeArr = processPageAndSize(pageNumber, pageSize, pageStore);
		pageNumber = pageSizeArr[0];
		pageSize = pageSizeArr[1];

		List<String> groupList = DevExtGridFilterUtils.getSortListFromString(group);

		List<String> sortList = DevExtGridFilterUtils.getSortListFromString(sort);

		if (DevExtGridFilterUtils.isGroupWithoutFilterOrSort(group, filter, sort)) {
			return handleGroupOnly(request, groupList, pageNumber, pageSize, skip, status, pageStore, latestGroupCount);
		}

		if (DevExtGridFilterUtils.isGroupWithFilterOrSort(group, filter, sort)) {
			return handleGroupWithFilterOrSort(request, groupList, filterList, sortList, pageNumber, pageSize, skip,
					requireTotalCount, status, pageStore, latestGroupCount);
		}

		if (DevExtGridFilterUtils.isFilterOrSortOnly(group, filter, sort)) {
			return handleFilterOrSort(request, filterList, sortList, pageNumber, pageSize, skip, requireTotalCount,
					status, pageStore, latestGroupCount);
		}
		return null;
	}

	private int[] processPageAndSize(Integer pageNumber, Integer pageSize, Integer pageStore) {
		if (pageNumber == null) {
			pageNumber = 0;
		}
		if (pageSize == null) {
			pageSize = pageStore;
		}
		return new int[] { pageNumber, pageSize };
	}

	@SuppressWarnings("squid:S107")
	private <T> T handleGroupOnly(HsmOnlineInspectionRequestDto request, List<String> groupList, int pageNumber,
			int pageSize, int skip, String status, Integer pageStore, Integer latestGroupCount) {
		pageSize = pageNumber + pageSize;
		pageNumber = 0;

		String groupQuery = getQueryForGrouping(groupList, status);
		String groupCountQuery = getQueryForGroupingCount(groupList, status);
		String mainCountQuery = getMainProcessInspQueryCount(status);
		Long mainQueryCount = processInspCustRepository.getMainProcessInspQueryCount(request, mainCountQuery, status);
		Page<Object[]> groupingListData = processInspCustRepository.getGroupingListData(groupQuery, groupCountQuery,
				pageNumber, pageSize, skip, request, status);
		Long totalDistCount = processInspCustRepository.groupCountQuery(groupCountQuery, request, status);
		groupingListData.getContent().parallelStream().forEach(row -> {
		    Object schdSeqObj = row[1]; // assuming schdSeqId is at index 0
		    long schdSeqId = schdSeqObj != null ? (long) schdSeqObj : null;

		    PhysicalInspectionCoilDto dto = new PhysicalInspectionCoilDto();
		    dto.setSchdSeqId(schdSeqId);

		    boolean isSeqValid = DownCoilerValidationUtil.checkNumber(dto.getSchdSeqId());
//		    dto.setInspFlag(isSeqValid ? "YES" : "");
		    int lastIndex = row.length - 1;
		    row[lastIndex] = isSeqValid ? "YES" : "";
		});
		return buildGroupedDataResponse(groupingListData, mainQueryCount, totalDistCount);
	}

	@SuppressWarnings("squid:S107")
	private <T> T handleGroupWithFilterOrSort(HsmOnlineInspectionRequestDto request, List<String> groupList,
			List<String> filterList, List<String> sortList, Integer page, Integer size, Integer skip,
			boolean requireTotalCount, String status, Integer pageStore, Integer latestGroupCounts) {
		if (requireTotalCount && size == null) {
			size = pageStore;
		} else {
			size = page + size;
			page = 0;
		}

		String queryForGrouping = getProcessInspQueryForGroupingAndFiltering(groupList, filterList, status);
		String queryForGroupingAndFilteringCount = getProcessInspQueryForGroupingAndFilteringCount(groupList,
				filterList, sortList, status);
		String mainCountQuery = getMainProcessInspQueryCount(status);
		Long mainQueryCount = processInspCustRepository.getMainProcessInspQueryCount(request, mainCountQuery, status);
		Page<Object[]> groupingListData = processInspCustRepository.getGroupingListData(queryForGrouping,
				queryForGroupingAndFilteringCount, page, size, skip, request, status);
		Long totalDistCount = processInspCustRepository.groupCountQuery(queryForGroupingAndFilteringCount, request,
				status);
		groupingListData.getContent().parallelStream().forEach(row -> {
		    Object schdSeqObj = row[1]; // assuming schdSeqId is at index 0
		    long schdSeqId = schdSeqObj != null ? (long) schdSeqObj : null;

		    PhysicalInspectionCoilDto dto = new PhysicalInspectionCoilDto();
		    dto.setSchdSeqId(schdSeqId);

		    boolean isSeqValid = DownCoilerValidationUtil.checkNumber(dto.getSchdSeqId());
//		    dto.setInspFlag(isSeqValid ? "YES" : "");
		    int lastIndex = row.length - 1;
		    row[lastIndex] = isSeqValid ? "YES" : "";
		});
		return buildGroupedDataResponse(groupingListData, mainQueryCount,
				(totalDistCount != null && totalDistCount != 0) ? totalDistCount : latestGroupCounts);

	}

	private <T> T handleFilterOrSort(HsmOnlineInspectionRequestDto request, List<String> filterList,
			List<String> sortList, Integer page, Integer size, Integer skip, boolean requireTotalCount, String status,
			Integer pageStore, Integer latestGroupCount) {
		if (!requireTotalCount) {
			size = page + size;
			page = 0;
		}

		String query = processInspCustRepository.getAllPaginatedInspCoilInString();
		String countQuery = getMainProcessInspQueryCount(status);
		if (!filterList.isEmpty()) {
			query = filterQueryUsingFilterList(filterList, query);
			countQuery = filterQueryUsingFilterList(filterList, countQuery);
		}

		query = applySorting(sortList, query);
		Page<PhysicalInspectionCoilDto> processInsp = processInspCustRepository.getProcessInsp(request, status, page,
				size, query, countQuery, skip);
		processInsp.getContent().parallelStream().forEach(physicalInspectionCoilDto -> {
			boolean isSeqValid = DownCoilerValidationUtil.checkNumber(physicalInspectionCoilDto.getSchdSeqId());
			physicalInspectionCoilDto.setInspFlag(isSeqValid ? "YES" : "");
		});
