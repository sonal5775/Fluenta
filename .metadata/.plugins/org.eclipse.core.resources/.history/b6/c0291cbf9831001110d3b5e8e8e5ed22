	@Override
	public EligibilityDto isElligible(String userid, String grdid) {
		EligibilityDto eligibilityDto = new EligibilityDto();
		eligibilityDto.setIsUserElligible(false);
		Long roleId = wfusermapJmRepository.findRoleIdByUserIdAndWorkFlowId(OfsConstants.INT_SPEC_WF_ID, userid);
		LOGGER.info("role id>>{}", roleId);
		String roleName = wfroleJmRepository.findRoleNameByWorkFlowIdAndRoleId(OfsConstants.INT_SPEC_WF_ID, roleId);
		LOGGER.info("role name>>{}", roleName);
		String exeId = wfapprovalJmRepository.getExecutionIdByWfidAndGrdId(OfsConstants.INT_SPEC_WF_ID, grdid);
		LOGGER.info("exe id>>{}", exeId);
		List<WfexestepsJmEntity> listOfSteps = wfexestepsJmRepository.findLastStepByExecutionId(exeId);
		LOGGER.info("steps>>{}", listOfSteps);
		if (!listOfSteps.isEmpty()) {
			WfexestepsJmEntity entity = listOfSteps.get(0);
			if (entity != null) {
				if (entity.getNextwfroleid().longValue() == roleId) {
					eligibilityDto.setIsUserElligible(true);
					eligibilityDto.setPrevComment(entity.getStepmsgbody());
					eligibilityDto.setCrBy(entity.getCrBy());
					eligibilityDto.setCrDt(entity.getCrDt());
					eligibilityDto.setMoBy(entity.getMoBy());
					eligibilityDto.setMoDt(entity.getMoDt());
					eligibilityDto.setRoleName(roleName);
				} else {
					eligibilityDto.setIsUserElligible(false);
					eligibilityDto.setPrevComment(entity.getStepmsgbody());
					eligibilityDto.setCrBy(entity.getCrBy());
					eligibilityDto.setCrDt(entity.getCrDt());
					eligibilityDto.setMoBy(entity.getMoBy());
					eligibilityDto.setMoDt(entity.getMoDt());
					eligibilityDto.setRoleName(roleName);
				}
			}
		} else {
			if (OfsConstants.INITIATOR.equals(roleName)) {
				eligibilityDto.setIsUserElligible(true);
			}
		}
		if (exeId == null && (OfsConstants.INITIATOR.equals(roleName))) {
				eligibilityDto.setIsUserElligible(true);
			
		}

		LOGGER.info("Elligible>>{}", eligibilityDto);
		return eligibilityDto;
	}

	@Override
	public List<IsApprovalFlowRemarksDto> getPreviusMessages(InternalSpecDto dto) {
		List<IsApprovalFlowRemarksDto> remarksList = new ArrayList<>();
		String exeId = wfapprovalJmRepository.getExecutionIdByWfidAndGrdId(OfsConstants.INT_SPEC_WF_ID, dto.getGrdid());
		List<WfexestepsJmEntity> steps = wfexestepsJmRepository.findLastStepByExecutionId(exeId);
		for (WfexestepsJmEntity entity : steps) {
			IsApprovalFlowRemarksDto remarksDto = new IsApprovalFlowRemarksDto();
			remarksDto.setCrBy(entity.getCrBy());
			remarksDto.setCrDt(entity.getCrDt());
			remarksDto.setStepmsgbody(entity.getStepmsgbody());
			BigDecimal nextwfroleid = entity.getNextwfroleid();
			String roleName = this.wfroleJmRepository.findRoleNameByWorkFlowIdAndRoleId(OfsConstants.INT_SPEC_WF_ID,
					nextwfroleid.longValue());
			remarksDto.setNextDept(roleName);
			remarksList.add(remarksDto);
		}
		return remarksList;
	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public void updateIsStatus(InternalSpecDto dto) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		if (dto.getGrdid() != null) {
			GrdCm entity = null;
			Optional<GrdCm> internalGrade = internalSpecJpaRepository.findById(dto.getGrdid().trim());
			if (internalGrade.isPresent()) {
				entity = internalGrade.get();
				entity.setGrdsts(dto.getGrdsts());
				internalSpecJpaRepository.save(entity);
			} else {
				LOGGER.info("IS-SERVICEIMPL>>345 {}", "Entity not found");
			}
		}
