	@Override
	@Transactional(rollbackFor = Exception.class)
	public List<InternalSpecDto> saveInternalGradeDetails(List<InternalSpecDto> list) {
		try {
			dbSessionService.setSessionInfo(this.getClass().getName());

			for (InternalSpecDto dto : list) {
				if (dto.getGrdid() != null && !dto.getGrdid().trim().isEmpty()) {
					Optional<GrdCm> internalGrade = internalSpecJpaRepository.findById(dto.getGrdid().trim());
					GrdCm entity = new GrdCm();
					if (internalGrade.isPresent()) {
						entity = internalGrade.get();
						entity.setMoBy(ClientIpUtils.getClient());
						entity.setMoDt(new Date());
						entity.setMoMacAddr(ClientIpUtils.getClientIpAddress());
					} else {

						entity.setGrdid(dto.getGrdid().trim());
						entity.setCrBy(ClientIpUtils.getClient());
						entity.setCrDt(new Date());
						entity.setCrMacAddr(ClientIpUtils.getClientIpAddress());
					}
					entity.setGrddesc(dto.getGrddesc());
					entity.setGrdnm(dto.getGrdnm());
					entity.setGrdgrp(dto.getGrdgrp());
					entity.setGrdty(dto.getGrdty());
					entity.setEnduse(dto.getEnduse());
					entity.setIsactv(BigDecimal.ONE);
					entity.setGrdsts(dto.getGrdsts());
					entity.setTdcrefid(dto.getTdcrefid());
					entity.setReqBy(dto.getReqBy());
					entity.setReqDt(dto.getReqDt());
					internalSpecJpaRepository.save(entity);
				}
			}

			return list;
		} catch (Exception e) {
			throw new CustomException("Error while saving internal grade details");
		}

	}

