	@Override
	public ValidateInternalSpecDto validateInterspec(ReleaseRequestDto dto) {
		ValidateInternalSpecDto validatedto = new ValidateInternalSpecDto();

		// for chemistry
		InternalspecChemistryRequestDto chemdto = new InternalspecChemistryRequestDto(dto.getGrdid(), null);
		validatedto.setChemtabledata(custrepo.getAllChemistry(chemdto));

		// for product code
		ProductCodeRequest prdcdreq = new ProductCodeRequest(null, dto.getGrdid(), null);
		validatedto.setProductcodetabledata(prdCodeCustRepo.validateProductCode(prdcdreq));

		// for hsm pdi grade
		InternalSpecHsmPdiGradeMasterRequest pdigrdreq = new InternalSpecHsmPdiGradeMasterRequest(dto.getGrdid(), null, "HSM1", null);
		validatedto.setHsmpdigrade(hsmPdiCustRepo.getHsmPdiGradeMasterDetails(pdigrdreq));

		// for rhf pdi
		InternalSpecRhfPdiGrdMastRequest rhfpdigrdmaster = new InternalSpecRhfPdiGrdMastRequest(dto.getGrdid(), "HSM1");
		validatedto.setRhfpdigrade(rhfPdiCustRepo.getRhfPdiDetails(rhfpdigrdmaster));

		// for pdi temp
		InternalSpecHsmPdiTempSearchReqDto temppdimaster = new InternalSpecHsmPdiTempSearchReqDto("HSM1", dto.getGrdid(), null, null);
		validatedto.setTemppdigrade(hsmPdiTempCustRepo.getHsmDataOnSearch(temppdimaster));

		return validatedto;
	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public boolean releaseInternalSpecData(ReleaseRequestDto dto) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		long chemistryCount = internalSpecChemistryMasterRepository.findCountById(dto.getGrdid());
		long hsmPdiTempMasterCount = hsmPdiTempMasterRepository.findCountById(dto.getGrdid());
		long productCodeCount = productCodeRepository.findCountById(dto.getGrdid());
		long hsmPdiGradeMasterCount = hsmpdiCmRepository.findCountById(dto.getGrdid());
		long rhfPdiGradeMasterCount = rhfPdiGrdMastRepository.findCountById(dto.getGrdid());
		if (chemistryCount > 0 && hsmPdiTempMasterCount > 0 && productCodeCount > 0 && hsmPdiGradeMasterCount > 0
				&& rhfPdiGradeMasterCount > 0) {
			GrdCm grdCm = null;
			Optional<GrdCm> optional = internalSpecJpaRepository.findByGrdid(dto.getGrdid());
			if (optional.isPresent()) {
				grdCm = optional.get();
				grdCm.setMoBy(ClientIpUtils.getClient());
				grdCm.setMoDt(new Date());
				grdCm.setMoMacAddr(ClientIpUtils.getClientIpAddress());
			} else {
				LOGGER.info("InternalSpecServiceImpl:ReleaseInternalSpecData:Entity Not Found");
				return false;
			}
			grdCm.setApprBy(dto.getReleasedby());
			grdCm.setApprDt(dto.getReleaseddate());
			grdCm.setGrdsts(OfsStatusConstants.IS_STATUS_RELEASED);
			internalSpecJpaRepository.save(grdCm);
			LOGGER.info("InternalSpecServiceImpl:ReleaseInternalSpecData:GradeStatusUpdatedSuccessfully");
			return true;
		} else {
			return false;
		}
	}

	@Override
	@Transactional
	@SuppressWarnings({"java:S3776", "java:S3457"})
	public void validateWithInternalSpecAndChangeStatus(ReleaseRequestDto dto) {
		dbSessionService.setSessionInfo(this.getClass().getName());
		List<InternalSpecDto> specList = dto.getInternalSpecList();
		InternalSpecDto specDto = specList.get(0);
		Optional<GrdCm> internalGrade = internalSpecJpaRepository.findByGrdid(specDto.getGrdid());
		GrdCm grdCm = null;
		if(internalGrade.isPresent()) {
			grdCm = internalGrade.get();
			if(OfsStatusConstants.IS_WF_STATUS_APPROVAL.equals(grdCm.getGrdsts())) {
				return;
			}
		}
		long chemistryCount = internalSpecChemistryMasterRepository.findCountById(specDto.getGrdid());
		long hsmPdiTempMasterCount = hsmPdiTempMasterRepository.findCountById(specDto.getGrdid());
		long productCodeCount = productCodeRepository.findCountById(specDto.getGrdid());
		long hsmPdiGradeMasterCount = hsmpdiCmRepository.findCountById(specDto.getGrdid());
		long rhfPdiGradeMasterCount = rhfPdiGrdMastRepository.findCountById(specDto.getGrdid());
		LOGGER.info("data found chemistryCount {}>>"+chemistryCount+ "hsmPdiTempMasterCount {}>>>>"+hsmPdiTempMasterCount+
		"productCodeCount{}>>>"+productCodeCount+"hsmPdiGradeMasterCount{}>>>>"+hsmPdiGradeMasterCount+"rhfPdiGradeMasterCount {}>>" +
				rhfPdiGradeMasterCount);

		if (chemistryCount > 0 || productCodeCount > 0 || hsmPdiGradeMasterCount > 0
				|| rhfPdiGradeMasterCount > 0 || hsmPdiTempMasterCount > 0) {
			for (InternalSpecDto item : dto.getInternalSpecList()) {
				if(grdCm !=null && (grdCm.getGrdsts() ==null || OfsStatusConstants.TDC_STATUS_NEW_REQUEST.equals(grdCm.getGrdsts()))) {
					item.setGrdsts(OfsStatusConstants.IN_PROGRESS);
					saveInternalGradeDetails(dto.getInternalSpecList());
				}
			}
		}

		if (hsmPdiTempMasterCount > 0 && chemistryCount > 0) {
			for (InternalSpecDto item : dto.getInternalSpecList()) {
				if(grdCm !=null && OfsStatusConstants.IN_PROGRESS.equals(grdCm.getGrdsts())) {
					item.setGrdsts(OfsStatusConstants.TDC_WF_STATUS_PENDING);
					saveInternalGradeDetails(dto.getInternalSpecList());
				}
			}
		}
	}

